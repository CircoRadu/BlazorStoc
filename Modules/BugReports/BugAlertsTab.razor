@namespace BlazorStoc.Components.Shared
@using BlazorStoc.Modules.BugReports
@inject IBugReportService Reports
@inject IAccessControl Access
@* The tab "Bugs" of the Notifications page (PROP-0013, same logic as the tab "Propuneri"): the reports of errors that wait for a developer (new ones), red when there are any. Shown only to the
   accounts marked as developers while the module runs. It belongs to the BugReports module; the page of another module (Notifications) shows it through this wrapper. *@
@if (developer)
{
    <ModuleGate ModuleId="@BugReportsModule.ModuleId" Notice="false">
        <button type="button" role="tab" id="tab-bugs" class="settings-tab @(Active ? "active" : "") @(total > 0 ? "needs-attention" : "")" aria-selected="@(Active ? "true" : "false")" aria-controls="panel-notifications" @onclick="Select">Bugs <span class="count-badge">@total</span></button>
    </ModuleGate>
}

@code {
    [Parameter] public bool Active { get; set; }
    [Parameter] public EventCallback Selected { get; set; }

    private int total;
    private bool developer;

    private Task Select() => Selected.InvokeAsync();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            developer = await Access.HasAsync("setari-bug-raport.view");
            if (developer) total = (await Reports.GetAlertsAsync()).Count;
        }
        catch (Exception exception) when (exception is not OperationCanceledException) { total = 0; }
    }
}
