@using Microsoft.AspNetCore.Components.Forms
@inject IProposalService Proposals
@inject IAccessControl Access
@inject IChangeFeed ChangeFeed
@inject IJSRuntime JS
@inject ILogger<ProposalsPanel> Logger
@implements IAsyncDisposable
@* Setari -> Dezvoltare -> Propuneri (administrator): the proposals sent from the menu entry "Propune o modificare". Two tabs (open and closed ones), filters, a paged table (server side), the proposal
   with its pictures and the thread of answers, the change of state (with the version it was implemented in) and a first answer, the deletion and the ZIP export. *@
<section class="catalog" aria-labelledby="proposal-admin-title">
    <div class="catalog-heading"><h2 id="proposal-admin-title">Propuneri <span class="count-badge">@total</span></h2></div>
    <div class="catalog-body">
        @if (error is not null) { <div class="error-banner" role="alert" id="proposal-admin-error">@error</div> }
        @if (notice is not null) { <div class="success-banner" role="status" id="proposal-admin-notice">@notice</div> }
        <CollapsibleSection Id="proposal-admin-flow" RootClass="bug-help" HeaderRowClass="collapsible-header" ToggleClass="bug-help-toggle" ContentClass="bug-help-body" Expanded="false">
            <Header>Cum se lucrează cu propunerile</Header>
            <ChildContent>
                <ol>
                    <li>Utilizatorii trimit propuneri din meniul „Propune o modificare”; fiecare primește un număr (PROP-0042) și starea <strong>Nouă</strong>. Propunerile (textul) și răspunsurile sunt vizibile tuturor utilizatorilor; imaginile doar autorului și administratorilor.</li>
                    <li>Filele „Active” (Nouă, În analiză, Acceptată, Planificată) și „Închise” (Implementată, Amânată, Respinsă). Filtrezi după stare, tip, importanță, autor sau perioadă și deschizi o propunere cu pictograma ochi.</li>
                    <li>Alegi starea; la „Implementată” scrii versiunea în care a intrat. Poți scrie și un răspuns: autorul îl vede în „Propunerile mele” și în Notificări, fila „Propuneri”. Fiecare schimbare intră în jurnalul de activitate.</li>
                    <li><strong>Exportă propunerea</strong> descarcă un ZIP cu <code>propunere.json</code>, <code>propunere.txt</code> și imaginile; <strong>Exportă lista filtrată</strong> pune toate propunerile din filtre într-un ZIP, cu un <code>index.csv</code>.</li>
                    <li>Pictograma coșului șterge definitiv propunerea, răspunsurile și imaginile (după confirmare); ștergerea intră în jurnal.</li>
                </ol>
            </ChildContent>
        </CollapsibleSection>

        <div class="settings-tabs" role="tablist" aria-label="Propuneri">
            <button type="button" role="tab" id="tab-proposals-open" class="settings-tab @(showClosed ? "" : "active")" aria-selected="@(showClosed ? "false" : "true")" aria-controls="panel-proposals" @onclick="() => OpenTabAsync(false)">Active</button>
            <button type="button" role="tab" id="tab-proposals-closed" class="settings-tab @(showClosed ? "active" : "")" aria-selected="@(showClosed ? "true" : "false")" aria-controls="panel-proposals" @onclick="() => OpenTabAsync(true)">Închise</button>
        </div>
        <div id="panel-proposals" role="tabpanel" aria-labelledby="@(showClosed ? "tab-proposals-closed" : "tab-proposals-open")">
            <div class="audit-filters bug-filters">
                <label>Stare
                    <select id="proposal-filter-state" @bind="state" @bind:after="FilterChangedAsync">
                        <option value="">Toate</option>
                        @foreach (var item in ProposalRules.States.Where(item => ProposalRules.IsClosed(item) == showClosed)) { <option value="@item">@item</option> }
                    </select></label>
                <label>Tip
                    <select id="proposal-filter-kind" @bind="kind" @bind:after="FilterChangedAsync">
                        <option value="">Toate</option>
                        @foreach (var item in ProposalRules.Kinds) { <option value="@item">@item</option> }
                    </select></label>
                <label>Importanță
                    <select id="proposal-filter-importance" @bind="importance" @bind:after="FilterChangedAsync">
                        <option value="">Toate</option>
                        @foreach (var item in ProposalRules.Importances) { <option value="@item">@item</option> }
                    </select></label>
                <label>Caută <input id="proposal-filter-text" placeholder="număr, titlu sau zonă" @bind="text" @bind:event="onchange" @bind:after="FilterChangedAsync" /></label>
                <label>Autor <input id="proposal-filter-user" @bind="user" @bind:event="onchange" @bind:after="FilterChangedAsync" /></label>
                <label>De la <input id="proposal-filter-from" type="date" @bind="from" @bind:after="FilterChangedAsync" /></label>
                <label>Până la <input id="proposal-filter-to" type="date" @bind="to" @bind:after="FilterChangedAsync" /></label>
            </div>
            <div class="editor-actions">
                <button type="button" class="refresh act-reload" id="proposal-refresh" disabled="@busy" @onclick="LoadAsync">Actualizează</button>
                @if (canExport) { <button type="button" class="refresh act-export" id="proposal-export-filter" disabled="@(busy || total == 0)" @onclick="ExportFilteredAsync">Exportă lista filtrată (ZIP)</button> }
                @if (canEdit && showClosed) { <button type="button" class="danger" id="proposal-delete-all" disabled="@(busy || total == 0)" title="Șterge definitiv toate propunerile închise" @onclick="AskDeleteAllAsync">Șterge toate cele rezolvate</button> }
            </div>

            @if (loading) { <div class="empty-state" role="status"><div class="spinner"></div><h3>Se încarcă</h3></div> }
            else if (items.Count == 0) { <p class="muted" id="proposal-admin-empty">Nicio propunere pentru filtrele alese.</p> }
            else
            {
                <div class="table-scroll">
                    <table id="proposal-admin-table">
                        <thead><tr><th>Număr</th><th>Titlu</th><th>Tip</th><th>Importanță</th><th>Stare</th><th>Autor</th><th>Trimis</th><th>Imagini</th><th>Răspunsuri</th><th>Operații</th></tr></thead>
                        <tbody>
                            @foreach (var proposal in items)
                            {
                                var item = proposal;
                                <tr class="@(opened?.Id == item.Id ? "selected" : "")">
                                    <td>@item.Number</td><td>@item.Title</td><td>@item.Kind</td><td>@item.WantedImportance</td><td>@item.State@(item.ImplementedVersion.Length > 0 ? $" ({item.ImplementedVersion})" : "")</td><td>@item.UserName</td>
                                    <td>@ProposalRules.Display(item.CreatedUtc)</td><td>@item.FileCount</td><td>@item.NoteCount</td>
                                    <td class="row-actions">
                                        <button type="button" class="row-icon view" aria-label="Deschide propunerea @item.Number" title="Deschide propunerea @item.Number" @onclick="() => OpenAsync(item)"></button>
                                        @if (canEdit && item.State != ProposalRules.StateImplemented) { <button type="button" class="row-icon check" disabled="@busy" aria-label="Marchează propunerea @item.Number ca implementată" title="Marchează propunerea @item.Number ca implementată (în versiunea @AppVersion.Current)" @onclick="() => ImplementRowAsync(item)"></button> }
                                        @if (canEdit) { <button type="button" class="row-icon edit" aria-label="Editează propunerea @item.Number" title="Editează propunerea @item.Number" @onclick="() => OpenAsync(item, true)"></button> }
                                        @if (canExport) { <button type="button" class="row-icon export" aria-label="Exportă propunerea @item.Number" title="Exportă propunerea @item.Number (ZIP)" disabled="@busy" @onclick="() => ExportRowAsync(item)"></button> }
                                        @if (canEdit) { <button type="button" class="row-icon delete" aria-label="Șterge propunerea @item.Number" title="Șterge propunerea @item.Number" @onclick="() => AskDelete(item)"></button> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <AuditPager Id="proposal-admin-size" Label="Propuneri pe pagină" PageSizes="sizes" PageSize="pageSize" Page="page" Total="total" PageChanged="PageChangedAsync" PageSizeChanged="SizeChangedAsync" />
            }
        </div>

        @if (deleting is not null)
        {
            <div class="error-banner" role="alert" id="proposal-delete-confirm">Ștergi definitiv propunerea <strong>@deleting.Number</strong> („@deleting.Title”), răspunsurile și imaginile ei? Nu se poate anula.
                <span class="editor-actions"><button type="button" class="danger" id="proposal-delete-yes" disabled="@busy" @onclick="DeleteAsync">Da, șterge</button>
                    <button type="button" class="refresh act-nav" id="proposal-delete-no" @onclick="() => deleting = null">Nu, păstrează</button></span></div>
        }
@if (deletingAll)        {            <div class="error-banner" role="alert" id="proposal-delete-all-confirm">Ștergi definitiv <strong>@(deleteAllCount == 1 ? "singura propunere închisă" : $"toate cele {deleteAllCount} propuneri închise")</strong> (implementate, amânate sau respinse), cu răspunsurile și imaginile lor? Se șterg de pe server, nu se arhivează, și nu se pot recupera.                <span class="editor-actions"><button type="button" class="danger" id="proposal-delete-all-yes" disabled="@busy" @onclick="DeleteAllAsync">Da, șterge toate</button>                    <button type="button" class="refresh act-nav" id="proposal-delete-all-no" @onclick="() => deletingAll = false">Nu, păstrează</button></span></div>        }

        @if (zoomed is not null)
        {
            <ImageLightbox Src="@zoomed.Url" Title="@zoomed.Name" Closed="() => zoomed = null" />
        }

        @if (opened is not null)
        {
            <AppDialog Size="AppDialogSize.L" Floating="AnnotatorView" Title="@($"{opened.Number} · {opened.Title}")" TitleId="proposal-detail-title" HelpTopic="propunere-modificare" HelpAbout="Propuneri" OnClose="RequestClose" PanelClass="bug-detail">
                <div id="proposal-detail" class="catalog-body">
                    <dl class="bug-facts">
                        <dt>Tip</dt><dd>@opened.Kind</dd>
                        <dt>Importanță pentru autor</dt><dd>@opened.WantedImportance</dd>
                        <dt>Autor</dt><dd>@opened.UserName (@opened.UserRole)</dd>
                        <dt>Trimis</dt><dd>@ProposalRules.Display(opened.CreatedUtc) · versiunea @opened.AppVersion</dd>
                        <dt>Zona</dt><dd>@opened.AreaTitle <code>@opened.AreaRoute</code></dd>
                        <dt>Stare</dt><dd id="proposal-detail-state-text">@opened.State@(opened.ImplementedVersion.Length > 0 ? $" ({opened.ImplementedVersion})" : "")</dd>
                    </dl>
                    <h4>Descriere</h4>
                    <p class="bug-description">@opened.Description</p>
                    @if (opened.Benefit.Length > 0) { <h4>De ce</h4><p class="bug-description">@opened.Benefit</p> }
                    <div class="bug-images" id="proposal-detail-images">
                        @foreach (var picture in pictures)
                        {
                            var shown = picture;
                            <figure class="bug-image"><button type="button" class="bug-image-zoom" aria-label="Mărește imaginea @shown.Name" title="@(editing ? "Marchează zone pe imaginea " + shown.Name : "Mărește imaginea " + shown.Name)" @onclick="() => OpenPicture(shown)"><img src="@shown.Url" alt="@shown.Name" /><span class="bug-zoom-plus" aria-hidden="true">+</span></button><figcaption>@shown.Name</figcaption></figure>
                        }
                    </div>
                    <h4>Răspunsuri <span class="count-badge">@notes.Count</span></h4>
                    @if (notes.Count == 0) { <p class="muted">Nu există încă niciun răspuns.</p> }
                    @foreach (var note in notes)
                    {
                        <div class="proposal-note @(note.AuthorRole == "Administrator" ? "from-admin" : "")"><strong>@note.Author</strong> <small class="muted">@(note.AuthorRole) · @ProposalRules.Display(note.CreatedUtc)</small><p>@note.Body</p></div>
                    }
                    @if (error is not null) { <div class="error-banner" role="alert" id="proposal-detail-error">@error</div> }
                    @if (confirmDiscard) { <div class="error-banner" role="alert" id="proposal-detail-discard">Ai modificări nesalvate. <span class="editor-actions"><button type="button" class="danger" id="proposal-detail-discard-yes" @onclick="CloseDetail">Renunț la modificări</button> <button type="button" class="refresh act-nav" id="proposal-detail-discard-no" @onclick="() => confirmDiscard = false">Rămân</button></span></div> }
                    @if (editing)
                    {
                        <h4>Modificarea propunerii</h4>
                        <div class="editor-grid bug-form">
                            <label class="wide">Titlu
                                <input id="proposal-detail-title-input" maxlength="@ProposalRules.MaxTitle" @bind="editTitle" @bind:event="oninput" disabled="@busy" /></label>
                            <label class="wide">Descriere
                                <textarea id="proposal-detail-description" rows="6" maxlength="@ProposalRules.MaxDescription" @bind="editDescription" @bind:event="oninput" disabled="@busy"></textarea></label>
                            <label class="wide">De ce (motivarea)
                                <textarea id="proposal-detail-benefit" rows="3" maxlength="@ProposalRules.MaxBenefit" @bind="editBenefit" @bind:event="oninput" disabled="@busy"></textarea></label>
                        </div>
                        <h4>Imagini adăugate acum <span class="count-badge">@added.Count</span></h4>
                        <div class="bug-images" id="proposal-detail-added">
                            @foreach (var image in added)
                            {
                                var item = image;
                                <figure class="bug-image">
                                    <button type="button" class="bug-image-zoom" aria-label="Marchează zone pe imaginea @item.Name" title="Deschide imaginea mărită și marchează zone" @onclick="() => annotating = new Marking(item.Id, item.Name, item.DataUrl)"><img src="@item.DataUrl" alt="@item.Name" /><span class="bug-zoom-plus" aria-hidden="true">+</span></button>
                                    <figcaption>@item.Name</figcaption>
                                    <button type="button" class="row-icon delete" aria-label="Scoate imaginea @item.Name" title="Scoate imaginea @item.Name" disabled="@busy" @onclick="() => added.Remove(item)"></button>
                                </figure>
                            }
                        </div>
                        <div class="bug-add-images">
                            <label class="refresh act-confirm bug-file-button">Adaugă imagini…<InputFile OnChange="OnAddFilesAsync" multiple accept="image/png,image/jpeg,image/gif,image/webp" disabled="@busy" /></label>
                            <span class="muted">cel mult @ReportImageRules.MaxImages imagini în total (acum @pictures.Count), fiecare de cel mult @(ReportImageRules.MaxImageBytes / 1024 / 1024) MB</span>
                        </div>
                    <div class="editor-grid bug-form">
                        <label>Stare
                            <select id="proposal-detail-state" @bind="newState" disabled="@(!canEdit || busy)">
                                @foreach (var item in ProposalRules.States) { <option value="@item">@item</option> }
                            </select></label>
                        @if (newState == ProposalRules.StateImplemented)
                        {
                            <label>Implementată în versiunea
                                <input id="proposal-detail-version" maxlength="@ProposalRules.MaxVersion" @bind="implementedVersion" @bind:event="oninput" disabled="@(!canEdit || busy)" placeholder="ex.: 0.5.62" /></label>
                        }
                        <label class="wide">Răspuns pentru autor (opțional)
                            <textarea id="proposal-detail-note" rows="3" maxlength="@ProposalRules.MaxNote" @bind="note" @bind:event="oninput" disabled="@(!canEdit || busy)"></textarea></label>
                    </div>
                        <div class="editor-actions">
                            <button type="button" class="primary" id="proposal-detail-save" disabled="@busy" @onclick="SaveStateAsync">@(busy ? "Se salvează…" : "Salvează")</button>
                            <button type="button" class="refresh act-nav" id="proposal-detail-cancel" disabled="@busy" @onclick="CancelEdit">Renunță</button>
                        </div>
                    }
                    else
                    {
                        <div class="editor-actions">
                            @if (canEdit) { <button type="button" class="refresh act-edit" id="proposal-detail-edit" @onclick="BeginEdit">Editează</button> }
                            @if (canExport) { <button type="button" class="refresh act-export" id="proposal-detail-export" disabled="@busy" @onclick="ExportOpenedAsync">Exportă propunerea (ZIP)</button> }
                            <button type="button" class="refresh act-close" id="proposal-detail-close" @onclick="RequestClose">Închide propunerea</button>
                        </div>
                    }
                </div>
            </AppDialog>
        }
    </div>
</section>

@code {
    private sealed record Picture(string Name, string Url);

    private readonly CancellationTokenSource lifetime = new();
    private static readonly IReadOnlyList<int> sizes = [10, 25, 50, 100];
    private IReadOnlyList<Proposal> items = [];
    private IReadOnlyList<ProposalNote> notes = [];
    private List<Picture> pictures = [];
    private Proposal? opened, deleting;
    private Picture? zoomed;
    private string state = "", kind = "", importance = "", text = "", user = "", newState = ProposalRules.StateNew, implementedVersion = "", note = "";
    private DateTime? from, to;
    private int page = 1, pageSize = 25, total;
    private bool loading = true, busy, canEdit, canExport, showClosed;
    private string? error, notice;
    private IJSObjectReference? downloads;

    protected override async Task OnInitializedAsync()
    {
        StartLive();
        try
        {
            canEdit = await Access.HasAsync("setari-propuneri.edit", lifetime.Token);
            canExport = await Access.HasAsync("setari-propuneri.export", lifetime.Token);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        await LoadAsync();
    }

    private ProposalQuery Query => new(state.Length == 0 ? null : state, kind.Length == 0 ? null : kind, importance.Length == 0 ? null : importance, user,
        from is { } f ? DateOnly.FromDateTime(f) : null, to is { } t ? DateOnly.FromDateTime(t) : null, showClosed, text);

    private async Task OpenTabAsync(bool closed)
    {
        if (showClosed == closed) return;
        showClosed = closed; state = ""; page = 1; opened = null; deleting = null; zoomed = null; pictures = [];
        await LoadAsync();
    }

    // A proposal / report added, changed or deleted by any session (also the dialog of this one) refreshes the table in place, without the spinner.
    private LiveRefresh? live;
    private void StartLive() => live = new LiveRefresh(ChangeFeed, Guid.NewGuid(), change => change.EntityType == AuditEntities.Proposal,
        () => InvokeAsync(async () => { await LoadAsync(silent: true); StateHasChanged(); }), () => busy, () => Task.CompletedTask, fallbackInterval: TimeSpan.FromSeconds(60));

    private Task LoadAsync() => LoadAsync(silent: false);
    private async Task LoadAsync(bool silent)
    {
        if (!silent) { loading = true; error = null; }
        try
        {
            var result = await Proposals.QueryAsync(Query, page, pageSize, lifetime.Token);
            if (result.Items.Count == 0 && result.Total > 0 && page > 1) { page = Math.Max(1, (result.Total + pageSize - 1) / pageSize); result = await Proposals.QueryAsync(Query, page, pageSize, lifetime.Token); }
            items = result.Items; total = result.Total;
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) when (exception is AccessDeniedException or ModuleUnavailableException or ProposalException) { error = exception.Message; }
        catch (Exception exception)
        {
            Logger.LogError("The proposals could not be read ({ErrorType}).", exception.GetType().Name);
            error = "Propunerile nu au putut fi citite. Încearcă din nou.";
        }
        finally { loading = false; }
    }

    private async Task FilterChangedAsync() { page = 1; await LoadAsync(); }
    private async Task PageChangedAsync(int value) { page = value; await LoadAsync(); }
    private async Task SizeChangedAsync(int value) { pageSize = value; page = 1; await LoadAsync(); }

    // Editing the content (BUG-0014): the title and the description can be corrected and more pictures added (the ones already there stay); saved with the state.
    private string editTitle = "", editDescription = "", editBenefit = "";
    private readonly List<NewImage> added = [];
    private sealed class NewImage(string name, byte[] bytes, string contentType, string? source = null)
    {
        public string Id { get; } = Guid.NewGuid().ToString("N");
        public string Name { get; private set; } = name;
        public byte[] Bytes { get; private set; } = bytes;
        public string ContentType { get; private set; } = contentType;
        /// <summary>Key of the saved picture this one is a marked copy of (null: a picture chosen from a file).</summary>
        public string? Source { get; } = source;
        public string DataUrl => $"data:{ContentType};base64,{Convert.ToBase64String(Bytes)}";
        public void Replace(byte[] marked, string type) { Bytes = marked; ContentType = type; Name = Path.ChangeExtension(Name, ".jpg"); }
    }

    // Marking zones over a picture while editing (the picture of the report stays as it is: the marked copy is added as a new picture, saved with the rest).
    private sealed record Marking(string Id, string Label, string Src);
    private Marking? annotating;
    private RenderFragment? AnnotatorView => annotating is not { } shown ? null : @<ImageAnnotator @key="shown.Id" ImageId="@shown.Id" Label="@shown.Label" Src="@shown.Src" MaxBytes="ReportImageRules.MaxImageBytes" Applied="AppliedAsync" Closed="() => annotating = null" />;
    private void OpenPicture(Picture picture)
    {
        if (!editing) { zoomed = picture; return; }
        annotating = new Marking("saved-" + pictures.IndexOf(picture), picture.Name, picture.Url);
    }
    private Task AppliedAsync((string ImageId, byte[] Bytes, string ContentType) marked)
    {
        if (added.FirstOrDefault(item => item.Id == marked.ImageId || item.Source == marked.ImageId) is { } existing) { existing.Replace(marked.Bytes, marked.ContentType); return Task.CompletedTask; }
        if (pictures.Count + added.Count >= ReportImageRules.MaxImages) { error = $"Poți avea cel mult {ReportImageRules.MaxImages} imagini."; return Task.CompletedTask; }
        var name = annotating?.Label ?? "imagine";
        added.Add(new NewImage("marcata-" + Path.GetFileNameWithoutExtension(name) + ".jpg", marked.Bytes, marked.ContentType, marked.ImageId));
        return Task.CompletedTask;
    }

    private void StartEditing(Proposal report) { editing = true; newState = report.State; implementedVersion = report.ImplementedVersion; note = ""; editTitle = report.Title; editDescription = report.Description; editBenefit = report.Benefit; added.Clear(); annotating = null; }
    private bool ContentChanged => opened is not null && (editTitle.Trim() != opened.Title || editDescription.Trim() != opened.Description || editBenefit.Trim() != opened.Benefit || added.Count > 0);

    private async Task OnAddFilesAsync(InputFileChangeEventArgs args)
    {
        error = null;
        foreach (var file in args.GetMultipleFiles(ReportImageRules.MaxImages))
        {
            if (pictures.Count + added.Count >= ReportImageRules.MaxImages) { error = $"O propunere poate avea cel mult {ReportImageRules.MaxImages} imagini."; break; }
            if (file.Size > ReportImageRules.MaxImageBytes) { error = $"Imaginea „{file.Name}” depășește {ReportImageRules.MaxImageBytes / 1024 / 1024} MB."; continue; }
            try
            {
                await using var stream = file.OpenReadStream(ReportImageRules.MaxImageBytes);
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer, lifetime.Token);
                var bytes = buffer.ToArray();
                if (ReportImageRules.DetectImageType(bytes) is not { } type) { error = $"Fișierul „{file.Name}” nu este o imagine (PNG, JPEG, GIF sau WebP)."; continue; }
                added.Add(new NewImage(file.Name, bytes, type));
            }
            catch (Exception exception) when (exception is IOException or InvalidOperationException) { error = $"Fișierul „{file.Name}” nu a putut fi citit."; }
        }
    }


    private async Task LoadPicturesAsync(Proposal proposal)
    {
        pictures = [];
        foreach (var file in await Proposals.GetFilesAsync(proposal.Id, lifetime.Token))
            if (await Proposals.GetFileContentAsync(file.Id, lifetime.Token) is { } content)
                pictures.Add(new Picture(file.Kind == ReportImageRulesKindScreenshot ? "Captura paginii" : file.FileName, $"data:{content.ContentType};base64,{Convert.ToBase64String(content.Content)}"));
    }

    private bool editing, confirmDiscard;
    private async Task OpenAsync(Proposal proposal, bool edit = false)
    {
        error = notice = null; deleting = null; zoomed = null; editing = edit && canEdit; confirmDiscard = false;
        opened = proposal; newState = proposal.State; implementedVersion = proposal.ImplementedVersion; note = ""; pictures = []; notes = [];
        if (editing) StartEditing(proposal);
        try
        {
            notes = await Proposals.GetNotesAsync(proposal.Id, lifetime.Token);
            foreach (var file in await Proposals.GetFilesAsync(proposal.Id, lifetime.Token))
                if (await Proposals.GetFileContentAsync(file.Id, lifetime.Token) is { } content)
                    pictures.Add(new Picture(file.Kind == ReportImageRulesKindScreenshot ? "Captura paginii" : file.FileName, $"data:{content.ContentType};base64,{Convert.ToBase64String(content.Content)}"));
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) when (exception is AccessDeniedException or ModuleUnavailableException) { error = exception.Message; }
    }

    private const string ReportImageRulesKindScreenshot = BlazorStoc.Services.ReportImageRules.KindScreenshot;

    private void CloseDetail() { opened = null; pictures = []; notes = []; zoomed = null; editing = false; confirmDiscard = false; added.Clear(); annotating = null; }
    private bool Dirty => editing && opened is not null && (note.Trim().Length > 0 || newState != opened.State || implementedVersion != opened.ImplementedVersion || ContentChanged);
    private void RequestClose() { if (Dirty) confirmDiscard = true; else CloseDetail(); }
    private void BeginEdit() { if (!canEdit || opened is null) return; StartEditing(opened); }
    private void CancelEdit() { if (Dirty && !confirmDiscard) { confirmDiscard = true; return; } editing = false; confirmDiscard = false; added.Clear(); annotating = null; if (opened is not null) { newState = opened.State; implementedVersion = opened.ImplementedVersion; } note = ""; }
    private Task ExportRowAsync(Proposal proposal) => RunAsync(() => ExportAsync([proposal.Id]), "Exportul nu a putut fi făcut.");
    private void AskDelete(Proposal proposal) { deleting = proposal; deletingAll = false; error = notice = null; }

    private async Task RunAsync(Func<Task> work, string failure)
    {
        if (busy) return;
        busy = true; error = null;
        try { await work(); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) when (exception is ProposalException or AccessDeniedException or ModuleUnavailableException) { error = exception.Message; }
        catch (Exception exception)
        {
            Logger.LogError("{Failure} ({ErrorType}).", failure, exception.GetType().Name);
            error = failure + " Încearcă din nou.";
        }
        finally { busy = false; }
    }

    // One click from the list: the proposal becomes "Implementată" in the running version (the field of the detail window can still correct it); no answer is added.
    private Task ImplementRowAsync(Proposal proposal) => RunAsync(async () =>
    {
        var saved = await Proposals.ChangeStateAsync(proposal.Id, ProposalRules.StateImplemented, AppVersion.Current, "", lifetime.Token);
        if (opened?.Id == saved.Id) { opened = saved; newState = saved.State; implementedVersion = saved.ImplementedVersion; note = ""; editing = false; confirmDiscard = false; }
        notice = $"Propunerea {saved.Number} este acum „{saved.State}” (versiunea {saved.ImplementedVersion}).";
        await LoadAsync();
    }, "Starea nu a putut fi salvată.");

    private Task SaveStateAsync() => RunAsync(async () =>
    {
        var current = opened!;
        var contentSaved = false;
        if (ContentChanged)
        {
            current = await Proposals.UpdateContentAsync(current.Id, editTitle, editDescription, editBenefit, [.. added.Select(item => new ReportImage(ReportImageRules.KindFile, item.Name, item.Bytes))], lifetime.Token);
            added.Clear(); annotating = null;
            await LoadPicturesAsync(current);
            contentSaved = true;
        }
        var saved = await Proposals.ChangeStateAsync(current.Id, newState, implementedVersion, note, lifetime.Token);
        opened = saved; note = ""; editing = false; confirmDiscard = false;
        notes = await Proposals.GetNotesAsync(saved.Id, lifetime.Token);
        notice = contentSaved ? $"Propunerea {saved.Number} a fost modificată și este acum „{saved.State}”." : $"Propunerea {saved.Number} este acum „{saved.State}”.";
        await LoadAsync();
    }, "Starea nu a putut fi salvată.");

    private bool deletingAll;
    private int deleteAllCount;
    private Task AskDeleteAllAsync() => RunAsync(async () =>
    {
        deleteAllCount = (await Proposals.QueryAsync(new ProposalQuery(Closed: true), 1, 1, lifetime.Token)).Total;
        deletingAll = deleteAllCount > 0; deleting = null; notice = null;
        if (deleteAllCount == 0) notice = "Nu există propuneri închise de șters.";
    }, "Numărul propunerilor nu a putut fi citit.");

    private Task DeleteAllAsync() => RunAsync(async () =>
    {
        var deleted = await Proposals.DeleteClosedAsync(lifetime.Token);
        deletingAll = false; if (opened is not null && ProposalRules.ClosedStates.Contains(opened.State)) CloseDetail();
        notice = deleted == 1 ? "A fost ștearsă definitiv o propunere închisă." : $"Au fost șterse definitiv {deleted} propuneri închise.";
        page = 1;
        await LoadAsync();
    }, "Propunerile nu au putut fi șterse.");

    private Task DeleteAsync() => RunAsync(async () =>
    {
        var gone = deleting!;
        await Proposals.DeleteAsync(gone.Id, lifetime.Token);
        if (opened?.Id == gone.Id) CloseDetail();
        deleting = null;
        notice = $"Propunerea {gone.Number} a fost ștearsă.";
        await LoadAsync();
    }, "Propunerea nu a putut fi ștearsă.");

    private Task ExportOpenedAsync() => RunAsync(() => ExportAsync([opened!.Id]), "Exportul nu a putut fi făcut.");

    private Task ExportFilteredAsync() => RunAsync(async () =>
    {
        var all = await Proposals.QueryAsync(Query, 1, 0, lifetime.Token);
        await ExportAsync([.. all.Items.Select(item => item.Id)]);
    }, "Exportul nu a putut fi făcut.");

    private async Task ExportAsync(IReadOnlyList<int> ids)
    {
        var export = await Proposals.ExportAsync(ids, lifetime.Token);
        downloads ??= await JS.InvokeAsync<IJSObjectReference>("import", "./file-download.js");
        using var stream = new MemoryStream(export.Content);
        using var reference = new DotNetStreamReference(stream);
        await downloads.InvokeVoidAsync("downloadBinary", export.FileName, reference, "application/zip");
        notice = $"Fișierul {export.FileName} a fost descărcat ({export.Proposals} {(export.Proposals == 1 ? "propunere" : "propuneri")}).";
    }

    public async ValueTask DisposeAsync()
    {
        live?.Dispose();
        await DisposeCoreAsync();
    }

    private async ValueTask DisposeCoreAsync()
    {
        lifetime.Cancel();
        if (downloads is not null)
        {
            try { await downloads.DisposeAsync(); }
            catch (Exception exception) when (exception is JSDisconnectedException or JSException or InvalidOperationException) { }
        }
        lifetime.Dispose();
    }
}
