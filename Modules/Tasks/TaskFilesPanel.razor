@inject IUserTaskFiles Store
@inject IAccessControl Access
@inject ILogger<TaskFilesPanel> Logger
@implements IDisposable
@* The files of a task: the user the task is addressed to and the administrator add files; the user deletes only the files they added, the administrator (taskuri.edit) any.
   Same look and checks as the attached files of the other objects (EntityFilesPanel). *@

<div class="work-point-photos entity-files">
    <div class="catalog-heading"><h3>Fișiere <span>@files.Count</span></h3></div>
    @if (TaskId <= 0)
    {
        <p class="form-note">Fișierele se adaugă după salvare; fereastra rămâne deschisă după salvare, ca să le poți adăuga imediat.</p>
    }
    else
    {
        @if (error is not null) { <div class="error-banner" role="alert">@error</div> }
        <div class="image-inputs">
            <FileDropZone OnChange="SelectedAsync" Multiple="true" Text="Alege fișiere" Disabled="@(uploading || busy)" />
            <small>Orice tip de fișier, cel mult 20 MB fiecare, cel mult @EntityFileRules.MaximumPerOwner de fișiere (imaginile, PDF-urile și textele se pot vedea în fereastră, restul se descarcă). Se salvează imediat, fără să apeși butonul de salvare al formularului.</small>
            @if (uploading) { <span role="status">Se încarcă…</span> }
        </div>
        @if (files.Count == 0)
        {
            <p class="muted">Nu există fișiere atașate.</p>
        }
        else
        {
            <table>
                <thead><tr><th>Fișier</th><th>Încărcat</th><th></th></tr></thead>
                <tbody>
                    @foreach (var file in files)
                    {
                        var mayDelete = CanDelete(file);
                        <tr @key="file.Id">
                            <td><a href="@($"/media/task-files/{file.Id}")" target="_blank" rel="noopener">@file.OriginalName</a></td>
                            <td>@file.UploadedBy · @StockMovementRules.DisplayDate(DateOnly.FromDateTime(file.UploadedUtc.ToLocalTime()))</td>
                            <td>
                                <button type="button" class="row-icon view" aria-label="Vizualizează fișierul @file.OriginalName" title="Vizualizează fișierul @file.OriginalName" @onclick="() => previewing = file"></button>
                                <button type="button" class="row-icon delete" disabled="@(uploading || busy || !mayDelete)" aria-label="Șterge fișierul @file.OriginalName"
                                        title="@(mayDelete ? $"Șterge fișierul {file.OriginalName}" : "Fișierul a fost adăugat de altcineva; îl poate șterge doar cine l-a adăugat sau administratorul.")" @onclick="() => confirmingDelete = file"></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</div>

@if (confirmingDelete is { } doomed)
{
    <div class="delete-overlay" @onkeydown="ConfirmKey">
        <section class="delete-dialog" role="alertdialog" aria-modal="true" tabindex="-1" aria-labelledby="task-file-delete-title">
            <h2 id="task-file-delete-title">Ștergi fișierul?</h2>
            <p class="delete-object"><strong>@doomed.OriginalName</strong></p>
            <p>Fișierul este șters definitiv din task.</p>
            <div class="editor-actions">
                <button type="button" class="danger" disabled="@busy" @onclick="ConfirmDeleteAsync">@(busy ? "Se șterge…" : "Șterge")</button>
                <button type="button" class="refresh act-close" disabled="@busy" @onclick="() => confirmingDelete = null">Anulează</button>
            </div>
        </section>
    </div>
}

@if (previewing is { } shown)
{
    <EntityFilePreview File="shown" BaseUrl="/media/task-files" Closed="ClosePreview" />
}

@code {
    [Parameter] public int TaskId { get; set; }
    // Raised after a file was added or deleted (the task counts its files and may have been taken over by adding one).
    [Parameter] public EventCallback Changed { get; set; }
    private IReadOnlyList<EntityFile> files = Array.Empty<EntityFile>();
    private bool uploading, busy, canEditAll;
    private string? error, me;
    private EntityFile? previewing, confirmingDelete;
    private int loadedFor;
    private readonly CancellationTokenSource lifetime = new();

    private bool CanDelete(EntityFile file) => canEditAll || string.Equals(file.UploadedBy, me, StringComparison.Ordinal);

    protected override async Task OnParametersSetAsync()
    {
        if (TaskId > 0 && loadedFor != TaskId)
        {
            loadedFor = TaskId;
            try { canEditAll = await Access.HasAsync("taskuri.edit", lifetime.Token); me = await Access.GetUsernameAsync(lifetime.Token); }
            catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { return; }
            catch (Exception) { canEditAll = false; }
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        try { files = await Store.GetAsync(TaskId, lifetime.Token); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Logger.LogWarning("Task files loading failed ({ErrorType}).", exception.GetType().Name);
            error = "Fișierele nu au putut fi încărcate.";
        }
    }

    // Each chosen file is stored at once (and journaled); a refused file is reported and the others are still stored.
    private async Task SelectedAsync(InputFileChangeEventArgs eventArgs)
    {
        if (TaskId <= 0 || uploading) return;
        uploading = true;
        error = null;
        var problems = new List<string>();
        try
        {
            foreach (var file in eventArgs.GetMultipleFiles(EntityFileRules.MaximumPerOwner))
            {
                try
                {
                    await using var stream = file.OpenReadStream(EntityFileRules.MaximumBytes, lifetime.Token);
                    using var buffer = new MemoryStream();
                    await stream.CopyToAsync(buffer, lifetime.Token);
                    await Store.AddAsync(TaskId, file.Name, file.ContentType, buffer.ToArray(), lifetime.Token);
                }
                catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { return; }
                catch (WorkPointOperationException exception) { problems.Add($"{file.Name}: {exception.Message}"); }
                catch (UserTaskOperationException exception) { problems.Add($"{file.Name}: {exception.Message}"); }
                catch (AccessDeniedException exception) { problems.Add($"{file.Name}: {exception.Message}"); }
                catch (IOException) { problems.Add($"{file.Name}: fișierul depășește 20 MB sau nu a putut fi citit."); }
                catch (Exception exception)
                {
                    Logger.LogError("Task file upload failed ({ErrorType}).", exception.GetType().Name);
                    problems.Add($"{file.Name}: fișierul nu a putut fi încărcat.");
                }
            }
        }
        finally { uploading = false; }
        if (problems.Count > 0) error = string.Join(" ", problems);
        await LoadAsync();
        await Changed.InvokeAsync();
    }

    private void ClosePreview() => previewing = null;
    private void ConfirmKey(KeyboardEventArgs e) { if (e.Key == "Escape" && !busy) confirmingDelete = null; }

    private async Task ConfirmDeleteAsync()
    {
        if (confirmingDelete is not { } file || busy) return;
        busy = true;
        error = null;
        try { await Store.DeleteAsync(file.Id, lifetime.Token); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (UserTaskOperationException exception) { error = exception.Message; }
        catch (AccessDeniedException exception) { error = exception.Message; }
        catch (Exception exception)
        {
            Logger.LogError("Task file deletion failed ({ErrorType}).", exception.GetType().Name);
            error = "Fișierul nu a putut fi șters.";
        }
        finally { busy = false; confirmingDelete = null; }
        await LoadAsync();
        await Changed.InvokeAsync();
    }

    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
}
