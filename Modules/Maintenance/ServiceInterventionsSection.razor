@using BlazorStoc.Services
@namespace BlazorStoc.Components.Pages
@inject IServiceInterventionRepository Repository
@inject IServicePhotoStore PhotoStore
@inject ILogger<ServiceInterventionsSection> Logger
@implements IDisposable

@if (adding || editing is not null)
{
    <div class="delete-overlay">
        <div class="delete-dialog template-popup" role="dialog" aria-modal="true" tabindex="-1" aria-labelledby="intervention-editor-title">
            <ServiceInterventionEditor @key="editorKey" BeneficiaryId="BeneficiaryId" WorkPoints="WorkPoints" Contracts="Contracts" Interventions="interventions" Original="editing" InitialWorkPointId="initialWorkPointId"
                                       Saved="SavedAsync" Closed="CloseEditorAsync" PhotosChanged="ReloadCountsAsync" />
        </div>
    </div>
}

@if (viewing is not null)
{
    <div class="delete-overlay">
        <div class="delete-dialog template-popup review-popup" role="dialog" aria-modal="true" tabindex="-1" aria-labelledby="intervention-view-title">
            <div class="catalog-heading"><h2 id="intervention-view-title">Intervenția @ServiceInterventionRules.KindText(viewing.Kind) din @StockMovementRules.DisplayDate(viewing.PerformedOn)</h2>
                <span class="heading-actions"><button type="button" class="danger" @onclick="CloseView">Închide</button></span></div>
            <dl class="review-facts">
                <dt>Fel</dt><dd>@ServiceInterventionRules.KindLabel(viewing.Kind)</dd>
                <dt>Punct de lucru</dt><dd>@viewing.WorkPointName<br /><small class="muted">@viewing.WorkPointAddress</small></dd>
                <dt>Contract</dt><dd>@(viewing.ContractLabel ?? "—")</dd>
                <dt>Efectuată la</dt><dd>@StockMovementRules.DisplayDate(viewing.PerformedOn)</dd>
                @if (viewing.IsMaintenance)
                {
                    <dt>Scadență</dt><dd>@if (viewing.MovesDue) { <text>@StockMovementRules.DisplayDate(viewing.PlannedDue!.Value) → <strong>@StockMovementRules.DisplayDate(viewing.NextDueSet!.Value)</strong></text> } else { <text>Nu a modificat scadența</text> }</dd>
                }
                <dt>Observații</dt><dd class="review-text">@(viewing.Notes.Length > 0 ? viewing.Notes : "—")</dd>
                <dt>Înregistrată de</dt><dd>@viewing.RecordedBy · @StockMovementRules.DisplayDate(DateOnly.FromDateTime(viewing.RecordedUtc.ToLocalTime()))</dd>
            </dl>
            @if (viewTicketLoading) { <p class="muted" role="status">Se citește tichetul…</p> }
            else if (viewTicket is { } ticket)
            {
                <h3>Tichet ActivityApp</h3>
                <dl class="review-facts">
                    <dt>Tichet</dt><dd>@ticket.Number @ticket.Title</dd>
                    @if (ticket.Problem.Length > 0) { <dt>Problema</dt><dd class="review-text">@ticket.Problem</dd> }
                    @if (ticket.Resolution.Length > 0) { <dt>Rezolvarea</dt><dd class="review-text">@ticket.Resolution</dd> }
                    @if (ticket.Report.Length > 0 && ticket.Report != ticket.Resolution) { <dt>Raport complet</dt><dd class="review-text">@ticket.Report</dd> }
                    @if (ticket.Executor.Length > 0) { <dt>Executant</dt><dd>@ticket.Executor</dd> }
                    <dt>Preluat la</dt><dd>@StockMovementRules.DisplayDate(DateOnly.FromDateTime(ticket.ImportedUtc.ToLocalTime()))</dd>
                </dl>
            }
        </div>
    </div>
}

<section class="catalog">
    <details class="catalog-collapse"><summary class="catalog-heading"><h2>Intervenții <span>@Visible.Count</span></h2>
        <div class="heading-actions">
            <label class="kind-filter">Fel <select aria-label="Filtrează după felul intervenției" @bind="kindFilter">
                <option value="">Toate</option>
                <option value="M">Mentenanță</option>
                <option value="C">La cerere</option>
            </select></label>
            @if (CanManage) { <button class="refresh act-confirm" disabled="@Locked" @onclick="OpenAdd">+ Înregistrează intervenție</button> }
        </div>
    </summary>
    @if (notice is not null) { <div class="success-banner" role="status">@notice</div> }
    @if (error is not null) { <div class="error-banner" role="alert">@error</div> }
    @if (loading)
    {
        <div class="empty-state" role="status"><div class="spinner"></div><h3>Se încarcă intervențiile</h3></div>
    }
    else if (Visible.Count == 0)
    {
        <div class="empty-state"><span class="empty-icon">⚒</span><h3>@(interventions.Count == 0 ? "Nu există intervenții înregistrate" : "Nicio intervenție de acest fel")</h3>
            <p>@(interventions.Count == 0 ? "Înregistrează o intervenție de mentenanță sau la cerere ca să ții evidența lucrărilor la punctele de lucru." : "Schimbă filtrul „Fel” ca să vezi celelalte intervenții.")</p></div>
    }
    else
    {
        <div class="table-scroll"><table><thead><tr><th>EFECTUATĂ LA</th><th>FEL</th><th>PUNCT DE LUCRU</th><th>CONTRACT</th><th>SCADENȚĂ</th><th>OBSERVAȚII</th><th class="number">FOTO</th><th></th></tr></thead><tbody>
        @foreach (var item in Visible)
        {
            <tr @key="item.Id">
                <td>@StockMovementRules.DisplayDate(item.PerformedOn)</td>
                <td><span class="contract-state @(item.IsMaintenance ? "on" : "off")">@ServiceInterventionRules.KindLabel(item.Kind)</span></td>
                <td><strong>@item.WorkPointName</strong><br /><small class="muted">@item.WorkPointAddress</small></td>
                <td>@(item.ContractLabel ?? "—")</td>
                <td>
                    @if (!item.IsMaintenance) { <span class="muted">—</span> }
                    else if (item.MovesDue) { <span>@StockMovementRules.DisplayDate(item.PlannedDue!.Value) → <strong>@StockMovementRules.DisplayDate(item.NextDueSet!.Value)</strong><br /><small class="muted">@ServiceInterventionRules.BasisLabel(item.Basis!.Value)</small></span> }
                    else { <small class="muted">Nu a modificat scadența</small> }
                </td>
                <td class="work-point-description" title="@item.Notes">@item.Notes</td>
                <td class="number">@(photoCounts.TryGetValue(item.Id, out var count) ? count.ToString() : "")</td>
                <td>
                    <button class="row-icon view" aria-label="Vizualizează intervenția din @StockMovementRules.DisplayDate(item.PerformedOn)" title="Vizualizează intervenția din @StockMovementRules.DisplayDate(item.PerformedOn)" @onclick="() => OpenViewAsync(item)"></button>
                    @if (CanManage)
                    {
                        <button class="row-icon edit" disabled="@Locked" aria-label="Editează intervenția din @StockMovementRules.DisplayDate(item.PerformedOn)" title="Editează intervenția din @StockMovementRules.DisplayDate(item.PerformedOn)" @onclick="() => OpenEdit(item)"></button>
                        <button class="row-icon delete" disabled="@Locked" aria-label="Șterge intervenția din @StockMovementRules.DisplayDate(item.PerformedOn)" title="Șterge intervenția din @StockMovementRules.DisplayDate(item.PerformedOn)" @onclick="() => OpenDelete(item)"></button>
                    }
                </td>
            </tr>
        }
        </tbody></table></div>
    }
</details>
</section>

@if (deleting is not null)
{
    <DeleteConfirmationDialog @key="deleting.Id" Title="Ștergi intervenția?" Subject="Intervenția" ObjectLabel="@($"{ServiceInterventionRules.KindLabel(deleting.Kind)} · {deleting.WorkPointName} · {StockMovementRules.DisplayDate(deleting.PerformedOn)}")"
                              Description="@DeleteDescription" Busy="@busy" Error="@deleteError" Confirmed="DeleteAsync" Cancelled="CancelDeleteAsync" />
}

@code {
    [Parameter, EditorRequired] public int BeneficiaryId { get; set; }
    [Parameter, EditorRequired] public string BeneficiaryName { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<WorkPoint> WorkPoints { get; set; } = Array.Empty<WorkPoint>();
    [Parameter, EditorRequired] public IReadOnlyList<ServiceContractDetails> Contracts { get; set; } = Array.Empty<ServiceContractDetails>();
    [Parameter] public bool CanManage { get; set; }
    // Opens the form of a new intervention on this work point when the page is opened (the link of the map: ?adauga-interventie=<id>).
    [Parameter] public int OpenForWorkPointId { get; set; }
    // The parent reloads the contracts (and the work point list) after a change: a maintenance intervention moves due dates.
    [Parameter] public EventCallback Changed { get; set; }

    private IReadOnlyList<ServiceIntervention> interventions = Array.Empty<ServiceIntervention>();
    private IReadOnlyDictionary<int, int> photoCounts = new Dictionary<int, int>();
    private bool adding, busy, loading = true;
    private ServiceIntervention? editing, deleting, viewing;
    private InterventionTicket? viewTicket;
    private bool viewTicketLoading;
    private Guid editorKey;
    private int initialWorkPointId;
    private string kindFilter = "";
    private string? notice, error, deleteError;
    private readonly CancellationTokenSource lifetime = new();

    private bool Locked => busy || adding || editing is not null;
    private IReadOnlyList<ServiceIntervention> Visible => kindFilter.Length == 0 ? interventions : interventions.Where(item => ServiceInterventionRules.KindCode(item.Kind).ToString() == kindFilter).ToList();

    private string DeleteDescription => deleting is { MovesDue: true }
        ? "Intervenția se arhivează împreună cu fotografiile ei. Dacă este ultima intervenție de mentenanță a punctului, scadența punctului revine la cea pe care a închis-o."
        : "Intervenția se arhivează împreună cu fotografiile ei; nu modifică scadențele punctului.";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        if (CanManage && OpenForWorkPointId > 0 && WorkPoints.Any(point => point.Id == OpenForWorkPointId)) { initialWorkPointId = OpenForWorkPointId; OpenAdd(); }
    }

    private async Task LoadAsync()
    {
        try
        {
            interventions = await Repository.GetForBeneficiaryAsync(BeneficiaryId, lifetime.Token);
            photoCounts = await PhotoStore.CountsForInterventionsAsync(BeneficiaryId, lifetime.Token);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Logger.LogError("Service interventions loading failed ({ErrorType}).", exception.GetType().Name);
            error = "Intervențiile nu au putut fi încărcate.";
        }
        finally { loading = false; }
    }

    private async Task ReloadCountsAsync()
    {
        try { photoCounts = await PhotoStore.CountsForInterventionsAsync(BeneficiaryId, lifetime.Token); }
        catch (OperationCanceledException) { }
        catch (Exception exception) { Logger.LogWarning("Intervention photo counts refresh failed ({ErrorType}).", exception.GetType().Name); }
    }

    private async Task OpenViewAsync(ServiceIntervention item)
    {
        viewing = item; viewTicket = null; viewTicketLoading = true; notice = error = null;
        try { viewTicket = await Repository.GetTicketAsync(item.Id, lifetime.Token); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) { Logger.LogWarning("Intervention ticket loading failed ({ErrorType}).", exception.GetType().Name); }
        finally { viewTicketLoading = false; }
    }
    private void CloseView() { viewing = null; viewTicket = null; }

    private void OpenAdd() { adding = true; editing = null; editorKey = Guid.NewGuid(); notice = error = null; }
    private void OpenEdit(ServiceIntervention item) { initialWorkPointId = 0; adding = false; editing = item; editorKey = Guid.NewGuid(); notice = error = null; }
    private Task CloseEditorAsync() { adding = false; editing = null; return Task.CompletedTask; }

    private async Task SavedAsync(ServiceInterventionSaved saved)
    {
        var wasNew = adding;
        var kind = ServiceInterventionRules.KindText(saved.Intervention.Kind);
        notice = wasNew
            ? $"Intervenția {kind} din {StockMovementRules.DisplayDate(saved.Intervention.PerformedOn)} a fost înregistrată" + (saved.NewDue is { } due ? $"; următoarea scadență a punctului: {StockMovementRules.DisplayDate(due)}." : ".") + " Poți adăuga acum fotografii sau închide fișa."
            : $"Intervenția {kind} din {StockMovementRules.DisplayDate(saved.Intervention.PerformedOn)} a fost actualizată.";
        await LoadAsync();
        // A new intervention stays open for editing, so its photos can be added right away.
        adding = false;
        editing = wasNew ? interventions.FirstOrDefault(item => item.Id == saved.Intervention.Id) ?? saved.Intervention : null;
        if (wasNew) editorKey = Guid.NewGuid();
        await Changed.InvokeAsync();
    }

    private void OpenDelete(ServiceIntervention item) { deleting = item; deleteError = null; notice = error = null; }
    private Task CancelDeleteAsync() { deleting = null; deleteError = null; return Task.CompletedTask; }

    private async Task DeleteAsync(string reason)
    {
        if (busy || deleting is not { } item) return;
        busy = true;
        deleteError = null;
        var done = false;
        try
        {
            await Repository.DeleteAsync(item, reason, lifetime.Token);
            notice = $"Intervenția {ServiceInterventionRules.KindText(item.Kind)} din {StockMovementRules.DisplayDate(item.PerformedOn)} a fost ștearsă (arhivată).";
            done = true;
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (ServiceInterventionOperationException exception) { deleteError = exception.Message; }
        catch (AccessDeniedException exception) { deleteError = exception.Message; }
        catch (Exception exception)
        {
            Logger.LogError("Service intervention deletion failed ({ErrorType}).", exception.GetType().Name);
            deleteError = "Intervenția nu a putut fi ștearsă.";
        }
        finally { busy = false; }
        if (done) { deleting = null; await LoadAsync(); await Changed.InvokeAsync(); }
    }

    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
}
