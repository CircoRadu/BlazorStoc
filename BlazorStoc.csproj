<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Only Release is built in development: a plain "dotnet build" (or one asking for Debug) builds Release. -->
    <Configurations>Release</Configurations>
    <Configuration Condition="'$(Configuration)' == '' Or '$(Configuration)' == 'Debug'">Release</Configuration>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The version of the application as a whole (shown in Setari -> Module and in /health); tools
elease.ps1 sets it for a release. -->
    <Version>0.5.17</Version>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;keys/**;keys-test/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlazorStoc.InvoiceCorpus" />
    <InternalsVisibleTo Include="BlazorStoc.Checks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.10" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PDFsharp" Version="6.2.1" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Content Remove="tests/**" />
    <None Remove="tests/**" />
    <Content Remove="keys/**;keys-test/**;.env;.env.*" />
    <None Remove="keys/**;keys-test/**;.env;.env.*" />
    <!-- The updater tool (tools/BlazorStoc.Updater) is its own project. The private files of the accounts (local-secrets), the settings and data of the developer's
         machine (data), the logs and the dump of the database are never part of what is published: a release must not carry passwords or the data of the
         machine it was built on (the data of an installation live in the data root, see AppDataRoot). -->
    <Compile Remove="tools/BlazorStoc.Updater/**/*.cs;tools/BlazorStoc.Installer/**/*.cs" />
    <Content Remove="tools/BlazorStoc.Updater/**;tools/BlazorStoc.Installer/**;local-secrets/**;data/**;logs/**;database/**" />
    <None Remove="tools/BlazorStoc.Updater/**;tools/BlazorStoc.Installer/**;local-secrets/**;data/**;logs/**;database/**" />
    <Content Remove="Assets/Fonts/**" />
    <None Remove="Assets/Fonts/**" />
    <EmbeddedResource Include="Assets/Fonts/PTSans-Regular.ttf" />
    <EmbeddedResource Include="Assets/Fonts/PTSans-Bold.ttf" />
    <Content Remove="Assets/Data/**" />
    <None Remove="Assets/Data/**" />
    <EmbeddedResource Include="Assets/Data/**" LogicalName="BlazorStoc.Data.%(Filename)%(Extension)" />
    <Content Remove="Assets/Migrations/**" />
    <None Remove="Assets/Migrations/**" />
    <EmbeddedResource Include="Assets/Migrations/*.sql" LogicalName="BlazorStoc.Migrations.%(Filename)%(Extension)" />
    <Content Remove="Assets/Help/**" />
    <None Remove="Assets/Help/**" />
    <EmbeddedResource Include="Assets/Help/*.help" LogicalName="BlazorStoc.Help.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets/Help/img/*" LogicalName="BlazorStoc.HelpImg.%(Filename)%(Extension)" />
    <Content Remove="Assets/Models/**" />
    <None Remove="Assets/Models/**" />
    <EmbeddedResource Include="Assets/Models/mnist-12.onnx" />
    <Content Remove="Assets/Tessdata/**" />
    <None Remove="Assets/Tessdata/**" />
    <Content Include="Assets/Tessdata/eng.traineddata">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- Romanian data for reading invoices (Tesseract tessdata_fast, same source and licence as eng): with it OCR reads ro + eng together. -->
    <Content Include="Assets/Tessdata/ron.traineddata">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
