<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;keys/**;keys-test/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlazorStoc.InvoiceCorpus" />
    <InternalsVisibleTo Include="BlazorStoc.Checks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PDFsharp" Version="6.2.1" />
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Content Remove="tests/**" />
    <None Remove="tests/**" />
    <Content Remove="keys/**;keys-test/**;.env;.env.*" />
    <None Remove="keys/**;keys-test/**;.env;.env.*" />
    <Content Remove="Assets/Fonts/**" />
    <None Remove="Assets/Fonts/**" />
    <EmbeddedResource Include="Assets/Fonts/PTSans-Regular.ttf" />
    <EmbeddedResource Include="Assets/Fonts/PTSans-Bold.ttf" />
    <Content Remove="Assets/Models/**" />
    <None Remove="Assets/Models/**" />
    <EmbeddedResource Include="Assets/Models/mnist-12.onnx" />
    <Content Remove="Assets/Tessdata/**" />
    <None Remove="Assets/Tessdata/**" />
    <Content Include="Assets/Tessdata/eng.traineddata">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- Romanian data for reading invoices (Tesseract tessdata_fast, same source and licence as eng): with it OCR reads ro + eng together. -->
    <Content Include="Assets/Tessdata/ron.traineddata">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
