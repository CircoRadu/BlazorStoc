@page
@model BlazorStoc.Pages.Account.TwoFactorModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{ Layout = null; }
<!DOCTYPE html>
<html lang="ro"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Autentificatorul meu · BlazorStoc</title><link rel="stylesheet" href="/app.css" /></head>
<body class="login-body"><main class="login-card"><span class="brand-icon">B</span><p class="eyebrow">ESP · GESTIUNE STOCURI</p><h1>Autentificatorul meu</h1>
@if (Model.Error is not null) { <p role="alert" class="error-text">@Model.Error</p> }
else
{
    <p class="muted"><strong>@(Model.Status.Active ? "Activ" : Model.Status.Suspended ? "Suspendat" : Model.Status.Exists ? "În așteptare" : "Neînrolat")</strong></p>
    <p class="muted">@Model.Text</p>
    @if (Model.Status.Active)
    {
        <p class="muted small">Coduri de recuperare rămase: @Model.Status.RecoveryLeft@(Model.Status.LastUsedUtc is null ? "" : " · ultima folosire: " + DateTime.Parse(Model.Status.LastUsedUtc, null, System.Globalization.DateTimeStyles.RoundtripKind).ToLocalTime().ToString("dd.MM.yyyy HH:mm"))</p>
    }
}
<p class="muted small"><a href="/">← Înapoi în aplicație</a></p></main></body></html>
