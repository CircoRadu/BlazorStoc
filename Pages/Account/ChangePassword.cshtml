@page
@model BlazorStoc.Pages.Account.ChangePasswordModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{ Layout = null; }
<!DOCTYPE html>
<html lang="ro"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Alege o parolă nouă · BlazorStoc</title><link rel="stylesheet" href="/app.css" /></head>
<body class="login-body"><main class="login-card"><span class="brand-icon">B</span><p class="eyebrow">ESP · GESTIUNE STOCURI</p><h1>Alege o parolă nouă</h1>
<p class="muted">@Model.Username, parola ta a fost stabilită de un administrator. Înainte să intri în aplicație alege o parolă nouă, doar a ta.</p>
<form method="post" data-password-form><input asp-for="ReturnUrl" type="hidden" />
<div class="password-pair"><label>Parola nouă<input asp-for="NewPassword" type="password" autocomplete="new-password" maxlength="200" required autofocus data-password-new /></label>
<label>Repetă parola<input asp-for="Confirmation" type="password" autocomplete="new-password" maxlength="200" required data-password-confirm /></label></div>
<label class="password-show"><input type="checkbox" role="switch" data-password-show /><span class="toggle-track" aria-hidden="true"></span><span>Arată parola</span></label>
<ul class="password-rules" data-password-rules aria-live="polite">
@foreach (var rule in BlazorStoc.Services.PasswordPolicy.Rules) { <li class="bad" data-rule="@rule.Key"><span class="rule-mark" aria-hidden="true">✕</span><span>@rule.Text</span></li> }
<li class="bad" data-rule="match"><span class="rule-mark" aria-hidden="true">✕</span><span>Parolele introduse coincid</span></li>
</ul>
<p class="muted small">Trebuie să fie diferită de parola primită de la administrator.</p>
@if (Model.Error is not null) { <p role="alert" class="error-text">@Model.Error</p> }
<button class="primary" type="submit" data-password-submit>Salvează parola și intră →</button></form>
<form method="post" asp-page-handler="Cancel"><button class="refresh act-nav" type="submit">Renunță</button></form>
<p class="muted small">BlazorStoc · versiunea @BlazorStoc.Services.AppVersion.Current</p></main><script src="/password-rules.js"></script></body></html>
