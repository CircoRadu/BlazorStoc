@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.WebUtilities
@using BlazorStoc.Services
@inject IProductRepository Products
@inject IOperationLockService OperationLock
@inject IExpiryNotificationService Notifications
@inject NavigationManager Navigation

<div class="app-shell">
    <aside class="sidebar">
        <a class="brand" href="/"><span class="brand-icon">B</span><span>Blazor<span class="brand-light">Stoc</span><small>ESP · GESTIUNE</small></span></a>
        @if (productSection)
        {
            <a class="nav-back" href="/"><span>←</span> Meniu principal</a>
            <p class="nav-label category-label">CATEGORII PRODUSE</p>
            <a class="nav-item @(selectedCategory.Length == 0 ? "active" : "")" href="/produse"><span>▦</span> Toate produsele <span class="nav-arrow">→</span></a>
            @foreach (var category in categories)
            {
                var isSelected = string.Equals(category, selectedCategory, StringComparison.OrdinalIgnoreCase);
                <CollapsibleSection Id="@ProductCategoryId(category)"
                                    RootClass="product-category-menu"
                                    HeaderRowClass="collapsible-header"
                                    ToggleClass="@($"nav-item category-item {(isSelected ? "active" : "")}")"
                                    ContentClass="category-submenu"
                                    Expanded="@isSelected"
                                    OpenHref="@ProductUrl(category)"
                                    CloseHref="/produse">
                    <Header><span>▪</span> @category</Header>
                    <ChildContent>
                        @foreach (var subcategory in Subcategories(category))
                        {
                            <a class="@(string.Equals(subcategory, selectedSubcategory, StringComparison.OrdinalIgnoreCase) ? "active" : "")" href="@ProductUrl(category, subcategory)">@subcategory</a>
                        }
                    </ChildContent>
                </CollapsibleSection>
            }
        }
        else
        {
            <p class="nav-label">SPAȚIU DE LUCRU</p>
            <NavLink class="nav-item" href="/" Match="NavLinkMatch.All"><span>⌂</span> Pagina principală <span class="nav-arrow">→</span></NavLink>
            <NavLink class="nav-item" href="/produse" Match="NavLinkMatch.Prefix"><span>▦</span> Produse și stocuri <span class="nav-arrow">→</span></NavLink>
            <CollapsibleSection Id="inventory-menu"
                                RootClass="administration-menu"
                                HeaderRowClass="collapsible-header"
                                ToggleClass="@($"nav-item administration-parent {(inventorySection ? "active" : "")}")"
                                ContentClass="administration-submenu"
                                Expanded="@inventoryExpanded">
                <Header><span>▥</span> Inventar</Header>
                <ChildContent>
                    <NavLink href="/inventar" Match="NavLinkMatch.All">Generare situație inventar</NavLink>
                    <NavLink href="/inventar/preluare" Match="NavLinkMatch.Prefix">Preluare inventar</NavLink>
                    <AuthorizeView Roles="Administrator"><Authorized><NavLink href="/inventar/restaurare" Match="NavLinkMatch.Prefix">Restaurează stoc</NavLink></Authorized></AuthorizeView>
                </ChildContent>
            </CollapsibleSection>
            <CollapsibleSection Id="administration-menu"
                                RootClass="administration-menu"
                                HeaderRowClass="collapsible-header"
                                ToggleClass="@($"nav-item administration-parent {(administrationSection ? "active" : "")}")"
                                ContentClass="administration-submenu"
                                Expanded="@administrationExpanded">
                <Header><span>⚙</span> Administrare</Header>
                <ChildContent>
                    <NavLink href="/categorii" Match="NavLinkMatch.Prefix">Categorii</NavLink>
                    <NavLink href="/beneficiari" Match="NavLinkMatch.Prefix">Beneficiari</NavLink>
                    <NavLink href="/vehicule" Match="NavLinkMatch.Prefix">Vehicule</NavLink>
                    <AuthorizeView Roles="Administrator"><Authorized><NavLink href="/utilizatori" Match="NavLinkMatch.Prefix">Utilizatori</NavLink></Authorized></AuthorizeView>
                </ChildContent>
            </CollapsibleSection>
            <NavLink class="@($"nav-item{(alertCount > 0 ? " nav-alert" : "")}")" href="/notificari" Match="NavLinkMatch.Prefix" data-notification-nav><span>✉</span> Notificări <span class="nav-triangle" data-notification-triangle role="img" aria-label="Notificări noi" hidden="@(alertCount <= 0)">⚠</span><span class="nav-arrow">→</span></NavLink>
            <AuthorizeView Roles="Administrator"><Authorized><NavLink class="nav-item" href="/jurnal" Match="NavLinkMatch.Prefix"><span>≡</span> Jurnal activitate <span class="nav-arrow">→</span></NavLink></Authorized></AuthorizeView>
            <AuthorizeView Roles="Administrator"><Authorized><NavLink class="nav-item" href="/setari" Match="NavLinkMatch.Prefix"><span>☰</span> Setări <span class="nav-arrow">→</span></NavLink></Authorized></AuthorizeView>
        }
        <div class="sidebar-bottom"><span class="status-dot"></span> Versiunea 0.3 <p>Gestiune produse</p><small>BlazorStoc · MariaDB</small></div>
    </aside>
    <div class="main-shell"><header class="topbar"><span>Inventar <span class="breadcrumb">/ BlazorStoc</span></span><div class="topbar-actions"><span class="mode-pill">Sesiune autentificată</span><AuthorizeView><Authorized Context="session"><span>@session.User.Identity?.Name · @(session.User.IsInRole("Administrator") ? "Administrator" : "Utilizator")</span></Authorized></AuthorizeView><button type="button" class="logout-action" data-logout-open aria-haspopup="dialog">Deconectare</button><span class="avatar">ES</span></div></header>
        @if (activeOperation is not null && !onRestorePage && !onWaitingPage)
        {
            <div class="error-banner" role="alert" id="maintenance-banner">
                Backup/restaurare in curs (@activeOperation.OperatorName) - datele pot fi temporar indisponibile. Reveniti mai tarziu.
            </div>
        }
        <main class="workspace">@Body</main></div>
</div>
<dialog id="logout-dialog" class="delete-dialog logout-dialog" aria-labelledby="logout-title" aria-describedby="logout-description">
    <form method="post" action="/Account/Logout">
        <AntiforgeryToken />
        <h2 id="logout-title">Închizi sesiunea?</h2>
        <p id="logout-description">Vei fi deconectat și redirecționat la pagina de autentificare. Pagina curentă nu se modifică dacă anulezi.</p>
        <div class="editor-actions">
            <button type="submit" class="danger">Deconectare</button>
            <button type="button" class="primary" data-logout-cancel autofocus>Anulează deconectarea</button>
        </div>
    </form>
</dialog>
<div id="blazor-error-ui" role="alert">Conexiunea cu aplicația a fost întreruptă. <a href="" class="reload">Reîncarcă pagina</a><a class="dismiss">×</a></div>

@code {
    private IReadOnlyList<BlazorStoc.Services.ProductGroup> groups = Array.Empty<BlazorStoc.Services.ProductGroup>();
    private List<string> categories = [];
    private bool productSection, administrationSection, administrationExpanded, inventorySection, inventoryExpanded, onRestorePage, onWaitingPage;
    private string selectedCategory = "", selectedSubcategory = "";
    private OperationLockInfo? activeOperation;
    private int alertCount;
    private readonly CancellationTokenSource lifetime = new();

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += LocationChanged;
        ReadLocation();
        if (productSection) await LoadGroupsAsync();
        // Subtask 3.4 (Task 3), "Notificarea sesiunilor Blazor active": MainLayout has no @rendermode of its own
        // (only individual pages like Home.razor/DatabaseRestore.razor do), so it renders once per navigation as
        // plain server-side HTML rather than as a live interactive circuit - a background polling loop started here
        // would be torn down with the request the moment this render finishes, never firing again. Checking the
        // shared operation lock (Services/OperationLock.cs) here instead, on every OnInitializedAsync, means every
        // page load/navigation picks up the current state, which is enough for "a session that is not the one
        // driving the operation learns a backup or restoration is under way" without pretending this layout can
        // push a live update to an already-open, otherwise-idle tab.
        try { activeOperation = await OperationLock.GetActiveAsync(lifetime.Token); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception) { activeOperation = null; }
        await LoadAlertCountAsync();
    }

    // Entering the application (and every navigation) checks whether a template fires; the number of warning
    // notifications drives the red triangle next to the "Notificări" entry.
    private async Task LoadAlertCountAsync()
    {
        try
        {
            await Notifications.EvaluateAsync(TimeSpan.FromMinutes(5), lifetime.Token);
            alertCount = await Notifications.AlertCountAsync(lifetime.Token);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception) { alertCount = 0; }
    }

    private void LocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args) => _ = RefreshNavigationAsync();

    private async Task RefreshNavigationAsync()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                ReadLocation();
                if (productSection) await LoadGroupsAsync();
                try { activeOperation = await OperationLock.GetActiveAsync(lifetime.Token); }
                catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { return; }
                catch (Exception) { activeOperation = null; }
                await LoadAlertCountAsync();
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }

    private void ReadLocation()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        productSection = uri.AbsolutePath.Equals("/produse", StringComparison.OrdinalIgnoreCase);
        administrationSection = uri.AbsolutePath.StartsWith("/categorii", StringComparison.OrdinalIgnoreCase) ||
            uri.AbsolutePath.StartsWith("/beneficiari", StringComparison.OrdinalIgnoreCase) ||
            uri.AbsolutePath.StartsWith("/vehicule", StringComparison.OrdinalIgnoreCase) ||
            uri.AbsolutePath.StartsWith("/utilizatori", StringComparison.OrdinalIgnoreCase);
        if (administrationSection) administrationExpanded = true;
        inventorySection = uri.AbsolutePath.StartsWith("/inventar", StringComparison.OrdinalIgnoreCase);
        if (inventorySection) inventoryExpanded = true;
        onRestorePage = uri.AbsolutePath.StartsWith("/inventar/restaurare", StringComparison.OrdinalIgnoreCase);
        onWaitingPage = uri.AbsolutePath.StartsWith(MaintenanceSupport.WaitingPath, StringComparison.OrdinalIgnoreCase);
        var query = QueryHelpers.ParseQuery(uri.Query);
        selectedCategory = productSection && query.TryGetValue("categorie", out var categoryValue) ? categoryValue.ToString() : "";
        selectedSubcategory = productSection && query.TryGetValue("subcategorie", out var subcategoryValue) ? subcategoryValue.ToString() : "";
    }

    private async Task LoadGroupsAsync()
    {
        groups = await Products.GetGroupsAsync(lifetime.Token);
        categories = groups.Select(g => g.Category).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.CurrentCultureIgnoreCase).ToList();
    }

    private IEnumerable<string> Subcategories(string category) => groups
        .Where(g => string.Equals(g.Category, category, StringComparison.OrdinalIgnoreCase))
        .Select(g => g.Subcategory)
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Order(StringComparer.CurrentCultureIgnoreCase);

    private static string ProductUrl(string category, string? subcategory = null)
    {
        var url = $"/produse?categorie={Uri.EscapeDataString(category)}";
        return string.IsNullOrWhiteSpace(subcategory) ? url : $"{url}&subcategorie={Uri.EscapeDataString(subcategory)}";
    }

    private static string ProductCategoryId(string category) => $"product-category-{Uri.EscapeDataString(BlazorStoc.Services.TextNormalization.UniquenessKey(category))}";

    public void Dispose()
    {
        Navigation.LocationChanged -= LocationChanged;
        lifetime.Cancel();
        lifetime.Dispose();
    }
}
