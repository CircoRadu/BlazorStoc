@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.WebUtilities
@using BlazorStoc.Services
@inject BlazorStoc.Modules.ModuleRegistry Modules
@inject IProductRepository Products
@inject ISubcategoryTree SubcategoryTree
@inject IOperationLockService OperationLock
@inject IExpiryNotificationService Notifications
@inject NavigationManager Navigation
@inject ILogger<MainLayout> Logger

<div class="app-shell" style="@($"--sidebar-extra:{SidebarExtra()}px")">
    <aside class="sidebar">
        <a class="brand" href="/"><span class="brand-icon">B</span><span>Blazor<span class="brand-light">Stoc</span><small>ESP · GESTIUNE</small></span></a>
        @if (productSection)
        {
            <a class="nav-back" href="/"><span>←</span> Meniu principal</a>
            <p class="nav-label category-label">CATEGORII PRODUSE</p>
            <a class="nav-item @(selectedCategory.Length == 0 ? "active" : "")" href="/produse"><span>▦</span> Toate produsele <span class="nav-arrow">→</span></a>
            @foreach (var category in categories)
            {
                var isSelected = string.Equals(category, selectedCategory, StringComparison.OrdinalIgnoreCase);
                <CollapsibleSection Id="@ProductCategoryId(category)"
                                    RootClass="product-category-menu"
                                    HeaderRowClass="collapsible-header"
                                    ToggleClass="@($"nav-item category-item {(isSelected ? "active" : "")}")"
                                    ContentClass="category-submenu"
                                    Expanded="@isSelected"
                                    OpenHref="@ProductUrl(category)"
                                    CloseHref="/produse">
                    <Header><span>▪</span> @category</Header>
                    <ChildContent>
                        @Nodes((category, (string?)null))
                    </ChildContent>
                </CollapsibleSection>
            }
        }
        else
        {
            <p class="nav-label">SPAȚIU DE LUCRU</p>
            <NavLink class="nav-item" href="/" Match="NavLinkMatch.All"><span>⌂</span> Pagina principală <span class="nav-arrow">→</span></NavLink>
            <AuthorizeView Policy="perm:stoc.view|preluare-factura.view|iesire-multipla.view|export-consum.view"><Authorized Context="menuSection"><CollapsibleSection Id="products-menu"
                                RootClass="administration-menu"
                                HeaderRowClass="collapsible-header"
                                ToggleClass="@($"nav-item administration-parent {(productsMenuSection ? "active" : "")}")"
                                ContentClass="administration-submenu"
                                Expanded="@productsExpanded">
                <Header><span>▦</span> Produse</Header>
                <ChildContent>
                    <AuthorizeView Policy="perm:stoc.view"><Authorized><a class="@(onStockPage ? "active" : "")" href="/produse">Stoc</a></Authorized></AuthorizeView>
                    @if (Modules.IsAvailable(BlazorStoc.Modules.Invoices.InvoicesModule.ModuleId)) {
                    <AuthorizeView Policy="perm:preluare-factura.view"><Authorized><NavLink href="/produse/preluare-factura" Match="NavLinkMatch.Prefix">Preluare factură</NavLink></Authorized></AuthorizeView>
                    }
                    <AuthorizeView Policy="perm:iesire-multipla.view"><Authorized><NavLink href="/iesiri/multipla" Match="NavLinkMatch.Prefix">Ieșire multiplă</NavLink></Authorized></AuthorizeView>
                    @if (Modules.IsAvailable(BlazorStoc.Modules.ProjectReports.ProjectReportsModule.ModuleId)) { <AuthorizeView Policy="perm:export-consum.view"><Authorized><NavLink href="/consum" Match="NavLinkMatch.Prefix">Export consum</NavLink></Authorized></AuthorizeView> }
                </ChildContent>
            </CollapsibleSection></Authorized></AuthorizeView>
            @if (Modules.IsAvailable(BlazorStoc.Modules.Inventory.InventoryModule.ModuleId))
            {
            <AuthorizeView Policy="perm:inventar.view|inventar-preluare.view"><Authorized Context="menuSection"><CollapsibleSection Id="inventory-menu"
                                RootClass="administration-menu"
                                HeaderRowClass="collapsible-header"
                                ToggleClass="@($"nav-item administration-parent {(inventorySection ? "active" : "")}")"
                                ContentClass="administration-submenu"
                                Expanded="@inventoryExpanded">
                <Header><span>▥</span> Inventar</Header>
                <ChildContent>
                    <AuthorizeView Policy="perm:inventar.view"><Authorized><NavLink href="/inventar" Match="NavLinkMatch.All">Generare situație inventar</NavLink></Authorized></AuthorizeView>
                    <AuthorizeView Policy="perm:inventar-preluare.view"><Authorized><NavLink href="/inventar/preluare" Match="NavLinkMatch.Prefix">Preluare inventar</NavLink></Authorized></AuthorizeView>
                </ChildContent>
            </CollapsibleSection></Authorized></AuthorizeView>
            }
            <AuthorizeView Policy="perm:categorii.view|beneficiari.view|furnizori.view|facturi.view|vehicule.view|nomenclator.view"><Authorized Context="menuSection"><CollapsibleSection Id="administration-menu"
                                RootClass="administration-menu"
                                HeaderRowClass="collapsible-header"
                                ToggleClass="@($"nav-item administration-parent {(administrationSection ? "active" : "")}")"
                                ContentClass="administration-submenu"
                                Expanded="@administrationExpanded">
                <Header><span>⚙</span> Administrare</Header>
                <ChildContent>
                    <AuthorizeView Policy="perm:categorii.view"><Authorized><NavLink href="/categorii" Match="NavLinkMatch.Prefix">Categorii</NavLink></Authorized></AuthorizeView>
                    <AuthorizeView Policy="perm:beneficiari.view"><Authorized><NavLink href="/beneficiari" Match="NavLinkMatch.Prefix">Beneficiari</NavLink></Authorized></AuthorizeView>
                    @if (Modules.IsAvailable(BlazorStoc.Modules.Suppliers.SuppliersModule.ModuleId))
                    {
                        <AuthorizeView Policy="perm:furnizori.view"><Authorized><NavLink href="/furnizori" Match="NavLinkMatch.Prefix">Furnizori</NavLink></Authorized></AuthorizeView>
                        <AuthorizeView Policy="perm:facturi.view"><Authorized><NavLink href="/facturi" Match="NavLinkMatch.Prefix">Facturi</NavLink></Authorized></AuthorizeView>
                    }
                    @if (Modules.IsAvailable(BlazorStoc.Modules.Vehicles.VehiclesModule.ModuleId)) { <AuthorizeView Policy="perm:vehicule.view"><Authorized><NavLink href="/vehicule" Match="NavLinkMatch.Prefix">Vehicule</NavLink></Authorized></AuthorizeView> }
                    <AuthorizeView Policy="perm:nomenclator.view"><Authorized><NavLink href="/nomenclator" Match="NavLinkMatch.Prefix">Nomenclator</NavLink></Authorized></AuthorizeView>
                </ChildContent>
            </CollapsibleSection></Authorized></AuthorizeView>
            @foreach (var module in Modules.NavItems())
            {
                <AuthorizeView Policy="@($"perm:{module.PermissionModule}.view")"><Authorized><NavLink class="nav-item" href="@module.Href" Match="NavLinkMatch.Prefix"><span>@module.Icon</span> @module.Label <span class="nav-arrow">→</span></NavLink></Authorized></AuthorizeView>
            }
            @if (Modules.IsAvailable(BlazorStoc.Modules.Notifications.NotificationsModule.ModuleId))
            {
            <AuthorizeView Policy="perm:notificari.view"><Authorized><NavLink class="@($"nav-item{(alertCount > 0 ? " nav-alert" : "")}")" href="/notificari" Match="NavLinkMatch.Prefix" data-notification-nav><span>✉</span> Notificări <span class="nav-triangle" data-notification-triangle role="img" aria-label="Notificări noi" hidden="@(alertCount <= 0)">⚠</span><span class="nav-arrow">→</span></NavLink></Authorized></AuthorizeView>
            }
            @if (Modules.IsAvailable(BlazorStoc.Modules.Journal.JournalModule.ModuleId)) { <AuthorizeView Policy="perm:jurnal.view"><Authorized><NavLink class="nav-item" href="/jurnal" Match="NavLinkMatch.Prefix"><span>≡</span> Jurnal activitate <span class="nav-arrow">→</span></NavLink></Authorized></AuthorizeView> }
            <AuthorizeView Policy="perm:setari-facturi.view|setari-anaf.view|setari-notificari.view|setari-harta.view|setari-backup.view|setari-module.view|setari-jurnal.view|setari-actualizare.view|setari-import-activityapp.view|utilizatori.view|tipuri-utilizatori.view"><Authorized><NavLink class="nav-item" href="/setari" Match="NavLinkMatch.Prefix"><span>☰</span> Setări <span class="nav-arrow">→</span></NavLink></Authorized></AuthorizeView><a class="nav-item" href="#ajutor" id="nav-help" data-help-index aria-haspopup="dialog"><span>?</span> Ajutor <span class="nav-arrow">→</span></a>
        }
        <div class="sidebar-bottom"><span class="status-dot"></span> Versiunea @BlazorStoc.Services.AppVersion.Current <p>Gestiune produse</p><small>BlazorStoc · MariaDB</small></div>
    </aside>
    <div class="main-shell"><header class="topbar">@RouteTrail()<div class="topbar-actions"><span class="mode-pill">Sesiune autentificată</span><AuthorizeView><Authorized Context="session"><span>@session.User.Identity?.Name · @(session.User.IsInRole("Administrator") ? "Administrator" : "Utilizator")</span></Authorized></AuthorizeView><button type="button" class="help-icon" data-help-open aria-haspopup="dialog" aria-label="Ajutor pentru această fereastră" title="Ajutor pentru această fereastră"></button><button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false" aria-label="Treci la tema întunecată" title="Treci la tema întunecată"></button><button type="button" class="logout-action" data-logout-open aria-haspopup="dialog">Deconectare</button><span class="avatar">ES</span></div></header>
        @if (activeOperation is not null && !onRestorePage && !onWaitingPage)
        {
            <div class="error-banner" role="alert" id="maintenance-banner">
                Backup/restaurare in curs (@activeOperation.OperatorName) - datele pot fi temporar indisponibile. Reveniti mai tarziu.
            </div>
        }
        <main class="workspace"><UpdateBanner @rendermode="@(new InteractiveServerRenderMode(prerender: false))" /><ModuleAlertBanner @rendermode="@(new InteractiveServerRenderMode(prerender: false))" /><SessionTracker @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />@Body</main></div>
</div>
<dialog id="logout-dialog" class="delete-dialog logout-dialog" aria-labelledby="logout-title" aria-describedby="logout-description">
    <form method="post" action="/Account/Logout">
        <AntiforgeryToken />
        <h2 id="logout-title">Închizi sesiunea?</h2>
        <p id="logout-description">Vei fi deconectat și redirecționat la pagina de autentificare. Pagina curentă nu se modifică dacă anulezi.</p>
        <div class="editor-actions">
            <button type="submit" class="danger">Deconectare</button>
            <button type="button" class="primary" data-logout-cancel autofocus>Anulează deconectarea</button>
        </div>
    </form>
</dialog>
<div id="blazor-error-ui" role="alert">Conexiunea cu aplicația a fost întreruptă. Dacă aplicația se repornește singură, durează câteva secunde. <a href="" class="reload">Reîncarcă pagina</a><a class="dismiss" title="Închide" aria-label="Închide">×</a></div>

@code {
    private IReadOnlyList<BlazorStoc.Services.ProductGroup> groups = Array.Empty<BlazorStoc.Services.ProductGroup>();
    private List<string> categories = [];
    private bool productSection, administrationSection, administrationExpanded, inventorySection, inventoryExpanded, productsMenuSection, productsExpanded, onStockPage, onInvoicePickupPage, onRestorePage, onWaitingPage;
    private string selectedCategory = "", selectedSubcategory = "";
    private int? productPageId;
    private Product? openedProduct;
    private Uri routeUri = new("http://localhost/");
    private OperationLockInfo? activeOperation;
    private int alertCount;
    private readonly CancellationTokenSource lifetime = new();

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += LocationChanged;
        ReadLocation();
        await LoadOpenedProductAsync();
        if (productSection) await LoadGroupsAsync();
        // Subtask 3.4 (Task 3), "Notificarea sesiunilor Blazor active": MainLayout has no @rendermode of its own
        // (only individual pages like Home.razor/DatabaseRestore.razor do), so it renders once per navigation as
        // plain server-side HTML rather than as a live interactive circuit - a background polling loop started here
        // would be torn down with the request the moment this render finishes, never firing again. Checking the
        // shared operation lock (Services/OperationLock.cs) here instead, on every OnInitializedAsync, means every
        // page load/navigation picks up the current state, which is enough for "a session that is not the one
        // driving the operation learns a backup or restoration is under way" without pretending this layout can
        // push a live update to an already-open, otherwise-idle tab.
        try { activeOperation = await OperationLock.GetActiveAsync(lifetime.Token); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception) { activeOperation = null; }
        await LoadAlertCountAsync();
    }

    // Entering the application (and every navigation) checks whether a template fires; the number of warning
    // notifications drives the red triangle next to the "Notificări" entry.
    private async Task LoadAlertCountAsync()
    {
        try
        {
            await Notifications.EvaluateAsync(TimeSpan.FromMinutes(5), lifetime.Token);
            alertCount = await Notifications.AlertCountAsync(lifetime.Token);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception) { alertCount = 0; }
    }

    private void LocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        RefreshNavigationAsync().FireAndForget(Logger, "layout navigation refresh");
    }

    private async Task RefreshNavigationAsync()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                ReadLocation();
                await LoadOpenedProductAsync();
                if (productSection) await LoadGroupsAsync();
                try { activeOperation = await OperationLock.GetActiveAsync(lifetime.Token); }
                catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { return; }
                catch (Exception) { activeOperation = null; }
                await LoadAlertCountAsync();
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }

    // On a product page the category menu stays open at the subcategory of the product, and the route names it.
    private async Task LoadOpenedProductAsync()
    {
        openedProduct = null;
        if (productPageId is not { } id) return;
        try { openedProduct = await Products.GetProductAsync(id, lifetime.Token); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception) { openedProduct = null; }
        if (openedProduct is not null) (selectedCategory, selectedSubcategory) = (openedProduct.Category, openedProduct.Subcategory);
    }

    // Main page / section / subsection / page: every step but the last one is a link back.
    private RenderFragment RouteTrail() => builder =>
    {
        var steps = Breadcrumbs.For(routeUri.AbsolutePath, selectedCategory, selectedSubcategory, openedProduct);
        var seq = 0;
        builder.OpenElement(seq++, "nav"); builder.AddAttribute(seq++, "class", "route-trail"); builder.AddAttribute(seq++, "aria-label", "Ruta paginii");
        builder.OpenElement(seq++, "ol");
        void Step(string label, string? href, bool last)
        {
            builder.OpenElement(seq++, "li");
            if (last) { builder.AddAttribute(seq++, "aria-current", "page"); builder.AddContent(seq++, label); }
            else if (href is not null) { builder.OpenElement(seq++, "a"); builder.AddAttribute(seq++, "href", href); builder.AddContent(seq++, label); builder.CloseElement(); }
            else builder.AddContent(seq++, label);
            builder.CloseElement();
        }
        Step("Meniu principal", "/", steps.Count == 0);
        for (var index = 0; index < steps.Count; index++) Step(steps[index].Label, steps[index].Href, index == steps.Count - 1);
        builder.CloseElement(); builder.CloseElement();
    };

    private void ReadLocation()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        productPageId = Breadcrumbs.ProductId(uri.AbsolutePath);
        productSection = uri.AbsolutePath.Equals("/produse", StringComparison.OrdinalIgnoreCase) || productPageId is not null;
        administrationSection = uri.AbsolutePath.StartsWith("/categorii", StringComparison.OrdinalIgnoreCase) ||
            uri.AbsolutePath.StartsWith("/beneficiari", StringComparison.OrdinalIgnoreCase) ||
            uri.AbsolutePath.StartsWith("/furnizori", StringComparison.OrdinalIgnoreCase) ||
            uri.AbsolutePath.StartsWith("/facturi", StringComparison.OrdinalIgnoreCase) ||
            uri.AbsolutePath.StartsWith("/vehicule", StringComparison.OrdinalIgnoreCase) ||
            uri.AbsolutePath.StartsWith("/nomenclator", StringComparison.OrdinalIgnoreCase) ||
            uri.AbsolutePath.StartsWith("/proiecte", StringComparison.OrdinalIgnoreCase) ||
            uri.AbsolutePath.StartsWith("/observatii", StringComparison.OrdinalIgnoreCase);
        if (administrationSection) administrationExpanded = true;
        productsMenuSection = uri.AbsolutePath.StartsWith("/produse", StringComparison.OrdinalIgnoreCase) || uri.AbsolutePath.StartsWith("/consum", StringComparison.OrdinalIgnoreCase) ||
            uri.AbsolutePath.StartsWith("/iesiri", StringComparison.OrdinalIgnoreCase) || uri.AbsolutePath.StartsWith("/miscari", StringComparison.OrdinalIgnoreCase);
        onStockPage = uri.AbsolutePath.StartsWith("/produse", StringComparison.OrdinalIgnoreCase) && !uri.AbsolutePath.StartsWith("/produse/preluare-factura", StringComparison.OrdinalIgnoreCase) ||
            uri.AbsolutePath.StartsWith("/miscari", StringComparison.OrdinalIgnoreCase);
        if (productsMenuSection) productsExpanded = true;
        onInvoicePickupPage = uri.AbsolutePath.StartsWith("/produse/preluare-factura", StringComparison.OrdinalIgnoreCase);
        inventorySection = uri.AbsolutePath.StartsWith("/inventar", StringComparison.OrdinalIgnoreCase);
        if (inventorySection) inventoryExpanded = true;
        onRestorePage = uri.AbsolutePath.StartsWith("/setari", StringComparison.OrdinalIgnoreCase);
        onWaitingPage = uri.AbsolutePath.StartsWith(MaintenanceSupport.WaitingPath, StringComparison.OrdinalIgnoreCase);
        var query = QueryHelpers.ParseQuery(uri.Query);
        selectedCategory = uri.AbsolutePath.Equals("/produse", StringComparison.OrdinalIgnoreCase) && query.TryGetValue("categorie", out var categoryValue) ? categoryValue.ToString() : "";
        selectedSubcategory = uri.AbsolutePath.Equals("/produse", StringComparison.OrdinalIgnoreCase) && query.TryGetValue("subcategorie", out var subcategoryValue) ? subcategoryValue.ToString() : "";
        routeUri = uri;
    }

    // ---- the menu of the stock section is a tree (subcategories under subcategories); it widens to show what is open ----
    private IReadOnlyList<SubcategoryNode> tree = [];
    private readonly HashSet<string> openNodes = new(StringComparer.Ordinal);

    private IEnumerable<SubcategoryNode> Children(string category, string? parent) =>
        tree.Where(node => string.Equals(node.Category, category, StringComparison.OrdinalIgnoreCase) && node.Parent == parent);
    private static string NodeKey(SubcategoryNode node) => node.Category + "\u001f" + node.Name;
    private static string NodeId(SubcategoryNode node) => $"product-node-{Uri.EscapeDataString(BlazorStoc.Services.TextNormalization.UniquenessKey(node.Category + "/" + node.Name))}";

    // The selected subcategory and its ancestors: the branch that stays open.
    private HashSet<string> SelectedBranch()
    {
        var names = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var node = tree.FirstOrDefault(item => string.Equals(item.Category, selectedCategory, StringComparison.OrdinalIgnoreCase) && string.Equals(item.Name, selectedSubcategory, StringComparison.OrdinalIgnoreCase));
        while (node is not null)
        {
            names.Add(node.Name);
            var parent = node.Parent;
            node = parent is null ? null : tree.FirstOrDefault(item => string.Equals(item.Category, node.Category, StringComparison.OrdinalIgnoreCase) && item.Name == parent);
        }
        return names;
    }
    private bool IsNodeOpen(SubcategoryNode node) => openNodes.Contains(NodeKey(node)) || SelectedBranch().Contains(node.Name);
    private void SetNodeOpen(SubcategoryNode node, bool open)
    {
        if (open) openNodes.Add(NodeKey(node)); else { openNodes.Remove(NodeKey(node)); }
    }

    private RenderFragment<(string Category, string? Parent)> Nodes => scope => @<text>
        @foreach (var node in Children(scope.Category, scope.Parent))
        {
            var current = node;
            if (current.IsLeaf)
            {
                <a class="@(string.Equals(current.Name, selectedSubcategory, StringComparison.OrdinalIgnoreCase) ? "active" : "")" href="@ProductUrl(current.Category, current.Name)">@current.Name</a>
            }
            else
            {
                <CollapsibleSection Id="@NodeId(current)"
                                    RootClass="menu-tree-node"
                                    HeaderRowClass="collapsible-header"
                                    ToggleClass="@($"menu-tree-toggle {(string.Equals(current.Name, selectedSubcategory, StringComparison.OrdinalIgnoreCase) ? "active" : "")}")"
                                    ContentClass="menu-tree-children"
                                    Expanded="@IsNodeOpen(current)"
                                    ExpandedChanged="@(open => SetNodeOpen(current, open))">
                    <Header><a class="menu-tree-link" href="@ProductUrl(current.Category, current.Name)" title="Produsele de sub @current.Name">@current.Name</a></Header>
                    <ChildContent>@Nodes((current.Category, current.Name))</ChildContent>
                </CollapsibleSection>
            }
        }
    </text>;

    // The sidebar grows with the open branches: the widest visible line decides (an estimate of the text plus the indent of its level).
    private int SidebarExtra()
    {
        if (!productSection) return 0;
        var widest = 0;
        void Visit(string category, string? parent, int depth)
        {
            foreach (var node in Children(category, parent))
            {
                widest = Math.Max(widest, depth * 19 + (int)(node.Name.Length * 7.4) + (node.IsLeaf ? 20 : 46));
                if (!node.IsLeaf && IsNodeOpen(node)) Visit(category, node.Name, depth + 1);
            }
        }
        foreach (var category in categories.Where(item => string.Equals(item, selectedCategory, StringComparison.OrdinalIgnoreCase))) Visit(category, null, 0);
        return Math.Clamp(widest + 48 - 200, 0, 300);
    }

    private async Task LoadGroupsAsync()
    {
        groups = await Products.GetGroupsAsync(lifetime.Token);
        try { tree = await SubcategoryTree.GetTreeAsync(lifetime.Token); } catch (Exception exception) when (exception is not OperationCanceledException) { Logger.LogWarning("Subcategory tree loading failed ({ErrorType}).", exception.GetType().Name); }
        categories = groups.Select(g => g.Category).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();   // the order arranged on the catalog page (the repository returns it)
    }

    private IEnumerable<string> Subcategories(string category) => groups
        .Where(g => string.Equals(g.Category, category, StringComparison.OrdinalIgnoreCase))
        .Select(g => g.Subcategory)
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .Distinct(StringComparer.OrdinalIgnoreCase);

    private static string ProductUrl(string category, string? subcategory = null)
    {
        var url = $"/produse?categorie={Uri.EscapeDataString(category)}";
        return string.IsNullOrWhiteSpace(subcategory) ? url : $"{url}&subcategorie={Uri.EscapeDataString(subcategory)}";
    }

    private static string ProductCategoryId(string category) => $"product-category-{Uri.EscapeDataString(BlazorStoc.Services.TextNormalization.UniquenessKey(category))}";

    public void Dispose()
    {
        Navigation.LocationChanged -= LocationChanged;
        lifetime.Cancel();
        lifetime.Dispose();
    }
}
