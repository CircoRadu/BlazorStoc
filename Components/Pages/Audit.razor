@page "/jurnal"
@attribute [Authorize(Roles = AccessRoles.Administrator)]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using BlazorStoc.Services
@inject IAuditTrail AuditTrail
@inject ILogger<Audit> Logger
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable
<PageBoundary>

<PageTitle>Jurnal activitate · BlazorStoc</PageTitle>
<div class="page-heading"><div><p class="eyebrow">TRASABILITATE</p><h1>Jurnal activitate</h1><p class="muted">Acțiunile operate în sistem, în ordine cronologică.</p></div>
    <div class="heading-actions"><a class="refresh" href="@AuditCompleteState.Path">Jurnal complet (toate evenimentele) →</a></div></div>
@if (error is not null) { <div class="error-banner" role="alert">@error</div> }
<section class="metrics audit-metrics" aria-label="Rezumat activitate">
    <article><span>Evenimente</span><strong>@(summary is null ? "—" : summary.Total.ToString("N0"))</strong><small>În tot jurnalul</small><i>≡</i></article>
    <article><span>Astăzi</span><strong>@(summary is null ? "—" : summary.Today.ToString("N0"))</strong><small>Operații UTC</small><i>◷</i></article>
    <article><span>Operatori</span><strong>@(summary is null ? "—" : summary.Actors.ToString("N0"))</strong><small>Utilizatori distincți</small><i>♙</i></article>
    <article><span>Produse</span><strong>@(summary is null ? "—" : summary.Products.ToString("N0"))</strong><small>Editări produse</small><i>▦</i></article>
</section>
<section class="catalog">
    <div class="catalog-heading"><h2>Istoric operații <span>@(result?.Total ?? 0)</span></h2><small>Ultimele @AuditQueryRules.RecentWindow de evenimente · sincronizare automată la 15 secunde · afișare în ora locală · stocare UTC</small></div>
    @if (result is not null && result.JournalTotal > AuditQueryRules.RecentWindow)
    {
        <p class="form-note audit-window-note" role="status">Această pagină lucrează pe cele mai recente @AuditQueryRules.RecentWindow de evenimente din @result.JournalTotal.ToString("N0"). Pentru evenimente mai vechi folosește <a href="@CompleteUrl">Jurnal complet</a>@(values.Any || dateKey is not null ? " (filtrele alese se păstrează)" : "").</p>
    }
    <AuditFilterBar Values="values" Changed="FiltersChangedAsync" DateChip="@selectedDateLabel" DateRemoved="RemoveDateAsync" Cleared="ClearAsync" />
    @if (loading && result is null) { <div class="empty-state" role="status"><div class="spinner"></div><h3>Se încarcă jurnalul</h3></div> }
    else if (result is not null && result.Total == 0) { <div class="empty-state"><span class="empty-icon">≡</span><h3>Nu există evenimente pentru filtrul selectat</h3><p>Jurnalul se completează automat după adăugări, editări și ștergeri.</p></div> }
    else if (result is not null)
    {
        <AuditEventsTable Events="result.Events" Removals="removals" DateChosen="FilterByDateAsync" ActorChosen="FilterByActorAsync" ActionChosen="FilterByActionAsync" />
        <AuditPager PageSize="pageSize" Page="currentPage" Total="result.Total" PageChanged="GoToPageAsync" PageSizeChanged="PageSizeChangedAsync" />
    }
</section>

</PageBoundary>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? QueryText { get; set; }
    [SupplyParameterFromQuery(Name = "tip")] public string? EntityParameter { get; set; }
    [SupplyParameterFromQuery(Name = "operatie")] public string? ActionParameter { get; set; }
    [SupplyParameterFromQuery(Name = "operator")] public string? ActorParameter { get; set; }
    [SupplyParameterFromQuery(Name = "data")] public string? DateParameter { get; set; }
    [SupplyParameterFromQuery(Name = "pe-pagina")] public int? PageSizeParameter { get; set; }
    [SupplyParameterFromQuery(Name = "pagina")] public int? PageParameter { get; set; }

    private readonly AuditFilterValues values = new();
    private AuditPage? result;
    private AuditSummary? summary;
    private IReadOnlyDictionary<string, DateTime> removals = new Dictionary<string, DateTime>();
    private string? syncedUrl, selectedDateLabel, dateKey, error;
    private bool loading;
    private int pageSize = AuditListState.DefaultPageSize, currentPage = 1, loadVersion;
    private IJSObjectReference? timeModule;
    private CancellationTokenSource? loadCts, debounce;
    private readonly CancellationTokenSource lifetime = new();

    // The complete journal opens with the same filters (the date of a single day becomes a one-day range).
    private string CompleteUrl => new AuditCompleteState(values.Query.Trim(), values.Entity, values.Action, values.Actor, dateKey, dateKey, dateKey is null && !values.Any, AuditQueryRules.DefaultCompletePageSize, 1).Url();

    private Task FiltersChangedAsync(bool typing) { currentPage = 1; SyncState(); return ReloadAsync(typing ? 350 : 0); }
    private Task FilterByActorAsync(string value) { values.Actor = value; return FiltersChangedAsync(false); }
    private Task FilterByActionAsync(string value) { values.Action = value; return FiltersChangedAsync(false); }
    private Task FilterByDateAsync(string key) { dateKey = AuditListState.ValidDateKey(key); selectedDateLabel = dateKey is null ? null : AuditListState.DateLabel(dateKey); return FiltersChangedAsync(false); }
    private Task RemoveDateAsync() { dateKey = selectedDateLabel = null; return FiltersChangedAsync(false); }
    private Task ClearAsync() { dateKey = selectedDateLabel = null; return FiltersChangedAsync(false); }
    private Task GoToPageAsync(int page) { currentPage = Math.Max(1, page); SyncState(); return ReloadAsync(0); }
    private Task PageSizeChangedAsync(int size) { pageSize = size; currentPage = 1; SyncState(); return ReloadAsync(0); }

    // Filters and page live in the address (replaced in place, so Back from an object page restores them). They are
    // read from the address only when the page is opened, so that a delayed location update cannot overwrite typed text.
    private void ApplyStateFromAddress()
    {
        var state = AuditListState.From(QueryText, EntityParameter, ActionParameter, ActorParameter, DateParameter, PageSizeParameter, PageParameter);
        (values.Query, values.Entity, values.Action, values.Actor, dateKey, pageSize, currentPage) =
            (state.Query, state.Entity, state.Action, state.Actor, state.DateKey, state.PageSize, state.Page);
        selectedDateLabel = state.DateKey is null ? null : AuditListState.DateLabel(state.DateKey);
        syncedUrl = state.Url();
    }

    private void SyncState()
    {
        var url = new AuditListState(values.Query.Trim(), values.Entity, values.Action, values.Actor, dateKey, pageSize, currentPage).Url();
        if (url == syncedUrl) return;
        syncedUrl = url;
        Navigation.NavigateTo(url, replace: true);
    }

    protected override async Task OnInitializedAsync()
    {
        ApplyStateFromAddress();
        await LoadAsync(true);
        SynchronizePeriodicallyAsync().FireAndForget(Logger, "periodic synchronization");
    }

    // Typing waits a moment (a new keystroke cancels the wait), so the server is asked once per pause, not once per letter.
    private async Task ReloadAsync(int delayMilliseconds)
    {
        debounce?.Cancel();
        var source = debounce = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token);
        try
        {
            if (delayMilliseconds > 0) await Task.Delay(delayMilliseconds, source.Token);
            await LoadAsync(false);
        }
        catch (OperationCanceledException) { }
    }

    private async Task<AuditUtcRange> RangeAsync()
    {
        if (dateKey is null) return new(null, null);
        timeModule ??= await JS.InvokeAsync<IJSObjectReference>("import", lifetime.Token, "./audit-time.js");
        return await timeModule.InvokeAsync<AuditUtcRange>("localRangeUtc", lifetime.Token, dateKey, dateKey);
    }

    // Every load asks the server for one page of the latest events; a load that is overtaken by a newer one is dropped.
    private async Task LoadAsync(bool showLoading)
    {
        loadCts?.Cancel();
        var source = loadCts = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token);
        var version = ++loadVersion;
        if (showLoading) loading = true;
        try
        {
            var range = await RangeAsync();
            var query = new AuditQuery(values.Query, values.Entity, values.Action, values.Actor, range.From, range.To);
            var page = await AuditTrail.QueryAsync(query, currentPage, pageSize, AuditQueryRules.RecentWindow, source.Token);
            var removed = await AuditTrail.RemovalTimesAsync(page.Events, source.Token);
            var totals = await AuditTrail.SummaryAsync(DateTime.UtcNow.Date, source.Token);
            if (version != loadVersion) return;
            result = page; removals = removed; summary = totals;
            if (page.Page != currentPage) { currentPage = page.Page; SyncState(); }
            error = null;
        }
        catch (OperationCanceledException) { }
        catch (Exception exception) when (version == loadVersion)
        {
            Logger.LogError("Audit loading failed ({ErrorType}).", exception.GetType().Name);
            error = "Jurnalul nu a putut fi încărcat.";
        }
        finally { if (version == loadVersion) loading = false; }
    }

    private async Task SynchronizePeriodicallyAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(lifetime.Token))
                await InvokeAsync(async () => { if (!loading) await LoadAsync(false); StateHasChanged(); });
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }

    public async ValueTask DisposeAsync()
    {
        lifetime.Cancel();
        if (timeModule is not null)
            try { await timeModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        lifetime.Dispose();
    }
}
