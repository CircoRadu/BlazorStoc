@using BlazorStoc.Services
@inject IUserRepository Repository
@inject ILogger<UserEditor> Logger
@implements IDisposable

<UnsavedChangesTracker @ref="tracker" Adding="@(Original is null)" Snapshot="CurrentSnapshot" Discard="DiscardAsync" />
<section class="product-editor" aria-labelledby="user-editor-title">
    <div class="catalog-heading"><h2 id="user-editor-title">@(Original is null ? "Adaugă utilizator" : $"Editează utilizatorul #{Original.Id}")</h2><button type="button" class="danger" disabled="@saving" @onclick="CloseAsync">Închide</button></div>
    @if (error is not null) { <div class="error-banner" role="alert">@error</div> }
    <EditForm Model="input" OnValidSubmit="SaveAsync" FormName="user-editor">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <fieldset disabled="@saving">
            <div class="editor-grid">
                <label for="user-username">Nume utilizator *<InputText id="user-username" @bind-Value="input.Username" maxlength="100" autocomplete="off" /><ValidationMessage For="() => input.Username" /></label>
                <label for="user-display-name">Nume afișat *<InputText id="user-display-name" @bind-Value="input.DisplayName" maxlength="150" autocomplete="off" /><ValidationMessage For="() => input.DisplayName" /></label>
                <label class="password-field" for="user-password">@(Original is null ? "Parolă *" : "Parolă nouă")<InputTextLive id="user-password" type="@PasswordType" @bind-Value="input.Password" maxlength="200" autocomplete="new-password" /><small>@(Original is null ? $"Minimum {WebUserInput.MinimumPasswordLength} caractere." : "Lasă necompletat pentru a păstra parola actuală.")</small><ValidationMessage For="() => input.Password" /></label>
                <label class="password-field" for="user-password-confirmation">@(Original is null ? "Confirmă parola *" : "Confirmă parola nouă")<InputTextLive id="user-password-confirmation" type="@PasswordType" @bind-Value="input.PasswordConfirmation" maxlength="200" autocomplete="new-password" /><small>Repetă parola pentru verificare.</small>
                    <span class="password-match @(ConfirmationMatches ? "ok" : "bad")" role="status" aria-live="polite">@ConfirmationText</span></label>
                <label class="toggle-switch full-width" for="user-password-show"><input id="user-password-show" type="checkbox" role="switch" @bind="showPassword" /><span class="toggle-track" aria-hidden="true"></span><span>Arată parola</span></label>
                <label for="user-role">Nivel de acces *<InputSelect id="user-role" @bind-Value="input.Role"><option value="@AccessRoles.LimitedUser">Utilizator — gestiune produse</option><option value="@AccessRoles.Administrator">Administrator — acces complet</option></InputSelect></label>
                @if (Original is not null)
                {
                    <label class="check-label full-width" for="user-active"><InputCheckbox id="user-active" @bind-Value="input.IsActive" /> Cont activ</label>
                    <ChangeReasonField Id="user-change-reason" @bind-Value="input.Reason" Error="@reasonError" Disabled="saving" />
                }
            </div>
            <div class="editor-actions"><button class="primary" type="submit">@(saving ? "Se salvează…" : "Salvează utilizatorul")</button><button class="danger" type="button" @onclick="CloseAsync">Anulează</button></div>
        </fieldset>
    </EditForm>
</section>
@if (pendingChanges is not null && Original is not null)
{
    <SaveConfirmationDialog Title="Salvezi modificările utilizatorului?" ObjectLabel="@Original.Username" Changes="pendingChanges"
                            Reason="@input.Reason" Confirmed="ConfirmSaveAsync" Cancelled="CancelConfirmation" />
}

@code {
    [Parameter] public WebUser? Original { get; set; }
    [Parameter] public EventCallback<WebUser> Saved { get; set; }
    [Parameter] public EventCallback Closed { get; set; }
    private UnsavedChangesTracker? tracker;
    private string CurrentSnapshot() => FormSnapshot.Of(input);
    // "Părăsește editarea": the leave warning closes the form without saving (Task 1).
    private Task DiscardAsync() => Closed.InvokeAsync();
    private WebUserInput input = new();
    private bool saving;
    private IReadOnlyList<AuditChange>? pendingChanges;
    private string? error, reasonError, confirmationError;
    private bool showPassword;

    private string PasswordType => showPassword ? "text" : "password";
    private bool ConfirmationMatches => input.PasswordConfirmation.Length > 0 && string.Equals(input.Password, input.PasswordConfirmation, StringComparison.Ordinal);

    // Checked while typing in either field (both update on every keystroke); the message after a refused save stays until they match.
    private string ConfirmationText => input.PasswordConfirmation.Length == 0 ? (confirmationError ?? "")
        : ConfirmationMatches ? "Parolele coincid." : "Parolele nu coincid.";
    private readonly CancellationTokenSource lifetime = new();

    protected override Task OnInitializedAsync()
    {
        input = Original is null ? new WebUserInput() : WebUserInput.From(Original);
        return Task.CompletedTask;
    }

    private Task CloseAsync() => saving ? Task.CompletedTask : tracker is null ? Closed.InvokeAsync() : tracker.RunAfterConfirmAsync(() => Closed.InvokeAsync());

    private async Task SaveAsync()
    {
        if (saving) return;
        reasonError = Original is null ? null : ChangeReasonRules.ValidationError(input.Reason);
        confirmationError = input.PasswordConfirmationError();
        if (reasonError is not null || confirmationError is not null) return;
        if (Original is not null)
        {
            // Saving over existing data needs an explicit confirmation of the changed fields (never the password itself).
            error = null;
            try
            {
                var value = input.Validated(false);
                pendingChanges = SaveSummary.Changed(
                    new("Nume utilizator", Original.Username, value.Username), new("Nume afișat", Original.DisplayName, value.DisplayName),
                    new("Nivel de acces", Original.Role, value.Role),
                    new("Cont activ", Original.IsActive ? "Da" : "Nu", value.IsActive ? "Da" : "Nu"),
                    new("Parolă", "neschimbată", value.Password.Length > 0 ? "va fi schimbată" : "neschimbată"));
            }
            catch (UserOperationException exception) { error = exception.Message; }
            return;
        }
        await PersistAsync();
    }

    private Task ConfirmSaveAsync() { pendingChanges = null; return PersistAsync(); }
    private Task CancelConfirmation() { pendingChanges = null; return Task.CompletedTask; }

    private async Task PersistAsync()
    {
        if (saving) return;
        saving = true; error = null;
        WebUser? saved = null;
        try
        {
            saved = Original is null
                ? await Repository.CreateAsync(input, lifetime.Token)
                : await Repository.UpdateAsync(Original, input, lifetime.Token);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (UserOperationException exception) { error = exception.Message; }
        catch (AccessDeniedException exception) { error = exception.Message; }
        catch (Exception exception)
        {
            Logger.LogError("User saving failed ({ErrorType}).", exception.GetType().Name);
            error = "Utilizatorul nu a putut fi salvat. Datele formularului sunt păstrate; actualizează lista înainte să reîncerci.";
        }
        finally { saving = false; }
        if (saved is not null) { tracker?.Rebase(); await Saved.InvokeAsync(saved); }
    }

    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
}
