@using BlazorStoc.Services
@inject IProductRepository Repository
@inject ISubcategoryTree Tree
@inject IStockMovementRepository Movements
@inject IProductParameterRepository ParameterRepository
@inject IProductTagRepository TagRepository
@inject IProductImageStore ImageStore
@inject ILogger<ProductEditor> Logger
@inject IJSRuntime JS
@implements IAsyncDisposable

<UnsavedChangesTracker @ref="tracker" Adding="@(Original is null)" Snapshot="CurrentSnapshot" Discard="DiscardAsync" />
<section class="product-editor" aria-labelledby="editor-title">
    <div class="catalog-heading"><h2 id="editor-title">@(Original is null ? (Staging ? "Pregătește produs nou" : "Adaugă produs") : $"Editează produsul {Original.Name}")</h2><span class="heading-actions"><HelpButton Topic="produse-editor" About="Formularul de produs" /><button type="button" class="danger" disabled="@saving" @onclick="Close">Închide</button></span></div>
    @if (error is not null) { <div class="error-banner" role="alert">@error</div> }
    <EditForm Model="input" OnValidSubmit="SaveAsync" FormName="product-editor">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <fieldset disabled="@saving">
            <div class="editor-grid">
                <label class="full-width" for="product-code">@(HasParameters ? "Model" : ProductCode.Label) *<input id="product-code" value="@CodeText" @oninput="args => CodeText = args.Value?.ToString() ?? string.Empty" maxlength="100" autocomplete="off" aria-describedby="product-code-note" />@if (HasParameters) { <small id="product-code-note" class="form-note">Introdu modelul stabilit de producător, fără variantă (aceasta se alege mai jos). Codul produsului se compune din model și valorile alese.</small> } else { <small id="product-code-note" class="form-note">Introdu codul stabilit de producător. Codul trebuie să fie unic în catalog.</small> }<ValidationMessage For="() => input.Name" /></label>
                @if (InvoiceAmbiguity.Found(CodeText) is { Length: > 0 } codeDoubt) { <p class="uncertain-note full-width" id="product-code-doubt" role="status"><span class="uncertain-badge">⚠ caractere nesigure: @codeDoubt</span> Codul conține caractere care se confundă ușor cu litere sau cifre (o liniuță verticală în loc de I, l sau 1 etc.). Verifică-l: căutarea imaginii folosește exact acest cod.</p> }
                <label for="product-category">Categorie *<InputSelect id="product-category" @bind-Value="input.Category" @bind-Value:after="CategoryChangedAsync">@foreach (var category in Categories) { <option value="@category">@category</option> }</InputSelect><ValidationMessage For="() => input.Category" /></label>
                <label for="product-subcategory">Subcategorie *<InputSelect id="product-subcategory" @bind-Value="input.Subcategory" @bind-Value:after="GroupChanged">@foreach (var subcategory in Subcategories) { <option value="@subcategory">@subcategory</option> }</InputSelect><ValidationMessage For="() => input.Subcategory" /></label>
                <p class="form-note full-width">Poți selecta numai categorii și subcategorii existente. Pentru o structură nouă, folosește pagina <a href="/categorii">Categorii și subcategorii</a>@if (Original is null) { <text> sau <button type="button" class="refresh act-confirm" @onclick="OpenCategories">Adaugă categorie / subcategorie</button> (se deschide într-o fereastră separată)</text> }.</p>
                @if (!HasSelectableGroup) { <p class="validation-message full-width" role="alert">Nu există nicio combinație categorie–subcategorie disponibilă. Creează mai întâi o subcategorie în pagina dedicată.</p> }
                @if (HasParameters)
                {
                    @foreach (var slot in CurrentSlots)
                    {
                        @if (slot.Family is null)
                        {
                            @FieldFor(slot.Members[0])
                        }
                        else
                        {
                            var active = ActiveMember(slot);
                            <fieldset class="parameter-family full-width" @key="@($"family:{slot.Family.Id}")">
                                <legend>@slot.Family.Name *</legend>
                                <label for="@($"product-family-{slot.Family.Id}")">Tipul (unul singur poate fi activ)
                                    <select id="@($"product-family-{slot.Family.Id}")" @onchange="args => ChooseFamilyMember(slot, args.Value?.ToString())">
                                        <option value="" selected="@(active is null)">— alege —</option>
                                        @foreach (var member in slot.Members) { <option value="@member.Id" selected="@(active?.Id == member.Id)">@member.Name</option> }
                                    </select>
                                </label>
                                @if (active is not null) { @FieldFor(active) }
                            </fieldset>
                        }
                    }
                    <p class="form-note full-width" id="product-composed-code">Codul produsului rezultat: <strong>@ComposedPreview</strong>@if (!ParametersComplete) { <text> (incomplet: alege câte o valoare pentru fiecare parametru)</text> }</p>
                }
                <label class="full-width" for="product-description">Descriere<InputTextArea id="product-description" @bind-Value="input.Description" @oninput="args => input.Description = args.Value?.ToString() ?? string.Empty" maxlength="1000" rows="3" /><ValidationMessage For="() => input.Description" /></label>
                @if (InvoiceAmbiguity.Found(input.Description) is { Length: > 0 } descriptionDoubt) { <p class="uncertain-note full-width" id="product-description-doubt" role="status"><span class="uncertain-badge">⚠ caractere nesigure: @descriptionDoubt</span> Descrierea conține caractere care se confundă ușor cu litere sau cifre. Verifică-o.</p> }
                @if (!Staging && CurrentTags.Count > 0)
                {
                    <fieldset class="parameter-kind product-tags full-width" aria-describedby="product-tags-note">
                        <legend>Etichete (opționale)</legend>
                        @foreach (var tag in CurrentTags)
                        {
                            <ToggleSwitch @key="tag.Id" Value="@tagsOn.Contains(tag.Id)" ValueChanged="on => SetTag(tag.Id, on)" AriaLabel="@($"Etichetă: {tag.Name}")">@tag.Name</ToggleSwitch>
                        }
                        <small id="product-tags-note" class="form-note">Etichetele active devin filtre în catalogul de produse; nu fac parte din cod și nu sunt obligatorii.</small>
                    </fieldset>
                }
                <div class="product-image-editor full-width">
                    <div class="image-preview-card">
                        <img src="@ImagePreviewUrl" alt="Previzualizare imagine pentru produs" />
                    </div>
                    <div class="image-inputs">
                        <strong>Imagine produs (opțional)</strong>
                        <div class="image-pick-row" @ref="pasteArea">
                            <FileDropZone Id="product-image-input" OnChange="ImageSelectedAsync" Accept="image/jpeg,image/png,image/webp,image/gif" Text="Alege imaginea" />
                            <span class="paste-hint">sau lipește imaginea copiată cu <kbd>Ctrl</kbd> + <kbd>V</kbd></span>
                        </div>
                        <div class="image-web-search">
                            @if (ImageSearchUrl is { } searchUrl)
                            {
                                <a class="refresh act-confirm" href="@searchUrl" target="product-image-search" rel="noopener noreferrer" id="product-image-search"
                                   onclick="window.open(this.href, 'product-image-search', 'popup=yes,width=1100,height=800'); return false;">🔍 Caută imaginea pe internet după codul „@input.Name.Trim()”</a>
                                <small>Se deschide într-o fereastră separată cu rezultatele căutării de imagini. Deschide pagina potrivită, copiază imaginea (clic dreapta → Copiază imaginea) și lipește-o în câmpul de mai sus.</small>
                            }
                            else { <small class="muted">Completează codul produsului ca să poți căuta imaginea pe internet.</small> }
                        </div>
                        <small>Dacă nu alegi o imagine, produsul va folosi automat imaginea generică „No img available”.</small>
                        <small>Formate acceptate: JPG, PNG, WebP sau GIF. Dimensiune maximă: 5 MB.</small>
                        @if (imageFileName is not null) { <span class="selected-image-name">Imagine selectată: @imageFileName</span> }
                        @if (imageError is not null) { <span class="validation-message">@imageError</span> }
                    </div>
                </div>
                <div class="form-note full-width" id="product-stock">
                    @if (Original is null && Staging) { <span>Produsul nu se salvează acum: se pregătește aici și se adaugă în catalog la finalizarea preluării (pasul 3), împreună cu intrarea în stoc.</span> }
                    else if (Original is null) { <span>Produsul nou este creat cu stoc 0. Stocul se modifică numai prin intrări și ieșiri.</span> }
                    else { <span>Stoc curent: <strong>@Original.Quantity buc.</strong>@if (inVehicles > 0) { <text> (@(Original.Quantity - inVehicles) în depozit, @inVehicles în vehicule)</text> } Stocul nu se editează aici; se modifică numai prin intrări și ieșiri.</span> }
                </div>
                @if (Original is not null)
                {
                    <ChangeReasonField Id="product-change-reason" @bind-Value="customReason" AutoText="@AutoSummary" @bind-UseAuto="reasonAuto" Error="@reasonError" Disabled="saving" />
                }
            </div>
            <div class="editor-actions"><button class="primary" type="submit" disabled="@(!HasSelectableGroup)">@(saving ? "Se salvează…" : Staging ? "Pregătește produsul" : "Salvează produsul")</button><button class="danger" type="button" @onclick="Close">Anulează</button></div>
        </fieldset>
    </EditForm>
</section>
@if (categoriesOpen)
{
    <div class="invoice-modal-backdrop front">
        <div class="invoice-modal wide" role="dialog" aria-modal="true" aria-label="Categorii și subcategorii">
            <div class="catalog-heading"><h3>Categorii și subcategorii</h3><button type="button" class="primary" @onclick="CloseCategoriesAsync">Gata, înapoi la produs</button></div>
            <iframe class="categories-frame" src="/categorii/fereastra" title="Categorii și subcategorii"></iframe>
        </div>
    </div>
}
@if (pendingChanges is not null && Original is not null)
{
    <SaveConfirmationDialog Title="Salvezi modificările produsului?" ObjectLabel="@Original.Name" Changes="pendingChanges"
                            Reason="@input.Reason" Confirmed="ConfirmSaveAsync" Cancelled="CancelConfirmation" />
}

@code {
    [Parameter] public Product? Original { get; set; }
    [Parameter] public string InitialCategory { get; set; } = "";
    [Parameter] public string InitialSubcategory { get; set; } = "";
    // A new product can start with a code and a description (the invoice pickup offers the product of an invoice row).
    [Parameter] public string InitialName { get; set; } = "";
    [Parameter] public string InitialDescription { get; set; } = "";
    // The values already chosen for a product prepared earlier (invoice pickup), kept when it is edited again.
    [Parameter] public IReadOnlyList<ProductParameterChoice> InitialChoices { get; set; } = [];
    [Parameter] public IReadOnlyList<ProductGroup> Groups { get; set; } = Array.Empty<ProductGroup>();
    [Parameter] public EventCallback<Product> Saved { get; set; }
    [Parameter] public EventCallback Closed { get; set; }
    private UnsavedChangesTracker? tracker;
    private string CurrentSnapshot() => FormSnapshot.Of(input, imageFileName, string.Join(",", chosen.OrderBy(item => item.Key).Select(item => $"{item.Key}:{item.Value}")) + "|" + string.Join(",", tagsOn.Order()));
    // "Părăsește editarea": the leave warning closes the form without saving (Task 1).
    private Task DiscardAsync() => Closed.InvokeAsync();
    private ProductInput input = new();
    private bool saving;
    private IReadOnlyList<AuditChange>? pendingChanges;
    private string? error, reasonError, imageError, imageFileName, imagePreviewUrl;

    // The reason of an edit: the summary of the changes made in the form (rebuilt at every render, so it follows the form and drops a change
    // that was put back to the original value), or a text the user writes; the choice is made with radio buttons.
    private bool reasonAuto = true;
    private string customReason = "";

    private string AutoSummary => Original is null ? "" : ChangeReasonSummary.Build(
    [
        new(ProductCode.Label, Original.Name, input.Name), new("Categorie", Original.Category, input.Category),
        new("Subcategorie", Original.Subcategory, input.Subcategory), new("Descriere", Original.Description, input.Description),
        new("Parametri", ChoiceSummary(originalChoices), ChoiceSummary(CurrentChoices)),
        new("Etichete", TagSummary(originalTagsOn), TagSummary(tagsOn)),
        new("Imagine", "neschimbată", selectedImage is null ? "neschimbată" : $"înlocuită cu {imageFileName}")
    ]);

    // Tags of the chosen subcategory (optional, On/Off): saved with the product, shown as filters in the catalog.
    private IReadOnlyList<SubcategoryTag> allTags = [];
    private readonly HashSet<int> tagsOn = [], originalTagsOn = [];
    private IReadOnlyList<SubcategoryTag> CurrentTags => allTags
        .Where(tag => string.Equals(tag.Category, input.Category, StringComparison.OrdinalIgnoreCase) && InLineage(tag.Subcategory)).OrderBy(tag => LineageIndex(tag.Subcategory)).ThenBy(tag => tag.Position).ToList();
    private void SetTag(int id, bool on) { if (on) tagsOn.Add(id); else tagsOn.Remove(id); }
    private string TagSummary(IEnumerable<int> ids) => string.Join(", ", allTags.Where(tag => ids.Contains(tag.Id)).Select(tag => tag.Name).Order(StringComparer.CurrentCultureIgnoreCase)) is { Length: > 0 } text ? text : "—";
    private ProductImageData? selectedImage;
    private ElementReference pasteArea;
    private IJSObjectReference? imageModule;
    private readonly CancellationTokenSource lifetime = new();
    private string ImagePreviewUrl => imagePreviewUrl ?? (Original is null ? ProductImageRules.PlaceholderUrl : $"/media/products/{Original.Id}?v={Original.Version}");
    // Invoice pickup: the product is only prepared (checked and handed back), nothing is written to the catalog; the pickup saves it at the end.
    [Parameter] public bool Staging { get; set; }
    [Parameter] public EventCallback<StagedProduct> Staged { get; set; }
    [Parameter] public ProductImageData? InitialImage { get; set; }

    // The categories as they are now: the list given by the page, read again after the categories were edited in the popup.
    private IReadOnlyList<ProductGroup>? refreshedGroups;
    private bool categoriesOpen;
    private IReadOnlyList<ProductGroup> CurrentGroups => refreshedGroups ?? Groups;

    private void OpenCategories() => categoriesOpen = true;

    private async Task CloseCategoriesAsync()
    {
        categoriesOpen = false;
        try
        {
            refreshedGroups = await Repository.GetGroupsAsync(lifetime.Token);
            await LoadTreeAsync();
            await LoadParametersAsync();
            NormalizeGroupSelection();
            GroupChanged();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) { Logger.LogWarning("Category list reloading failed ({ErrorType}).", exception.GetType().Name); }
    }

    private IReadOnlyList<string> Categories => CurrentGroups.Select(group => group.Category)
        .Where(value => !string.IsNullOrWhiteSpace(value)).Distinct(StringComparer.OrdinalIgnoreCase)
        .Order(StringComparer.CurrentCultureIgnoreCase).ToArray();
    private IReadOnlyList<string> Subcategories => CurrentGroups
        .Where(group => string.Equals(group.Category, input.Category, StringComparison.OrdinalIgnoreCase))
        .Select(group => group.Subcategory).Where(value => !string.IsNullOrWhiteSpace(value) && IsLeafName(value))
        .Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.CurrentCultureIgnoreCase).ToArray();
    // The web search for the picture of the product, by its code (the name of the product): the results of an image search, opened in a popup window.
    private string? ImageSearchUrl => string.IsNullOrWhiteSpace(input.Name) ? null : "https://www.google.com/search?tbm=isch&q=" + Uri.EscapeDataString(input.Name.Trim());
    private bool HasSelectableGroup =>Categories.Count > 0 && Subcategories.Count > 0;
    // The tree of subcategories (migration 54): the product goes on a leaf, which has the parameters, families and tags of its ancestors besides its own.
    private IReadOnlyList<SubcategoryNode> treeNodes = [];
    private async Task LoadTreeAsync()
    {
        try { treeNodes = await Tree.GetTreeAsync(lifetime.Token); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) { Logger.LogWarning("Subcategory tree loading failed ({ErrorType}).", exception.GetType().Name); }
    }
    // The subcategory and its ancestors, root first.
    private List<string> Lineage()
    {
        var names = new List<string>();
        var node = treeNodes.FirstOrDefault(item => string.Equals(item.Category, input.Category, StringComparison.OrdinalIgnoreCase) && string.Equals(item.Name, input.Subcategory, StringComparison.OrdinalIgnoreCase));
        while (node is not null)
        {
            names.Insert(0, node.Name);
            var parent = node.Parent;
            node = parent is null ? null : treeNodes.FirstOrDefault(item => string.Equals(item.Category, input.Category, StringComparison.OrdinalIgnoreCase) && string.Equals(item.Name, parent, StringComparison.OrdinalIgnoreCase));
        }
        if (names.Count == 0 && !string.IsNullOrWhiteSpace(input.Subcategory)) names.Add(input.Subcategory);
        return names;
    }
    private bool InLineage(string subcategory) => Lineage().Contains(subcategory, StringComparer.OrdinalIgnoreCase);
    private int LineageIndex(string subcategory) => Lineage().FindIndex(name => string.Equals(name, subcategory, StringComparison.OrdinalIgnoreCase));
    private bool IsLeafName(string subcategory) => treeNodes.FirstOrDefault(item => string.Equals(item.Category, input.Category, StringComparison.OrdinalIgnoreCase) && string.Equals(item.Name, subcategory, StringComparison.OrdinalIgnoreCase))?.IsLeaf ?? true;

    private int inVehicles;

    // Required parameters of the chosen subcategory: the code becomes "<model> - <value> - ..." and every parameter needs a value.
    private IReadOnlyList<SubcategoryParameter> allParameters = [];
    private readonly Dictionary<int, int> chosen = [];
    private readonly Dictionary<int, string> newParameterValues = [];
    private IReadOnlyList<ProductParameterChoice> originalChoices = [];
    private IReadOnlyList<SubcategoryParameter> CurrentParameters => allParameters
        .Where(parameter => string.Equals(parameter.Category, input.Category, StringComparison.OrdinalIgnoreCase)
            && InLineage(parameter.Subcategory)).OrderBy(parameter => LineageIndex(parameter.Subcategory)).ThenBy(parameter => parameter.Position)
        .Select((parameter, index) => parameter with { Position = index }).ToList();
    private bool HasParameters => CurrentSlots.Count > 0;

    // Families of the chosen subcategory: a product has exactly one active member per family (the member picked in the family list, with its value).
    private IReadOnlyList<ParameterFamily> allFamilies = [];
    private readonly Dictionary<int, int> familyPick = [];
    private IReadOnlyList<ParameterSlot> CurrentSlots => ProductParameterRules.Slots(CurrentParameters,
        allFamilies.Where(family => string.Equals(family.Category, input.Category, StringComparison.OrdinalIgnoreCase) && InLineage(family.Subcategory)));
    private SubcategoryParameter? ActiveMember(ParameterSlot slot) =>
        slot.Members.FirstOrDefault(member => chosen.ContainsKey(member.Id))
        ?? (slot.Family is not null && familyPick.TryGetValue(slot.Family.Id, out var picked) ? slot.Members.FirstOrDefault(member => member.Id == picked) : null);
    private bool ParametersComplete => ProductParameterRules.Problems(CurrentSlots, chosen.Keys.ToHashSet()).Count == 0;
    private IReadOnlyList<ProductParameterChoice> CurrentChoices => ProductParameterRules.CodeOrder(CurrentSlots, chosen.Keys.ToHashSet())
        .Select(parameter => new ProductParameterChoice(parameter.Id, chosen[parameter.Id])).ToList();

    // Switching the active member of a family drops the value of the other members.
    private void ChooseFamilyMember(ParameterSlot slot, string? text)
    {
        foreach (var member in slot.Members) chosen.Remove(member.Id);
        if (int.TryParse(text, out var id) && slot.Members.FirstOrDefault(member => member.Id == id) is { } picked)
        {
            familyPick[slot.Family!.Id] = id;
            // A fixed member has only one value (its name): choosing the member gives the family its value.
            if (picked.Kind == ParameterKind.Fixed && picked.Values.Count > 0) chosen[picked.Id] = picked.Values[0].Id;
        }
        else familyPick.Remove(slot.Family!.Id);
        SyncName();
    }

    private RenderFragment FieldFor(SubcategoryParameter parameter) => parameter.Kind == ParameterKind.Fixed ? FixedNote(parameter) : ParameterField(parameter);
    private RenderFragment FixedNote(SubcategoryParameter parameter) => @<p class="form-note fixed-parameter-note" @key="parameter.Id">Valoare fixă: <strong>@parameter.Name</strong>. Nu mai ai de completat nimic pentru această familie.</p>;
    private RenderFragment ParameterField(SubcategoryParameter parameter) => @<div class="parameter-field" @key="parameter.Id">
        <label for="@($"product-parameter-{parameter.Id}")">@parameter.Name@(parameter.Unit.Length > 0 ? $" ({parameter.Unit})" : "") *
            <select id="@($"product-parameter-{parameter.Id}")" @onchange="args => ChooseValue(parameter, args.Value?.ToString())">
                <option value="" selected="@(!chosen.ContainsKey(parameter.Id))">— alege valoarea —</option>
                @foreach (var value in parameter.Values) { <option value="@value.Id" selected="@(chosen.TryGetValue(parameter.Id, out var chosenId) && chosenId == value.Id)">@value.Value</option> }
            </select>
        </label>
        <div class="parameter-add">
            @if (parameter.Kind == ParameterKind.Interval)
            {
                <IntervalInputs Label="@($"Interval nou pentru {parameter.Name}")" Start="@NewParameterStart(parameter.Id)" End="@NewParameterEnd(parameter.Id)"
                                StartChanged="value => newParameterStarts[parameter.Id] = value" EndChanged="value => newParameterEnds[parameter.Id] = value" />
            }
            else
            {
            <input aria-label="@($"Valoare nouă pentru {parameter.Name}")" maxlength="@ProductParameterRules.ValueMaximumLength" placeholder="@(parameter.Kind == ParameterKind.Number ? "Valoare nouă (număr)" : "Valoare nouă")"
                   value="@NewParameterValue(parameter.Id)" @oninput="args => newParameterValues[parameter.Id] = args.Value?.ToString() ?? string.Empty" autocomplete="off" />
            }
            <button type="button" class="refresh act-confirm" @onclick="() => AddParameterValueAsync(parameter)">Adaugă valoarea</button>
        </div>
    </div>;
    private string NewParameterValue(int parameterId) => newParameterValues.TryGetValue(parameterId, out var text) ? text : "";
    private readonly Dictionary<int, string> newParameterStarts = [], newParameterEnds = [];
    private string NewParameterStart(int parameterId) => newParameterStarts.TryGetValue(parameterId, out var text) ? text : "";
    private string NewParameterEnd(int parameterId) => newParameterEnds.TryGetValue(parameterId, out var text) ? text : "";
    private string CodeText
    {
        get => HasParameters ? input.BaseModel : input.Name;
        set { if (HasParameters) input.BaseModel = value; else input.Name = value; SyncName(); }
    }
    private string ComposedPreview
    {
        get
        {
            var model = TextNormalization.ForObjectNameOrCode(input.BaseModel);
            var displays = ProductParameterRules.CodeOrder(CurrentSlots, chosen.Keys.ToHashSet())
                .Select(parameter => parameter.Values.FirstOrDefault(value => value.Id == chosen[parameter.Id]) is { } value ? parameter.Display(value.Value) : "…");
            return model.Length == 0 ? "—" : ProductParameterRules.ComposeName(model, displays);
        }
    }
    private string ChoiceSummary(IEnumerable<ProductParameterChoice> choices) => ProductParameterRules.Summary(allParameters
        .SelectMany(parameter => choices.Where(choice => choice.ParameterId == parameter.Id)
            .Select(choice => (parameter.Name, Display: parameter.Values.FirstOrDefault(value => value.Id == choice.ValueId) is { } value ? parameter.Display(value.Value) : "")))
        .Where(item => item.Display.Length > 0));

    // The code the form checks and shows follows the model and the values; the repository composes the final one.
    private void SyncName()
    {
        if (!HasParameters) return;
        var model = TextNormalization.ForObjectNameOrCode(input.BaseModel);
        input.Name = model.Length == 0 ? "" : ComposedPreview;
        input.Parameters = CurrentChoices.ToList();
    }

    private void ChooseValue(SubcategoryParameter parameter, string? text)
    {
        if (int.TryParse(text, out var id) && parameter.Values.Any(value => value.Id == id)) chosen[parameter.Id] = id;
        else chosen.Remove(parameter.Id);
        SyncName();
    }

    // The subcategory changed: values of other subcategories are dropped, and the typed code becomes the model of a subcategory with parameters.
    private void GroupChanged()
    {
        var wasParametric = input.BaseModel.Length > 0;
        foreach (var id in chosen.Keys.Where(id => CurrentParameters.All(parameter => parameter.Id != id)).ToList()) chosen.Remove(id);
        familyPick.Clear();
        tagsOn.RemoveWhere(id => CurrentTags.All(tag => tag.Id != id));
        if (HasParameters && input.BaseModel.Length == 0) input.BaseModel = input.Name;
        else if (!HasParameters && wasParametric && string.IsNullOrWhiteSpace(input.Name)) input.Name = input.BaseModel;
        SyncName();
    }

    private async Task LoadParametersAsync()
    {
        try
        {
            allParameters = await ParameterRepository.GetParametersAsync(lifetime.Token);
            allFamilies = await ParameterRepository.GetFamiliesAsync(lifetime.Token);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) { Logger.LogWarning("Parameter list loading failed ({ErrorType}).", exception.GetType().Name); }
    }

    private async Task AddParameterValueAsync(SubcategoryParameter parameter)
    {
        error = null;
        try
        {
            var text = parameter.Kind == ParameterKind.Interval ? IntervalInputs.Compose(NewParameterStart(parameter.Id), NewParameterEnd(parameter.Id)) : NewParameterValue(parameter.Id);
            var added = await ParameterRepository.AddValueAsync(parameter.Id, text, lifetime.Token);
            newParameterValues.Remove(parameter.Id); newParameterStarts.Remove(parameter.Id); newParameterEnds.Remove(parameter.Id);
            await LoadParametersAsync();
            chosen[parameter.Id] = added.Id;
            SyncName();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (ProductOperationException exception) { error = exception.Message; }
        catch (AccessDeniedException exception) { error = exception.Message; }
        catch (Exception exception) { Logger.LogError("Parameter value adding failed ({ErrorType}).", exception.GetType().Name); error = "Valoarea nu a putut fi adăugată."; }
    }

    // The list given by the page can be older than the catalog (a category created in the popup of another form of the same page):
    // the categories are read again when the form opens, before the chosen category is checked against them.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            refreshedGroups = await Repository.GetGroupsAsync(lifetime.Token);
            await LoadTreeAsync();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) { Logger.LogWarning("Category list reloading failed ({ErrorType}).", exception.GetType().Name); }
        await LoadParametersAsync();
        try
        {
            allTags = await TagRepository.GetTagsAsync(lifetime.Token);
            if (Original is not null) foreach (var id in await TagRepository.GetProductTagIdsAsync(Original.Id, lifetime.Token)) { tagsOn.Add(id); originalTagsOn.Add(id); }
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) { Logger.LogWarning("Tag loading failed ({ErrorType}).", exception.GetType().Name); }
        NormalizeGroupSelection();
        if (Original is not null)
        {
            try
            {
                var state = await ParameterRepository.GetProductStateAsync(Original.Id, lifetime.Token);
                originalChoices = state.Choices;
                foreach (var choice in state.Choices) chosen[choice.ParameterId] = choice.ValueId;
                input.BaseModel = state.BaseModel.Length > 0 ? state.BaseModel : Original.Name;
            }
            catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
            catch (Exception exception) { Logger.LogWarning("Product parameters loading failed ({ErrorType}).", exception.GetType().Name); input.BaseModel = Original.Name; }
        }
        if (HasParameters && input.BaseModel.Length == 0) input.BaseModel = input.Name;
        if (Original is null)
            foreach (var choice in InitialChoices)
                if (CurrentParameters.Any(parameter => parameter.Id == choice.ParameterId && parameter.Values.Any(value => value.Id == choice.ValueId))) chosen[choice.ParameterId] = choice.ValueId;
        SyncName();
        if (Original is null) return;
        try { inVehicles = (await Movements.GetVehicleStocksAsync(Original.Id, lifetime.Token)).Sum(stock => stock.Quantity); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) { Logger.LogWarning("Vehicle stock loading failed ({ErrorType}).", exception.GetType().Name); }
    }

    protected override void OnInitialized()
    {
        input = Original is null
            ? new ProductInput { Category = InitialCategory, Subcategory = InitialSubcategory, Name = InitialName, Description = InitialDescription }
            : ProductInput.From(Original);
        if (Original is null && InitialImage is not null)
        {
            selectedImage = InitialImage;
            imageFileName = InitialImage.FileName;
            imagePreviewUrl = $"data:{InitialImage.ContentType};base64,{Convert.ToBase64String(InitialImage.Content)}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            imageModule = await JS.InvokeAsync<IJSObjectReference>("import", "./product-image.js");
            await imageModule.InvokeVoidAsync("attachPaste", pasteArea, "product-image-input");
        }
        catch (JSDisconnectedException) { }
        catch (JSException exception)
        {
            Logger.LogWarning("Product image clipboard module could not be loaded ({ErrorType}).", exception.GetType().Name);
            imageError = "Lipirea cu Ctrl + V nu este disponibilă momentan. Poți selecta imaginea dintr-un fișier.";
            await InvokeAsync(StateHasChanged);
        }
    }
    private Task CategoryChangedAsync()
    {
        input.Subcategory = Subcategories.FirstOrDefault() ?? "";
        GroupChanged();
        return Task.CompletedTask;
    }
    private void NormalizeGroupSelection()
    {
        input.Category = Categories.FirstOrDefault(category =>
            string.Equals(category, input.Category, StringComparison.OrdinalIgnoreCase)) ?? Categories.FirstOrDefault() ?? "";
        input.Subcategory = Subcategories.FirstOrDefault(subcategory =>
            string.Equals(subcategory, input.Subcategory, StringComparison.OrdinalIgnoreCase)) ?? Subcategories.FirstOrDefault() ?? "";
    }
    private Task Close() => saving ? Task.CompletedTask : tracker is null ? Closed.InvokeAsync() : tracker.RunAfterConfirmAsync(() => Closed.InvokeAsync());
    private async Task SaveAsync()
    {
        if (saving) return;
        if (HasParameters && !ParametersComplete)
        {
            error = ProductParameterRules.RequiredMessage(input.Subcategory, CurrentParameters.Select(parameter => parameter.Name));
            return;
        }
        SyncName();
        if (Original is not null) input.Reason = ChangeReasonSummary.Chosen(reasonAuto, AutoSummary, customReason);
        reasonError = Original is null ? null : ChangeReasonSummary.ValidationError(reasonAuto, AutoSummary, customReason);
        if (reasonError is not null) return;
        if (Original is not null)
        {
            // Saving over existing data needs an explicit confirmation; a new product is saved directly.
            error = null;
            try
            {
                var value = input.Validated(Original);
                pendingChanges = SaveSummary.Changed(
                    new(ProductCode.Label, Original.Name, value.Name), new("Categorie", Original.Category, value.Category),
                    new("Subcategorie", Original.Subcategory, value.Subcategory), new("Descriere", Original.Description, value.Description),
                    new("Parametri", ChoiceSummary(originalChoices), ChoiceSummary(CurrentChoices)),
                    new("Etichete", TagSummary(originalTagsOn), TagSummary(tagsOn)),
                    new("Imagine", "neschimbată", selectedImage is null ? "neschimbată" : $"înlocuită cu {imageFileName}"));
            }
            catch (ProductOperationException exception) { error = exception.Message; }
            return;
        }
        if (Staging) { await StageAsync(); return; }
        await PersistAsync();
    }

    // Invoice pickup: the product is checked like a new one (fields, code not used in the catalog) and handed back, not saved.
    private async Task StageAsync()
    {
        error = null;
        try
        {
            var value = input.Validated();
            var existing = (await Repository.GetProductsAsync(lifetime.Token)).FirstOrDefault(product => TextNormalization.SameUniqueValue(product.Name, value.Name));
            if (existing is not null) throw new ProductOperationException(ProductCode.DuplicateMessage(existing.Name, existing.Category, existing.Subcategory));
            tracker?.Rebase();
            await Staged.InvokeAsync(new StagedProduct(value, selectedImage));
        }
        catch (ProductOperationException exception) { error = exception.Message; }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }

    private Task ConfirmSaveAsync() { pendingChanges = null; return PersistAsync(); }
    private Task CancelConfirmation() { pendingChanges = null; return Task.CompletedTask; }

    private async Task PersistAsync()
    {
        if (saving) return;
        saving = true; error = null;
        Product? saved = null;
        try
        {
            saved = Original is null ? await Repository.CreateAsync(input, lifetime.Token) : await Repository.UpdateAsync(Original, input, lifetime.Token);
            if (selectedImage is not null) await ImageStore.SaveAsync(saved.Id, selectedImage, lifetime.Token);
            if (CurrentTags.Count > 0 || originalTagsOn.Count > 0)
                await TagRepository.SetProductTagsAsync(saved.Id, tagsOn.Where(id => CurrentTags.Any(tag => tag.Id == id)).ToList(), lifetime.Token);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (ProductOperationException ex) { error = ex.Message; }
        catch (Exception ex)
        {
            Logger.LogError("Product saving failed ({ErrorType}).", ex.GetType().Name);
            error = "Salvarea nu a putut fi confirmată. Datele formularului sunt păstrate. Verifică în catalog dacă modificarea apare înainte să reîncerci; dacă problema continuă, verifică accesul de scriere și pregătirea bazei cu administratorul.";
        }
        finally { saving = false; }
        if (saved is not null) { tracker?.Rebase(); await Saved.InvokeAsync(saved); }
    }

    private async Task ImageSelectedAsync(InputFileChangeEventArgs eventArgs)
    {
        imageError = null;
        try
        {
            var file = eventArgs.File;
            if (file.Size > ProductImageRules.MaximumBytes) throw new ProductImageException("Imaginea poate avea cel mult 5 MB.");
            await using var stream = file.OpenReadStream(ProductImageRules.MaximumBytes, lifetime.Token);
            using var memory = new MemoryStream();
            await stream.CopyToAsync(memory, lifetime.Token);
            var content = memory.ToArray();
            var contentType = ProductImageRules.DetectContentType(content);
            selectedImage = new(content, contentType, file.Name);
            imageFileName = file.Name;
            imagePreviewUrl = $"data:{contentType};base64,{Convert.ToBase64String(content)}";
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (ProductImageException exception) { selectedImage = null; imageError = exception.Message; }
        catch (Exception exception) { selectedImage = null; Logger.LogError("Product image loading failed ({ErrorType}).", exception.GetType().Name); imageError = "Imaginea nu a putut fi citită."; }
    }

    public async ValueTask DisposeAsync()
    {
        lifetime.Cancel();
        if (imageModule is not null)
        {
            try { await imageModule.InvokeVoidAsync("detachPaste", pasteArea); await imageModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        lifetime.Dispose();
    }
}
