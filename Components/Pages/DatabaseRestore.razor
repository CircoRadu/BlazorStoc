@page "/inventar/restaurare"
@attribute [Authorize(Roles = AccessRoles.Administrator)]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using BlazorStoc.Services
@using System.Globalization
@inject IDatabaseBackupService BackupService
@inject IDatabaseRestoreService RestoreService
@inject IAccessControl Access
@inject ILogger<DatabaseRestore> Logger
@implements IDisposable

<PageTitle>Restaurare stoc · BlazorStoc</PageTitle>
<div class="page-heading">
    <div><p class="eyebrow">INVENTAR</p><h1>Restaurare stoc</h1>
        <p class="muted">Pachetele de siguranta generate la preluarea situatiei de inventar si, ulterior, inaintea unei restaurari.</p></div>
</div>

@if (!authorized && !loading) { <div class="error-banner" role="alert">Nu ai drepturi de administrator.</div> }
@if (error is not null) { <div class="error-banner" role="alert">@error <button class="primary" @onclick="RetryLoadAsync">Reincearca</button></div> }
@if (notice is not null) { <div class="success-banner" role="status">@notice</div> }

@if (authorized)
{
    <section class="metrics" aria-label="Rezumat pachete">
        <article><span>Total pachete</span><strong>@(loaded ? packages.Count.ToString() : "—")</strong><small>Copii de siguranta</small><i>▤</i></article>
        <article><span>Spatiu ocupat</span><strong>@(loaded ? FormatSize(packages.Sum(package => package.SizeBytes)) : "—")</strong><small>Pe server</small><i>◆</i></article>
        <article><span>Preluare inventar</span><strong>@(loaded ? packages.Count(package => package.Kind == BackupKind.InventoryPickup).ToString() : "—")</strong><small>Pot fi sterse</small><i>◇</i></article>
        <article><span>Pre-restaurare</span><strong>@(loaded ? packages.Count(package => package.Kind == BackupKind.PreRestore).ToString() : "—")</strong><small>Nu pot fi sterse</small><i class="amber">⚿</i></article>
    </section>

    <section class="catalog">
        <div class="catalog-heading">
            <h2>Pachete disponibile <span>@packages.Count</span></h2>
            <button class="primary" disabled="@(selectedFileName is null || restoring)" @onclick="OpenRestorePopup">
                Restaureaza baza de date
            </button>
        </div>
        @if (loading) { <div class="empty-state" role="status"><div class="spinner"></div><h3>Se incarca pachetele</h3></div> }
        else if (packages.Count == 0) { <div class="empty-state"><h3>Niciun pachet de siguranta</h3><p>Un pachet apare aici dupa prima preluare de inventar.</p></div> }
        else
        {
            <div class="table-scroll">
                <table>
                    <thead><tr>
                        <th><span class="sr-only">Selecteaza</span></th>
                        <th>TIP</th><th>DENUMIRE</th><th>DATA</th><th>OPERATOR</th><th>DIMENSIUNE</th>
                        <th><span class="sr-only">Actiuni</span></th>
                    </tr></thead>
                    <tbody>
                        @foreach (var package in packages)
                        {
                            <tr @key="package.FileName">
                                <td><input type="radio" name="backup-selection" aria-label="@($"Selecteaza {package.FileName}")"
                                           checked="@(selectedFileName == package.FileName)" @onchange="() => Select(package)" /></td>
                                <td><span class="role-badge @(package.Kind == BackupKind.InventoryPickup ? "limited" : "admin")">
                                    @(package.Kind == BackupKind.InventoryPickup ? "Preluare inventar" : "Pre-restaurare")</span></td>
                                <td>@package.FileName</td>
                                <td>@package.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm", CultureInfo.InvariantCulture)</td>
                                <td>@package.OperatorName (@package.OperatorRole)</td>
                                <td>@FormatSize(package.SizeBytes)</td>
                                <td>
                                    @if (package.CanDelete)
                                    {
                                        <button class="row-action delete" aria-label="@($"Sterge {package.FileName}")"
                                                disabled="@(deleting is not null)" @onclick="() => RequestDeleteAsync(package)">×</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@if (deleting is not null)
{
    <DeleteConfirmationDialog @key="deleting.FileName" Title="Stergi pachetul de siguranta?" Subject="Pachetul"
                              ObjectLabel="@deleting.FileName"
                              Description="Pachetul nu va mai putea fi folosit pentru o restaurare ulterioara."
                              ConfirmationNote="Fisierul va fi sters definitiv de pe server (nu poate fi recuperat) si operatia va fi inregistrata in jurnal."
                              Busy="@deleteBusy" Error="@deleteError" Confirmed="DeletePackageAsync"
                              Cancelled="CancelDeleteAsync" />
}

@if (showRestorePopup && selectedPackage is not null)
{
    <RestoreConfirmationDialog @key="selectedPackage.FileName" PackageLabel="@selectedPackage.FileName"
                               Busy="@restoring" Error="@restoreError" ProgressMessage="@restoreProgressMessage"
                               Confirmed="ConfirmRestoreAsync" Cancelled="CancelRestoreAsync" />
}

@code {
    private IReadOnlyList<BackupPackage> packages = Array.Empty<BackupPackage>();
    private BackupPackage? deleting;
    private string? selectedFileName;
    private bool loading = true, loaded, authorized, deleteBusy;
    private string? error, notice, deleteError;
    private bool showRestorePopup, restoring;
    private string? restoreError, restoreProgressMessage;
    private readonly CancellationTokenSource lifetime = new();
    private BackupPackage? selectedPackage => packages.FirstOrDefault(package => package.FileName == selectedFileName);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private Task RetryLoadAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            authorized = await Access.IsAdministratorAsync(lifetime.Token);
            packages = authorized ? await BackupService.ListPackagesAsync(lifetime.Token) : Array.Empty<BackupPackage>();
            loaded = authorized;
            if (selectedFileName is not null && packages.All(package => package.FileName != selectedFileName)) selectedFileName = null;
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Logger.LogError("Backup package listing failed ({ErrorType}).", exception.GetType().Name);
            error = "Pachetele de siguranta nu au putut fi incarcate. Verifica conexiunea la baza de date.";
        }
        finally { loading = false; }
    }

    private void Select(BackupPackage package) => selectedFileName = package.FileName;
    private Task RequestDeleteAsync(BackupPackage package) { deleting = package; deleteError = null; notice = null; return Task.CompletedTask; }
    private Task CancelDeleteAsync() { deleting = null; deleteError = null; return Task.CompletedTask; }

    private async Task DeletePackageAsync(string reason)
    {
        if (deleteBusy || deleting is null) return;
        deleteBusy = true; deleteError = null;
        try
        {
            var result = await BackupService.DeletePackageAsync(deleting.FileName, reason, lifetime.Token);
            if (!result.Success) { deleteError = result.ErrorMessage; return; }
            notice = "Pachetul a fost sters.";
            deleting = null;
            await LoadAsync();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Logger.LogError("Backup package deletion failed ({ErrorType}).", exception.GetType().Name);
            deleteError = "Pachetul nu a putut fi sters. Actualizeaza lista si reincearca.";
        }
        finally { deleteBusy = false; }
    }

    private void OpenRestorePopup()
    {
        if (selectedFileName is null) return;
        restoreError = null;
        notice = null;
        showRestorePopup = true;
    }

    private Task CancelRestoreAsync()
    {
        if (restoring) return Task.CompletedTask;
        showRestorePopup = false;
        restoreError = null;
        return Task.CompletedTask;
    }

    // Subtask 3.3/3.4 (Task 3): the popup's own word check (RestoreConfirmationRules) already keeps the "Confirma"
    // button disabled until the exact word is typed, so reaching this handler already means a valid confirmation.
    private async Task ConfirmRestoreAsync()
    {
        if (restoring || selectedPackage is null) return;
        var fileName = selectedPackage.FileName;
        restoring = true;
        restoreError = null;
        try
        {
            var progress = new Progress<RestoreProgress>(step => { restoreProgressMessage = step.Message; StateHasChanged(); });
            var result = await RestoreService.RestoreAsync(fileName, progress, lifetime.Token);
            if (!result.Success)
            {
                restoreError = result.ErrorMessage ?? RestoreRules.GenericFailedMessage;
                return;
            }
            showRestorePopup = false;
            selectedFileName = null;
            notice = RestoreRules.SuccessMessage;
            await LoadAsync();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Logger.LogError("Database restore failed ({ErrorType}).", exception.GetType().Name);
            restoreError = RestoreRules.GenericFailedMessage;
        }
        finally { restoring = false; restoreProgressMessage = null; }
    }

    private static string FormatSize(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB"];
        double size = bytes;
        var unitIndex = 0;
        while (size >= 1024 && unitIndex < units.Length - 1) { size /= 1024; unitIndex++; }
        return $"{size.ToString(unitIndex == 0 ? "0" : "0.0", CultureInfo.InvariantCulture)} {units[unitIndex]}";
    }

    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
}
