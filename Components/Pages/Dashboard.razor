@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using BlazorStoc.Services
@inject IStockMovementRepository Movements
@inject IExpiryNotificationService Notifications
@inject IRiskAnalysisRepository RiskAnalyses
@inject BlazorStoc.Modules.ModuleRegistry Modules
@inject TimeProvider Clock
<PageBoundary>

<PageTitle>Pagina principală · BlazorStoc</PageTitle>

<div class="page-heading">
    <div>
        <p class="eyebrow">SPAȚIU DE LUCRU</p>
        <h1>Pagina principală</h1>
        <p class="muted">Alege secțiunea în care dorești să lucrezi.</p>
    </div>
</div>

<section class="main-menu-grid" aria-label="Secțiunile aplicației">
    <AuthorizeView Policy="perm:stoc.view"><Authorized><a href="/produse"><span class="main-menu-icon">▦</span><div><h2>Produse și stocuri</h2><p>Consultă inventarul și gestionează produsele pe categorii.@if (toRegularize > 0) { <text> </text><strong class="awaiting-count" title="Produse cu stoc negativ după ieșiri peste stoc (tabul De regularizat)">@toRegularize @(toRegularize == 1 ? "produs de regularizat" : "produse de regularizat")</strong> }</p></div><span class="main-menu-arrow">→</span></a></Authorized></AuthorizeView>
    <ModuleTile ModuleId="preluare-factura" Policy="perm:preluare-factura.view" Href="/produse/preluare-factura" Icon="▤" Title="Preluare factură" Description="Preia în stoc facturile furnizorilor (PDF, XML sau ZIP)." />
    <AuthorizeView Policy="perm:iesire-multipla.view"><Authorized><a href="/iesiri/multipla"><span class="main-menu-icon">▦</span><div><h2>Ieșire multiplă</h2><p>Înregistrează ieșirile mai multor produse deodată.</p></div><span class="main-menu-arrow">→</span></a></Authorized></AuthorizeView>
    <ModuleTile ModuleId="situatie-proiect" Policy="perm:export-consum.view" Href="/consum" Icon="▤" Title="Export consum" Description="Exportă consumul de produse pe beneficiar sau proiect." />
    <ModuleTile ModuleId="inventar" Policy="perm:inventar-preluare.view" Href="/inventar/preluare" Icon="▥" Title="Preluare inventar" Description="Compară stocul numărat fizic cu stocul curent." />
    <AuthorizeView Policy="perm:categorii.view"><Authorized><a href="/categorii"><span class="main-menu-icon">▤</span><div><h2>Categorii și subcategorii</h2><p>Editează denumirile și mută subcategoriile între categorii.</p></div><span class="main-menu-arrow">→</span></a></Authorized></AuthorizeView>
    <ModuleTile ModuleId="inventar" Policy="perm:inventar.view" Href="/inventar" Icon="▥" Title="Inventar" Description="Generează situația de inventar pentru numărarea stocului." />
    <AuthorizeView Policy="perm:beneficiari.view"><Authorized><a href="/beneficiari"><span class="main-menu-icon">♧</span><div><h2>Beneficiari</h2><p>Adaugă, editează și consultă beneficiarii.</p></div><span class="main-menu-arrow">→</span></a></Authorized></AuthorizeView>
    <ModuleTile ModuleId="@BlazorStoc.Modules.Suppliers.SuppliersModule.ModuleId" Policy="perm:furnizori.view" Href="/furnizori" Icon="⌂" Title="Furnizori" Description="Adaugă, editează și consultă furnizorii și facturile lor." />
    <ModuleTile ModuleId="@BlazorStoc.Modules.Suppliers.SuppliersModule.ModuleId" Policy="perm:facturi.view" Href="/facturi" Icon="▤" Title="Facturi" Description="Consultă facturile preluate în stoc și intrările din fiecare."><Extra>@if (awaiting > 0) { <text> </text><strong class="awaiting-count" title="Intrări fără factură, în urmărire">@awaiting @(awaiting == 1 ? "intrare așteaptă" : "intrări așteaptă") factura</strong> }</Extra></ModuleTile>
    <ModuleTile ModuleId="oferte" Policy="perm:oferte.view" Href="/oferte/preluare" Icon="▤" Title="Oferte" Description="Preia devizele-ofertă Excel (.xlsx) în proiecte; șabloanele lor sunt la Oferte → Șabloane." />
    <ModuleTile ModuleId="vehicule" Policy="perm:vehicule.view" Href="/vehicule" Icon="▨" Title="Vehicule" Description="Administrează autovehiculele firmei și stocul aflat în ele." />
    <ModuleTile ModuleId="mentenanta" Policy="perm:mentenanta.view" Href="/mentenanta" Icon="⚒" Title="Mentenanță" Description="Scadențe, registrul de intervenții, contracte și harta punctelor de lucru." />
    <ModuleTile ModuleId="analize-risc" Policy="perm:analize-risc.view" Href="/analize-risc" Icon="⚠" Title="Analize de risc" Description="Analizele de risc ale punctelor de lucru, reînnoirile și expirarea lor."><Extra>@if (riskDue > 0) { <text> </text><strong class="awaiting-count" title="Analize de risc active expirate sau care expiră în curând">@riskDue @(riskDue == 1 ? "analiză expiră" : "analize expiră")</strong> }</Extra></ModuleTile>
    <ModuleTile ModuleId="notificari" Policy="perm:notificari.view" Href="/notificari" Icon="✉" Title="Notificări" Description="Notificările de expirare și de mentenanță care cer atenție." AnchorClass="@(alertCount > 0 ? "nav-alert" : null)" data-notification-nav><TitleExtra> <span class="nav-triangle" data-notification-triangle role="img" aria-label="Notificări noi" hidden="@(alertCount <= 0)">⚠</span></TitleExtra></ModuleTile>
            <AuthorizeView Policy="perm:utilizatori.view"><Authorized><a href="/setari?tab=utilizatori"><span class="main-menu-icon">♙</span><div><h2>Utilizatori</h2><p>Administrează accesul și rolurile utilizatorilor.</p></div><span class="main-menu-arrow">→</span></a></Authorized></AuthorizeView>
            <AuthorizeView Policy="perm:nomenclator.view"><Authorized><a href="/nomenclator"><span class="main-menu-icon">▦</span><div><h2>Nomenclator</h2><p>Tipurile de sisteme din proiecte și denumirile lor alternative.</p></div><span class="main-menu-arrow">→</span></a></Authorized></AuthorizeView>
            <ModuleTile ModuleId="jurnal" Policy="perm:jurnal.view" Href="/jurnal" Icon="≡" Title="Jurnal activitate" Description="Urmărește operațiunile efectuate în sistem." />
            <a href="#ajutor" id="dashboard-help" data-help-index aria-haspopup="dialog"><span class="main-menu-icon">?</span><div><h2>Ajutor</h2><p>Descrierea tuturor ferestrelor aplicației, cu căutare.</p></div><span class="main-menu-arrow">→</span></a>
</section>

</PageBoundary>

@code {
    // Entries recorded as "achizitie fara factura" that no invoice was tied to yet.
    private int awaiting;
    // Products with negative stock after exits over the stock.
    private int toRegularize;
    // Notifications that warn now; the same source as the red mark of the side menu entry.
    private int alertCount;
    // Active risk analyses that are expired or expire within the threshold of their notification template.
    private int riskDue;

    protected override async Task OnInitializedAsync()
    {
        try { awaiting = (await Movements.GetFreeEntriesAsync(new FreeEntryQuery(FreeEntryType.AwaitedInvoice))).Count; }
        catch (Exception) { awaiting = 0; }
        try { toRegularize = (await Movements.GetToRegularizeAsync()).Count; }
        catch (Exception) { toRegularize = 0; }
        try
        {
            var threshold = await Notifications.GetThresholdDaysAsync(ExpirySourceKeys.RiskAnalysisExpiry, RiskAnalysisRules.DefaultThresholdDays);
            var today = DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);
            riskDue = (await Modules.TryRunAsync("analize-risc", () => RiskAnalyses.GetAllAsync(false), Array.Empty<RiskAnalysisView>())).Count(item => RiskAnalysisRules.State(item.Analysis, today, threshold) is RiskAnalysisState.Expired or RiskAnalysisState.ExpiresSoon);
        }
        catch (Exception) { riskDue = 0; }
        try { alertCount = await Notifications.AlertCountAsync(); }
        catch (Exception) { alertCount = 0; }
    }
}
