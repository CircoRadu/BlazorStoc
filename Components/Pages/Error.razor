@page "/Error"
@using System.Diagnostics
<PageBoundary>

<PageTitle>Eroare · BlazorStoc</PageTitle>

<h1>Pagina nu a putut fi încărcată.</h1>
<p class="muted">Încearcă din nou. Dacă problema persistă, comunică administratorului codul de mai jos.</p>
<a class="refresh act-nav" href="/">Înapoi la catalog</a>

@if (ShowRequestId)
{
    <p>
        <strong>Cod de diagnostic:</strong> <code>@RequestId</code>
    </p>
}

</PageBoundary>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
