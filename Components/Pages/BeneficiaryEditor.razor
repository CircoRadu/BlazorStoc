@using BlazorStoc.Services
@inject IBeneficiaryRepository Repository
@inject IAnafService Anaf
@inject ILogger<BeneficiaryEditor> Logger
@implements IDisposable

<UnsavedChangesTracker @ref="tracker" Adding="@(Original is null)" Snapshot="CurrentSnapshot" Discard="DiscardAsync" />
<section class="product-editor" aria-labelledby="beneficiary-editor-title">
    <div class="catalog-heading"><h2 id="beneficiary-editor-title">@(Original is null ? "Adaugă beneficiar" : $"Editează beneficiarul #{Original.Id}")</h2><button type="button" class="danger" disabled="@saving" @onclick="CloseAsync">Închide</button></div>
    @if (error is not null) { <div class="error-banner" role="alert">@error</div> }
    <EditForm Model="input" OnValidSubmit="SaveAsync" FormName="beneficiary-editor">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <fieldset disabled="@saving">
            <fieldset class="beneficiary-kind" disabled="@(saving || Original is not null)">
                <legend>Tip beneficiar</legend>
                <InputRadioGroup Name="beneficiary-kind" @bind-Value="input.Kind">
                    <label class="anaf-check"><InputRadio Value="@BeneficiaryKinds.Individual" id="beneficiary-kind-pf" aria-label="Persoană fizică" /> Persoană fizică</label>
                    <label class="anaf-check"><InputRadio Value="@BeneficiaryKinds.Legal" id="beneficiary-kind-pj" aria-label="Persoană juridică" /> Persoană juridică</label>
                </InputRadioGroup>
            </fieldset>
            <div class="editor-grid">
                @if (input.IsIndividual)
                {
                    <label for="beneficiary-name">Nume complet *<InputTextLive id="beneficiary-name" @bind-Value="input.Name" maxlength="200" autocomplete="name" /><small>Numele complet identifică persoana fizică.</small><ValidationMessage For="() => input.Name" /></label>
                    <label for="beneficiary-address">Adresă *<InputTextLive id="beneficiary-address" @bind-Value="input.Address" maxlength="300" autocomplete="street-address" /><ValidationMessage For="() => input.Address" /></label>
                    <label for="beneficiary-phone">Număr de telefon *<InputTextLive id="beneficiary-phone" @bind-Value="input.Phone" maxlength="20" autocomplete="tel" inputmode="tel" /><ValidationMessage For="() => input.Phone" /></label>
                }
                else
                {
                    <div class="beneficiary-cui-row">
                        <label for="beneficiary-cui">CUI *</label>
                        <div class="beneficiary-cui-line">
                            <InputTextLive id="beneficiary-cui" @bind-Value="input.Cui" maxlength="12" autocomplete="off" />
                            <button type="button" class="refresh" disabled="@(fetching || input.Cui.Trim().Length == 0)" @onclick="FetchFromAnafAsync">@(fetching ? "Se interoghează ANAF…" : "Preia date din ANAF")</button>
                        </div>
                        <small>2–10 cifre, opțional precedate de RO. CUI-ul identifică persoana juridică.</small>
                        <ValidationMessage For="() => input.Cui" />
                    </div>
                    <div class="anaf-source-cell" role="status" aria-live="polite">
                        @if (FromAnaf) { <span class="anaf-source ok"><span aria-hidden="true">✓</span> Date preluate din ANAF</span> }
                        else { <span class="anaf-source warn"><span aria-hidden="true">⚠</span> Date introduse manual</span> }
                    </div>
                    @if (anafMessage is not null) { <div class="anaf-message @(anafMessageIsError ? "error" : "ok") beneficiary-anaf-message" role="@(anafMessageIsError ? "alert" : "status")">@anafMessage</div> }
                    @if (anafWarning is not null) { <div class="anaf-message warn beneficiary-anaf-message" role="status">@anafWarning</div> }
                    <label for="beneficiary-name">Denumire *<InputTextLive id="beneficiary-name" @bind-Value="input.Name" maxlength="200" autocomplete="organization" /><ValidationMessage For="() => input.Name" /></label>
                    <label for="beneficiary-address">Adresă *<InputTextLive id="beneficiary-address" @bind-Value="input.Address" maxlength="300" autocomplete="street-address" /><ValidationMessage For="() => input.Address" /></label>
                    <label for="beneficiary-registry">Nr. Registrul Comerțului<InputTextLive id="beneficiary-registry" @bind-Value="input.RegistryNumber" maxlength="40" autocomplete="off" /><small>De exemplu J40/1234/2020.</small><ValidationMessage For="() => input.RegistryNumber" /></label>
                    <label for="beneficiary-phone">Număr de telefon *<InputTextLive id="beneficiary-phone" @bind-Value="input.Phone" maxlength="20" autocomplete="tel" inputmode="tel" /><ValidationMessage For="() => input.Phone" /></label>
                    <label for="beneficiary-postal">Cod poștal<InputTextLive id="beneficiary-postal" @bind-Value="input.PostalCode" maxlength="10" autocomplete="postal-code" inputmode="numeric" /><small>5 sau 6 cifre.</small><ValidationMessage For="() => input.PostalCode" /></label>
                    <label for="beneficiary-caen">Cod CAEN<InputTextLive id="beneficiary-caen" @bind-Value="input.CaenCode" maxlength="4" autocomplete="off" inputmode="numeric" /><small>3 sau 4 cifre.</small><ValidationMessage For="() => input.CaenCode" /></label>
                }
                @if (Original is not null)
                {
                    <ChangeReasonField Id="beneficiary-change-reason" @bind-Value="customReason" AutoText="@AutoSummary" @bind-UseAuto="reasonAuto" Error="@reasonError" Disabled="saving" />
                }
            </div>
            <div class="editor-actions"><button class="primary" type="submit">@(saving ? "Se salvează…" : "Salvează beneficiarul")</button><button class="danger" type="button" @onclick="CloseAsync">Anulează</button></div>
        </fieldset>
    </EditForm>
</section>
@if (pendingChanges is not null && Original is not null)
{
    <SaveConfirmationDialog Title="Salvezi modificările beneficiarului?" ObjectLabel="@Original.Name" Changes="pendingChanges"
                            Reason="@input.Reason" Confirmed="ConfirmSaveAsync" Cancelled="CancelConfirmation" />
}

@code {
    [Parameter] public Beneficiary? Original { get; set; }
    [Parameter] public EventCallback<Beneficiary> Saved { get; set; }
    [Parameter] public EventCallback Closed { get; set; }
    private UnsavedChangesTracker? tracker;
    private string CurrentSnapshot() => FormSnapshot.Of(input);
    // "Părăsește editarea": the leave warning closes the form without saving (Task 1).
    private Task DiscardAsync() => Closed.InvokeAsync();
    private BeneficiaryInput input = new();
    // The reason of an edit: the summary of the changes made in the form (one on each line, following the form) or a text the user writes.
    private bool reasonAuto = true;
    private string customReason = "";
    private string AutoSummary => Original is null ? "" : ChangeReasonSummary.Build(BeneficiaryRules.Changes(Original,
        new Beneficiary(Original.Id, input.Name, input.Cui, Original.Version, input.Kind, input.Address, input.Phone, input.RegistryNumber, input.PostalCode, input.CaenCode, FromAnaf)));
    private bool saving, fetching, anafMessageIsError;
    private IReadOnlyList<AuditChange>? pendingChanges;
    private string? error, reasonError, anafMessage, anafWarning;
    // The company data as ANAF returned it (or as stored, for a record saved earlier from ANAF): the data counts as
    // "preluate din ANAF" only while every value ANAF supplied is still unchanged in the form.
    private AnafCompany? anafSnapshot;
    private readonly CancellationTokenSource lifetime = new();

    protected override Task OnInitializedAsync()
    {
        input = Original is null ? new() : BeneficiaryInput.From(Original);
        if (Original is { AnafVerified: true })
            anafSnapshot = new(Original.Cui, Original.Name, Original.Address, Original.RegistryNumber, Original.Phone, Original.PostalCode, Original.CaenCode);
        return Task.CompletedTask;
    }

    private static string Norm(string? value) => TextNormalization.ForObjectNameOrCode(value);

    private static string Digits(string? cui)
    {
        var compact = BeneficiaryRules.CompactValue(cui);
        return compact.StartsWith("RO", StringComparison.OrdinalIgnoreCase) ? compact[2..] : compact;
    }

    private bool FromAnaf => !input.IsIndividual && anafSnapshot is { } snapshot &&
        Digits(input.Cui) == Digits(snapshot.Cui) &&
        Same(snapshot.Name, input.Name) && Same(snapshot.Address, input.Address) &&
        Same(snapshot.RegistryNumber, input.RegistryNumber) && Same(BeneficiaryRules.NormalizePhone(snapshot.Phone), BeneficiaryRules.NormalizePhone(input.Phone)) &&
        Same(BeneficiaryRules.CompactValue(snapshot.PostalCode), BeneficiaryRules.CompactValue(input.PostalCode)) &&
        Same(BeneficiaryRules.CompactValue(snapshot.CaenCode), BeneficiaryRules.CompactValue(input.CaenCode));

    // Values ANAF did not supply (empty) may be typed by hand without turning the data into "manual".
    private static bool Same(string snapshotValue, string current) =>
        snapshotValue.Length == 0 || string.Equals(Norm(snapshotValue), Norm(current), StringComparison.OrdinalIgnoreCase);

    private async Task FetchFromAnafAsync()
    {
        if (fetching || saving) return;
        fetching = true;
        anafMessage = anafWarning = null;
        try
        {
            var result = await Anaf.LookupCompanyAsync(input.Cui, lifetime.Token);
            if (result.Company is { } company)
            {
                input.Name = Norm(company.Name);
                if (company.Address.Length > 0) input.Address = Norm(company.Address);
                if (company.RegistryNumber.Length > 0) input.RegistryNumber = Norm(company.RegistryNumber).ToUpperInvariant();
                if (company.Phone.Length > 0) input.Phone = BeneficiaryRules.NormalizePhone(company.Phone);
                if (company.PostalCode.Length > 0) input.PostalCode = BeneficiaryRules.CompactValue(company.PostalCode);
                if (company.CaenCode.Length > 0) input.CaenCode = BeneficiaryRules.CompactValue(company.CaenCode);
                anafSnapshot = company with { Cui = input.Cui };
                anafMessageIsError = false;
                anafMessage = "Datele au fost preluate din ANAF. Completează manual câmpurile obligatorii pe care ANAF nu le-a returnat (de exemplu telefonul).";
                anafWarning = result.Warning;
            }
            else
            {
                anafMessageIsError = true;
                anafMessage = result.Error ?? "Datele nu au putut fi preluate din ANAF.";
            }
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (AccessDeniedException exception) { anafMessageIsError = true; anafMessage = exception.Message; }
        catch (Exception exception)
        {
            Logger.LogError("ANAF lookup for a beneficiary failed ({ErrorType}).", exception.GetType().Name);
            anafMessageIsError = true;
            anafMessage = "Datele nu au putut fi preluate din ANAF. Le poți introduce manual.";
        }
        finally { fetching = false; }
    }

    private Task CloseAsync() => saving ? Task.CompletedTask : tracker is null ? Closed.InvokeAsync() : tracker.RunAfterConfirmAsync(() => Closed.InvokeAsync());

    private async Task SaveAsync()
    {
        if (saving) return;
        if (Original is not null) input.Reason = ChangeReasonSummary.Chosen(reasonAuto, AutoSummary, customReason);
        reasonError = Original is null ? null : ChangeReasonSummary.ValidationError(reasonAuto, AutoSummary, customReason);
        if (reasonError is not null) return;
        input.AnafVerified = FromAnaf;
        if (Original is not null)
        {
            // Saving over existing data needs an explicit confirmation of the changed fields.
            error = null;
            try
            {
                var value = input.Validated(true);
                var preview = new Beneficiary(Original.Id, value.Name, value.Cui, Original.Version, value.Kind, value.Address, value.Phone,
                    value.RegistryNumber, value.PostalCode, value.CaenCode, value.AnafVerified);
                pendingChanges = SaveSummary.Changed(BeneficiaryRules.Changes(Original, preview).ToArray());
            }
            catch (BeneficiaryOperationException exception) { error = exception.Message; }
            return;
        }
        await PersistAsync();
    }

    private Task ConfirmSaveAsync() { pendingChanges = null; return PersistAsync(); }
    private Task CancelConfirmation() { pendingChanges = null; return Task.CompletedTask; }

    private async Task PersistAsync()
    {
        if (saving) return;
        saving = true;
        error = null;
        Beneficiary? saved = null;
        try
        {
            saved = Original is null
                ? await Repository.CreateAsync(input, lifetime.Token)
                : await Repository.UpdateAsync(Original, input, lifetime.Token);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (BeneficiaryOperationException exception) { error = exception.Message; }
        catch (AccessDeniedException exception) { error = exception.Message; }
        catch (Exception exception)
        {
            Logger.LogError("Beneficiary saving failed ({ErrorType}).", exception.GetType().Name);
            error = "Beneficiarul nu a putut fi salvat. Datele formularului au fost păstrate; actualizează lista înainte să reîncerci.";
        }
        finally { saving = false; }
        if (saved is not null) { tracker?.Rebase(); await Saved.InvokeAsync(saved); }
    }

    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
}
