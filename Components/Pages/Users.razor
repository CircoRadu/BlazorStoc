@page "/utilizatori"
@attribute [Authorize]
@inject NavigationManager Navigation
<PageBoundary></PageBoundary>
@* The list of accounts moved into Settings -> Utilizatori; the old address keeps working (also with ?edit=<id>). *@

@code {
    [SupplyParameterFromQuery(Name = "edit")] public int? EditId { get; set; }

    protected override void OnInitialized() => Navigation.NavigateTo(EditId is > 0 ? UserNavigation.EditUrl(EditId.Value) : UserNavigation.ListUrl, replace: true);
}
