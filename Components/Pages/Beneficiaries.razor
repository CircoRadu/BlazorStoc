@page "/beneficiari"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using BlazorStoc.Services
@inject UnsavedChanges Guard
@inject ExitFormDraft ExitDraft
@inject IBeneficiaryRepository Repository
@inject NavigationManager Navigation
@inject ILogger<Beneficiaries> Logger
@implements IDisposable

<PageTitle>Beneficiari · BlazorStoc</PageTitle>
<UnsavedChangesHost />
<div class="page-heading"><div><p class="eyebrow">PARTENERI STOC</p><h1>Beneficiari</h1><p class="muted">Gestionează persoanele fizice și juridice către care vor fi operate mișcările de stoc.</p></div><div class="heading-actions"><button class="primary" disabled="@(loading || editing || deleting is not null)" @onclick="() => OpenEditorAsync(null)">+ Adaugă beneficiar</button></div></div>
@if (error is not null) { <div class="error-banner" role="alert">@error <button class="primary" @onclick="RetryLoadAsync">Reîncearcă</button></div> }
@if (notice is not null) { <div class="success-banner" role="status">@notice</div> }
@if (editing) { <BeneficiaryEditor @key="editorKey" Original="editingBeneficiary" Saved="BeneficiarySavedAsync" Closed="CloseEditorAsync" /> }

<section class="metrics users-metrics" aria-label="Rezumat beneficiari">
    <article><span>Total beneficiari</span><strong>@(loaded ? beneficiaries.Count.ToString() : "—")</strong><small>În registrul disponibil</small><i>♧</i></article>
    <article><span>Persoane juridice</span><strong>@(loaded ? beneficiaries.Count(beneficiary => !beneficiary.IsIndividual).ToString() : "—")</strong><small>Identificate prin CUI</small><i>◆</i></article>
    <article><span>Persoane fizice</span><strong>@(loaded ? beneficiaries.Count(beneficiary => beneficiary.IsIndividual).ToString() : "—")</strong><small>Identificate prin nume complet</small><i>◇</i></article>
    <article><span>Actualizare</span><strong>15s</strong><small>Sincronizare automată</small><i>◷</i></article>
</section>

<section class="catalog">
    <div class="catalog-heading"><h2>Registru beneficiari <span>@Filtered.Count</span></h2><small>CUI-ul (persoană juridică) sau numele complet (persoană fizică) identifică în mod unic fiecare beneficiar</small></div>
    <div class="filters"><label class="search-box"><span>⌕</span><input aria-label="Caută beneficiari" placeholder="Caută după nume, CUI, adresă sau telefon…" @bind="query" @bind:event="oninput" /></label></div>
    @if (loading) { <div class="empty-state" role="status"><div class="spinner"></div><h3>Se încarcă beneficiarii</h3></div> }
    else if (Filtered.Count == 0) { <div class="empty-state"><span class="empty-icon">♧</span><h3>Nu există beneficiari pentru căutarea curentă</h3><p>Adaugă primul beneficiar sau șterge textul din câmpul de căutare.</p></div> }
    else
    {
        <div class="table-scroll"><table><thead><tr><th>BENEFICIAR</th><th>TIP / CUI</th><th>ADRESĂ</th><th>TELEFON</th><th><span class="sr-only">Acțiuni</span></th></tr></thead><tbody>
        @foreach (var beneficiary in Filtered)
        {
            <tr @key="beneficiary.Id"><td><a class="category-table-link" href="@($"/beneficiari/{beneficiary.Id}")"><strong>@beneficiary.Name</strong></a></td><td><span class="role-badge limited">@beneficiary.Identifier</span></td><td>@(beneficiary.Address.Length == 0 ? "—" : beneficiary.Address)</td><td>@(beneficiary.Phone.Length == 0 ? "—" : beneficiary.Phone)</td><td><div class="row-buttons"><button class="row-action edit" aria-label="Editează @beneficiary.Name" @onclick="() => OpenEditorAsync(beneficiary)">✎</button><button class="row-action delete" aria-label="Șterge @beneficiary.Name" @onclick="() => RequestDeleteAsync(beneficiary)">×</button></div></td></tr>
        }
        </tbody></table></div>
    }
</section>

@if (deleting is not null)
{
    <DeleteConfirmationDialog @key="deleting.Id" Title="Ștergi beneficiarul?" Subject="Beneficiarul"
                              ObjectLabel="@($"{deleting.Name} · {deleting.Identifier}")"
                              Description="Beneficiarii care au proiecte sau mișcări de stoc asociate nu pot fi șterși."
                              Busy="@deleteBusy" Error="@deleteError" Confirmed="DeleteBeneficiaryAsync"
                              Cancelled="CancelDeleteAsync" />
}

@code {
    [SupplyParameterFromQuery(Name = "edit")] public int? EditId { get; set; }
    // /beneficiari?adauga=1&inapoi=<page>: opened from a form (the exit form of a product) that continues afterwards.
    [SupplyParameterFromQuery(Name = "adauga")] public string? AddFlag { get; set; }
    [SupplyParameterFromQuery(Name = ReturnNavigation.QueryName)] public string? ReturnParameter { get; set; }
    private string? returnTo;
    private bool addFlagHandled;
    private IReadOnlyList<Beneficiary> beneficiaries = Array.Empty<Beneficiary>();
    private Beneficiary? editingBeneficiary, deleting;
    private string query = "";
    private bool loading, syncing, loaded, editing, deleteBusy;
    private string? error, notice, deleteError;
    private Guid editorKey;
    private readonly CancellationTokenSource lifetime = new();
    private List<Beneficiary> Filtered => BeneficiarySearch.Filter(beneficiaries, query).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(true);
        _ = SynchronizePeriodicallyAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!addFlagHandled && AddFlag == "1" && loaded)
        {
            addFlagHandled = true;
            returnTo = ReturnNavigation.Safe(ReturnParameter);
            await OpenEditorAsync(null);
            return;
        }
        if (EditId is > 0 && loaded && (!editing || editingBeneficiary?.Id != EditId.Value))
        {
            var requested = beneficiaries.FirstOrDefault(beneficiary => beneficiary.Id == EditId.Value);
            if (requested is not null) await OpenEditorAsync(requested);
            else error = "Beneficiarul solicitat pentru editare nu mai există.";
        }
    }

    private Task RetryLoadAsync() => LoadAsync(true);
    private async Task LoadAsync(bool showLoading)
    {
        if (syncing) return;
        syncing = true;
        if (showLoading) loading = true;
        error = null;
        try { beneficiaries = await Repository.GetBeneficiariesAsync(lifetime.Token); loaded = true; }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (AccessDeniedException exception) { error = exception.Message; }
        catch (Exception exception) { Logger.LogError("Beneficiary loading failed ({ErrorType}).", exception.GetType().Name); error = "Beneficiarii nu au putut fi încărcați."; }
        finally { loading = false; syncing = false; }
    }

    private async Task SynchronizePeriodicallyAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(lifetime.Token))
                await InvokeAsync(async () => { if (!editing && deleting is null) { await LoadAsync(false); StateHasChanged(); } });
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }

    private Task OpenEditorAsync(Beneficiary? beneficiary) { editingBeneficiary = beneficiary; editorKey = Guid.NewGuid(); editing = true; notice = null; return Task.CompletedTask; }
    private Task CloseEditorAsync()
    {
        editing = false; editingBeneficiary = null;
        if (EditId is not null) { EditId = null; if (!Guard.IsDiscarding) Navigation.NavigateTo("/beneficiari"); }
        else if (returnTo is { } back && !Guard.IsDiscarding) { returnTo = null; Navigation.NavigateTo(back); }
        return Task.CompletedTask;
    }
    private async Task BeneficiarySavedAsync(Beneficiary beneficiary)
    {
        var created = editingBeneficiary is null;
        beneficiaries = beneficiaries.Where(existing => existing.Id != beneficiary.Id).Append(beneficiary).OrderBy(existing => existing.Name).ToArray();
        // Opened from a form: hand the new beneficiary to it (it selects it) before going back.
        if (created && returnTo is not null) ExitDraft.SetNewBeneficiary(beneficiary.Id);
        await CloseEditorAsync();
        notice = created ? "Beneficiarul a fost adăugat." : "Beneficiarul a fost actualizat.";
    }
    private Task RequestDeleteAsync(Beneficiary beneficiary) { deleting = beneficiary; deleteError = null; notice = null; return Task.CompletedTask; }
    private Task CancelDeleteAsync() { deleting = null; deleteError = null; return Task.CompletedTask; }
    private async Task DeleteBeneficiaryAsync(string reason)
    {
        if (deleteBusy || deleting is null) return;
        deleteBusy = true;
        deleteError = null;
        try { await Repository.DeleteAsync(deleting, reason, lifetime.Token); beneficiaries = beneficiaries.Where(beneficiary => beneficiary.Id != deleting.Id).ToArray(); deleting = null; notice = "Beneficiarul a fost mutat în arhivă."; }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (BeneficiaryOperationException exception) { deleteError = exception.Message; }
        catch (AccessDeniedException exception) { deleteError = exception.Message; }
        catch (Exception exception) { Logger.LogError("Beneficiary deletion failed ({ErrorType}).", exception.GetType().Name); deleteError = "Beneficiarul nu a putut fi șters. Actualizează lista și reîncearcă."; }
        finally { deleteBusy = false; }
    }

    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
}
