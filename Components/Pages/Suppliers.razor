@page "/furnizori"
@attribute [Authorize(Policy = "perm:furnizori.view")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using BlazorStoc.Services
@inject UnsavedChanges Guard
@inject ISupplierRepository Repository
@inject IAccessControl Access
@inject NavigationManager Navigation
@inject ILogger<Suppliers> Logger
@inject IServiceProvider Services
@implements IDisposable
<PageBoundary>

<PageTitle>Furnizori · BlazorStoc</PageTitle>
<UnsavedChangesHost />
<div class="page-heading"><div><p class="eyebrow">PARTENERI STOC</p><h1>Furnizori</h1><p class="muted">Registrul furnizorilor ale căror facturi se preiau în stoc. Un furnizor se identifică prin CUI (sau codul de TVA al unui stat UE) și nu poate apărea de două ori.</p></div><div class="heading-actions">@if (permAdd) { <button class="primary" disabled="@(loading || editing || deleting is not null)" @onclick="() => OpenEditorAsync(null)">+ Adaugă furnizor</button> }</div></div>
@if (error is not null) { <div class="error-banner" role="alert">@error <button class="primary" @onclick="RetryLoadAsync">Reîncearcă</button></div> }
@if (notice is not null) { <div class="success-banner" role="status">@notice</div> }
@if (editing) { <SupplierEditor @key="editorKey" Original="editingSupplier" Saved="SupplierSavedAsync" Closed="CloseEditorAsync" /> }

<section class="metrics users-metrics" aria-label="Rezumat furnizori">
    <article><span>Total furnizori</span><strong>@(loaded ? suppliers.Count.ToString() : "—")</strong><small>În registrul disponibil</small><i>⌂</i></article>
    <article><span>Date din ANAF</span><strong>@(loaded ? suppliers.Count(supplier => SupplierSources.IsVerified(supplier.Source)).ToString() : "—")</strong><small>Preluate și nemodificate</small><i>✓</i></article>
    <article><span>De verificat</span><strong>@(loaded ? suppliers.Count(supplier => SupplierSources.NeedsCheck(supplier.Source)).ToString() : "—")</strong><small>Introduși manual sau editați după ANAF</small><i>⚠</i></article>
    <article><span>Alte state UE</span><strong>@(loaded ? suppliers.Count(supplier => supplier.IsExternal).ToString() : "—")</strong><small>Identificați prin cod de TVA</small><i>◇</i></article>
</section>

@if (recognition is { Total: > 0 } summary)
{
    <details class="catalog" id="supplier-recognition-summary">
        <summary><strong>Recunoașterea furnizorului la preluarea facturilor</strong> <span class="muted">· @summary.Total recunoașteri, @summary.Corrected corectate de utilizator</span></summary>
        <div class="catalog-body">
        <p><a href="/api/furnizori/recunoastere.csv" download>Exportă jurnalul (CSV)</a></p>
        @if (summary.ByMethod.Any(Suspect)) { <p class="invoice-warning" role="status">⚠ O metodă cu încredere „mare” depășește 5% corecții: pragurile recunoașterii merită revăzute.</p> }
        <div class="table-wrap"><table>
            <thead><tr><th>Metodă</th><th>Încredere</th><th>Facturi</th><th>Corectate</th><th>Rata</th><th>Șablon schimbat</th></tr></thead>
            <tbody>
                @foreach (var row in summary.ByMethod) { <tr><td>@SupplierRecognitionText.MethodName(row.Method)</td><td>@SupplierRecognitionText.ConfidenceName(row.Confidence)</td><td>@row.Total</td><td>@row.Corrected</td><td>@(Rate(row))%@(Suspect(row) ? " ⚠" : "")</td><td>@row.TemplateChanged</td></tr> }
            </tbody>
        </table></div>
        @if (Unresolved(summary).Count > 0)
        {
            <p class="muted">Ultimele corecții nerezolvate (citit din factură → furnizorul ales):</p>
            @if (aliasError is not null) { <div class="validation-message" role="alert">@aliasError</div> }
            <ul>
                @foreach (var fix in Unresolved(summary)) { <li>@StockMovementRules.DisplayDate(DateOnly.FromDateTime(fix.Utc)) · factura @fix.InvoiceNumber · „@(fix.ReadName.Length > 0 ? fix.ReadName : "—")” (CUI @(fix.ReadCui.Length > 0 ? fix.ReadCui : "—")) → <strong>@(fix.ChosenName.Length > 0 ? fix.ChosenName : "—")</strong>@(fix.RecognizedName.Length > 0 ? $" (propus: {fix.RecognizedName})" : " (nimic propus)") <button type="button" class="refresh act-confirm" disabled="@(aliasBusy || fix.ReadName.Trim().Length == 0)" @onclick="() => RememberAliasAsync(fix)">Ține minte ca denumire alternativă</button></li> }
            </ul>
        }
        </div>
    </details>
}

<section class="catalog">
    <div class="catalog-heading"><h2>Registru furnizori <span>@Filtered.Count</span></h2><small>Un furnizor se șterge numai de un administrator și numai dacă nu are facturi, intrări de stoc sau șabloane legate</small></div>
    <div class="filters">
        <label class="search-box"><span>⌕</span><input aria-label="Caută furnizori" placeholder="Caută după denumire, CUI, adresă sau telefon…" @bind="query" @bind:event="oninput" /></label>
        <ToggleSwitch @bind-Value="onlyToCheck" OnText="Doar cei de verificat" OffText="Toți furnizorii" AriaLabel="Arată doar furnizorii de verificat" />
    </div>
    @if (loading) { <div class="empty-state" role="status"><div class="spinner"></div><h3>Se încarcă furnizorii</h3></div> }
    else if (Filtered.Count == 0) { <div class="empty-state"><span class="empty-icon">⌂</span><h3>Nu există furnizori pentru căutarea curentă</h3><p>Adaugă primul furnizor sau schimbă căutarea și filtrul.</p></div> }
    else
    {
        <div class="table-scroll"><table><thead><tr><th>FURNIZOR</th><th>CUI / COD TVA</th><th>SURSA DATELOR</th><th>ADRESĂ</th><th>TELEFON</th><th>FACTURI</th><th><span class="sr-only">Acțiuni</span></th></tr></thead><tbody>
        @foreach (var supplier in Filtered)
        {
            <tr @key="supplier.Id">
                <td><a class="category-table-link" href="@SupplierNavigation.SupplierUrl(supplier.Id)"><strong>@supplier.Name</strong></a></td>
                <td><span class="role-badge limited">@supplier.Identifier</span></td>
                <td><span class="anaf-source @SupplierSources.CssClass(supplier.Source)"><span aria-hidden="true">@SupplierSources.Icon(supplier.Source)</span> @SupplierSources.Label(supplier.Source)</span></td>
                <td>@(supplier.Address.Length == 0 ? "—" : supplier.Address)</td>
                <td>@(supplier.Phone.Length == 0 ? "—" : supplier.Phone)</td>
                <td>@(supplier.InvoiceCount == 0 ? "—" : $"{supplier.InvoiceCount} ({supplier.MovementCount} {(supplier.MovementCount == 1 ? "intrare" : "intrări")})")</td>
                <td><div class="row-buttons">
                    @if (permEdit) { <button class="row-icon edit" aria-label="Editează @supplier.Name" title="Editează" disabled="@(editing || deleting is not null)" @onclick="() => OpenEditorAsync(supplier)"></button> }
                    @if (permDelete) { <button class="row-icon delete" aria-label="Șterge @supplier.Name" title="@DeleteHint(supplier)" disabled="@(!canDelete || supplier.InUse)" @onclick="() => RequestDeleteAsync(supplier)"></button> }
                </div></td>
            </tr>
        }
        </tbody></table></div>
    }
</section>

@if (deleting is not null)
{
    <DeleteConfirmationDialog @key="deleting.Id" Title="Ștergi furnizorul?" Subject="Furnizorul"
                              ObjectLabel="@($"{deleting.Name} · {deleting.Identifier}")"
                              Description="Furnizorii care au facturi, intrări de stoc sau șabloane de factură legate nu pot fi șterși."
                              Busy="@deleteBusy" Error="@deleteError" Confirmed="DeleteSupplierAsync"
                              Cancelled="CancelDeleteAsync" />
}

</PageBoundary>

@code {
    private bool permAdd, permEdit, permDelete;
    private async Task LoadPermissionsAsync()
    {
        permAdd = await Access.HasAsync("furnizori.add");
        permEdit = await Access.HasAsync("furnizori.edit");
        permDelete = await Access.HasAsync("furnizori.delete");
    }
    [SupplyParameterFromQuery(Name = "edit")] public int? EditId { get; set; }
    [SupplyParameterFromQuery(Name = "adauga")] public string? AddFlag { get; set; }
    private bool addFlagHandled;
    private IReadOnlyList<Supplier> suppliers = Array.Empty<Supplier>();
    private Supplier? editingSupplier, deleting;
    private string query = "";
    private bool onlyToCheck;
    private bool loading, syncing, loaded, editing, deleteBusy, canDelete;
    private string? error, notice, deleteError;
    private Guid editorKey;
    private SupplierRecognitionSummary? recognition;

    private static int Rate(SupplierRecognitionCount row) => row.Total == 0 ? 0 : (int)Math.Round(100.0 * row.Corrected / row.Total);
    // A "high" confidence that is corrected too often (at least 20 invoices, over 5%): the thresholds of the recognition need another look.
    private static bool Suspect(SupplierRecognitionCount row) => row.Confidence == "high" && row.Total >= 20 && row.Corrected * 100 > row.Total * 5;

    private string? aliasError;
    private bool aliasBusy;

    // Corrections whose read name is not yet a name or alias of the supplier the user chose (the others are resolved), at most 10.
    private List<SupplierRecognitionCorrection> Unresolved(SupplierRecognitionSummary summary) =>
        [.. summary.Recent.Where(fix => fix.ChosenSupplierId is { } id && fix.ReadName.Trim().Length > 0
            && suppliers.FirstOrDefault(item => item.Id == id) is { } chosen && SupplierRules.AliasProblem(fix.ReadName, chosen, suppliers) is null).Take(10)];

    private async Task RememberAliasAsync(SupplierRecognitionCorrection fix)
    {
        if (aliasBusy || suppliers.FirstOrDefault(item => item.Id == fix.ChosenSupplierId) is not { } chosen) return;
        aliasBusy = true; aliasError = null;
        try
        {
            await Repository.AddAliasAsync(chosen, fix.ReadName, lifetime.Token);
            notice = $"Denumirea „{fix.ReadName}” a fost reținută pentru {chosen.Name}.";
            await LoadAsync(false);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) when (exception is SupplierOperationException or AccessDeniedException) { aliasError = exception.Message; }
        finally { aliasBusy = false; }
    }

    private async Task LoadRecognitionAsync()
    {
        if (Services.GetService<ISupplierRecognitionLog>() is not { } log) return;
        try { recognition = await log.SummaryAsync(lifetime.Token); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) when (exception is not OperationCanceledException) { Logger.LogWarning("Supplier recognition summary failed ({ErrorType}).", exception.GetType().Name); }
    }
    private readonly CancellationTokenSource lifetime = new();
    private List<Supplier> Filtered => SupplierSearch.Filter(suppliers, query, onlyToCheck).ToList();

    // Only an administrator deletes; the button of a supplier that is in use says why it cannot be used.
    private string DeleteHint(Supplier supplier) =>
        !canDelete ? "Doar administratorul poate șterge furnizori"
        : supplier.InUse ? SupplierRules.DeleteBlockedMessage(supplier.InvoiceCount, supplier.MovementCount, supplier.TemplateCount)
        : "Șterge";

    protected override async Task OnInitializedAsync()
    {
        await LoadPermissionsAsync();
        try { canDelete = await Access.IsAdministratorAsync(lifetime.Token); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        await LoadAsync(true);
        await LoadRecognitionAsync();
        SynchronizePeriodicallyAsync().FireAndForget(Logger, "periodic synchronization");
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!addFlagHandled && AddFlag == "1" && loaded)
        {
            addFlagHandled = true;
            await OpenEditorAsync(null);
            return;
        }
        if (EditId is > 0 && loaded && (!editing || editingSupplier?.Id != EditId.Value))
        {
            var requested = suppliers.FirstOrDefault(supplier => supplier.Id == EditId.Value);
            if (requested is not null) await OpenEditorAsync(requested);
            else error = "Furnizorul solicitat pentru editare nu mai există.";
        }
    }

    private Task RetryLoadAsync() => LoadAsync(true);
    private async Task LoadAsync(bool showLoading)
    {
        if (syncing) return;
        syncing = true;
        if (showLoading) loading = true;
        error = null;
        try { suppliers = await Repository.GetSuppliersAsync(lifetime.Token); loaded = true; }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (AccessDeniedException exception) { error = exception.Message; }
        catch (Exception exception) { Logger.LogError("Supplier loading failed ({ErrorType}).", exception.GetType().Name); error = "Furnizorii nu au putut fi încărcați."; }
        finally { loading = false; syncing = false; }
    }

    private async Task SynchronizePeriodicallyAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(lifetime.Token))
                await InvokeAsync(async () => { if (!editing && deleting is null) { await LoadAsync(false); StateHasChanged(); } });
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }

    private Task OpenEditorAsync(Supplier? supplier) { editingSupplier = supplier; editorKey = Guid.NewGuid(); editing = true; notice = null; return Task.CompletedTask; }
    private Task CloseEditorAsync()
    {
        editing = false; editingSupplier = null;
        if (EditId is not null) { EditId = null; if (!Guard.IsDiscarding) Navigation.NavigateTo("/furnizori"); }
        return Task.CompletedTask;
    }
    private async Task SupplierSavedAsync(Supplier supplier)
    {
        var created = editingSupplier is null;
        await CloseEditorAsync();
        await LoadAsync(false);   // the counts (invoices, entries) come with the list
        notice = created ? "Furnizorul a fost adăugat." : "Furnizorul a fost actualizat.";
    }
    private Task RequestDeleteAsync(Supplier supplier) { deleting = supplier; deleteError = null; notice = null; return Task.CompletedTask; }
    private Task CancelDeleteAsync() { deleting = null; deleteError = null; return Task.CompletedTask; }
    private async Task DeleteSupplierAsync(string reason)
    {
        if (deleteBusy || deleting is null) return;
        deleteBusy = true;
        deleteError = null;
        try { await Repository.DeleteAsync(deleting, reason, lifetime.Token); suppliers = suppliers.Where(supplier => supplier.Id != deleting.Id).ToArray(); deleting = null; notice = "Furnizorul a fost mutat în arhivă."; }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (SupplierOperationException exception) { deleteError = exception.Message; }
        catch (AccessDeniedException exception) { deleteError = exception.Message; }
        catch (Exception exception) { Logger.LogError("Supplier deletion failed ({ErrorType}).", exception.GetType().Name); deleteError = "Furnizorul nu a putut fi șters. Actualizează lista și reîncearcă."; }
        finally { deleteBusy = false; }
    }

    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
}
