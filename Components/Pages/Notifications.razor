@page "/notificari"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using BlazorStoc.Services
@inject IExpiryNotificationService Service
@inject ILogger<Notifications> Logger
@inject IJSRuntime JS
@implements IDisposable
<PageBoundary>

<PageTitle>Notificări · BlazorStoc</PageTitle>
<div class="page-heading">
    <div><p class="eyebrow">AVERTIZĂRI</p><h1>Notificări</h1><p class="muted">Expirări apropiate sau depășite, după șabloanele definite de administrator. O notificare rămâne în listă până este rezolvată. O notificare preluată nu mai avertizează; dacă o amâni, avertizează din nou la sfârșitul perioadei.</p></div>
    <div class="heading-actions"><button class="refresh act-reload" type="button" disabled="@loading" @onclick="() => LoadAsync(true)">↻ Actualizează</button></div>
</div>
@if (error is not null) { <div class="error-banner" role="alert">@error</div> }
@if (notice is not null) { <div class="success-banner" role="status">@notice</div> }

<div class="settings-tabs" role="tablist" aria-label="Liste de notificări">
    <button type="button" role="tab" id="tab-active" class="settings-tab @(showResolved ? "" : "active")" aria-selected="@(showResolved ? "false" : "true")" aria-controls="panel-notifications" @onclick="() => showResolved = false">Active <span class="count-badge">@views.Count</span></button>
    <button type="button" role="tab" id="tab-resolved" class="settings-tab @(showResolved ? "active" : "")" aria-selected="@(showResolved ? "true" : "false")" aria-controls="panel-notifications" @onclick="() => showResolved = true">Rezolvate <span class="count-badge">@resolved.Count</span></button>
</div>

<div id="panel-notifications" role="tabpanel" aria-labelledby="@(showResolved ? "tab-resolved" : "tab-active")">
@if (loading && !loaded) { <section class="catalog"><div class="empty-state" role="status"><div class="spinner"></div><h3>Se încarcă notificările</h3></div></section> }
else if (loaded && !showResolved)
{
    @if (views.Count == 0)
    {
        <section class="catalog"><div class="empty-state"><span class="empty-icon">✉</span><h3>Nu există notificări</h3><p>Notificările apar când o expirare intră în perioada stabilită într-un șablon (Setări → Notificări → Șabloane notificări) și rămân aici până sunt rezolvate.</p></div></section>
    }
    else
    {
        <section class="catalog notification-section">
            <div class="catalog-heading"><h2>Scadență depășită <span>@Overdue.Count</span></h2><small>@AlertCount necesită atenție</small></div>
            @if (Overdue.Count == 0) { <p class="muted notification-none">Nicio notificare cu scadența depășită.</p> }
            else { @NotificationTable(Overdue, true) }
        </section>
        <section class="catalog notification-section">
            <div class="catalog-heading"><h2>Următoarele scadențe <span>@Upcoming.Count</span></h2></div>
            @if (Upcoming.Count == 0) { <p class="muted notification-none">Nicio altă notificare activă.</p> }
            else { @NotificationTable(Upcoming, false) }
        </section>
    }
}
else if (loaded)
{
    <section class="catalog">
        <div class="catalog-heading"><h2>Notificări rezolvate <span>@resolved.Count</span></h2><small>cele mai recente @ExpiryNotificationService.MaxResolvedListed</small></div>
        @if (resolved.Count == 0) { <div class="empty-state"><span class="empty-icon">✓</span><h3>Nu există notificări rezolvate</h3><p>O notificare devine rezolvată când o marchezi tu sau când data obiectului se schimbă ori obiectul dispare.</p></div> }
        else
        {
            <div class="table-scroll"><table class="notification-table"><thead><tr><th>TITLU</th><th>OBIECT</th><th>SCADENȚĂ</th><th>REZOLVATĂ LA</th><th>REZOLVATĂ DE</th><th>MOTIV</th></tr></thead><tbody>
            @foreach (var item in resolved)
            {
                <tr @key="item.Notification.Id" class="notification-row" tabindex="0" role="button" aria-label="Deschide notificarea rezolvată @item.Subject"
                    @onclick="() => OpenResolved(item)" @onkeydown="args => ResolvedKeyDown(args, item)">
                    <td>@item.Subject</td>
                    <td>@item.ObjectLabel</td>
                    <td>@StockMovementRules.DisplayDate(item.Notification.ExpiryDate)</td>
                    <td>@ResolvedAt(item.Notification)</td>
                    <td>@(item.Notification.ResolvedAutomatically ? "sistem (automat)" : item.Notification.ResolvedBy)</td>
                    <td class="notification-reason">@item.Notification.ResolvedReason</td>
                </tr>
            }
            </tbody></table></div>
        }
    </section>
}
</div>

@if (selected is not null)
{
    <div class="delete-overlay" @onkeydown="DialogKeyDown">
        <section class="delete-dialog notification-dialog" role="dialog" aria-modal="true" tabindex="-1" aria-labelledby="notification-title">
            <h2 id="notification-title">@selected.Subject</h2>
            <p class="delete-object"><strong>@selected.Category · @selected.EventName · @selected.ObjectLabel</strong></p>
            <p class="notification-body">@selected.Body</p>
            @if (selected.IsOverdue) { <p class="notification-overdue-note">Termenul a fost depășit cu @(-selected.DaysLeft) @(-selected.DaysLeft == 1 ? "zi" : "zile").</p> }
            <p class="muted small">@(selected.IsOverdue ? "Scadență" : "Expiră la") @StockMovementRules.DisplayDate(selected.Notification.ExpiryDate)@(selected.IsOverdue ? "" : $" · {selected.DaysLeft} zile rămase") · @StateDetail(selected)</p>
            @if (dialogError is not null) { <div class="error-banner" role="alert">@dialogError</div> }
            @if (selected.IsAlert)
            {
                <div class="notification-snooze">
                    @if (selected.MaxSnoozeDays >= 1)
                    {
                        <label for="snooze-days">Amintește-mi peste (zile, cel mult @selected.MaxSnoozeDays)<input id="snooze-days" type="number" min="1" max="@selected.MaxSnoozeDays" step="1" @bind="snoozeDays" disabled="@busy" /></label>
                        <button type="button" class="refresh act-edit" disabled="@busy" @onclick="SnoozeAsync">Amână</button>
                    }
                    else { <small class="muted">Amânarea nu mai este posibilă: expirarea este prea aproape (limita este numărul de zile rămase minus 2).</small> }
                </div>
            }
            @if (confirmingResolve)
            {
                <div class="notification-resolve-confirm" role="alert">
                    <p>Marchezi notificarea ca rezolvată? Trece în lista „Rezolvate” și nu mai avertizează.</p>
                    <div class="editor-actions">
                        <button type="button" class="primary" disabled="@busy" @onclick="ResolveAsync">@(busy ? "Se salvează…" : "Da, rezolvată")</button>
                        <button type="button" class="refresh act-close" disabled="@busy" @onclick="() => confirmingResolve = false">Renunț</button>
                    </div>
                </div>
            }
            else
            {
                <div class="editor-actions">
                    @if (selected.IsAlert) { <button type="button" class="primary" disabled="@busy" @onclick="AcknowledgeAsync">@(busy ? "Se salvează…" : "Preiau notificarea")</button> }
                    <button type="button" class="refresh act-confirm" disabled="@busy" @onclick="() => confirmingResolve = true">Marchează ca rezolvată</button>
                    @if (selected.Url is { Length: > 0 } url) { <a class="refresh act-nav" href="@url">Deschide obiectul</a> }
                    <button type="button" class="danger" disabled="@busy" @onclick="Close">Închide</button>
                </div>
            }
        </section>
    </div>
}

@if (selectedResolved is not null)
{
    <div class="delete-overlay" @onkeydown="DialogKeyDown">
        <section class="delete-dialog notification-dialog" role="dialog" aria-modal="true" tabindex="-1" aria-labelledby="resolved-title">
            <h2 id="resolved-title">@selectedResolved.Subject</h2>
            <p class="delete-object"><strong>@selectedResolved.SourceText · @selectedResolved.ObjectLabel</strong></p>
            <p class="notification-body">@selectedResolved.Body</p>
            <p class="muted small">Scadență @StockMovementRules.DisplayDate(selectedResolved.Notification.ExpiryDate) · rezolvată la @ResolvedAt(selectedResolved.Notification) de @(selectedResolved.Notification.ResolvedAutomatically ? "sistem (automat)" : selectedResolved.Notification.ResolvedBy)</p>
            <p class="notification-reason-box"><strong>Motiv:</strong> @selectedResolved.Notification.ResolvedReason</p>
            <div class="editor-actions"><button type="button" class="danger" @onclick="Close">Închide</button></div>
        </section>
    </div>
}

</PageBoundary>

@code {
    private IReadOnlyList<NotificationView> views = Array.Empty<NotificationView>();
    private IReadOnlyList<ResolvedNotificationView> resolved = Array.Empty<ResolvedNotificationView>();
    private NotificationView? selected;
    private ResolvedNotificationView? selectedResolved;
    private bool loading, loaded, busy, showResolved, confirmingResolve;
    private string? error, notice, dialogError;
    private int snoozeDays = 1;
    private readonly CancellationTokenSource lifetime = new();
    private int AlertCount => views.Count(view => view.IsAlert);
    private List<NotificationView> Overdue => views.Where(view => view.IsOverdue).ToList();
    private List<NotificationView> Upcoming => views.Where(view => !view.IsOverdue).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(true);
        RefreshPeriodicallyAsync().FireAndForget(Logger, "periodic refresh");
    }

    private RenderFragment NotificationTable(IReadOnlyList<NotificationView> items, bool overdue) => @<div class="table-scroll"><table class="notification-table"><thead><tr><th>STARE</th><th>TITLU</th><th>OBIECT</th><th>@(overdue ? "SCADENȚĂ" : "EXPIRĂ LA")</th><th class="number">@(overdue ? "DEPĂȘIT CU (ZILE)" : "ZILE RĂMASE")</th></tr></thead><tbody>
        @foreach (var view in items)
        {
            <tr @key="view.Notification.Id" class="notification-row @(view.IsAlert ? "notification-unread" : "") @(overdue ? "notification-overdue" : "")" tabindex="0" role="button"
                aria-label="Deschide notificarea @view.Subject" @onclick="() => Open(view)" @onkeydown="args => KeyDown(args, view)">
                <td><span class="notification-state @(view.IsAlert ? "alert" : "done")">@StateText(view)</span></td>
                <td>@view.Subject</td>
                <td>@view.ObjectLabel</td>
                <td>@StockMovementRules.DisplayDate(view.Notification.ExpiryDate)</td>
                <td class="number">@(overdue ? -view.DaysLeft : view.DaysLeft)</td>
            </tr>
        }
        </tbody></table></div>;

    private async Task LoadAsync(bool evaluate)
    {
        loading = true; error = null;
        try
        {
            if (evaluate) await Service.EvaluateAsync(null, lifetime.Token);
            views = await Service.GetViewsAsync(lifetime.Token);
            resolved = await Service.GetResolvedViewsAsync(lifetime.Token);
            loaded = true;
            if (selected is not null) selected = views.FirstOrDefault(view => view.Notification.Id == selected.Notification.Id);
            if (selected is null) confirmingResolve = false;
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Logger.LogError("Notification loading failed ({ErrorType}).", exception.GetType().Name);
            error = "Notificările nu au putut fi încărcate. Reîncearcă peste câteva momente.";
        }
        finally { loading = false; }
    }

    // Another user may take a notification over: the list follows without a manual refresh (never while a popup is open).
    private async Task RefreshPeriodicallyAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (await timer.WaitForNextTickAsync(lifetime.Token))
                await InvokeAsync(async () => { if (selected is null && selectedResolved is null && !busy) { await LoadAsync(false); StateHasChanged(); } });
        }
        catch (OperationCanceledException) { }
    }

    private void Open(NotificationView view)
    {
        selected = view; dialogError = null; notice = null; confirmingResolve = false;
        var max = Math.Max(1, view.MaxSnoozeDays);
        snoozeDays = view.IsOverdue ? Math.Min(ExpiryTemplateRules.SuggestedOverdueSnoozeDays, max) : Math.Clamp(snoozeDays, 1, max);
    }

    private void OpenResolved(ResolvedNotificationView view) { selectedResolved = view; notice = null; }

    private void KeyDown(KeyboardEventArgs args, NotificationView view)
    {
        if (args.Key is "Enter" or " ") Open(view);
    }

    private void ResolvedKeyDown(KeyboardEventArgs args, ResolvedNotificationView view)
    {
        if (args.Key is "Enter" or " ") OpenResolved(view);
    }

    private void DialogKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && !busy) Close();
    }

    private void Close() { selected = null; selectedResolved = null; dialogError = null; confirmingResolve = false; }

    private async Task AcknowledgeAsync()
    {
        if (selected is null || busy) return;
        await RunAsync(async view => { await Service.AcknowledgeAsync(view, lifetime.Token); return "Notificarea a fost preluată."; });
    }

    private async Task SnoozeAsync()
    {
        if (selected is null || busy) return;
        var days = snoozeDays;
        await RunAsync(async view =>
        {
            await Service.SnoozeAsync(view, days, lifetime.Token);
            return $"Notificarea a fost preluată și va avertiza din nou peste {days} zile.";
        });
    }

    private async Task ResolveAsync()
    {
        if (selected is null || busy) return;
        await RunAsync(async view => { await Service.ResolveAsync(view, lifetime.Token); return "Notificarea a fost marcată ca rezolvată și a trecut în lista „Rezolvate”."; });
    }

    private async Task RunAsync(Func<NotificationView, Task<string>> operation)
    {
        var view = selected!;
        busy = true; dialogError = null;
        try
        {
            notice = await operation(view);
            selected = null; confirmingResolve = false;
            await LoadAsync(false);
            // The menu warning follows immediately (the layout itself is not re-rendered by this page).
            try { await JS.InvokeVoidAsync("refreshNotificationAlerts"); } catch (Exception) { }
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (NotificationOperationException exception) { dialogError = exception.Message; confirmingResolve = false; await LoadAsync(false); }
        catch (Exception exception)
        {
            Logger.LogError("Notification operation failed ({ErrorType}).", exception.GetType().Name);
            dialogError = "Operația nu a putut fi efectuată. Actualizează lista și reîncearcă.";
        }
        finally { busy = false; }
    }

    private static string ResolvedAt(ExpiryNotification notification) =>
        notification.ResolvedUtc is { } at ? at.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : string.Empty;

    private static string StateText(NotificationView view) =>
        view.IsAlert ? (view.Notification.AcknowledgedBy is null ? "Nouă" : "Amânare încheiată") : view.Notification.SnoozeUntil is not null ? "Amânată" : "Preluată";

    private static string StateDetail(NotificationView view) => view.IsAlert
        ? (view.Notification.AcknowledgedBy is null ? "nepreluată" : $"amânarea cerută de {view.Notification.AcknowledgedBy} s-a încheiat")
        : view.Notification.SnoozeUntil is { } until
            ? $"preluată de {view.Notification.AcknowledgedBy}, amânată până la {StockMovementRules.DisplayDate(until)}"
            : $"preluată de {view.Notification.AcknowledgedBy}";

    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
}
