@page "/utilizatori/{Id:int}"
@attribute [Authorize(Policy = "perm:utilizatori.view")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using BlazorStoc.Services
@inject IUserRepository Repository
@inject IAccessControl Access
@inject IAccessSecuritySettingsService Authenticators
@inject ILogger<UserDetail> Logger
@inject IChangeFeed ChangeFeed
@inject ChangeOrigin Origin
@implements IDisposable
<PageBoundary>

<PageTitle>@(user?.Username ?? "Utilizator") · BlazorStoc</PageTitle>
<UnsavedChangesHost />
<a class="nav-back" href="@UserNavigation.ListUrl"><span>←</span> Utilizatori</a>

@if (loading)
{
    <div class="empty-state" role="status"><div class="spinner"></div><h3>Se încarcă utilizatorul</h3></div>
}
else if (error is not null)
{
    <div class="error-banner" role="alert">@error <button class="primary" @onclick="() => LoadAsync()">Reîncearcă</button></div>
}
else if (user is null)
{
    <div class="empty-state"><span class="empty-icon">♙</span><h3>Utilizatorul nu mai există</h3><p>Contul a fost șters (mutat în arhivă) sau linkul nu este valid.</p><a class="refresh act-nav" href="@UserNavigation.ListUrl">Înapoi la utilizatori</a></div>
}
else
{
    <div class="page-heading">
        <div><p class="eyebrow">UTILIZATOR</p><h1>@user.Username</h1><p class="muted">@user.DisplayName</p></div>
        <div class="heading-actions">@if (canEdit) { <button class="refresh act-edit" disabled="@editing" @onclick="OpenEditorAsync">Editează</button> }</div>
    </div>
    @if (notice is not null) { <div class="success-banner" role="status">@notice</div> }
    <LiveChangeNotice Visible="live?.HasPendingChange == true" Reload="ReloadLiveAsync" />
    @if (editing) { <UserEditor @key="editorKey" Original="user" Saved="UserSavedAsync" Closed="CloseEditorAsync" /> }

    <section class="movement-card" aria-labelledby="user-facts-title">
        <h2 id="user-facts-title">Date cont</h2>
        <dl class="movement-facts">
            <dt>Nume utilizator</dt><dd>@user.Username</dd>
            <dt>Nume afișat</dt><dd>@user.DisplayName</dd>
            <dt>Tip utilizator</dt><dd><span class="role-badge @(user.Role == AccessRoles.Administrator ? "admin" : "limited")">@(user.TypeName.Length > 0 ? user.TypeName : user.Role)</span></dd>
            <dt>Stare</dt><dd><span class="stock-badge @(user.IsActive ? "positive" : "zero")">@(user.IsActive ? "Activ" : "Inactiv")</span></dd>
        </dl>
        <p class="muted">Parola nu este afișată și nu poate fi recuperată.@(user.MustChangePassword ? " Utilizatorul trebuie să aleagă o parolă nouă la prima autentificare (parola actuală a fost stabilită de un administrator)." : "")</p>
    </section>
    @if (authRow is not null)
    {
        <section class="movement-card" aria-labelledby="user-auth-title">
            <h2 id="user-auth-title">Autentificator</h2>
            <dl class="movement-facts">
                <dt>Stare</dt><dd>@AuthState(authRow)</dd>
                @if (authRow.Status.Confirmed)
                {
                    <dt>Confirmat</dt><dd>@Local(authRow.Status.ConfirmedUtc)@(authRow.Status.ConfirmedBy is null ? "" : " · de " + authRow.Status.ConfirmedBy)</dd>
                    <dt>Ultima folosire</dt><dd>@(authRow.Status.LastUsedUtc is null ? "încă nefolosit" : Local(authRow.Status.LastUsedUtc) + (authRow.Status.LastUsedIp is null ? "" : " · IP " + authRow.Status.LastUsedIp))</dd>
                    <dt>Coduri de recuperare rămase</dt><dd>@authRow.Status.RecoveryLeft</dd>
                }
            </dl>
            @if (authRow.Status.Suspended && authRow.AccountActive)
            {
                <p class="muted">Contul a fost reactivat, dar autentificatorul rămâne suspendat până alegi: <strong>Reactivează</strong> (același telefon) sau <strong>Revocă</strong> și asociază altul.</p>
            }
            @if (!authRow.AccountActive) { <p class="muted">Cât timp contul este inactiv, autentificatorul rămâne suspendat și nu poate fi folosit.</p> }
            <AuthenticatorActions Row="authRow" Icons="false" Changed="ReloadAuthenticatorAsync" Notice="SetAuthNotice" />
            @if (authNotice is not null) { <div class="success-banner" role="status">@authNotice</div> }
        </section>
    }
}

</PageBoundary>

@code {
    [Parameter] public int Id { get; set; }
    private WebUser? user;
    private bool loading = true, editing, canEdit;
    private string? error, notice, authNotice;
    private AuthenticatorRow? authRow;
    private Guid editorKey;
    private readonly CancellationTokenSource lifetime = new();

    // Another session or application changed this account: refresh in place (Task 8).
    private LiveRefresh? live;
    protected override void OnInitialized() =>
        live = new LiveRefresh(ChangeFeed, Origin.Id, change => change.EntityType == AuditEntities.User && change.EntityId == Id.ToString(),
            () => InvokeAsync(async () => { await LoadAsync(false); StateHasChanged(); }), () => editing,
            () => InvokeAsync(StateHasChanged), fallbackInterval: TimeSpan.FromSeconds(60));
    private Task ReloadLiveAsync() => live?.ReloadPendingAsync() ?? Task.CompletedTask;

    protected override async Task OnParametersSetAsync()
    {
        if (user is null || user.Id != Id) { editing = false; notice = null; await LoadAsync(); }
    }

    private async Task LoadAsync(bool showLoading = true)
    {
        if (showLoading) loading = true;
        error = null;
        try
        {
            // The route is guarded by the permission; the check is repeated so the data is never read without it.
            await Access.EnsureAsync(Permissions.Key("utilizatori", Permissions.View), lifetime.Token);
            canEdit = await Access.HasAsync(Permissions.Key("utilizatori", Permissions.Edit), lifetime.Token);
            var users = await Repository.GetUsersAsync(lifetime.Token);
            user = users.FirstOrDefault(item => item.Id == Id);
            await LoadAuthenticatorAsync();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (AccessDeniedException exception) { user = null; error = exception.Message; }
        catch (Exception exception)
        {
            Logger.LogError("User detail loading failed ({ErrorType}).", exception.GetType().Name);
            error = "Utilizatorul nu a putut fi încărcat.";
        }
        finally { loading = false; }
    }

    // The authenticator card is only for administrators (it is the administrator who associates, revokes and resumes it).
    private async Task LoadAuthenticatorAsync()
    {
        try { authRow = await Authenticators.GetAsync(Id, lifetime.Token); }
        catch (AccessDeniedException) { authRow = null; }
        catch (Exception exception) when (exception is not OperationCanceledException) { Logger.LogError("Authenticator state loading failed ({ErrorType}).", exception.GetType().Name); authRow = null; }
    }

    private async Task ReloadAuthenticatorAsync() { await LoadAuthenticatorAsync(); StateHasChanged(); }
    private Task SetAuthNotice(string text) { authNotice = text; return Task.CompletedTask; }

    private static string AuthState(AuthenticatorRow row) =>
        row.Status.LockedUntil is { } until ? $"Blocat până la {until.ToLocalTime():HH:mm} (prea multe coduri greșite)"
        : !row.Status.Exists ? "Neînrolat"
        : !row.Status.Confirmed ? "În așteptare (asocierea nu a fost confirmată)"
        : row.Status.Suspended ? "Suspendat"
        : "Activ";

    private static string Local(string? utc) =>
        DateTime.TryParse(utc, null, System.Globalization.DateTimeStyles.RoundtripKind, out var value) ? value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "—";

    // Arriving on this page only shows the account; editing starts from the explicit "Editează" action.
    private Task OpenEditorAsync() { editing = true; editorKey = Guid.NewGuid(); notice = null; return Task.CompletedTask; }
    private Task CloseEditorAsync() { editing = false; return Task.CompletedTask; }
    private Task UserSavedAsync(WebUser saved)
    {
        user = saved;
        editing = false;
        notice = "Utilizatorul a fost actualizat.";
        return LoadAuthenticatorAsync();
    }

    public void Dispose() { live?.Dispose(); lifetime.Cancel(); lifetime.Dispose(); }
}
