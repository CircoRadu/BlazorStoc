@page "/beneficiari/{Id:int}"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using BlazorStoc.Services
@inject IBeneficiaryRepository Beneficiaries
@inject IProjectRepository Projects
@inject IWorkPointRepository WorkPointStore
@inject IServicePhotoStore PhotoStore
@inject IServiceContractRepository ContractStore
@inject TimeProvider Clock
@inject ExitFormDraft ExitDraft
@inject UnsavedChanges Guard
@inject IAccessControl Access
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IChangeFeed ChangeFeed
@inject ChangeOrigin Origin
@inject ListNavigationContext ListContext
@inject ILogger<BeneficiaryDetail> Logger
@implements IDisposable

<PageTitle>@(beneficiary?.Name ?? "Beneficiar") · BlazorStoc</PageTitle>
<UnsavedChangesHost />
<a class="nav-back" href="/beneficiari"><span>←</span> Beneficiari</a>

@if (loading)
{
    <div class="empty-state" role="status"><div class="spinner"></div><h3>Se încarcă beneficiarul</h3></div>
}
else if (error is not null)
{
    <div class="error-banner" role="alert">@error <button class="primary" @onclick="LoadAsync">Reîncearcă</button></div>
}
else if (beneficiary is not null)
{
    <div class="page-heading">
        <div><p class="eyebrow">BENEFICIAR</p><h1>@beneficiary.Name</h1><p class="muted">@(beneficiary.IsIndividual ? "Persoană fizică" : $"CUI {beneficiary.Cui}")@(beneficiary.Address.Length > 0 ? $" · {beneficiary.Address}" : "")@(beneficiary.Phone.Length > 0 ? $" · tel. {beneficiary.Phone}" : "")</p>
            @if (!beneficiary.IsIndividual && (beneficiary.RegistryNumber.Length > 0 || beneficiary.PostalCode.Length > 0 || beneficiary.CaenCode.Length > 0))
            {
                <p class="muted">@string.Join(" · ", new[] { beneficiary.RegistryNumber.Length > 0 ? $"Reg. Com. {beneficiary.RegistryNumber}" : null, beneficiary.PostalCode.Length > 0 ? $"Cod poștal {beneficiary.PostalCode}" : null, beneficiary.CaenCode.Length > 0 ? $"CAEN {beneficiary.CaenCode}" : null }.Where(part => part is not null))</p>
            }
            @if (!beneficiary.IsIndividual)
            {
                <p><span class="anaf-source @(beneficiary.AnafVerified ? "ok" : "warn")"><span aria-hidden="true">@(beneficiary.AnafVerified ? "✓" : "⚠")</span> @(beneficiary.AnafVerified ? "Date preluate din ANAF" : "Date introduse manual")</span></p>
            }</div>
        <div class="heading-actions">
            @if (canManage) { <button class="refresh" disabled="@(addingProject || editingBeneficiary)" @onclick="OpenEditBeneficiaryAsync">Editează</button> }
            <button class="primary" disabled="@(addingProject || editingBeneficiary)" @onclick="OpenAddProjectAsync">+ Adaugă proiect</button>
        </div>
    </div>
    @if (notice is not null) { <div class="success-banner" role="status">@notice</div> }

    @if (editingBeneficiary)
    {
        <BeneficiaryEditor @key="beneficiaryEditorKey" Original="beneficiary" Saved="BeneficiarySavedAsync" Closed="CloseEditBeneficiaryAsync" />
    }

    @if (addingProject)
    {
        <ProjectEditor @key="editorKey" Original="null" FixedBeneficiaryId="Id" FixedBeneficiaryName="@beneficiary.Name"
                       Saved="ProjectSavedAsync" Closed="CloseAddProjectAsync" />
    }

    @if (addingWorkPoint || editingWorkPoint is not null)
    {
        <WorkPointEditor @key="workPointEditorKey" BeneficiaryId="Id" Original="editingWorkPoint"
                         Saved="WorkPointSavedAsync" Closed="CloseWorkPointEditorAsync" PhotosChanged="ReloadPhotoCountsAsync" />
    }

    <section class="catalog">
        <div class="catalog-heading"><h2>Puncte de lucru <span>@workPoints.Count</span></h2>
            @if (canManage) { <button class="refresh" disabled="@(addingWorkPoint || editingWorkPoint is not null || editingBeneficiary)" @onclick="OpenAddWorkPoint">+ Adaugă punct de lucru</button> }
        </div>
        @if (workPointError is not null) { <div class="error-banner" role="alert">@workPointError</div> }
        <div class="table-scroll"><table><thead><tr><th>NUME</th><th>ADRESĂ</th><th>TELEFON</th><th>PERSOANĂ DE CONTACT</th><th>DESCRIERE</th><th>COORDONATE</th><th class="number">FOTO</th><th>MENTENANȚĂ</th>@if (canManage) { <th></th> }</tr></thead><tbody>
            @foreach (var workPoint in workPoints)
            {
                <tr @key="workPoint.Id"><td><strong>@workPoint.Name</strong>@if (workPoint.IsPrimary) { <text> <span class="anaf-source ok">Principal</span></text> }</td><td>@workPoint.Address</td><td>@workPoint.Phone</td><td>@workPoint.ContactPerson</td>
                    <td class="work-point-description" title="@workPoint.Description">@workPoint.Description</td>
                    <td>@(workPoint.HasCoordinates ? WorkPointCoordinates.Format(workPoint.Latitude, workPoint.Longitude) : "")</td>
                    <td class="number">@(photoCounts.TryGetValue(workPoint.Id, out var photoCount) ? photoCount.ToString() : "")</td>
                    <td>@{ var coverage = ActiveCoverage(workPoint.Id); }@if (coverage is { } covered) { <span>@covered.Contract.Label</span><text> </text><span class="due-chip @ServiceDueRules.CssClass(ServiceDueRules.State(covered.Point.NextDue, Today))">@StockMovementRules.DisplayDate(covered.Point.NextDue)</span> } else if (InOffContract(workPoint.Id)) { <span class="contract-state off">Contract Off</span> }</td>
                    @if (canManage)
                    {
                        <td>
                            @if (workPoint.Id == 0)
                            {
                                <small class="muted">Se creează la pornirea aplicației</small>
                            }
                            else
                            {
                                <button class="refresh" disabled="@(workPointBusy || addingWorkPoint || editingWorkPoint is not null || editingBeneficiary)" @onclick="() => OpenEditWorkPoint(workPoint)">Editează</button>
                                @if (!workPoint.IsPrimary)
                                {
                                    <button class="danger" disabled="@(workPointBusy || addingWorkPoint || editingWorkPoint is not null || editingBeneficiary)" @onclick="() => DeleteWorkPointAsync(workPoint)">Șterge</button>
                                }
                                else
                                {
                                    <small class="muted">Adresa și telefonul: din editarea beneficiarului</small>
                                }
                            }
                        </td>
                    }
                </tr>
            }
        </tbody></table></div>
    </section>

    <ServiceContractsSection BeneficiaryId="Id" BeneficiaryName="@beneficiary.Name" WorkPoints="workPoints" Contracts="contracts" CanManage="canManage" Changed="ReloadContractsAsync" />

    <section class="catalog">
        <div class="catalog-heading"><h2>Proiecte <span>@FilteredProjects.Count</span></h2></div>
        <div class="filters"><label class="search-box"><span>⌕</span><input aria-label="Caută proiecte" placeholder="Caută după denumire…" @bind="query" @bind:event="oninput" @bind:after="QueryChanged" /></label></div>
        @if (projectsLoading)
        {
            <div class="empty-state" role="status"><div class="spinner"></div><h3>Se încarcă proiectele</h3></div>
        }
        else if (FilteredProjects.Count == 0)
        {
            <div class="empty-state"><span class="empty-icon">▦</span><h3>Nu există proiecte pentru căutarea curentă</h3><p>Adaugă primul proiect al acestui beneficiar sau șterge textul din câmpul de căutare.</p></div>
        }
        else
        {
            <div class="table-scroll"><table><thead><tr><th>PROIECT</th><th>ULTIMA MODIFICARE</th></tr></thead><tbody>
            @foreach (var project in PagedProjects)
            {
                <tr @key="project.Id"><td><a class="category-table-link" data-restore-scroll href="@($"/proiecte/{project.Id}")"><strong>@project.Name</strong></a></td><td>@project.UpdatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td></tr>
            }
            </tbody></table></div>
            <div class="table-footer">
                <span>@FilteredProjects.Count proiecte</span>
                @if (TotalPages > 1)
                {
                    <nav class="pagination" aria-label="Paginare proiecte">
                        <button type="button" aria-label="Pagina anterioară" disabled="@(pageNumber <= 1)" @onclick="() => GoToPage(pageNumber - 1)">‹</button>
                        <span>Pagina <strong>@pageNumber</strong> din <strong>@TotalPages</strong></span>
                        <button type="button" aria-label="Pagina următoare" disabled="@(pageNumber >= TotalPages)" @onclick="() => GoToPage(pageNumber + 1)">›</button>
                    </nav>
                }
            </div>
        }
    </section>
}

@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery(Name = BeneficiaryProjectListState.QueryParameter)] public string? QueryText { get; set; }
    [SupplyParameterFromQuery(Name = BeneficiaryProjectListState.PageParameter)] public int? PageParameter { get; set; }
    // /beneficiari/<id>?adauga-proiect=1&inapoi=<page>: opened from a form (the exit form of a product) that continues afterwards.
    [SupplyParameterFromQuery(Name = "adauga-proiect")] public string? AddProjectFlag { get; set; }
    [SupplyParameterFromQuery(Name = ReturnNavigation.QueryName)] public string? ReturnParameter { get; set; }
    private string? returnTo;
    private Beneficiary? beneficiary;
    private IReadOnlyList<Project> projects = Array.Empty<Project>();
    private bool loading = true, projectsLoading, addingProject, editingBeneficiary, canManage;
    private string? error, notice, workPointError;
    // The additional work points; the main one is derived from the beneficiary itself (WorkPointRules.Primary).
    private IReadOnlyList<WorkPoint> workPoints = Array.Empty<WorkPoint>();
    // Number of photos per work point id (points without photos are absent).
    private IReadOnlyDictionary<int, int> photoCounts = new Dictionary<int, int>();
    // Every maintenance contract of the beneficiary (On and Off) with its covered points.
    private IReadOnlyList<ServiceContractDetails> contracts = Array.Empty<ServiceContractDetails>();
    private bool addingWorkPoint, workPointBusy;
    private WorkPoint? editingWorkPoint;
    private Guid workPointEditorKey;
    private string query = "";
    private int pageNumber = 1;
    private const int PageSize = 10;
    private Guid editorKey, beneficiaryEditorKey;
    private readonly CancellationTokenSource lifetime = new();

    private List<Project> FilteredProjects
    {
        get
        {
            var trimmed = query.Trim();
            var filtered = trimmed.Length == 0 ? projects : projects.Where(project => project.Name.Contains(trimmed, StringComparison.OrdinalIgnoreCase));
            return filtered.OrderBy(project => project.Name).ToList();
        }
    }
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredProjects.Count / (double)PageSize));
    private IEnumerable<Project> PagedProjects => FilteredProjects.Skip((pageNumber - 1) * PageSize).Take(PageSize);
    private IDisposable? changeSubscription;
    private bool scrollRestorePending = true;
    private string? syncedUrl;

    // The filter text and page live in the address (replaced in place, so Back restores them) and are remembered
    // for the "back" links of the project pages; they are read from the address only when the page is opened.
    private void ApplyStateFromAddress()
    {
        var state = BeneficiaryProjectListState.From(QueryText, PageParameter);
        query = state.Query;
        pageNumber = state.Page;
        syncedUrl = state.Url(Id);
        ListContext.RememberBeneficiaryProjects(Id, state);
    }

    private void SyncState()
    {
        var state = BeneficiaryProjectListState.From(query, pageNumber);
        ListContext.RememberBeneficiaryProjects(Id, state);
        var url = state.Url(Id);
        if (url == syncedUrl) return;
        syncedUrl = url;
        Navigation.NavigateTo(url, replace: true);
    }

    private void QueryChanged() { pageNumber = 1; SyncState(); }
    private void GoToPage(int page) { pageNumber = Math.Clamp(page, 1, TotalPages); SyncState(); }

    protected override async Task OnInitializedAsync()
    {
        changeSubscription = ChangeFeed.Subscribe(OnChangeAsync);
        ApplyStateFromAddress();
        await LoadAsync();
        if (AddProjectFlag == "1" && beneficiary is not null)
        {
            returnTo = ReturnNavigation.Safe(ReturnParameter);
            await OpenAddProjectAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (beneficiary is not null && beneficiary.Id != Id)
        {
            ApplyStateFromAddress();
            scrollRestorePending = true;
            await LoadAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!scrollRestorePending || loading || projectsLoading || beneficiary is null) return;
        scrollRestorePending = false;
        try { await JS.InvokeVoidAsync("blazorStocNavigationContext.restoreScroll"); }
        catch (Exception exception) when (exception is JSException or InvalidOperationException or OperationCanceledException) { }
    }

    // Another session changed one of this beneficiary's projects: refresh the list in place. The open project form
    // is a separate component with its own state, so it is left untouched.
    private Task OnChangeAsync(ChangeEvent change)
    {
        if (change.Origin == Origin.Id || !ProjectChanges.AffectsBeneficiary(change, Id)) return Task.CompletedTask;
        return InvokeAsync(async () =>
        {
            await RefreshProjectsAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshProjectsAsync()
    {
        try
        {
            projects = await Projects.GetForBeneficiaryAsync(Id, lifetime.Token);
            if (pageNumber > TotalPages) { pageNumber = TotalPages; SyncState(); }
        }
        catch (OperationCanceledException) { }
        catch (Exception exception) { Logger.LogWarning("Project list refresh failed ({ErrorType}).", exception.GetType().Name); }
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            canManage = await Access.CanManageBeneficiariesAsync(lifetime.Token);
            var all = await Beneficiaries.GetBeneficiariesAsync(lifetime.Token);
            beneficiary = all.FirstOrDefault(item => item.Id == Id);
            if (beneficiary is null) { error = "Beneficiarul solicitat nu mai există."; return; }
            workPoints = await WorkPointStore.GetAsync(Id, lifetime.Token);
            photoCounts = await PhotoStore.CountsForBeneficiaryAsync(Id, lifetime.Token);
            contracts = await ContractStore.GetForBeneficiaryAsync(Id, lifetime.Token);
            addingWorkPoint = false;
            editingWorkPoint = null;
            await LoadProjectsAsync();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (AccessDeniedException exception) { error = exception.Message; }
        catch (Exception exception)
        {
            Logger.LogError("Beneficiary detail loading failed ({ErrorType}).", exception.GetType().Name);
            error = "Beneficiarul nu a putut fi încărcat.";
        }
        finally { loading = false; }
    }

    private async Task LoadProjectsAsync()
    {
        projectsLoading = true;
        try
        {
            projects = await Projects.GetForBeneficiaryAsync(Id, lifetime.Token);
            if (pageNumber > TotalPages) { pageNumber = TotalPages; SyncState(); }
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        finally { projectsLoading = false; }
    }

    // The page only shows the beneficiary; the editor is opened by the explicit "Editează" action, never by arriving here.
    private Task OpenEditBeneficiaryAsync() { editingBeneficiary = true; beneficiaryEditorKey = Guid.NewGuid(); notice = null; return Task.CompletedTask; }
    private Task CloseEditBeneficiaryAsync() { editingBeneficiary = false; return Task.CompletedTask; }
    private async Task BeneficiarySavedAsync(Beneficiary saved)
    {
        beneficiary = saved;
        editingBeneficiary = false;
        notice = "Beneficiarul a fost actualizat.";
        // The main work point follows the address and phone of the beneficiary.
        await ReloadWorkPointsAsync();
    }

    private void OpenAddWorkPoint() { addingWorkPoint = true; editingWorkPoint = null; workPointEditorKey = Guid.NewGuid(); notice = workPointError = null; }
    private void OpenEditWorkPoint(WorkPoint workPoint) { addingWorkPoint = false; editingWorkPoint = workPoint; workPointEditorKey = Guid.NewGuid(); notice = workPointError = null; }
    private Task CloseWorkPointEditorAsync() { addingWorkPoint = false; editingWorkPoint = null; return Task.CompletedTask; }

    private async Task WorkPointSavedAsync(WorkPoint saved)
    {
        var wasNew = editingWorkPoint is null;
        notice = wasNew ? "Punctul de lucru a fost adăugat. Poți adăuga acum fotografii sau închide fișa." : "Punctul de lucru a fost actualizat.";
        addingWorkPoint = false;
        editingWorkPoint = wasNew ? saved : null;
        // A new point stays open for editing, so its photos can be added right away.
        if (wasNew) workPointEditorKey = Guid.NewGuid();
        await ReloadWorkPointsAsync();
    }

    private async Task ReloadPhotoCountsAsync()
    {
        try { photoCounts = await PhotoStore.CountsForBeneficiaryAsync(Id, lifetime.Token); }
        catch (OperationCanceledException) { }
        catch (Exception exception) { Logger.LogWarning("Photo counts refresh failed ({ErrorType}).", exception.GetType().Name); }
    }

    // One step: no confirmation and no reason typed by the user (the audit trail records WorkPointRules.DeleteReason).
    private async Task DeleteWorkPointAsync(WorkPoint workPoint)
    {
        if (workPointBusy) return;
        workPointBusy = true;
        notice = workPointError = null;
        try
        {
            await WorkPointStore.DeleteAsync(workPoint, lifetime.Token);
            notice = $"Punctul de lucru «{workPoint.Name}» a fost șters.";
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (WorkPointOperationException exception) { workPointError = exception.Message; }
        catch (AccessDeniedException exception) { workPointError = exception.Message; }
        catch (Exception exception)
        {
            Logger.LogError("Work point deletion failed ({ErrorType}).", exception.GetType().Name);
            workPointError = "Punctul de lucru nu a putut fi șters.";
        }
        finally { workPointBusy = false; }
        await ReloadWorkPointsAsync();
    }

    private DateOnly Today => DateOnly.FromDateTime(Clock.GetLocalNow().DateTime);

    // The coverage of a work point by an ACTIVE contract (a point is in at most one), for the "Mentenanță" column of the table.
    private (ServiceContract Contract, ServiceContractPoint Point)? ActiveCoverage(int workPointId)
    {
        foreach (var details in contracts.Where(item => item.Contract.IsActive))
            if (details.Points.FirstOrDefault(point => point.Point.WorkPointId == workPointId) is { } covered) return (details.Contract, covered.Point);
        return null;
    }

    private bool InOffContract(int workPointId) =>
        contracts.Any(item => !item.Contract.IsActive && item.Points.Any(point => point.Point.WorkPointId == workPointId));

    private async Task ReloadContractsAsync()
    {
        try { contracts = await ContractStore.GetForBeneficiaryAsync(Id, lifetime.Token); }
        catch (OperationCanceledException) { }
        catch (Exception exception)
        {
            Logger.LogWarning("Contract list refresh failed ({ErrorType}).", exception.GetType().Name);
            workPointError = "Lista contractelor nu a putut fi actualizată.";
        }
    }

    private async Task ReloadWorkPointsAsync()
    {
        try
        {
            workPoints = await WorkPointStore.GetAsync(Id, lifetime.Token);
            photoCounts = await PhotoStore.CountsForBeneficiaryAsync(Id, lifetime.Token);
        }
        catch (OperationCanceledException) { }
        catch (Exception exception)
        {
            Logger.LogWarning("Work point list refresh failed ({ErrorType}).", exception.GetType().Name);
            workPointError = "Lista punctelor de lucru nu a putut fi actualizată.";
        }
    }

    private Task OpenAddProjectAsync() { addingProject = true; editorKey = Guid.NewGuid(); notice = null; return Task.CompletedTask; }
    private Task CloseAddProjectAsync()
    {
        addingProject = false;
        if (returnTo is { } back && !Guard.IsDiscarding) { returnTo = null; Navigation.NavigateTo(back); }
        return Task.CompletedTask;
    }
    private async Task ProjectSavedAsync(Project project)
    {
        addingProject = false;
        if (returnTo is { } back)
        {
            // Opened from a form: hand the new project to it (it selects it) and go back.
            ExitDraft.SetNewProject(project.Id);
            returnTo = null;
            Navigation.NavigateTo(back);
            return;
        }
        notice = "Proiectul a fost adăugat.";
        await LoadProjectsAsync();
    }

    public void Dispose() { changeSubscription?.Dispose(); lifetime.Cancel(); lifetime.Dispose(); }
}
