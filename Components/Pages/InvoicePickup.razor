@page "/produse/preluare-factura"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@using BlazorStoc.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IServiceProvider Services
@inject IAccessControl Access
@inject IInvoiceAnalysisService Analysis
@inject IInvoiceTemplateService Templates
@inject IProductRepository ProductsRepository
@inject IStockMovementRepository Movements
@inject ISupplierRepository Suppliers
@inject ISupplierInvoiceRepository SupplierInvoices
@inject IProductImageStore ImageStore
@inject IJSRuntime JS
@inject InvoiceLabSettings Lab
@inject ILogger<InvoicePickup> Logger
@implements IAsyncDisposable
<PageBoundary>

<PageTitle>Preluare factură · BlazorStoc</PageTitle>
<UnsavedChangesHost />
<div class="page-heading">
    <div><p class="eyebrow">PRODUSE</p><h1>Preluare factură</h1>
        <p class="muted">Încarcă factura PDF a furnizorului: se citește după șablonul detectat, iar liniile de demarcare dintre rânduri pot fi corectate.</p></div>
</div>

<ol class="wizard-steps" aria-label="Pașii preluării facturii">
    @for (var number = 1; number <= StepTitles.Length; number++)
    {
        var current = number;
        <li class="wizard-step @(current < step ? "done" : current == step ? "current" : "todo")" aria-current="@(current == step ? "step" : null)">
            <span class="wizard-circle">@(current < step ? "✓" : current.ToString(CultureInfo.InvariantCulture))</span>
            <span class="wizard-title">@StepTitles[current - 1]</span>
        </li>
    }
</ol>

@* The template of the supplier is made on the file already read, in a window over the pickup; once saved it is applied to the file. *@
@if (creatingTemplate && session is not null)
{
    <div class="delete-overlay template-popup-overlay">
        <section class="delete-dialog template-popup" role="dialog" aria-modal="true" aria-label="Creare șablon de factură">
            <div class="heading-actions"><button type="button" class="refresh act-close" @onclick="CloseTemplateCreation">✕ Închide fără să creezi șablonul</button></div>
            <InvoiceTemplateWorkbench ExistingSession="session" SavedRecord="OnTemplateCreatedAsync" Closed="CloseTemplateCreation" />
        </section>
    </div>
}

@if (step == 1)
{
<FileDropZone Id="invoice-pickup-file" Accept=".pdf,application/pdf" Text="Alege factura PDF" OnChange="FileSelectedAsync" Disabled="@(loading || loadError is not null || busy)" />

@if (loadError is not null) { <div class="error-banner" role="alert">@loadError</div> }
@if (error is not null) { <div class="error-banner" role="alert">@error</div> }
@if (notice is not null) { <div class="success-banner" role="status">@notice</div> }

@if (loading)
{
    <div class="empty-state" role="status"><div class="spinner"></div><h3>Se verifică drepturile de acces</h3></div>
}
else if (busy)
{
    <div class="empty-state" role="status"><div class="spinner"></div><h3>Se citește factura…</h3><p>O pagină scanată poate dura câteva secunde.</p></div>
}
else if (loadError is null && session is null)
{
    <div class="empty-state"><h3>Nicio factură încărcată</h3><p>Alege fișierul PDF al facturii sau trage-l în câmpul de mai sus.</p></div>
}
else if (session is not null)
{
    var pageData = CurrentPageData;
    <section class="invoice-head" aria-label="Fișierul citit">
        <div><strong>@session.FileName</strong> <span class="muted">· @session.Document.Pages.Count @(session.Document.Pages.Count == 1 ? "pagină" : "pagini")</span></div>
        <button type="button" class="danger" @onclick="DiscardAsync">Renunță și elimină fișierul</button>
    </section>

    @if (chosen is null && !Lab.Enabled)
    {
        <div class="invoice-warning no-template-warning" role="alert">
            <p><strong>⚠ Nu există niciun șablon definit pentru furnizorul acestei facturi@(SupplierText.Length > 0 ? " (" + SupplierText + ")" : "").</strong> Factura este citită automat: verifică rândurile și coloanele.</p>
            <div class="editor-actions">
                <button type="button" class="primary" disabled="@creatingTemplate" @onclick="OpenTemplateCreation">Creează șablon pentru acest furnizor</button>
                @if (allTemplates.Any(template => template.Info.Active))
                {
                    <label class="muted">sau folosește un șablon existent:
                        <select @onchange="ChooseAnyTemplate" aria-label="Folosește un șablon existent">
                            <option value="" selected>— alege —</option>
                            @foreach (var template in allTemplates.Where(template => template.Info.Active))
                            {
                                <option value="@template.Info.Id">@template.Info.Name · @SupplierLabel(template.Info)</option>
                            }
                        </select>
                    </label>
                }
            </div>
        </div>
    }
    else if (templateInfo is not null)
    {
        <div class="invoice-suggestions" role="status">
            <strong>@templateInfo</strong>
            @if (suggestions.Count > 1)
            {
                <label class="muted">Alt șablon:
                    <select @onchange="ChooseTemplate" aria-label="Alege șablonul de citire">
                        @foreach (var suggestion in suggestions)
                        {
                            <option value="@suggestion.Template.Info.Id" selected="@(chosen?.Info.Id == suggestion.Template.Info.Id)">@suggestion.Template.Info.Name · @SupplierLabel(suggestion.Template.Info)</option>
                        }
                    </select>
                </label>
            }
        </div>
    }
    @foreach (var warning in session.Analysis.Warnings) { <div class="invoice-warning" role="status">⚠ @warning</div> }

    @if (Lab.Enabled)
    {
        <section class="lab-panel" aria-label="Laborator OCR">
            <div class="lab-head"><strong>Laborator OCR</strong>
                <button type="button" class="refresh act-confirm" disabled="@(reading is null)" @onclick="SaveReference">Salvează ca referință</button>
            </div>
            @if (labNotice is not null) { <p class="muted" role="status">@labNotice</p> }
            <table class="lab-table">
                <thead><tr><th>Tabel</th><th>Rânduri găsite / așteptate</th><th>Linii P / R</th><th>Coloane P / R</th><th>Scor</th><th>Rânduri cu probleme în valori</th></tr></thead>
                <tbody>
                    @if (labResult is { } result)
                    {
                        <tr class="lab-current">
                            <td>@(result.Table is null ? "nu" : "da")</td>
                            @if (result.Match is { } match)
                            {
                                <td>@match.RowsFound / @match.RowsExpected</td>
                                <td>@Pct(match.SeparatorPrecision) / @Pct(match.SeparatorRecall)</td>
                                <td>@Pct(match.ColumnPrecision) / @Pct(match.ColumnRecall)</td>
                                <td><strong>@Pct(match.Score)</strong></td>
                            }
                            else
                            {
                                <td>@(result.Table?.Rows.Count.ToString(CultureInfo.InvariantCulture) ?? "-") / -</td>
                                <td colspan="3" class="muted">fără referință pentru acest fișier</td>
                            }
                            <td>@result.RowsWithProblems</td>
                        </tr>
                    }
                </tbody>
            </table>
            <small class="muted">@(labReference is null ? "Corectează liniile și coloanele pe pagină, apoi „Salvează ca referință”: citirea se măsoară după geometrie, nu după valorile citite." : "Referința fișierului este încărcată; „Salvează ca referință” o înlocuiește cu ce vezi pe pagină.")@(Lab.ReferencesDirectory is null ? " Folderul pentru referințe nu este configurat." : "")</small>
        </section>
    }

    @if (reading is null)
    {
        <div class="empty-state"><h3>Tabelul cu liniile facturii nu a fost găsit</h3><p>Nu există un șablon salvat potrivit, iar citirea automată nu a găsit tabelul. Creează șablonul în Setări → Facturi.</p></div>
    }
    else
    {
        <div class="invoice-layout">
            <div class="invoice-pages">
                @if (session.Document.Pages.Count > 1)
                {
                    <div class="invoice-page-tabs" role="tablist" aria-label="Paginile facturii">
                        @foreach (var page in session.Document.Pages)
                        {
                            var number = page.Number;
                            <button type="button" role="tab" class="invoice-page-tab @(number == currentPage ? "active" : "")" aria-selected="@(number == currentPage ? "true" : "false")" @onclick="() => currentPage = number">Pagina @number</button>
                        }
                    </div>
                }
                <div class="invoice-draw-tools">
                    <button type="button" class="refresh act-confirm @(addMode ? "active" : "")" aria-pressed="@(addMode ? "true" : "false")" @onclick="() => addMode = !addMode">─ Adaugă linie de demarcare</button>
                    <button type="button" class="danger" disabled="@(selectedId.Length == 0)" @onclick="DeleteSelected">Șterge linia selectată</button>
                    <button type="button" class="refresh act-nav" @onclick="ResetSeparators">Liniile propuse automat</button>
                    <span class="muted">@(addMode ? "Apasă pe pagină, la înălțimea la care vrei linia." : "Trage o linie în sus sau în jos; trage capetele ei ca să o scurtezi sau să o lungești. Ce este sub ultima linie nu se citește.")</span>
                </div>
                <div class="invoice-draw-tools" role="group" aria-label="Ce din șablon se vede pe pagină">
                    <button type="button" class="refresh act-nav @(showFields ? "active" : "")" aria-pressed="@(showFields ? "true" : "false")" title="Arată sau ascunde câmpurile din antet pe pagină" @onclick="() => showFields = !showFields">Câmpurile din antet</button>
                    <button type="button" class="refresh act-nav @(showHeader ? "active" : "")" aria-pressed="@(showHeader ? "true" : "false")" title="Arată sau ascunde capul de tabel pe pagină" @onclick="() => showHeader = !showHeader">Capul de tabel</button>
                    <button type="button" class="refresh act-nav @(showColumns ? "active" : "")" aria-pressed="@(showColumns ? "true" : "false")" title="Arată sau ascunde coloanele tabelului pe pagină" @onclick="() => showColumns = !showColumns">Coloanele</button>
                </div>
                <div class="invoice-page-wrap" style="aspect-ratio: @F(pageData.Width) / @F(pageData.Height)">
                    <img src="@ImageUrl(pageData.Number)" alt="Pagina @pageData.Number a facturii" draggable="false" />
                    <svg class="invoice-overlay sep-overlay @(addMode ? "drawing" : "")" viewBox="0 0 @F(pageData.Width) @F(pageData.Height)" preserveAspectRatio="none"
                         data-sep-svg data-sep-add="@(addMode ? "true" : "false")" data-sep-page="@pageData.Number" role="group" aria-label="Liniile de demarcare ale tabelului pe pagina @pageData.Number">
                        @if (showColumns && BodyRange(pageData) is { } body)
                        {
                            @foreach (var column in ColumnsOn(pageData))
                            {
                                <rect class="invoice-column used pickup-static" style="--col: @ColumnColor(column)" x="@F(column.Left)" y="@F(body.Top)" width="@F(Math.Max(1, column.Right - column.Left))" height="@F(Math.Max(1, body.Bottom - body.Top))"><title>@(column.Label.Length > 0 ? column.Label : InvoiceVocabulary.ColumnTitle(column.Meaning))</title></rect>
                            }
                        }
                        @if (overlay is not null)
                        {
                            @if (showHeader && overlay.HasTable && overlay.HeaderPage == pageData.Number && overlay.Columns.Count > 0)
                            {
                                <rect class="invoice-header-band pickup-static" x="@F(overlay.Columns.Min(column => column.Left))" y="@F(overlay.HeaderTop)" width="@F(Math.Max(1, overlay.Columns.Max(column => column.Right) - overlay.Columns.Min(column => column.Left)))" height="@F(Math.Max(1, overlay.HeaderBottom - overlay.HeaderTop))"><title>Capul de tabel</title></rect>
                                @foreach (var cell in overlay.Columns)
                                {
                                    var cellTop = cell.CellBottom > cell.CellTop ? cell.CellTop : overlay.HeaderTop;
                                    var cellBottom = cell.CellBottom > cell.CellTop ? cell.CellBottom : overlay.HeaderBottom;
                                    <rect class="invoice-hcell pickup-static" style="--col: @ColumnColor(cell.Id)" x="@F(cell.Left)" y="@F(cellTop)" width="@F(Math.Max(1, cell.Right - cell.Left))" height="@F(Math.Max(1, cellBottom - cellTop))"><title>@(cell.Label.Length > 0 ? cell.Label : cell.HeaderText)</title></rect>
                                }
                            }
                            @if (showFields)
                            {
                                @foreach (var field in overlay.Fields.Where(field => field.Use && field.Page == pageData.Number))
                                {
                                    <rect class="invoice-field pickup-static" x="@F(field.X)" y="@F(field.Y)" width="@F(Math.Max(1, field.Width))" height="@F(Math.Max(1, field.Height))"><title>@InvoiceTemplateDraft.EffectiveLabel(field): @field.Value</title></rect>
                                    <g><text class="pickup-field-label" x="@F(field.X)" y="@F(Math.Max(pageData.Height / 110, field.Y - 1.5))" font-size="@F(pageData.Width / 110)">@InvoiceTemplateDraft.EffectiveLabel(field)</text></g>
                                }
                            }
                        }
                        @{ var size = pageData.Width / 110; }
                        @foreach (var separator in separators.Where(item => item.Page == pageData.Number))
                        {
                            var id = separator.Id;
                            var selected = id == selectedId;
                            <g class="sep-line @(selected ? "selected" : "")" data-sep-id="@id" data-sep-y="@F(separator.Y)" data-sep-left="@F(separator.Left)" data-sep-right="@F(separator.Right)"
                               @onclick="() => Select(id)" @onclick:stopPropagation="true">
                                <line class="sep-visible" x1="@F(separator.Left)" x2="@F(separator.Right)" y1="@F(separator.Y)" y2="@F(separator.Y)" />
                                <line class="sep-hit" data-sep-handle="move" x1="@F(separator.Left)" x2="@F(separator.Right)" y1="@F(separator.Y)" y2="@F(separator.Y)"><title>Trage pentru a muta linia</title></line>
                                @if (selected)
                                {
                                    <rect class="sep-end" data-sep-handle="left" x="@F(separator.Left - size / 2)" y="@F(separator.Y - size / 2)" width="@F(size)" height="@F(size)"><title>Trage pentru a schimba începutul liniei</title></rect>
                                    <rect class="sep-end" data-sep-handle="right" x="@F(separator.Right - size / 2)" y="@F(separator.Y - size / 2)" width="@F(size)" height="@F(size)"><title>Trage pentru a schimba sfârșitul liniei</title></rect>
                                    <g class="invoice-delete" role="button" tabindex="0" aria-label="Șterge linia de demarcare" @onclick="DeleteSelected" @onclick:stopPropagation="true">
                                        <title>Șterge linia</title>
                                        <circle cx="@F(Math.Min(pageData.Width - size * 1.2, separator.Right + size * 1.8))" cy="@F(separator.Y)" r="@F(size * 1.1)" />
                                        <text x="@F(Math.Min(pageData.Width - size * 1.2, separator.Right + size * 1.8))" y="@F(separator.Y + size * 0.55)" font-size="@F(size * 1.6)" text-anchor="middle">×</text>
                                    </g>
                                }
                            </g>
                        }
                    </svg>
                </div>
            </div>

            <section class="catalog" aria-label="Rândurile citite">
                <div class="catalog-heading"><span class="category-title">Rânduri citite din factură (@rows.Count) · preluate: @(rows.Count - excluded.Count)</span></div>
                @if (rows.Count == 0)
                {
                    <div class="empty-state"><h3>Niciun rând între liniile de demarcare</h3><p>Pune cel puțin două linii de demarcare, deasupra și sub rândurile tabelului.</p></div>
                }
                else
                {
                    <div class="table-scroll">
                        <table>
                            <thead><tr>
                                <th><span class="row-select-all"><RowSelect Selected="@(excluded.Count == 0)" Mixed="@(excluded.Count > 0 && excluded.Count < rows.Count)" AriaLabel="Preia toate rândurile" SelectedChanged="ToggleAll" />Selectează tot</span></th>
                                <th>#</th>@foreach (var column in ShownColumns) { <th>@column.Title</th> }<th>Pagina</th></tr></thead>
                            <tbody>
                                @for (var index = 0; index < rows.Count; index++)
                                {
                                    var row = rows[index];
                                    var at = index;
                                    <tr class="selectable-row @(excluded.Contains(index) ? "row-off" : "selected")" @onclick="() => ToggleRow(at, excluded.Contains(at))">
                                        <td><RowSelect Selected="@(!excluded.Contains(index))" AriaLabel="@($"Preia rândul {index + 1}")" SelectedChanged="@(value => ToggleRow(at, value))" /></td>
                                        <td>@(index + 1)</td>
                                        @foreach (var column in ShownColumns) { <td>@row.Cells.GetValueOrDefault(column.Id, "")</td> }
                                        <td>@row.Page @foreach (var flag in row.Flags) { <span class="uncertain-badge" title="@flag">⚠ @flag</span> }</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>
    }
}
}
else if (step == 2)
{
    <section class="wizard-panel" aria-label="@StepTitles[1]">
        <h2>@StepTitles[1]</h2>
        <p class="muted">Rândurile preluate din <strong>@session?.FileName</strong> pot fi corectate. Pentru fiecare, se caută în catalog produsul cu același cod; dacă nu există, se oferă cele mai apropiate, sau se pregătește un produs nou (se adaugă în catalog abia la pasul 3). Cantitățile și prețurile care nu sunt citite ca număr au fundal roșu; rândul respectiv este afișat sub avertisment, așa cum este în factură.</p>
        @if (session is not null)
        {
            <p><a class="refresh act-nav button-link" href="@ViewerUrl" target="invoice-viewer" rel="noopener"
                  onclick="window.open(this.href, 'invoice-viewer', 'popup=yes,width=1000,height=900'); return false;">Afișează factura într-o fereastră nouă</a>
                <span class="muted">Fereastra se poate muta lângă acest tabel, ca să confrunți valorile cu factura.</span></p>
        }
        @if (step2Error is not null) { <div class="error-banner" role="alert">@step2Error</div> }
        @if (step2Loading) { <div class="empty-state" role="status"><div class="spinner"></div><h3>Se caută produsele în catalog</h3></div> }
        else if (step2Error is null)
        {
            <section class="pickup-invoice-head" aria-label="Datele facturii">
                <h3>Datele facturii</h3>
                <p class="muted">Numărul și data sunt citite din factură și <strong>neverificate</strong> până le confirmi, fiecare în parte, cu comutatorul de lângă ele, comparându-le cu imaginea regiunii din care au fost citite. CUI-ul este verificat de la sine când furnizorul este în registru (sau tocmai a fost adăugat). Orice modificare readuce câmpul la „neverificat”. Fără cele trei confirmări nu se poate trece la pasul 3.@(NumberFromOcr ? " Factura este o scanare citită prin OCR: o literă sau o cifră citită greșit ar duce la o factură nouă în loc de cea deja preluată, deci verifică atent numărul." : "")</p>
                @if (supplierError is not null) { <div class="error-banner" role="alert">@supplierError</div> }
                <div class="editor-grid">
                    <div class="verify-field">
                        <label for="pickup-invoice-number">Număr factură *
                            <input id="pickup-invoice-number" maxlength="@SupplierInvoiceRules.MaxNumberLength" disabled="@InvoiceLocked" value="@invoiceNumber" @oninput="NumberEdited" autocomplete="off" /></label>
                        @VerifyBadge(numberVerified)
                        <ToggleSwitch Value="numberVerified" ValueChanged="@(value => numberVerified = value && NumberValid)" Disabled="@(InvoiceLocked || !NumberValid)" OnText="Verificat" OffText="Neverificat" AriaLabel="Confirmă că numărul facturii este verificat" />
                        @if (HeaderFieldPicture(InvoiceFieldMeanings.InvoiceNumber) is { } numberPicture) { <img class="pickup-region" src="@numberPicture" alt="Regiunea din factură din care s-a citit numărul" /> }
                    </div>
                    <div class="verify-field">
                        <label for="pickup-supplier-cui">CUI furnizor *
                            <input id="pickup-supplier-cui" maxlength="20" disabled="@InvoiceLocked" value="@supplierCuiText" @oninput="CuiEdited" autocomplete="off" /></label>
                        @VerifyBadge(cuiVerified)
                        <ToggleSwitch Value="cuiVerified" ValueChanged="@(value => cuiVerified = value && ResolvedSupplier is not null)" Disabled="@(InvoiceLocked || ResolvedSupplier is null)" OnText="Verificat" OffText="Neverificat" AriaLabel="Confirmă că CUI-ul furnizorului este verificat" />
                        <small id="pickup-supplier-name">@(ResolvedSupplier is { } resolved ? $"Furnizor din registru: {resolved.Name} · {SupplierCountries.Name(resolved.Country)}" : "Niciun furnizor din registru cu acest CUI.")@(invoiceSupplierName.Length > 0 ? $" Citit din factură: {invoiceSupplierName}." : "")@(supplierByName && ResolvedSupplier is not null ? " Furnizor identificat după nume (forma juridică ignorată); CUI-ul este cel din registru." : "")@(CuiInInvoice switch { true => " CUI-ul se regăsește în factură.", false => " ⚠ CUI-ul furnizorului nu se regăsește în textul facturii: verifică furnizorul.", _ => "" })</small>
                    </div>
                    <div class="verify-field">
                        <label class="movement-date">Data emiterii *
                            <PickOnlyDate Id="pickup-invoice-date" Value="invoiceDate" ValueChanged="@((DateOnly? picked) => DateEdited(picked))" Disabled="@InvoiceLocked" Min="@StockMovementRules.StorageDate(StockMovementRules.EarliestDate)" Max="@StockMovementRules.StorageDate(StockMovementRules.Today)" /></label>
                        @VerifyBadge(dateVerified)
                        <ToggleSwitch Value="dateVerified" ValueChanged="@(value => dateVerified = value && DateValid)" Disabled="@(InvoiceLocked || !DateValid)" OnText="Verificat" OffText="Neverificat" AriaLabel="Confirmă că data facturii este verificată" />
                        @if (HeaderFieldPicture(InvoiceFieldMeanings.InvoiceDate) is { } datePicture) { <img class="pickup-region" src="@datePicture" alt="Regiunea din factură din care s-a citit data" /> }
                    </div>
                </div>
                @if (ResolvedSupplier is null && supplierCuiText.Trim().Length > 0 && !InvoiceLocked)
                {
                    <div class="invoice-warning" role="status">⚠ Furnizorul cu acest CUI nu este în registru.
                        <button type="button" class="refresh act-confirm" @onclick="() => OpenAddSupplier(true)">+ Adaugă furnizorul</button></div>
                }
                @if (recognition is { Supplier: not null, NeedsConfirmation: false } known && ResolvedSupplier?.Id == known.Supplier!.Id)
                {
                    <p class="muted" id="pickup-recognition">Furnizor recunoscut după @known.MethodText, încredere @known.ConfidenceText.@(known.Conflict ? " ⚠ Numele din factură indică alt furnizor: " + known.Other!.Name + ". Verifică furnizorul." : "")</p>
                }
                @if (similarSupplier is { } nearSupplier && ResolvedSupplier is null && !InvoiceLocked)
                {
                    <div class="invoice-warning" role="status" id="pickup-similar-supplier">Probabil furnizorul <strong>@nearSupplier.Name</strong> (nume citit din factură: @invoiceSupplierName).
                        <button type="button" class="refresh act-confirm" @onclick="UseSimilarSupplier" >Folosește acest furnizor</button></div>
                }
                @if (AliasOffer is { } offer && !InvoiceLocked)
                {
                    <div class="invoice-warning" role="status" id="pickup-alias-offer">Numele din factură („@offer”) diferă de cel din registru.
                        <button type="button" class="refresh act-confirm" @onclick="RememberAliasAsync">Ține minte această denumire pentru @ResolvedSupplier!.Name</button></div>
                }
                @if (aliasNotice.Length > 0) { <p class="success-banner" role="status">@aliasNotice</p> }
                @if (!InvoiceLocked) { <p><button type="button" class="refresh act-confirm" @onclick="() => OpenAddSupplier(false)">+ Adaugă alt furnizor</button></p> }
                @if (similarInvoices.Count > 0 && createdInvoice is null)
                {
                    <div class="invoice-warning" role="alert">
                        <p><strong>⚠ Nu există factura @invoiceNumber la acest furnizor, dar există una cu număr asemănător.</strong> Dacă este aceeași factură (numărul a fost citit greșit), continuă pe ea:</p>
                        @foreach (var similar in similarInvoices)
                        {
                            <button type="button" class="refresh act-confirm" disabled="@InvoiceLocked" @onclick="() => UseSimilarAsync(similar)">Da, este factura @similar.Number din @StockMovementRules.DisplayDate(similar.Date)</button>
                        }
                        <p class="muted">Dacă este o factură diferită, lasă numărul cum este: se înregistrează o factură nouă.</p>
                    </div>
                }
                @if (existingInvoice is not null && createdInvoice is null)
                {
                    <div class="invoice-warning" role="status">
                        <p><strong>⚠ Factura @existingInvoice.Number din @StockMovementRules.DisplayDate(existingInvoice.Date) a furnizorului @existingInvoice.SupplierName a mai fost preluată@(takenEntries.Count == 0 ? ", dar fără intrări în stoc" : $" ({takenEntries.Count} {(takenEntries.Count == 1 ? "intrare" : "intrări")})").</strong>
                            Preluarea continuă pe aceeași factură; produsele deja preluate sunt marcate la pasul 3 și nu se preiau din nou decât dacă alegi asta.</p>
                        @if (takenEntries.Count > 0)
                        {
                            <ul>@foreach (var entry in takenEntries) { <li>@entry.ProductName · @entry.Quantity buc. · @StockMovementRules.DisplayDate(entry.Date)</li> }</ul>
                        }
                    </div>
                }
            </section>
            <p class="muted">@pick.Count(item => item.ProductId is not null || item.Staged is not null) din @pick.Count rânduri au un produs ales sau pregătit. Nimic nu se salvează în acest pas; salvarea se face la pasul 3.</p>
            <div class="table-scroll">
                <table class="pickup-match">
                    <thead><tr><th>#</th>@foreach (var column in ShownColumns) { <th class="@ColumnClass(column)">@column.Title</th> }<th>Produs din catalog</th></tr></thead>
                    <tbody>
                        @for (var index = 0; index < pick.Count; index++)
                        {
                            var at = index;
                            var item = pick[index];
                            var rowHasBadNumber = ShownColumns.Any(column => NotANumber(column, item.Cells.GetValueOrDefault(column.Id, "")));
                            var warningColumnId = (ShownColumns.FirstOrDefault(column => column.Meaning == InvoiceColumnMeanings.Name) ?? ShownColumns.First()).Id;
                            <tr>
                                <td>@(index + 1)</td>
                                @foreach (var column in ShownColumns)
                                {
                                    var id = column.Id;
                                    var notNumber = NotANumber(column, item.Cells.GetValueOrDefault(id, ""));
                                    var cellText = item.Cells.GetValueOrDefault(id, "");
                                    <td class="@ColumnClass(column)">
                                        @if (column.Meaning == InvoiceColumnMeanings.Name)
                                        {
                                            @* The name is shown whole: the field grows in height with the text. *@
                                            <textarea class="pickup-cell pickup-name" rows="@NameRows(cellText)" aria-label="@column.Title, rândul @(index + 1)" value="@cellText" @onchange="args => EditCell(at, id, args.Value?.ToString() ?? string.Empty)"></textarea>
                                        }
                                        else {<input class="pickup-cell @(notNumber ? "invalid" : "")" data-numeric="@(IsNumeric(column) ? "" : null)" inputmode="@(IsNumeric(column) ? "decimal" : null)" aria-label="@column.Title, rândul @(index + 1)" aria-invalid="@(notNumber ? "true" : null)" title="@(notNumber ? "Valoarea nu este citită ca număr: corecteaz-o după factură." : null)" value="@item.Cells.GetValueOrDefault(id, "")" @onchange="args => EditCell(at, id, args.Value?.ToString() ?? string.Empty)" />}
                                        @if (rowHasBadNumber && id == warningColumnId) { <p class="pickup-row-warning" role="alert"><span class="pickup-warning-icon" aria-hidden="true">!</span> Atenție: unele valori din acest rând nu sunt numere (câmpurile cu fundal roșu). Corectați-le.</p>
                                            @if (RowPicture(item, [.. ShownColumns.Where(column => NotANumber(column, item.Cells.GetValueOrDefault(column.Id, "")))]) is { } rowPicture) { <img class="pickup-region pickup-row-picture" src="@rowPicture" alt="Rândul din factură, cu valorile necitite ca număr încadrate" /> } }</td>
                                }
                                <td class="pickup-product">
                                    @if (item.Match.Exact is { } exact)
                                    {
                                        <div class="pickup-exact"><span class="stock-badge in-stock"><span>●</span> Potrivire exactă</span> <strong>@exact.Name</strong> <small class="muted">@exact.Description · stoc @exact.Quantity buc.</small></div>
                                    }
                                    else if (item.Staged is { } staged)
                                    {
                                        <div class="pickup-exact"><span class="stock-badge low"><span>●</span> Produs nou pregătit</span> <strong>@staged.Input.Name</strong>
                                            <small class="muted">@staged.Input.Category / @staged.Input.Subcategory · nu e în catalog încă, se adaugă la finalizare</small>
                                            <button type="button" class="refresh act-edit" @onclick="() => OpenNewProduct(at)">Modifică</button>
                                            <button type="button" class="danger" @onclick="() => item.Staged = null">Renunță</button></div>
                                    }
                                    else
                                    {
                                        <fieldset class="pickup-alternatives">
                                            <legend class="muted">@(item.Match.Alternatives.Count == 0 ? "Niciun produs apropiat de codul „" + item.Match.Code + "”" : "Fără potrivire exactă pentru „" + item.Match.Code + "”. Alege cel mult un produs:")</legend>
                                            @foreach (var candidate in item.Match.Alternatives)
                                            {
                                                var productId = candidate.Product.Id;
                                                <label class="pickup-alternative"><input type="radio" name="@("pick-" + index)" checked="@(item.ProductId == productId)" @onchange="() => { item.ProductId = productId; item.Staged = null; }" />
                                                    <span><strong>@candidate.Product.Name</strong> <small class="muted">@candidate.Product.Description · stoc @candidate.Product.Quantity buc. · @((int)Math.Round(candidate.Score * 100))% asemănare</small></span></label>
                                            }
                                            <label class="pickup-alternative"><input type="radio" name="@("pick-" + index)" checked="@(item.ProductId is null)" @onchange="() => item.ProductId = null" /> <span>Niciunul dintre ele</span></label>
                                            <button type="button" class="refresh act-confirm" @onclick="() => OpenNewProduct(at)">+ Pregătește un produs nou</button>
                                        </fieldset>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
    @if (newProductFor is { } adding)
    {
        <div class="invoice-modal-backdrop">
            <div class="invoice-modal wide" role="dialog" aria-modal="true" aria-label="Adaugă produs">
                <ProductEditor @key="newProductKey" Staging="true" InitialName="@(adding.Staged?.Input.Name ?? adding.Match.Code)" InitialDescription="@(adding.Staged?.Input.Description ?? NewProductDescription(adding))"
                               InitialCategory="@(adding.Staged?.Input.Category ?? "")" InitialSubcategory="@(adding.Staged?.Input.Subcategory ?? "")" InitialImage="adding.Staged?.Image"
                               Groups="groups" Staged="NewProductStagedAsync" Closed="CloseNewProduct" />
            </div>
        </div>
    }
}
else
{
    <section class="wizard-panel" aria-label="@StepTitles[2]">
        <h2>@StepTitles[2]</h2>
        <p class="muted">Sumarul alegerilor din pasul 2. Abia la „Finalizează preluarea” se înregistrează factura, se adaugă produsele noi în catalog și se înregistrează intrările în stoc, legate de factură.</p>
        @if (finalizeError is not null) { <div class="error-banner" role="alert">@finalizeError</div> }
        @if (finalizeNotice is not null) { <div class="success-banner" role="status">@finalizeNotice</div> }
        @if (finished)
        {
            @foreach (var takenProduct in NewLines.Concat(ExistingLines).Where(line => line.Done && (line.CreatedProductId ?? line.ProductId) is not null).Select(line => (line.CreatedProductId ?? line.ProductId)!.Value).Distinct())
            {
                <ReserveSuggestions @key="@($"suggest-{takenProduct}")" ProductId="takenProduct" Trigger="1" />
            }
        }

        <h3>Factura și furnizorul</h3>
        <p>Factura <strong>@invoiceNumber</strong> din <strong>@(invoiceDate is { } issued ? StockMovementRules.DisplayDate(issued) : "—")</strong>, furnizor <strong>@(ResolvedSupplier?.Name ?? "—")</strong> (@(ResolvedSupplier?.Identifier ?? "—")); verificate la pasul 2.</p>
        @if (existingInvoice is not null && createdInvoice is null)
        {
            <div class="invoice-warning" role="status">⚠ Factura a mai fost preluată@(takenEntries.Count == 0 ? ", dar fără intrări în stoc" : $" ({takenEntries.Count} {(takenEntries.Count == 1 ? "intrare" : "intrări")})"): preluarea continuă pe ea, iar produsele deja preluate sunt marcate mai jos și nu se preiau din nou decât dacă alegi asta.</div>
        }
        @if (createdInvoice is not null) { <p class="success-banner" role="status">Factura @createdInvoice.Number a furnizorului @createdInvoice.SupplierName a fost înregistrată; intrările de mai jos i se leagă.</p> }

        <h3>1. Produse noi <span class="count-badge">@NewLines.Count</span></h3>
        @if (NewLines.Count == 0) { <p class="muted">Niciun produs nou.</p> }
        else
        {
            <label class="movement-date">Data intrării *
                <PickOnlyDate Id="entry-date-new" @bind-Value="newDate" Disabled="@(finalizing || finished)" Min="@StockMovementRules.StorageDate(StockMovementRules.EarliestDate)" Max="@StockMovementRules.StorageDate(StockMovementRules.Today)" /></label>
            @foreach (var line in NewLines) { @EntryCard(line) }
        }

        <h3>2. Produse existente introduse în stoc <span class="count-badge">@ExistingLines.Count</span></h3>
        @if (ExistingLines.Count == 0) { <p class="muted">Niciun produs existent.</p> }
        else
        {
            <label class="movement-date">Data intrării *
                <PickOnlyDate Id="entry-date-existing" @bind-Value="existingDate" Disabled="@(finalizing || finished)" Min="@StockMovementRules.StorageDate(StockMovementRules.EarliestDate)" Max="@StockMovementRules.StorageDate(StockMovementRules.Today)" /></label>
            @foreach (var line in ExistingLines) { @EntryCard(line) }
        }
        @if (pick.Count(item => item.ProductId is null && item.Staged is null) is > 0 and var skipped) { <p class="muted">@skipped @(skipped == 1 ? "rând fără produs ales nu va fi introdus" : "rânduri fără produs ales nu vor fi introduse").</p> }
        <div class="editor-actions">
            @if (finished) { <button type="button" class="primary" @onclick="NewPickupAsync">Preluare nouă</button> }
            else { <button type="button" class="primary" disabled="@(finalizing || !CanFinalize)" @onclick="FinalizeAsync">@(finalizing ? "Se salvează…" : "Finalizează preluarea")</button> }
        </div>
    </section>
}

@if (addingSupplier)
{
    <div class="invoice-modal-backdrop">
        <div class="invoice-modal wide" role="dialog" aria-modal="true" aria-label="Adaugă furnizor">
            <SupplierEditor @key="addSupplierKey" InitialCui="@(addFromInvoice ? supplierCuiText : "")" InitialName="@(addFromInvoice ? invoiceSupplierName : "")"
                            Saved="SupplierAddedAsync" Closed="CloseAddSupplier" />
        </div>
    </div>
}

<div class="wizard-nav">
    <button type="button" class="refresh act-nav" disabled="@(step == 1)" @onclick="PreviousStep">← Pasul precedent</button>
    <span class="muted">Pasul @step din @StepTitles.Length@(step == 1 && !CanLeaveStep1 ? " · citește o factură cu tabel și păstrează cel puțin un rând pentru a continua" : step == 2 && !CanLeaveStep2 ? " · alege sau pregătește un produs pentru cel puțin un rând" : "")@(step == 2 && !HeaderConfirmed && !step2Loading ? " · confirmă numărul facturii, CUI-ul furnizorului și data" : "")</span>
    @if (step < StepTitles.Length)
    {
        <button type="button" class="primary" disabled="@((step == 1 && !CanLeaveStep1) || (step == 2 && !CanLeaveStep2))" @onclick="NextStep">Pasul următor →</button>
    }
</div>

</PageBoundary>

@code {
    private static readonly string[] StepTitles = ["Citirea facturii", "Potrivirea produselor", "Confirmare"];
    private int step = 1;
    private bool CanLeaveStep1 => session is not null && reading is not null && rows.Count - excluded.Count > 0;
    private bool CanLeaveStep2 => !step2Loading && step2Error is null && pick.Any(item => item.ProductId is not null || item.Staged is not null) && HeaderConfirmed;

    private async Task NextStep()
    {
        if (step >= StepTitles.Length || (step == 1 && !CanLeaveStep1) || (step == 2 && !CanLeaveStep2)) return;
        step++;
        if (step == 2) { await BuildPickAsync(); await LoadSuppliersAsync(); }
        else if (step == 3) PrepareSummary();
    }

    // ---- step 3: summary of the choices, then the only place where anything is saved ----

    private DateOnly? newDate = StockMovementRules.Today, existingDate = StockMovementRules.Today;
    private bool finalizing, finished;
    private string? finalizeError, finalizeNotice;

    private List<PickRow> NewLines => pick.Where(item => item.Staged is not null).ToList();
    private List<PickRow> ExistingLines => pick.Where(item => item.Staged is null && item.ProductId is not null).ToList();
    // Rows whose product was already taken from this invoice are left out unless the user chose to take them again.
    private int? TakenQuantity(PickRow line) => line.Staged is null && line.ProductId is { } id && takenEntries.Where(entry => entry.ProductId == id).Sum(entry => entry.Quantity) is > 0 and var sum ? sum : null;
    // Stock of the existing product when it is negative (an operating error to be settled before the entry), else null.
    private int? NegativeStock(PickRow line) =>
        line.Staged is null && !line.Regularized && catalog.FirstOrDefault(product => product.Id == line.ProductId) is { Quantity: < 0 } found ? found.Quantity : null;
    private bool Skipped(PickRow line) => !line.Done && !line.RetakeAnyway && TakenQuantity(line) is not null;
    private bool CanFinalize => !finished && NewLines.Concat(ExistingLines).Any(line => !Skipped(line)) && supplierId is not null && invoiceNumber.Trim().Length > 0 && invoiceDate is not null;

    // ---- the invoice and its supplier: recorded with the first entry, every entry is tied to it ----

    private IReadOnlyList<Supplier> supplierList = [];
    private int? supplierId;
    private string invoiceNumber = "";
    private DateOnly? invoiceDate;
    private SupplierInvoice? createdInvoice, existingInvoice;
    private IReadOnlyList<InvoiceEntry> takenEntries = [];
    private IReadOnlyList<SupplierInvoice> similarInvoices = [];
    private bool NumberFromOcr => session?.Analysis.Source == InvoiceSources.Ocr;

    // "Yes, it is the same invoice": the number of the stored invoice replaces the one read (and is to be confirmed again).
    private async Task UseSimilarAsync(SupplierInvoice invoice)
    {
        invoiceNumber = invoice.Number;
        numberVerified = false;
        await RefreshExistingInvoiceAsync();
    }

    // The number, the supplier's CUI and the date are checked by the user in step 2, each on its own: they start as "neverificat" and any edit
    // of one of them puts it back there. Step 3 is reached only when all three are confirmed (and valid).
    private string supplierCuiText = "";
    private bool numberVerified, cuiVerified, dateVerified;
    private bool NumberValid => invoiceNumber.Trim().Length > 0;
    private bool DateValid => invoiceDate is not null;
    private Supplier? ResolvedSupplier => supplierList.FirstOrDefault(supplier => supplier.Id == supplierId);
    private bool HeaderConfirmed => numberVerified && cuiVerified && dateVerified && NumberValid && DateValid && ResolvedSupplier is not null;

    private RenderFragment VerifyBadge(bool verified) => @<span class="anaf-source @(verified ? "ok" : "warn")"><span aria-hidden="true">@(verified ? "✓" : "⚠")</span> @(verified ? "Verificat" : "Neverificat")</span>;

    // The supplier of the CUI as typed: a Romanian CUI by its digits, a VAT identifier of another state by its letters and digits.
    private void ResolveSupplier()
    {
        var digits = SupplierRules.CuiDigits(supplierCuiText);
        var compact = SupplierRules.CompactKey(supplierCuiText);
        supplierId = supplierList.FirstOrDefault(supplier => supplier.IsExternal ? compact.Length > 0 && SupplierRules.CompactKey(supplier.Cui) == compact
            : digits.Length > 0 && SupplierRules.CuiDigits(supplier.Cui) == digits)?.Id;
        // A supplier found in the register (by its CUI, its name, or just added) has its CUI verified by that very fact; the number and the date stay to be checked.
        cuiVerified = supplierId is not null;
    }

    private async Task NumberEdited(ChangeEventArgs e)
    {
        invoiceNumber = e.Value?.ToString() ?? "";
        numberVerified = false;
        await RefreshExistingInvoiceAsync();
    }

    private async Task CuiEdited(ChangeEventArgs e)
    {
        supplierCuiText = e.Value?.ToString() ?? "";
        cuiVerified = false;
        recognition = null;
        ResolveSupplier();
        await RefreshExistingInvoiceAsync();
    }

    private Task DateEdited(DateOnly? picked)
    {
        invoiceDate = picked;
        dateVerified = false;
        return Task.CompletedTask;
    }
    private string? supplierError;
    private string invoiceSupplierCui = "", invoiceSupplierName = "";
    private Guid? headerPrefilledFor;
    private bool addingSupplier, addFromInvoice;
    private int addSupplierKey;

    // Once the invoice is recorded the choice is fixed: a retry of the rows that failed goes to the same invoice.
    private bool InvoiceLocked => finalizing || finished || createdInvoice is not null;

    private async Task LoadSuppliersAsync()
    {
        supplierError = null;
        try { supplierList = await Suppliers.GetSuppliersAsync(lifetime.Token); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { return; }
        catch (Exception exception)
        {
            Logger.LogError("Supplier list loading failed ({ErrorType}).", exception.GetType().Name);
            supplierError = "Registrul de furnizori nu a putut fi citit. Reia „Pasul precedent” și „Pasul următor”.";
            supplierList = [];
        }
        if (headerPrefilledFor != session?.Id) { PrefillInvoiceHeader(); headerPrefilledFor = session?.Id; }
        else ResolveSupplier();
        await RefreshExistingInvoiceAsync();
    }

    // The number, the date and the supplier as the template read them from the invoice (the user checks and corrects them).
    private void PrefillInvoiceHeader()
    {
        string FieldValue(string meaning) => reading?.Extraction.Fields.FirstOrDefault(field => field.Meaning == meaning && field.Value.Trim().Length > 0)?.Value.Trim() ?? "";
        invoiceNumber = TextNormalization.ForObjectNameOrCode(FieldValue(InvoiceFieldMeanings.InvoiceNumber));
        invoiceDate = InvoiceValues.ParseDate(FieldValue(InvoiceFieldMeanings.InvoiceDate)) is { } date && date >= StockMovementRules.EarliestDate && date <= StockMovementRules.Today ? date : null;
        invoiceSupplierCui = InvoiceValues.NormalizeCui(FieldValue(InvoiceFieldMeanings.SupplierCui)) is { Length: > 0 } fromField ? fromField
            : session?.Analysis.SupplierCui is { Length: > 0 } fromAnalysis ? fromAnalysis
            : chosen?.Info.SupplierCui ?? "";
        invoiceSupplierName = FieldValue(InvoiceFieldMeanings.SupplierName) is { Length: > 0 } nameField ? nameField
            : session?.Analysis.SupplierName is { Length: > 0 } fromAnalysisName ? fromAnalysisName
            : chosen?.Info.SupplierName ?? "";
        supplierCuiText = invoiceSupplierCui;
        numberVerified = cuiVerified = dateVerified = false;   // read, not yet checked by the user
        ResolveSupplier();
        // The CUI read from the invoice found no supplier (misread, or not read): the name read from the invoice is looked up in the register,
        // legal form ignored (SC / S.C. / SRL / S.R.L.), and the supplier's own CUI is taken, to be checked against the text of the invoice.
        // One recognition for CUI, name, alias and near miss (SupplierRecognizer), with its method and confidence.
        BuildCuiSearchText();
        recognition = SupplierRecognizer.Recognize(supplierList, invoiceSupplierCui, invoiceSupplierName, cuiSearchText);
        initialRecognition = recognition;
        supplierByName = false;
        similarSupplier = null;
        if (recognition.NeedsConfirmation) similarSupplier = recognition.Supplier;
        else if (supplierId is null && recognition.Supplier is { } found)
        {
            supplierCuiText = found.Cui;
            supplierId = found.Id;
            supplierByName = true;
        }
        cuiVerified = ResolvedSupplier is not null;
    }

    private bool supplierByName;
    private Supplier? similarSupplier;
    private SupplierRecognition? recognition;
    private SupplierRecognition? initialRecognition;   // what the recognition proposed when the invoice was read (kept when the user edits the CUI)
    private int? autoTemplateId;
    private bool templateChanged;

    // The proposal and the final choice go to the recognition log (to see where the reading goes wrong); never blocks recording the invoice.
    private async Task RecordRecognitionAsync(int invoiceId)
    {
        if (Services.GetService<ISupplierRecognitionLog>() is not { } log) return;
        var proposed = initialRecognition ?? new SupplierRecognition(null, SupplierMatchMethod.None, "low");
        try
        {
            await log.RecordAsync(new SupplierRecognitionEntry(invoiceId, proposed.Method, proposed.Confidence, invoiceSupplierName, invoiceSupplierCui, proposed.Supplier?.Id, supplierId, templateChanged), lifetime.Token);
        }
        catch (Exception exception) when (exception is not OperationCanceledException) { Logger.LogWarning("Recording the supplier recognition failed ({ErrorType}).", exception.GetType().Name); }
    }

    // The near-miss supplier is only proposed (the OCR may have misread a letter): the user confirms, and the CUI is then checked as usual.
    private void UseSimilarSupplier()
    {
        if (similarSupplier is not { } suggested) return;
        supplierCuiText = suggested.Cui;
        cuiVerified = false;
        similarSupplier = null;
        ResolveSupplier();
    }
    private string aliasNotice = "";

    // The name read from the invoice, when the supplier was chosen another way (CUI or by hand) and the name is not yet one of its names: the
    // user can keep it as an alias, so the next invoice with that writing is recognised by name.
    private string? AliasOffer =>
        ResolvedSupplier is { } supplier && invoiceSupplierName.Trim() is { Length: > 0 } read && !supplierByName
        && SupplierRules.AliasProblem(read, supplier, supplierList) is null ? read : null;

    private async Task RememberAliasAsync()
    {
        if (AliasOffer is not { } read || ResolvedSupplier is not { } supplier) return;
        try
        {
            await Suppliers.AddAliasAsync(supplier, read, lifetime.Token);
            aliasNotice = $"Denumirea „{read}” a fost reținută pentru {supplier.Name}.";
            supplierList = await Suppliers.GetSuppliersAsync(lifetime.Token);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) when (exception is SupplierOperationException or AccessDeniedException) { supplierError = exception.Message; }
        catch (NotSupportedException) { }
    }

    // Whether the CUI of the supplier chosen from the register is written in the invoice (the text read from the file, or by OCR).
    private bool? CuiInInvoice
    {
        get
        {
            if (ResolvedSupplier is not { } supplier || session is null) return null;
            BuildCuiSearchText();
            var key = supplier.IsExternal ? SupplierRules.CompactKey(supplier.Cui) : SupplierRules.CuiDigits(supplier.Cui);
            if (key.Length == 0) return null;
            return cuiSearchText.Length > 0 && cuiSearchText.Contains(key, StringComparison.Ordinal);
        }
    }

    private Guid? cuiSearchFor;
    private string cuiSearchText = "";

    private void BuildCuiSearchText()
    {
        if (cuiSearchFor == session?.Id) return;
        cuiSearchFor = session?.Id;
        cuiSearchText = session is null ? "" : SupplierRules.CompactKey(string.Concat(session.Document.AllWords.Select(word => word.Text)));
    }

    // The invoice of this supplier and number may have been taken before, in part: what was taken is read, so the pickup continues on the same
    // invoice and the products already taken are marked.
    private async Task RefreshExistingInvoiceAsync()
    {
        if (createdInvoice is not null) return;
        existingInvoice = null; takenEntries = []; similarInvoices = [];
        if (supplierId is null || invoiceNumber.Trim().Length == 0) return;
        try
        {
            existingInvoice = await SupplierInvoices.FindAsync(supplierId.Value, invoiceNumber, lifetime.Token);
            if (existingInvoice is not null)
            {
                takenEntries = await SupplierInvoices.GetEntriesAsync(existingInvoice.Id, lifetime.Token);
                if (invoiceDate != existingInvoice.Date) { invoiceDate = existingInvoice.Date; dateVerified = false; }   // the stored date; to be confirmed
            }
            else
            {
                // OCR can misread the number: invoices of this supplier with a look-alike number (and the same date, when it is known) are offered.
                similarInvoices = [.. (await SupplierInvoices.GetForSupplierAsync(supplierId.Value, lifetime.Token))
                    .Where(item => SupplierInvoiceRules.LooksLike(invoiceNumber, item.Number) && (invoiceDate is null || item.Date == invoiceDate))];
            }
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Logger.LogError("Reading the invoice taken earlier failed ({ErrorType}).", exception.GetType().Name);
            existingInvoice = null; takenEntries = [];
            supplierError = "Nu s-a putut verifica dacă factura a mai fost preluată. Reia „Pasul precedent” și „Pasul următor”.";
        }
    }

    private void OpenAddSupplier(bool fromInvoice) { addFromInvoice = fromInvoice; addSupplierKey++; addingSupplier = true; }
    private Task CloseAddSupplier() { addingSupplier = false; return Task.CompletedTask; }

    // The supplier was saved in the window: it is offered and chosen at once.
    private async Task SupplierAddedAsync(Supplier saved)
    {
        addingSupplier = false;
        supplierCuiText = saved.Cui;   // the supplier's own tax id is now in the field: to be confirmed
        cuiVerified = false;
        await LoadSuppliersAsync();
    }

    // ---- pictures of the regions the values were read from (the user compares them with what was read) ----

    private readonly Dictionary<string, string?> regionPictures = [];

    private string? PageRegionPicture(string key, int pageNumber, InvoiceBox area, IEnumerable<InvoiceBox> outlines, double marginX = InvoiceRegionPicture.Margin)
    {
        if (session is null) return null;
        if (regionPictures.TryGetValue(key, out var cached)) return cached;
        var page = session.Document.Pages.FirstOrDefault(item => item.Number == pageNumber);
        var picture = page is not null && pageNumber >= 1 && pageNumber <= session.Previews.Count
            ? InvoiceRegionPicture.DataUri(session.Previews[pageNumber - 1], page, area, outlines, marginX) : null;
        return regionPictures[key] = picture;
    }

    // The label and the value of a header field (number, date) as the template read them on this file, the value outlined.
    private string? HeaderFieldPicture(string meaning)
    {
        if (overlay?.Fields.FirstOrDefault(item => item.Meaning == meaning && item.Use && item.Width > 0 && item.Height > 0) is not { } field) return null;
        var left = field.LabelX > 0 && field.LabelX < field.X ? field.LabelX : field.X;
        var top = field.LabelY > 0 ? Math.Min(field.LabelY, field.Y) : field.Y;
        var area = new InvoiceBox(field.Page, left, top, Math.Max(1, field.X + field.Width - left), Math.Max(1, field.Y + field.Height - top));
        return PageRegionPicture($"field|{meaning}|{field.Page}|{field.X:F1}|{field.Y:F1}", field.Page, area, [], 12);
    }

    // The table row as it stands on the page, the cells that are not read as numbers outlined.
    private string? RowPicture(PickRow item, IReadOnlyList<ShownColumn> bad)
    {
        if (reading is null || item.Page < 1 || item.Bottom <= item.Top || bad.Count == 0) return null;
        var columns = reading.Extraction.Columns.Where(column => ShownColumns.Any(shown => shown.Id == column.Id)).ToList();
        if (columns.Count == 0) return null;
        var left = columns.Min(column => column.Left);
        var right = columns.Max(column => column.Right);
        var outlines = columns.Where(column => bad.Any(shown => shown.Id == column.Id))
            .Select(column => new InvoiceBox(item.Page, column.Left, item.Top, Math.Max(1, column.Right - column.Left), item.Bottom - item.Top)).ToList();
        var area = new InvoiceBox(item.Page, left, item.Top, Math.Max(1, right - left), item.Bottom - item.Top);
        return PageRegionPicture($"row|{item.Page}|{item.Top:F1}|{item.Bottom:F1}|{string.Join(",", bad.Select(shown => shown.Id))}", item.Page, area, outlines, 6);
    }

    private void ResetInvoiceHeader()
    {
        createdInvoice = existingInvoice = null; takenEntries = []; similarInvoices = []; supplierId = null; invoiceNumber = ""; invoiceDate = null; headerPrefilledFor = null;
        invoiceSupplierCui = invoiceSupplierName = supplierCuiText = "";
