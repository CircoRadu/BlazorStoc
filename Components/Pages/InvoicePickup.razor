@page "/produse/preluare-factura"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@using BlazorStoc.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IAccessControl Access
@inject IInvoiceAnalysisService Analysis
@inject IInvoiceTemplateService Templates
@inject IProductRepository ProductsRepository
@inject IStockMovementRepository Movements
@inject IProductImageStore ImageStore
@inject IJSRuntime JS
@inject ILogger<InvoicePickup> Logger
@implements IAsyncDisposable

<PageTitle>Preluare factură · BlazorStoc</PageTitle>
<UnsavedChangesHost />
<div class="page-heading">
    <div><p class="eyebrow">PRODUSE</p><h1>Preluare factură</h1>
        <p class="muted">Încarcă factura PDF a furnizorului: se citește după șablonul detectat, iar liniile de demarcare dintre rânduri pot fi corectate.</p></div>
</div>

<ol class="wizard-steps" aria-label="Pașii preluării facturii">
    @for (var number = 1; number <= StepTitles.Length; number++)
    {
        var current = number;
        <li class="wizard-step @(current < step ? "done" : current == step ? "current" : "todo")" aria-current="@(current == step ? "step" : null)">
            <span class="wizard-circle">@(current < step ? "✓" : current.ToString(CultureInfo.InvariantCulture))</span>
            <span class="wizard-title">@StepTitles[current - 1]</span>
        </li>
    }
</ol>

@if (step == 1)
{
<FileDropZone Id="invoice-pickup-file" Accept=".pdf,application/pdf" Text="Alege factura PDF" OnChange="FileSelectedAsync" Disabled="@(loading || loadError is not null || busy)" />

@if (loadError is not null) { <div class="error-banner" role="alert">@loadError</div> }
@if (error is not null) { <div class="error-banner" role="alert">@error</div> }
@if (notice is not null) { <div class="success-banner" role="status">@notice</div> }

@if (loading)
{
    <div class="empty-state" role="status"><div class="spinner"></div><h3>Se verifică drepturile de acces</h3></div>
}
else if (busy)
{
    <div class="empty-state" role="status"><div class="spinner"></div><h3>Se citește factura…</h3><p>O pagină scanată poate dura câteva secunde.</p></div>
}
else if (loadError is null && session is null)
{
    <div class="empty-state"><h3>Nicio factură încărcată</h3><p>Alege fișierul PDF al facturii sau trage-l în câmpul de mai sus.</p></div>
}
else if (session is not null)
{
    var pageData = CurrentPageData;
    <section class="invoice-head" aria-label="Fișierul citit">
        <div><strong>@session.FileName</strong> <span class="muted">· @session.Document.Pages.Count @(session.Document.Pages.Count == 1 ? "pagină" : "pagini")</span></div>
        <button type="button" class="danger" @onclick="DiscardAsync">Renunță și elimină fișierul</button>
    </section>

    @if (templateInfo is not null)
    {
        <div class="invoice-suggestions" role="status">
            <strong>@templateInfo</strong>
            @if (suggestions.Count > 1)
            {
                <label class="muted">Alt șablon:
                    <select @onchange="ChooseTemplate" aria-label="Alege șablonul de citire">
                        @foreach (var suggestion in suggestions)
                        {
                            <option value="@suggestion.Template.Info.Id" selected="@(chosen?.Info.Id == suggestion.Template.Info.Id)">@suggestion.Template.Info.Name · @SupplierLabel(suggestion.Template.Info)</option>
                        }
                    </select>
                </label>
            }
        </div>
    }
    @foreach (var warning in session.Analysis.Warnings) { <div class="invoice-warning" role="status">⚠ @warning</div> }

    @if (reading is null)
    {
        <div class="empty-state"><h3>Tabelul cu liniile facturii nu a fost găsit</h3><p>Nu există un șablon salvat potrivit, iar citirea automată nu a găsit tabelul. Creează șablonul în Setări → Facturi.</p></div>
    }
    else
    {
        <div class="invoice-layout">
            <div class="invoice-pages">
                @if (session.Document.Pages.Count > 1)
                {
                    <div class="invoice-page-tabs" role="tablist" aria-label="Paginile facturii">
                        @foreach (var page in session.Document.Pages)
                        {
                            var number = page.Number;
                            <button type="button" role="tab" class="invoice-page-tab @(number == currentPage ? "active" : "")" aria-selected="@(number == currentPage ? "true" : "false")" @onclick="() => currentPage = number">Pagina @number</button>
                        }
                    </div>
                }
                <div class="invoice-draw-tools">
                    <button type="button" class="refresh @(addMode ? "active" : "")" aria-pressed="@(addMode ? "true" : "false")" @onclick="() => addMode = !addMode">─ Adaugă linie de demarcare</button>
                    <button type="button" class="danger" disabled="@(selectedId.Length == 0)" @onclick="DeleteSelected">Șterge linia selectată</button>
                    <button type="button" class="refresh" @onclick="ResetSeparators">Liniile propuse automat</button>
                    <span class="muted">@(addMode ? "Apasă pe pagină, la înălțimea la care vrei linia." : "Trage o linie în sus sau în jos; trage capetele ei ca să o scurtezi sau să o lungești. Ce este sub ultima linie nu se citește.")</span>
                </div>
                <div class="invoice-draw-tools" role="group" aria-label="Ce din șablon se vede pe pagină">
                    <label class="check-label"><input type="checkbox" checked="@showFields" @onchange="args => showFields = args.Value is true" /> <span>Câmpurile din antet</span></label>
                    <label class="check-label"><input type="checkbox" checked="@showHeader" @onchange="args => showHeader = args.Value is true" /> <span>Capul de tabel</span></label>
                    <label class="check-label"><input type="checkbox" checked="@showColumns" @onchange="args => showColumns = args.Value is true" /> <span>Coloanele</span></label>
                </div>
                <div class="invoice-page-wrap" style="aspect-ratio: @F(pageData.Width) / @F(pageData.Height)">
                    <img src="@ImageUrl(pageData.Number)" alt="Pagina @pageData.Number a facturii" draggable="false" />
                    <svg class="invoice-overlay sep-overlay @(addMode ? "drawing" : "")" viewBox="0 0 @F(pageData.Width) @F(pageData.Height)" preserveAspectRatio="none"
                         data-sep-svg data-sep-add="@(addMode ? "true" : "false")" data-sep-page="@pageData.Number" role="group" aria-label="Liniile de demarcare ale tabelului pe pagina @pageData.Number">
                        @if (showColumns && BodyRange(pageData) is { } body)
                        {
                            @foreach (var column in ColumnsOn(pageData))
                            {
                                <rect class="invoice-column used pickup-static" style="--col: @ColumnColor(column)" x="@F(column.Left)" y="@F(body.Top)" width="@F(Math.Max(1, column.Right - column.Left))" height="@F(Math.Max(1, body.Bottom - body.Top))"><title>@(column.Label.Length > 0 ? column.Label : InvoiceVocabulary.ColumnTitle(column.Meaning))</title></rect>
                            }
                        }
                        @if (overlay is not null)
                        {
                            @if (showHeader && overlay.HasTable && overlay.HeaderPage == pageData.Number && overlay.Columns.Count > 0)
                            {
                                <rect class="invoice-header-band pickup-static" x="@F(overlay.Columns.Min(column => column.Left))" y="@F(overlay.HeaderTop)" width="@F(Math.Max(1, overlay.Columns.Max(column => column.Right) - overlay.Columns.Min(column => column.Left)))" height="@F(Math.Max(1, overlay.HeaderBottom - overlay.HeaderTop))"><title>Capul de tabel</title></rect>
                                @foreach (var cell in overlay.Columns)
                                {
                                    var cellTop = cell.CellBottom > cell.CellTop ? cell.CellTop : overlay.HeaderTop;
                                    var cellBottom = cell.CellBottom > cell.CellTop ? cell.CellBottom : overlay.HeaderBottom;
                                    <rect class="invoice-hcell pickup-static" style="--col: @ColumnColor(cell.Id)" x="@F(cell.Left)" y="@F(cellTop)" width="@F(Math.Max(1, cell.Right - cell.Left))" height="@F(Math.Max(1, cellBottom - cellTop))"><title>@(cell.Label.Length > 0 ? cell.Label : cell.HeaderText)</title></rect>
                                }
                            }
                            @if (showFields)
                            {
                                @foreach (var field in overlay.Fields.Where(field => field.Use && field.Page == pageData.Number))
                                {
                                    <rect class="invoice-field pickup-static" x="@F(field.X)" y="@F(field.Y)" width="@F(Math.Max(1, field.Width))" height="@F(Math.Max(1, field.Height))"><title>@InvoiceTemplateDraft.EffectiveLabel(field): @field.Value</title></rect>
                                    <g><text class="pickup-field-label" x="@F(field.X)" y="@F(Math.Max(pageData.Height / 110, field.Y - 1.5))" font-size="@F(pageData.Width / 110)">@InvoiceTemplateDraft.EffectiveLabel(field)</text></g>
                                }
                            }
                        }
                        @{ var size = pageData.Width / 110; }
                        @foreach (var separator in separators.Where(item => item.Page == pageData.Number))
                        {
                            var id = separator.Id;
                            var selected = id == selectedId;
                            <g class="sep-line @(selected ? "selected" : "")" data-sep-id="@id" data-sep-y="@F(separator.Y)" data-sep-left="@F(separator.Left)" data-sep-right="@F(separator.Right)"
                               @onclick="() => Select(id)" @onclick:stopPropagation="true">
                                <line class="sep-visible" x1="@F(separator.Left)" x2="@F(separator.Right)" y1="@F(separator.Y)" y2="@F(separator.Y)" />
                                <line class="sep-hit" data-sep-handle="move" x1="@F(separator.Left)" x2="@F(separator.Right)" y1="@F(separator.Y)" y2="@F(separator.Y)"><title>Trage pentru a muta linia</title></line>
                                @if (selected)
                                {
                                    <rect class="sep-end" data-sep-handle="left" x="@F(separator.Left - size / 2)" y="@F(separator.Y - size / 2)" width="@F(size)" height="@F(size)"><title>Trage pentru a schimba începutul liniei</title></rect>
                                    <rect class="sep-end" data-sep-handle="right" x="@F(separator.Right - size / 2)" y="@F(separator.Y - size / 2)" width="@F(size)" height="@F(size)"><title>Trage pentru a schimba sfârșitul liniei</title></rect>
                                    <g class="invoice-delete" role="button" tabindex="0" aria-label="Șterge linia de demarcare" @onclick="DeleteSelected" @onclick:stopPropagation="true">
                                        <title>Șterge linia</title>
                                        <circle cx="@F(Math.Min(pageData.Width - size * 1.2, separator.Right + size * 1.8))" cy="@F(separator.Y)" r="@F(size * 1.1)" />
                                        <text x="@F(Math.Min(pageData.Width - size * 1.2, separator.Right + size * 1.8))" y="@F(separator.Y + size * 0.55)" font-size="@F(size * 1.6)" text-anchor="middle">×</text>
                                    </g>
                                }
                            </g>
                        }
                    </svg>
                </div>
            </div>

            <section class="catalog" aria-label="Rândurile citite">
                <div class="catalog-heading"><span class="category-title">Rânduri citite din factură (@rows.Count) · preluate: @(rows.Count - excluded.Count)</span></div>
                @if (rows.Count == 0)
                {
                    <div class="empty-state"><h3>Niciun rând între liniile de demarcare</h3><p>Pune cel puțin două linii de demarcare, deasupra și sub rândurile tabelului.</p></div>
                }
                else
                {
                    <div class="table-scroll">
                        <table>
                            <thead><tr>
                                <th><input type="checkbox" aria-label="Preia toate rândurile" checked="@(excluded.Count == 0)" @onchange="args => ToggleAll(args.Value is true)" /></th>
                                <th>#</th>@foreach (var column in ShownColumns) { <th>@column.Title</th> }<th>Pagina</th></tr></thead>
                            <tbody>
                                @for (var index = 0; index < rows.Count; index++)
                                {
                                    var row = rows[index];
                                    var at = index;
                                    <tr class="@(excluded.Contains(index) ? "row-off" : "")">
                                        <td><input type="checkbox" aria-label="Preia rândul @(index + 1)" checked="@(!excluded.Contains(index))" @onchange="args => ToggleRow(at, args.Value is true)" /></td>
                                        <td>@(index + 1)</td>
                                        @foreach (var column in ShownColumns) { <td>@row.Cells.GetValueOrDefault(column.Id, "")</td> }
                                        <td>@row.Page @foreach (var flag in row.Flags) { <span class="uncertain-badge" title="@flag">⚠ @flag</span> }</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>
    }
}
}
else if (step == 2)
{
    <section class="wizard-panel" aria-label="@StepTitles[1]">
        <h2>@StepTitles[1]</h2>
        <p class="muted">Rândurile preluate din <strong>@session?.FileName</strong> pot fi corectate. Pentru fiecare, se caută în catalog produsul cu același cod; dacă nu există, se oferă cele mai apropiate, sau se pregătește un produs nou (se adaugă în catalog abia la pasul 3). Cantitățile și prețurile care nu sunt citite ca număr au fundal roșu.</p>
        @if (session is not null)
        {
            <p><a class="refresh button-link" href="@ViewerUrl" target="invoice-viewer" rel="noopener"
                  onclick="window.open(this.href, 'invoice-viewer', 'popup=yes,width=1000,height=900'); return false;">Afișează factura într-o fereastră nouă</a>
                <span class="muted">Fereastra se poate muta lângă acest tabel, ca să confrunți valorile cu factura.</span></p>
        }
        @if (step2Error is not null) { <div class="error-banner" role="alert">@step2Error</div> }
        @if (step2Loading) { <div class="empty-state" role="status"><div class="spinner"></div><h3>Se caută produsele în catalog</h3></div> }
        else if (step2Error is null)
        {
            <p class="muted">@pick.Count(item => item.ProductId is not null || item.Staged is not null) din @pick.Count rânduri au un produs ales sau pregătit. Nimic nu se salvează în acest pas; salvarea se face la pasul 3.</p>
            <div class="table-scroll">
                <table class="pickup-match">
                    <thead><tr><th>#</th>@foreach (var column in ShownColumns) { <th class="@ColumnClass(column)">@column.Title</th> }<th>Produs din catalog</th></tr></thead>
                    <tbody>
                        @for (var index = 0; index < pick.Count; index++)
                        {
                            var at = index;
                            var item = pick[index];
                            var rowHasBadNumber = ShownColumns.Any(column => NotANumber(column, item.Cells.GetValueOrDefault(column.Id, "")));
                            var warningColumnId = (ShownColumns.FirstOrDefault(column => column.Meaning == InvoiceColumnMeanings.Name) ?? ShownColumns.First()).Id;
                            <tr>
                                <td>@(index + 1)</td>
                                @foreach (var column in ShownColumns)
                                {
                                    var id = column.Id;
                                    var notNumber = NotANumber(column, item.Cells.GetValueOrDefault(id, ""));
                                    var cellText = item.Cells.GetValueOrDefault(id, "");
                                    <td class="@ColumnClass(column)">
                                        @if (column.Meaning == InvoiceColumnMeanings.Name)
                                        {
                                            @* The name is shown whole: the field grows in height with the text. *@
                                            <textarea class="pickup-cell pickup-name" rows="@NameRows(cellText)" aria-label="@column.Title, rândul @(index + 1)" value="@cellText" @onchange="args => EditCell(at, id, args.Value?.ToString() ?? string.Empty)"></textarea>
                                        }
                                        else {<input class="pickup-cell @(notNumber ? "invalid" : "")" data-numeric="@(IsNumeric(column) ? "" : null)" inputmode="@(IsNumeric(column) ? "decimal" : null)" aria-label="@column.Title, rândul @(index + 1)" aria-invalid="@(notNumber ? "true" : null)" title="@(notNumber ? "Valoarea nu este citită ca număr: corecteaz-o după factură." : null)" value="@item.Cells.GetValueOrDefault(id, "")" @onchange="args => EditCell(at, id, args.Value?.ToString() ?? string.Empty)" />}
                                        @if (rowHasBadNumber && id == warningColumnId) { <p class="pickup-row-warning" role="alert"><span class="pickup-warning-icon" aria-hidden="true">!</span> Atenție: unele valori din acest rând nu sunt numere (câmpurile cu fundal roșu). Corectați-le.</p> }</td>
                                }
                                <td class="pickup-product">
                                    @if (item.Match.Exact is { } exact)
                                    {
                                        <div class="pickup-exact"><span class="stock-badge in-stock"><span>●</span> Potrivire exactă</span> <strong>@exact.Name</strong> <small class="muted">@exact.Description · stoc @exact.Quantity buc.</small></div>
                                    }
                                    else if (item.Staged is { } staged)
                                    {
                                        <div class="pickup-exact"><span class="stock-badge low"><span>●</span> Produs nou pregătit</span> <strong>@staged.Input.Name</strong>
                                            <small class="muted">@staged.Input.Category / @staged.Input.Subcategory · nu e în catalog încă, se adaugă la finalizare</small>
                                            <button type="button" class="refresh" @onclick="() => OpenNewProduct(at)">Modifică</button>
                                            <button type="button" class="danger" @onclick="() => item.Staged = null">Renunță</button></div>
                                    }
                                    else
                                    {
                                        <fieldset class="pickup-alternatives">
                                            <legend class="muted">@(item.Match.Alternatives.Count == 0 ? "Niciun produs apropiat de codul „" + item.Match.Code + "”" : "Fără potrivire exactă pentru „" + item.Match.Code + "”. Alege cel mult un produs:")</legend>
                                            @foreach (var candidate in item.Match.Alternatives)
                                            {
                                                var productId = candidate.Product.Id;
                                                <label class="pickup-alternative"><input type="radio" name="@("pick-" + index)" checked="@(item.ProductId == productId)" @onchange="() => { item.ProductId = productId; item.Staged = null; }" />
                                                    <span><strong>@candidate.Product.Name</strong> <small class="muted">@candidate.Product.Description · stoc @candidate.Product.Quantity buc. · @((int)Math.Round(candidate.Score * 100))% asemănare</small></span></label>
                                            }
                                            <label class="pickup-alternative"><input type="radio" name="@("pick-" + index)" checked="@(item.ProductId is null)" @onchange="() => item.ProductId = null" /> <span>Niciunul dintre ele</span></label>
                                            <button type="button" class="refresh" @onclick="() => OpenNewProduct(at)">+ Pregătește un produs nou</button>
                                        </fieldset>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
    @if (newProductFor is { } adding)
    {
        <div class="invoice-modal-backdrop">
            <div class="invoice-modal wide" role="dialog" aria-modal="true" aria-label="Adaugă produs">
                <ProductEditor @key="newProductKey" Staging="true" InitialName="@(adding.Staged?.Input.Name ?? adding.Match.Code)" InitialDescription="@(adding.Staged?.Input.Description ?? NewProductDescription(adding))"
                               InitialCategory="@(adding.Staged?.Input.Category ?? "")" InitialSubcategory="@(adding.Staged?.Input.Subcategory ?? "")" InitialImage="adding.Staged?.Image"
                               Groups="groups" Staged="NewProductStagedAsync" Closed="CloseNewProduct" />
            </div>
        </div>
    }
}
else
{
    <section class="wizard-panel" aria-label="@StepTitles[2]">
        <h2>@StepTitles[2]</h2>
        <p class="muted">Sumarul alegerilor din pasul 2. Abia la „Finalizează preluarea” se adaugă produsele noi în catalog și se înregistrează intrările în stoc.</p>
        @if (finalizeError is not null) { <div class="error-banner" role="alert">@finalizeError</div> }
        @if (finalizeNotice is not null) { <div class="success-banner" role="status">@finalizeNotice</div> }

        <h3>1. Produse noi (@NewLines.Count)</h3>
        @if (NewLines.Count == 0) { <p class="muted">Niciun produs nou.</p> }
        else
        {
            <label class="movement-date">Data intrării *
                <PickOnlyDate Id="entry-date-new" @bind-Value="newDate" Disabled="@(finalizing || finished)" Min="@StockMovementRules.StorageDate(StockMovementRules.EarliestDate)" Max="@StockMovementRules.StorageDate(StockMovementRules.Today)" /></label>
            @foreach (var line in NewLines) { @EntryCard(line) }
        }

        <h3>2. Produse existente introduse în stoc (@ExistingLines.Count)</h3>
        @if (ExistingLines.Count == 0) { <p class="muted">Niciun produs existent.</p> }
        else
        {
            <label class="movement-date">Data intrării *
                <PickOnlyDate Id="entry-date-existing" @bind-Value="existingDate" Disabled="@(finalizing || finished)" Min="@StockMovementRules.StorageDate(StockMovementRules.EarliestDate)" Max="@StockMovementRules.StorageDate(StockMovementRules.Today)" /></label>
            @foreach (var line in ExistingLines) { @EntryCard(line) }
        }
        @if (pick.Count(item => item.ProductId is null && item.Staged is null) is > 0 and var skipped) { <p class="muted">@skipped @(skipped == 1 ? "rând fără produs ales nu va fi introdus" : "rânduri fără produs ales nu vor fi introduse").</p> }
        <div class="editor-actions">
            @if (finished) { <button type="button" class="primary" @onclick="NewPickupAsync">Preluare nouă</button> }
            else { <button type="button" class="primary" disabled="@(finalizing || !CanFinalize)" @onclick="FinalizeAsync">@(finalizing ? "Se salvează…" : "Finalizează preluarea")</button> }
        </div>
    </section>
}

<div class="wizard-nav">
    <button type="button" class="refresh" disabled="@(step == 1)" @onclick="PreviousStep">← Pasul precedent</button>
    <span class="muted">Pasul @step din @StepTitles.Length@(step == 1 && !CanLeaveStep1 ? " · citește o factură cu tabel și păstrează cel puțin un rând pentru a continua" : step == 2 && !CanLeaveStep2 ? " · alege sau pregătește un produs pentru cel puțin un rând" : "")</span>
    @if (step < StepTitles.Length)
    {
        <button type="button" class="primary" disabled="@((step == 1 && !CanLeaveStep1) || (step == 2 && !CanLeaveStep2))" @onclick="NextStep">Pasul următor →</button>
    }
</div>

@code {
    private static readonly string[] StepTitles = ["Citirea facturii", "Potrivirea produselor", "Confirmare"];
    private int step = 1;
    private bool CanLeaveStep1 => session is not null && reading is not null && rows.Count - excluded.Count > 0;
    private bool CanLeaveStep2 => !step2Loading && step2Error is null && pick.Any(item => item.ProductId is not null || item.Staged is not null);

    private async Task NextStep()
    {
        if (step >= StepTitles.Length || (step == 1 && !CanLeaveStep1) || (step == 2 && !CanLeaveStep2)) return;
        step++;
        if (step == 2) await BuildPickAsync();
        else if (step == 3) PrepareSummary();
    }

    // ---- step 3: summary of the choices, then the only place where anything is saved ----

    private DateOnly? newDate = StockMovementRules.Today, existingDate = StockMovementRules.Today;
    private bool finalizing, finished;
    private string? finalizeError, finalizeNotice;

    private List<PickRow> NewLines => pick.Where(item => item.Staged is not null).ToList();
    private List<PickRow> ExistingLines => pick.Where(item => item.Staged is null && item.ProductId is not null).ToList();
    private bool CanFinalize => !finished && (NewLines.Count + ExistingLines.Count) > 0;

    private string? QuantityColumnId => reading?.Extraction.Columns.FirstOrDefault(column => column.Meaning == InvoiceColumnMeanings.Quantity)?.Id;

    // The quantity of a row (a whole number, as stock is counted in pieces) or why it cannot be used.
    private (int? Quantity, string? Error) QuantityOf(PickRow line)
    {
        if (QuantityColumnId is not { } id) return (null, "Șablonul nu citește o coloană cu cantitatea.");
        var text = line.Cells.GetValueOrDefault(id, "");
        if (InvoiceValues.ParseNumber(text, NumberHint) is not { } number) return (null, "Cantitatea „" + text + "” nu este un număr.");
        if (number != decimal.Truncate(number) || number < 1 || number > StockMovementRules.MaxQuantity)
            return (null, $"Cantitatea trebuie să fie un număr întreg între 1 și {StockMovementRules.MaxQuantity:N0} (este „{text}”). Corecteaz-o în pasul 2.");
        return ((int)number, null);
    }

    // The description of each entry is generated from the template (and kept as the user edited it afterwards).
    private void PrepareSummary()
    {
        finalizeError = finalizeNotice = null;
        foreach (var line in pick.Where(item => !item.DescriptionEdited))
            line.EntryDescription = overlay is null ? "" : InvoiceProductDescription.RenderRow(overlay, reading!.Extraction.Fields, WithCode(line), NumberHint);
    }

    // The cells of the row, with the product code as the pickup found it (so that <Cod produs> has a value whether or not the template has a code column).
    private IReadOnlyDictionary<string, string> WithCode(PickRow line)
    {
        var cells = new Dictionary<string, string>(line.Cells);
        if (!cells.TryGetValue("code", out var code) || code.Length == 0) cells["code"] = line.Match.Code;
        return cells;
    }

    private RenderFragment EntryCard(PickRow line) => @<article class="pickup-entry @(line.Done ? "done" : "")">
        <header>
            @if (line.Staged is { } staged)
            {
                <strong>@staged.Input.Name</strong> <small class="muted">produs nou · @staged.Input.Category / @staged.Input.Subcategory@(staged.Input.Description.Length > 0 ? " · " + staged.Input.Description : "")</small>
            }
            else if (catalog.FirstOrDefault(product => product.Id == line.ProductId) is { } product)
            {
                <strong>@product.Name</strong> <small class="muted">@product.Description · stoc actual @product.Quantity buc.</small>
            }
            @{ var (quantity, quantityError) = QuantityOf(line); }
            @if (quantityError is null) { <span class="stock-badge in-stock"><span>●</span> + @quantity buc.</span> }
            else { <span class="validation-message" role="alert">@quantityError</span> }
        </header>
        <label class="full-width">Descrierea intrării în stoc
            <textarea rows="2" maxlength="@StockMovementRules.MaxDescriptionLength" disabled="@(finalizing || line.Done)" @bind="line.EntryDescription" @bind:event="oninput" @bind:after="() => line.DescriptionEdited = true"></textarea></label>
        @if (line.Result is not null) { <p class="@(line.Done ? "success-banner" : "error-banner")" role="status">@line.Result</p> }
    </article>;

    // Creates the new products (with their images) and records every entry. A row that was saved is never saved twice: after an error the
    // remaining rows can be tried again.
    private async Task FinalizeAsync()
    {
        if (finalizing || finished) return;
        finalizeError = finalizeNotice = null;
        var lines = NewLines.Concat(ExistingLines).Where(line => !line.Done).ToList();
        foreach (var line in lines)
            if (QuantityOf(line).Error is { } problem) { finalizeError = problem; return; }
        if (NewLines.Any(line => !line.Done) && newDate is null || ExistingLines.Any(line => !line.Done) && existingDate is null) { finalizeError = "Alege data intrării."; return; }
        finalizing = true;
        StateHasChanged();
        try
        {
            foreach (var line in lines)
            {
                var isNew = line.Staged is not null;
                try
                {
                    var productId = line.CreatedProductId ?? line.ProductId;
                    if (isNew && line.CreatedProductId is null)
                    {
                        var created = await ProductsRepository.CreateAsync(line.Staged!.Input, lifetime.Token);
                        line.CreatedProductId = created.Id;
                        productId = created.Id;
                        if (line.Staged.Image is { } image) await ImageStore.SaveAsync(created.Id, image, lifetime.Token);
                    }
                    var input = new StockMovementInput { Kind = StockMovementKind.Entry, Date = isNew ? newDate : existingDate, Quantity = QuantityOf(line).Quantity, Description = line.EntryDescription };
                    await Movements.CreateAsync(productId!.Value, input, lifetime.Token);
                    line.Done = true;
                    line.Result = isNew ? "Produs adăugat în catalog și intrare înregistrată." : "Intrare înregistrată.";
                }
                catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { return; }
                catch (Exception exception) when (exception is ProductOperationException or StockMovementOperationException or AccessDeniedException)
                {
                    line.Result = (line.CreatedProductId is not null ? "Produsul a fost adăugat, dar intrarea nu: " : "") + exception.Message;
                }
                catch (Exception exception)
                {
                    Logger.LogError("Invoice pickup saving failed ({ErrorType}, database error {ErrorCode}).", exception.GetType().Name, (exception as MySqlConnector.MySqlException)?.ErrorCode);
                    line.Result = (line.CreatedProductId is not null ? "Produsul a fost adăugat, dar intrarea nu a putut fi salvată. " : "") + "Salvarea nu a putut fi confirmată; verifică în catalog înainte să reîncerci.";
                }
            }
            var all = NewLines.Concat(ExistingLines).ToList();
            if (all.All(line => line.Done)) { finished = true; finalizeNotice = $"Preluarea a fost finalizată: {all.Count} {(all.Count == 1 ? "intrare înregistrată" : "intrări înregistrate")}."; }
            else finalizeError = "Unele rânduri nu au fost salvate; vezi mesajele de sub ele. Cele salvate nu se salvează a doua oară la o nouă încercare.";
        }
        finally { finalizing = false; }
    }

    private async Task NewPickupAsync()
    {
        await DiscardAsync();
        pick = []; finished = false; finalizeNotice = null; finalizeError = null; step = 1;
        newDate = existingDate = StockMovementRules.Today;
    }
    private void PreviousStep() { if (step > 1) step--; }

    // ---- step 2: the rows taken in step 1, editable, matched with the catalog ----

    private sealed class PickRow
    {
        public required Dictionary<string, string> Cells { get; init; }
        // The row of step 1 this one was made from (as read, before any correction): going back to step 1 and forward again keeps
        // the work done on the rows that are still taken (corrections, chosen or prepared products, descriptions).
        public string SourceKey { get; init; } = "";
        public InvoiceProductMatch Match { get; set; } = new("", null, []);
        public int? ProductId { get; set; }
        public StagedProduct? Staged { get; set; }
        // Step 3: the description of the stock entry (from the template, editable) and what happened when it was saved.
        public string EntryDescription { get; set; } = "";
        public bool DescriptionEdited { get; set; }
        public int? CreatedProductId { get; set; }
        public bool Done { get; set; }
        public string? Result { get; set; }
    }

    private List<PickRow> pick = [];
    private IReadOnlyList<Product> catalog = [];
    private IReadOnlyList<ProductGroup> groups = [];
    private bool step2Loading;
    private string? step2Error;
    private PickRow? newProductFor;
    private int newProductKey;

    // The rows kept in step 1 (with the columns the template reads), looked up in the catalog.
    private async Task BuildPickAsync()
    {
        step2Loading = true; step2Error = null;
        StateHasChanged();
        try
        {
            catalog = await ProductsRepository.GetProductsAsync(lifetime.Token);
            groups = await ProductsRepository.GetGroupsAsync(lifetime.Token);
            var previous = pick.ToList();
            pick = [.. rows.Where((_, index) => !excluded.Contains(index)).Select(row =>
            {
                var key = SourceKey(row);
                var again = previous.FindIndex(item => item.SourceKey == key);
                if (again < 0) return new PickRow { Cells = new Dictionary<string, string>(row.Cells), SourceKey = key };
                var kept = previous[again];
                previous.RemoveAt(again);
                return kept;
            })];
            foreach (var item in pick) Rematch(item);   // also against the catalog as it is now
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Logger.LogError("Invoice pickup product lookup failed ({ErrorType}).", exception.GetType().Name);
            step2Error = "Catalogul de produse nu a putut fi citit. Reîncearcă prin „Pasul precedent” și „Pasul următor”.";
        }
        finally { step2Loading = false; }
    }

    private static string SourceKey(InvoiceTableRow row) =>
        row.Page.ToString(CultureInfo.InvariantCulture) + "|" + string.Join("\u001f", row.Cells.OrderBy(cell => cell.Key, StringComparer.Ordinal).Select(cell => cell.Key + "=" + cell.Value));

    private void Rematch(PickRow item)
    {
        var nameColumn = reading!.Extraction.Columns.FirstOrDefault(column => column.Meaning == InvoiceColumnMeanings.Name)?.Id;
        var name = nameColumn is null ? "" : item.Cells.GetValueOrDefault(nameColumn, "");
        item.Match = InvoiceProductMatcher.Match(InvoiceProductMatcher.CodeOf(item.Cells.GetValueOrDefault("code"), name), name, catalog);
        // An exact match is the product; else the choice made among the alternatives stays only while that product is still offered.
        item.ProductId = item.Match.Exact?.Id ?? (item.Match.Alternatives.Any(candidate => candidate.Product.Id == item.ProductId) ? item.ProductId : null);
        if (item.Match.Exact is not null) item.Staged = null;   // the code exists in the catalog now: no new product is needed
    }

    private void EditCell(int index, string columnId, string value)
    {
        if (ShownColumns.FirstOrDefault(column => column.Id == columnId) is { } column && IsNumeric(column)) value = NumbersOnly(value);
        pick[index].Cells[columnId] = value;
        Rematch(pick[index]);
    }

    // Quantity, prices and taxes are read as numbers, so only numbers can be typed in them: digits and one comma (numeric-field.js refuses the
    // rest as it is typed; this is the same rule for what reaches the server in another way). A dot of the text as it was read stays.
    private static bool IsNumeric(ShownColumn column) => column.Meaning is InvoiceColumnMeanings.Quantity or InvoiceColumnMeanings.UnitPrice or InvoiceColumnMeanings.Value
        or InvoiceColumnMeanings.ValueWithVat or InvoiceColumnMeanings.VatAmount or InvoiceColumnMeanings.VatRate or InvoiceColumnMeanings.Discount;

    internal static string NumbersOnly(string value)
    {
        var comma = false;
        var result = new System.Text.StringBuilder();
        foreach (var character in value)
        {
            if (char.IsAsciiDigit(character) || character == '.') result.Append(character);
            else if (character == ',' && !comma) { result.Append(character); comma = true; }
        }
        return result.ToString();
    }

    private string NewProductDescription(PickRow item)
    {
        var nameColumn = reading?.Extraction.Columns.FirstOrDefault(column => column.Meaning == InvoiceColumnMeanings.Name)?.Id;
        var name = nameColumn is null ? "" : item.Cells.GetValueOrDefault(nameColumn, "");
        var cut = name.IndexOf(" - ", StringComparison.Ordinal);
        return (cut > 0 && name[..cut].Trim().Equals(item.Match.Code, StringComparison.OrdinalIgnoreCase) ? name[(cut + 3)..] : name).Trim();
    }

    private void OpenNewProduct(int index) { newProductFor = pick[index]; newProductKey++; }
    private Task CloseNewProduct() { newProductFor = null; return Task.CompletedTask; }

    // The product was prepared, not saved: the row keeps it for the last step (and no existing product is chosen for it).
    private Task NewProductStagedAsync(StagedProduct staged)
    {
        if (newProductFor is { } item) { item.Staged = staged; item.ProductId = null; }
        newProductFor = null;
        return Task.CompletedTask;
    }

    private sealed record ShownColumn(string Id, string Title, string Meaning);

    // The invoice itself, in a window of its own (opened by the link of step 2): the pages of the file under pickup.
    private string ViewerUrl => $"/produse/preluare-factura/factura/{session!.Id}";

    // The decimal separator the invoice uses for its own numbers, found once per file.
    private char? numberHint;
    private Guid? numberHintFor;
    private char? NumberHint
    {
        get
        {
            if (numberHintFor != session!.Id) { numberHint = InvoiceValues.DecimalStyle(session.Document.AllWords.Select(word => word.Text)); numberHintFor = session.Id; }
            return numberHint;
        }
    }

    // Lines needed by a name in its field (about 40 characters a line; browsers that size the field to its text ignore this).
    private static int NameRows(string text) => Math.Clamp((text.Length + 39) / 40, 1, 8);

    // The name gets the room; the code a medium field; the unit is the shortest; quantity, prices and taxes are short.
    private static string ColumnClass(ShownColumn column) => column.Meaning switch
    {
        InvoiceColumnMeanings.Name => "pickup-col-name",
        InvoiceColumnMeanings.Code => "pickup-col-code",
        InvoiceColumnMeanings.Unit => "pickup-col-unit",
        _ => "pickup-col-short"
    };

    // Quantities and amounts must be numbers (missing is not acceptable for the first three); discounts and VAT may be empty.
    private bool NotANumber(ShownColumn column, string text)
    {
        switch (column.Meaning)
        {
            case InvoiceColumnMeanings.Quantity or InvoiceColumnMeanings.UnitPrice or InvoiceColumnMeanings.Value or InvoiceColumnMeanings.ValueWithVat:
                return InvoiceValues.ParseNumber(text, NumberHint) is null;
            case InvoiceColumnMeanings.VatAmount or InvoiceColumnMeanings.Discount:
                return text.Trim().Length > 0 && InvoiceValues.ParseNumber(text, NumberHint) is null;
            default:
                return false;
        }
    }

    private bool loading = true, busy, addMode;
    private string? loadError, error, notice, templateInfo;
    private string selectedId = "";
    private int currentPage = 1, separatorCounter;
    private InvoiceAnalysisSession? session;
    private InvoiceTemplateRecord? chosen;
    private IReadOnlyList<InvoiceTemplateSuggestion> suggestions = [];
    private InvoicePickupReading? reading;
    private List<InvoiceSeparator> separators = [];
    private IReadOnlyList<InvoiceTableRow> rows = [];
    private InvoiceTemplateDraft? overlay;
    private bool showFields = true, showHeader = true, showColumns = true;
    private readonly HashSet<int> excluded = [];
    private DotNetObjectReference<InvoicePickup>? reference;
    private readonly CancellationTokenSource lifetime = new();

    private InvoicePageData CurrentPageData => session!.Document.Pages.FirstOrDefault(page => page.Number == currentPage) ?? session.Document.Pages[0];
    private string ImageUrl(int page) => $"/media/invoice-analysis/{session!.Id}/{page}";
    private static string F(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
    private static string SupplierLabel(InvoiceTemplateInfo info) => info.SupplierName.Length > 0 ? info.SupplierName : info.SupplierCui.Length > 0 ? "CUI " + info.SupplierCui : "furnizor nespecificat";

    // The columns the template reads with a meaning, plus the product code when it was split off the name.
    private IEnumerable<ShownColumn> ShownColumns
    {
        get
        {
            var columns = reading!.Extraction.Columns.Where(column => column.Meaning != InvoiceColumnMeanings.Ignore).ToList();
            foreach (var column in columns) yield return new ShownColumn(column.Id, column.Label.Length > 0 ? column.Label : InvoiceVocabulary.ColumnTitle(column.Meaning), column.Meaning);
            if (columns.All(column => column.Id != "code") && rows.Any(row => row.Cells.ContainsKey("code"))) yield return new ShownColumn("code", InvoiceVocabulary.ColumnTitle(InvoiceColumnMeanings.Code), InvoiceColumnMeanings.Code);
        }
    }

    protected override void OnInitialized() => reference = DotNetObjectReference.Create(this);

    protected override async Task OnInitializedAsync()
    {
        if (!await Access.CanManageProductsAsync(lifetime.Token)) loadError = "Nu ai dreptul să preiei facturi.";
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { await JS.InvokeVoidAsync("blazorStocInvoiceSeparators.register", reference); }
        catch (Exception exception) when (exception is JSException or InvalidOperationException or TaskCanceledException or JSDisconnectedException) { }
    }

    private async Task FileSelectedAsync(InputFileChangeEventArgs e)
    {
        if (busy) return;
        error = notice = null;
        var file = e.File;
        if (!file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) && !string.Equals(file.ContentType, "application/pdf", StringComparison.OrdinalIgnoreCase)) { error = InvoiceAnalysisRules.NotAPdfMessage; return; }
        if (file.Size > InvoiceAnalysisRules.MaxFileSizeBytes) { error = InvoiceAnalysisRules.TooLargeMessage; return; }

        busy = true;
        StateHasChanged();
        try
        {
            DiscardSession();
            pick = []; finished = false; finalizeNotice = finalizeError = null;   // another file: nothing of the previous pickup applies
            await using var stream = file.OpenReadStream(InvoiceAnalysisRules.MaxFileSizeBytes, lifetime.Token);
            session = await Analysis.AnalyzeAsync(stream, file.Name, lifetime.Token);
            suggestions = InvoiceTemplateSuggestions.Rank(await Templates.GetAllAsync(lifetime.Token), session.Document);
            currentPage = session.Document.Pages[0].Number;
            chosen = suggestions.FirstOrDefault()?.Template;
            LoadReading();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (InvoiceAnalysisException exception) { error = exception.Message; ClearReading(); }
        catch (AccessDeniedException exception) { error = exception.Message; ClearReading(); }
        catch (Exception exception)
        {
            Logger.LogError("Invoice pickup analysis failed ({ErrorType}).", exception.GetType().Name);
            error = "Fișierul nu a putut fi citit. Încearcă din nou sau alt fișier.";
            ClearReading();
        }
        finally { busy = false; }
    }

    private void ChooseTemplate(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var id)) return;
        chosen = suggestions.FirstOrDefault(item => item.Template.Info.Id == id)?.Template ?? chosen;
        LoadReading();
    }

    // Reads the file with the detected template (the best saved one for the file); without one, with what the automatic analysis proposes.
    private void LoadReading()
    {
        InvoiceTemplateDefinition? definition = null;
        if (chosen is not null)
        {
            definition = chosen.Definition;
            var match = suggestions.First(item => item.Template.Info.Id == chosen.Info.Id).Match;
            templateInfo = $"Șablon detectat: {chosen.Info.Name} · {SupplierLabel(chosen.Info)} · potrivire {(int)Math.Round(match.Score * 100)}%";
        }
        else if (session!.Analysis.Table is not null)
        {
            definition = InvoiceTemplateDraft.FromAnalysis(session.Analysis).ToDefinition(session.Document);
            templateInfo = "Niciun șablon salvat nu se potrivește cu factura: s-a folosit citirea automată. Verifică rândurile și coloanele.";
        }
        else templateInfo = null;

        reading = definition is null ? null : InvoicePickupReader.Read(definition, session!.Document);
        if (reading is not null && reading.Extraction.Columns.Count == 0) reading = null;
        // The template's own overlay (fields with their read values, header, columns) placed on this file the way the engine reads it.
        overlay = reading is null || definition is null ? null
            : chosen is not null ? InvoiceTemplateDraft.FromDefinition(definition, session!.Document, chosen.Info.SupplierName, chosen.Info.SupplierCui)
            : InvoiceTemplateDraft.FromAnalysis(session!.Analysis);
        excluded.Clear();
        ResetSeparators();
    }

    private void ResetSeparators()
    {
        separators = reading is null ? [] : [.. reading.Separators];
        separatorCounter = separators.Count;
        selectedId = "";
        addMode = false;
        RereadRows();
    }

    private void RereadRows()
    {
        var before = rows.Count;
        rows = reading is null ? [] : InvoicePickupReader.Reread(reading, session!.Document, separators);
        if (rows.Count != before) excluded.Clear();   // the rows changed: the choices made on the old ones no longer apply
    }

    private void ToggleRow(int index, bool take) { if (take) excluded.Remove(index); else excluded.Add(index); }

    private void ToggleAll(bool take)
    {
        excluded.Clear();
        if (!take) for (var index = 0; index < rows.Count; index++) excluded.Add(index);
    }

    // The color of a column on the overlay: the one the template editor gives it (by its place among the template's columns).
    private string ColumnColor(string id)
    {
        var index = overlay?.Columns.FindIndex(item => item.Id == id) ?? -1;
        return index < 0 ? "#6b7a80" : $"hsl({(int)(index * 137.5 % 360)} 70% 42%)";
    }

    private string ColumnColor(InvoiceColumn column) => ColumnColor(column.Id);

    // Where the rows are on a page: between its first and its last demarcation line (the overlay of the columns stays inside the table).
    private (double Top, double Bottom)? BodyRange(InvoicePageData page)
    {
        var lines = separators.Where(item => item.Page == page.Number).Select(item => item.Y).ToList();
        return lines.Count < 2 ? null : (lines.Min(), lines.Max());
    }

    // The columns of the table as this page draws them (a following page may be shifted against the first one).
    private IEnumerable<InvoiceColumn> ColumnsOn(InvoicePageData page)
    {
        var columns = reading!.Extraction.Columns;
        var firstPage = separators.Count == 0 ? page.Number : separators.Min(item => item.Page);
        if (page.Number != firstPage && InvoiceTableReader.FindHeader(page, 3) is { } repeated) columns = [.. InvoiceTableReader.ColumnsOnPage(columns, repeated)];
        return columns.Where(column => column.Meaning != InvoiceColumnMeanings.Ignore);
    }

    private void ClearReading() { pick = []; session = null; reading = null; overlay = null; excluded.Clear(); separators = []; rows = []; templateInfo = null; suggestions = []; chosen = null; selectedId = ""; }

    private void Select(string id) => selectedId = selectedId == id ? "" : id;

    private void DeleteSelected()
    {
        if (selectedId.Length == 0) return;
        separators.RemoveAll(item => item.Id == selectedId);
        selectedId = "";
        RereadRows();
    }

    // Called by invoice-separators.js when a line was dragged (move, shorten, lengthen): the rows are read again between the new lines.
    [JSInvokable]
    public Task OnSeparatorChanged(string id, double y, double left, double right)
    {
        var index = separators.FindIndex(item => item.Id == id);
        if (index < 0) return Task.CompletedTask;
        var page = CurrentPageData;
        left = Math.Clamp(left, 0, page.Width);
        right = Math.Clamp(right, left + 1, page.Width);
        separators[index] = separators[index] with { Y = Math.Clamp(y, 0, page.Height), Left = left, Right = right };
        selectedId = id;
        RereadRows();
        return InvokeAsync(StateHasChanged);
    }

    // Called by invoice-separators.js when the page was pressed in "add line" mode.
    [JSInvokable]
    public Task OnSeparatorAdded(int pageNumber, double y)
    {
        if (reading is null) return Task.CompletedTask;
        var page = session!.Document.Pages.FirstOrDefault(item => item.Number == pageNumber) ?? CurrentPageData;
        var columns = reading.Extraction.Columns;
        separatorCounter++;
        var separator = new InvoiceSeparator("s" + separatorCounter.ToString(CultureInfo.InvariantCulture), page.Number, Math.Clamp(y, 0, page.Height), columns.Min(column => column.Left), columns.Max(column => column.Right));
        separators.Add(separator);
        selectedId = separator.Id;
        addMode = false;
        RereadRows();
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnSeparatorDeleteKey()
    {
        DeleteSelected();
        return InvokeAsync(StateHasChanged);
    }

    private void DiscardSession()
    {
        if (session is not null) Analysis.Discard(session.Id);
    }

    private Task DiscardAsync()
    {
        DiscardSession();
        ClearReading();
        notice = "Fișierul a fost eliminat din memorie.";
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        lifetime.Cancel();
        DiscardSession();
        try { await JS.InvokeVoidAsync("blazorStocInvoiceSeparators.unregister"); }
        catch (Exception exception) when (exception is JSException or InvalidOperationException or TaskCanceledException or JSDisconnectedException) { }
        reference?.Dispose();
        lifetime.Dispose();
    }
}
