@page "/inventar"
@attribute [Authorize(Policy = "perm:inventar.view")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using BlazorStoc.Services
@using System.Globalization
@inject IProductRepository Repository
@inject IInventoryReportBuilder ReportBuilder
@inject IInventoryPdfWriter PdfWriter
@inject IAuditTrail AuditTrail
@inject IAccessControl Access
@inject IJSRuntime JS
@inject ILogger<Inventory> Logger
@implements IAsyncDisposable
<PageBoundary>

<PageTitle>Inventar · BlazorStoc</PageTitle>
<div class="page-heading">
    <div><p class="eyebrow">SITUAȚIE DE STOC</p><h1>Inventar</h1><p class="muted">Selectează categoriile și subcategoriile pentru care se generează situația de inventar, folosită la numărarea fizică a stocului.</p></div>
    <div class="heading-actions">
        <button class="primary" disabled="@(!CanGenerate)" title="@(HasSelection ? null : InventoryRules.NoSelectionMessage)" @onclick="GenerateAsync">@(generating ? "Se generează…" : "Generează situația de inventar")</button>
    </div>
</div>
@if (loadError is not null) { <div class="error-banner" role="alert">@loadError <button class="primary" @onclick="LoadAsync">Reîncearcă</button></div> }
@if (error is not null) { <div class="error-banner" role="alert">@error</div> }
@if (notice is not null) { <div class="success-banner" role="status">@notice</div> }

@if (loading)
{
    <div class="empty-state" role="status"><div class="spinner"></div><h3>Se încarcă structura catalogului</h3></div>
}
else if (loadError is null && Categories.Count == 0)
{
    <div class="empty-state"><h3>Nu există categorii sau produse pentru inventar</h3></div>
}
else if (loadError is null)
{
    <section class="catalog inventory-options">
        <ToggleSwitch Value="@AllState.Checked" Mixed="@AllState.Indeterminate" ValueChanged="ToggleAllAsync" AriaLabel="Selectează toate categoriile">Selectează toate categoriile</ToggleSwitch>
        <ToggleSwitch Value="@selection.ExcludeZeroStock" ValueChanged="ToggleExcludeZeroAsync">Elimină din situația de inventar produsele cu stoc 0</ToggleSwitch>
    </section>

    <div class="category-management-list inventory-category-list">
        @foreach (var category in Categories)
        {
            var subcategoryNames = SubcategoryNames(category);
            <CollapsibleSection Id="@CategoryId(category)"
                                RootClass="catalog inventory-category-card"
                                HeaderRowClass="catalog-heading collapsible-header"
                                ToggleClass="category-disclosure"
                                ContentClass="category-management-content"
                                Expanded="@IsCategoryExpanded(category)"
                                ExpandedChanged="@(expanded => SetCategoryExpanded(category, expanded))">
                <Header>
                    <span class="inventory-checkbox" @onclick:stopPropagation="true">
                        @{ var categoryState = selection.CategoryState(category, subcategoryNames); }
<RowSelect Selected="@categoryState.Checked" Mixed="@categoryState.Indeterminate" Disabled="@(subcategoryNames.Count == 0)" AriaLabel="@($"Selectează categoria {category}")"                                   SelectedChanged="@(value => ToggleCategoryAsync(category, subcategoryNames, value))" />
                    </span>
                    <span class="category-disclosure-text">
                        <span class="category-title">@category</span>
                        <small>@SubcategoryCountLabel(category)</small>
                        <small>@ProductCount(category) produse asociate</small>
                        @if (subcategoryNames.Count > 0)
                        {
                            <small>@SelectionCountLabel(category, subcategoryNames)</small>
                        }
                    </span>
                </Header>
                <ChildContent>
                    @if (Subcategories(category).Count == 0)
                    {
                        <div class="empty-state compact"><p>Categoria nu are subcategorii.</p></div>
                    }
                    else
                    {
                        <div class="table-scroll"><table><thead><tr><th><span class="sr-only">Selectează</span></th><th>SUBCATEGORIE</th><th>PRODUSE</th></tr></thead><tbody>
                        @foreach (var group in Subcategories(category))
                        {
                            <tr @key="@($"{group.Category}:{group.Subcategory}")" class="selectable-row @(selection.IsSelected(group.Category, group.Subcategory) ? "selected" : null)" @onclick="() => ToggleSubcategoryAsync(group, !selection.IsSelected(group.Category, group.Subcategory))">
<td><RowSelect Selected="@selection.IsSelected(group.Category, group.Subcategory)" AriaLabel="@($"Selectează subcategoria {group.Subcategory}")" SelectedChanged="@(value => ToggleSubcategoryAsync(group, value))" /></td>
                                <td><strong>@group.Subcategory</strong></td>
                                <td>@ProductCount(group) produse</td>
                            </tr>
                        }
                        </tbody></table></div>
                    }
                </ChildContent>
            </CollapsibleSection>
        }
    </div>
}

@if (showPreview)
{
    <div class="delete-overlay" @onkeydown="PreviewKeyDownAsync">
        <section class="delete-dialog pdf-preview-dialog" role="dialog" aria-modal="true" tabindex="-1" aria-labelledby="pdf-preview-title">
            <h2 id="pdf-preview-title">Situația de inventar</h2>
            <p class="muted">@previewFileName</p>
            <iframe class="pdf-preview-frame" @ref="previewFrame" title="Previzualizare situație de inventar"></iframe>
            @if (previewError is not null) { <div class="validation-message" role="alert">@previewError</div> }
            <div class="editor-actions">
                <button type="button" class="primary" @onclick="PrintPreviewAsync">Imprimă</button>
                <button type="button" class="refresh act-confirm" @onclick="SavePreviewAsync">Salvează</button>
                <button type="button" class="danger" @onclick="ClosePreviewAsync">Închide</button>
            </div>
        </section>
    </div>
}

</PageBoundary>

@code {
    private IReadOnlyList<ProductGroup> groups = Array.Empty<ProductGroup>();
    private IReadOnlyList<Product> products = Array.Empty<Product>();
    private readonly InventorySelectionState selection = new();
    private readonly HashSet<string> expandedCategories = new(StringComparer.Ordinal);
    private bool loading, generating;
    private string? loadError, error, notice;
    private IJSObjectReference? previewModule;
    // The generated file is shown in a dialog with print / save. It is never stored on the server: the bytes are held
    // here only until they have been handed to the browser (OnAfterRenderAsync), then dropped; saving and printing work
    // on the browser's copy, which is released when the dialog closes.
    private bool showPreview, previewLoadPending;
    private byte[]? previewBytes;
    private string? previewFileName, previewError;
    private ElementReference previewFrame;
    private readonly CancellationTokenSource lifetime = new();

    private List<string> Categories => groups.Select(group => group.Category).Where(value => value.Length > 0)
        .Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.CurrentCultureIgnoreCase).ToList();
    private List<ProductGroup> Subcategories(string category) => groups
        .Where(group => string.Equals(group.Category, category, StringComparison.OrdinalIgnoreCase) && group.Subcategory.Length > 0)
        .OrderBy(group => group.Subcategory, StringComparer.CurrentCultureIgnoreCase).ToList();
    private List<string> SubcategoryNames(string category) => Subcategories(category).Select(group => group.Subcategory).ToList();
    private List<(string Category, IReadOnlyList<string> Subcategories)> CategoryEntries =>
        Categories.Select(category => (category, (IReadOnlyList<string>)SubcategoryNames(category))).ToList();
    private int ProductCount(string category) => products.Count(product => string.Equals(product.Category, category, StringComparison.OrdinalIgnoreCase));
    private int ProductCount(ProductGroup group) => products.Count(product =>
        string.Equals(product.Category, group.Category, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(product.Subcategory, group.Subcategory, StringComparison.OrdinalIgnoreCase));
    private string SubcategoryCountLabel(string category)
    {
        var count = Subcategories(category).Count;
        return $"{count} {(count == 1 ? "subcategorie" : "subcategorii")}";
    }
    private string SelectionCountLabel(string category, IReadOnlyList<string> subcategoryNames)
    {
        var selected = subcategoryNames.Count(subcategory => selection.IsSelected(category, subcategory));
        return $"{selected} din {subcategoryNames.Count} {(subcategoryNames.Count == 1 ? "subcategorie selectată" : "subcategorii selectate")}";
    }
    private static string CategoryId(string category) => $"inventory-category-{Uri.EscapeDataString(TextNormalization.UniquenessKey(category))}";
    private bool IsCategoryExpanded(string category) => expandedCategories.Contains(TextNormalization.UniquenessKey(category));
    private void SetCategoryExpanded(string category, bool expanded)
    {
        var key = TextNormalization.UniquenessKey(category);
        if (expanded) expandedCategories.Add(key);
        else expandedCategories.Remove(key);
    }

    private (bool Checked, bool Indeterminate) AllState => selection.AllState(CategoryEntries);
    private bool HasSelection => selection.Count(CategoryEntries) > 0;
    private bool CanGenerate => HasSelection && !generating && !loading;

    protected override async Task OnInitializedAsync()
    {
        if (!await Access.HasAsync("inventar.view", lifetime.Token)) { loadError = "Nu ai dreptul să consulți catalogul."; return; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true; loadError = null;
        try
        {
            var groupsTask = Repository.GetGroupsAsync(lifetime.Token);
            var productsTask = Repository.GetProductsAsync(lifetime.Token);
            await Task.WhenAll(groupsTask, productsTask);
            groups = await groupsTask;
            products = await productsTask;
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) { Logger.LogError("Inventory catalogue loading failed ({ErrorType}).", exception.GetType().Name); loadError = "Structura catalogului nu a putut fi încărcată."; }
        finally { loading = false; }
    }

    private Task ToggleAllAsync(bool value)
    {
        selection.SetAll(CategoryEntries, value);
        return Task.CompletedTask;
    }

    private Task ToggleExcludeZeroAsync(bool value)
    {
        selection.ExcludeZeroStock = value;
        return Task.CompletedTask;
    }

    private Task ToggleCategoryAsync(string category, IReadOnlyList<string> subcategories, bool value)
    {
        selection.SetCategory(category, subcategories, value);
        return Task.CompletedTask;
    }

    private Task ToggleSubcategoryAsync(ProductGroup group, bool value)
    {
        selection.SetSubcategory(group.Category, group.Subcategory, value);
        return Task.CompletedTask;
    }

    private async Task GenerateAsync()
    {
        if (generating) return;
        error = null; notice = null;
        var items = selection.ToItems(CategoryEntries);
        if (items.Count == 0) { error = InventoryRules.NoSelectionMessage; return; }
        generating = true;
        try
        {
            var request = new InventoryRequest(items, selection.ExcludeZeroStock);
            var report = await ReportBuilder.BuildAsync(request, lifetime.Token);
            var generatedLocal = DateTime.Now;
            var bytes = PdfWriter.Write(report, generatedLocal);
            var fileName = InventoryRules.FileName(generatedLocal);
            try { await LogGenerationAsync(request, report, fileName); }
            catch (Exception exception) { Logger.LogError("Inventory audit logging failed ({ErrorType}).", exception.GetType().Name); }
            previewBytes = bytes;
            previewFileName = fileName;
            previewError = null;
            previewLoadPending = true;
            showPreview = true;
            notice = "Situația de inventar a fost generată.";
        }
        catch (InventoryOperationException exception) { error = exception.Message; }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) { Logger.LogError("Inventory report generation failed ({ErrorType}).", exception.GetType().Name); error = "Situația de inventar nu a putut fi generată."; }
        finally { generating = false; }
    }

    private Task LogGenerationAsync(InventoryRequest request, InventoryReport report, string fileName)
    {
        var details = AuditDetails.Identification(
            ("Categorii selectate", report.SelectedCategoryCount.ToString(CultureInfo.InvariantCulture)),
            ("Subcategorii selectate", report.SelectedSubcategoryCount.ToString(CultureInfo.InvariantCulture)),
            ("Stoc 0 exclus", request.ExcludeZeroStock ? "da" : "nu"),
            ("Produse în situație", report.ProductCount.ToString(CultureInfo.InvariantCulture)),
            ("Din care cu stoc negativ", report.NegativeCount.ToString(CultureInfo.InvariantCulture)),
            ("Fișier", fileName));
        return AuditRecorder.RecordGenerateAsync(AuditTrail, Access, AuditEntities.Inventory, "Situație de inventar", details, lifetime.Token);
    }

    private async Task SavePreviewAsync()
    {
        if (previewFileName is null || previewModule is null) return;
        previewError = null;
        try
        {
            if (!await previewModule.InvokeAsync<bool>("savePdf", lifetime.Token, previewFileName))
                previewError = "Fișierul nu a putut fi salvat.";
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (JSDisconnectedException) { }
        catch (Exception exception)
        {
            Logger.LogError("Inventory PDF save failed ({ErrorType}).", exception.GetType().Name);
            previewError = "Fișierul nu a putut fi salvat.";
        }
    }

    private async Task PrintPreviewAsync()
    {
        previewError = null;
        try
        {
            previewModule ??= await JS.InvokeAsync<IJSObjectReference>("import", lifetime.Token, "./inventory-pdf-preview.js");
            if (!await previewModule.InvokeAsync<bool>("printPdf", lifetime.Token, previewFrame))
                previewError = "Imprimarea nu a putut fi pornită. Salvează fișierul și tipărește-l din vizualizatorul PDF.";
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (JSDisconnectedException) { }
        catch (Exception exception)
        {
            Logger.LogError("Inventory PDF print failed ({ErrorType}).", exception.GetType().Name);
            previewError = "Imprimarea nu a putut fi pornită.";
        }
    }

    private async Task ClosePreviewAsync()
    {
        showPreview = false;
        previewLoadPending = false;
        previewBytes = null;
        previewError = null;
        try { if (previewModule is not null) await previewModule.InvokeVoidAsync("release", lifetime.Token, previewFrame); }
        catch (Exception exception) when (exception is OperationCanceledException or JSDisconnectedException or InvalidOperationException) { }
    }

    private Task PreviewKeyDownAsync(KeyboardEventArgs e) => e.Key == "Escape" ? ClosePreviewAsync() : Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (previewLoadPending && showPreview && previewBytes is not null)
        {
            previewLoadPending = false;
            try
            {
                previewModule ??= await JS.InvokeAsync<IJSObjectReference>("import", lifetime.Token, "./inventory-pdf-preview.js");
                using var stream = new MemoryStream(previewBytes, writable: false);
                using var streamRef = new DotNetStreamReference(stream, leaveOpen: true);
                await previewModule.InvokeVoidAsync("showPdf", lifetime.Token, previewFrame, streamRef);
                previewBytes = null; // delivered to the browser: no copy of the generated file stays on the server
            }
            catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
            catch (JSDisconnectedException) { }
            catch (Exception exception)
            {
                Logger.LogError("Inventory PDF preview failed ({ErrorType}).", exception.GetType().Name);
                previewBytes = null;
                previewError = "Previzualizarea nu a putut fi afișată. Închide fereastra și generează din nou situația.";
                StateHasChanged();
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        lifetime.Cancel();
        previewBytes = null;
        if (previewModule is not null)
        {
            try { await previewModule.InvokeVoidAsync("release", null); } catch (Exception exception) when (exception is JSDisconnectedException or InvalidOperationException) { }
            try { await previewModule.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
        lifetime.Dispose();
    }
}
