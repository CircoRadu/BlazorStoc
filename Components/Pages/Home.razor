@page "/produse"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using BlazorStoc.Services
@inject IProductRepository Repository
@inject IStockMovementRepository Movements
@inject IProductImageStore ImageStore
@inject IAccessControl Access
@inject NavigationManager Navigation
@inject ILogger<Home> Logger
@inject IJSRuntime JS
@inject IChangeFeed ChangeFeed
@inject ChangeOrigin Origin
@inject UnsavedChanges Guard
@inject IProductLockRepository Locks
@implements IAsyncDisposable
<PageBoundary>

<PageTitle>Produse și stocuri · BlazorStoc</PageTitle>
<UnsavedChangesHost />
<div class="page-heading"><div><p class="eyebrow">INVENTAR CENTRALIZAT</p><h1>Produse și stocuri</h1><p class="muted">Găsește rapid produsele și verifică disponibilitatea lor.</p></div><div class="heading-actions"><a class="refresh act-nav" href="/">← Meniu principal</a>@if (canManage) { <a class="refresh act-nav" href="/iesiri/multipla">Ieșire multiplă</a><a class="refresh act-nav" href="/categorii">Administrează categorii</a><button class="primary" disabled="@(loading || editing || deleting is not null)" @onclick="() => OpenEditorAsync(null)">+ Adaugă produs</button> }<button class="refresh act-reload" disabled="@(loading || editing || deleting is not null)" @onclick="LoadAsync"><span>↻</span> @(loading ? "Se încarcă…" : "Actualizează")</button></div></div>
@if (error is not null) { <div class="error-banner" role="alert">@error <button class="primary" @onclick="LoadAsync">Reîncearcă</button></div> }
@if (notice is not null) { <div class="success-banner" role="status">@notice</div> }
<LiveChangeNotice Visible="live?.HasPendingChange == true" Reload="ReloadLiveAsync" />
@if (lockMessage is not null) { <div class="info-banner" role="status">@lockMessage</div> }
@if (lockLost && editing) { <div class="info-banner" role="status">Blocarea editării a fost pierdută (a expirat sau a fost eliberată de un administrator). Poți continua, dar la salvare se verifică versiunea produsului.</div> }
@if (editing) { <ProductEditor @key="editorKey" Original="editingProduct" InitialCategory="@category" InitialSubcategory="@subcategory" Groups="groups" Saved="ProductSavedAsync" Closed="CloseEditorAsync" /> }
<div class="settings-tabs" role="tablist" aria-label="Secțiuni produse">
    <button type="button" role="tab" class="settings-tab @(!regularizeTab ? "active" : "")" aria-selected="@(!regularizeTab)" @onclick="() => regularizeTab = false">Catalog</button>
    <button type="button" role="tab" class="settings-tab @(regularizeTab ? "active" : "")" aria-selected="@regularizeTab" @onclick="() => regularizeTab = true">De regularizat@(toRegularize > 0 ? $" ({toRegularize})" : "")</button>
</div>
@if (regularizeTab)
{
    <ToRegularizeTab Changed="CountToRegularizeAsync" />
}
else
{
<section class="metrics" aria-label="Rezumat inventar">
    <article><span>Produse în selecție</span><strong>@(loaded ? ScopedProducts.Count.ToString("N0") : "—")</strong><small>@SelectionDescription</small><i>▦</i></article>
    <article><span>Categorii</span><strong>@(loaded ? ScopedProducts.Select(p => p.Category).Distinct(StringComparer.OrdinalIgnoreCase).Count().ToString() : "—")</strong><small>În selecția curentă</small><i>▤</i></article>
    <article><span>Fără stoc</span><strong>@(loaded ? ScopedProducts.Count(p => p.Quantity == 0).ToString() : "—")</strong><small>Cantitate disponibilă zero</small><i class="amber">○</i></article>
    <article><span>Stoc negativ</span><strong>@(loaded ? ScopedProducts.Count(p => p.Quantity < 0).ToString() : "—")</strong><small>De verificat în selecție</small><i class="red">!</i></article>
</section>
<section class="catalog"><div class="catalog-heading"><h2>Catalog produse <span>@Filtered.Count</span></h2><small>@(lastLoaded is null ? "În așteptarea datelor" : $"Actualizat la {lastLoaded:HH:mm:ss} UTC")</small></div>
<div class="filters"><label class="search-box"><span>⌕</span><input aria-label="Caută produse" placeholder="Caută după cod produs sau descriere…" @bind="query" @bind:event="oninput" @bind:after="ResetPage" /></label><label><span class="sr-only">Disponibilitate</span><select @bind="stock" @bind:after="ResetPage"><option value="">Orice stoc</option><option value="positive">În stoc</option><option value="zero">Fără stoc</option><option value="negative">Stoc negativ</option></select></label></div>
@if (loading) { <div class="empty-state" role="status"><div class="spinner"></div><h3>Se încarcă produsele</h3><p>Preluăm catalogul pentru această sesiune.</p></div> }
else if (Filtered.Count == 0) { <div class="empty-state"><span class="empty-icon">▦</span><h3>@(error is not null ? "Catalog indisponibil" : products.Count == 0 ? "Catalogul nu conține produse" : "Nu am găsit produse")</h3><p>@(error is not null ? "Datele nu au putut fi preluate. Reîncearcă după verificarea conexiunii." : products.Count == 0 ? "Folosește „Adaugă produs” pentru a crea primul produs și categoriile sale." : "Încearcă alt termen sau elimină filtrele.")</p>@if (products.Count > 0) { <button class="refresh act-reload" @onclick="ClearFilters">Resetează filtrele</button> }</div> }
else { <div class="table-scroll"><table><thead><tr><th>COD PRODUS</th><th>CATEGORIE</th><th>SUBCATEGORIE</th><th class="number" aria-sort="@(quantityDescending ? "descending" : "ascending")"><button class="sort-header" @onclick="ToggleQuantitySort" aria-label="Sortează cantitatea @(quantityDescending ? "crescător" : "descrescător")">CANTITATE <span aria-hidden="true">@(quantityDescending ? "↓" : "↑")</span></button></th><th>DISPONIBILITATE</th><th><span class="sr-only">Detalii</span></th></tr></thead><tbody>@foreach (var p in Paged) { <tr @key="p.Id"><td><div class="product-cell"><button type="button" class="product-thumbnail" title="Mărește imaginea" aria-label="Mărește imaginea pentru @p.Name" @onclick="() => imagePreview = p"><img src="@ProductImageUrl(p)" alt="" /></button><div><button class="product-name" @onclick="() => OpenMovements(p)">@p.Name</button><small>@p.Description</small>@if (LockOfOthers(p.Id) is { } held) { <small class="lock-badge">🔒 În editare de @held.Owner</small> }</div></div></td><td><a class="category-table-link" href="@ProductUrl(p.Category)">@p.Category</a></td><td><a class="category-table-link" href="@ProductUrl(p.Category, p.Subcategory)">@p.Subcategory</a></td><td class="number quantity">@p.Quantity <small>buc.</small>@if (InVehicles(p.Id) is > 0 and var inCars) { <small class="stock-breakdown">@(p.Quantity - inCars) în depozit, @inCars în vehicule</small> }</td><td><span class="stock-badge @StockClass(p.Quantity)"><span>●</span> @StockLabel(p.Quantity)</span></td><td>@if (canManage) { <button class="row-action" title="Ieșire rapidă" aria-label="@($"Ieșire rapidă {p.Name}")" @onclick="() => quickExit = p">⇥</button> }<button class="row-action" aria-label="@($"Detalii {p.Name}")" @onclick="() => OpenMovements(p)" title="@($"Deschide mișcările produsului {p.Name}")">↗</button></td></tr> }</tbody></table></div> }
<footer class="table-footer"><span>@Filtered.Count @(Filtered.Count == 1 ? "rezultat" : "rezultate")</span><div class="pagination"><button disabled="@(page <= 1)" @onclick="() => page--" aria-label="Pagina anterioară">‹</button><span>Pagina @(page) din @Pages</span><button disabled="@(page >= Pages)" @onclick="() => page++" aria-label="Pagina următoare">›</button></div></footer></section>
<p class="workspace-note"><span class="status-dot"></span> Date din BlazorStoc <span>·</span> Catalog și gestiune produse</p>
}

@if (imagePreview is not null)
{
    <div class="image-lightbox" role="dialog" aria-modal="true" aria-label="Imagine mărită pentru @imagePreview.Name" @onclick="CloseImagePreviewAsync">
        <button type="button" class="image-lightbox-close" aria-label="Închide imaginea" @onclick="CloseImagePreviewAsync" title="Închide imaginea">×</button>
        <figure @onclick:stopPropagation="true"><img src="@ProductImageUrl(imagePreview)" alt="Imagine mărită pentru @imagePreview.Name" /><figcaption>@imagePreview.Name</figcaption></figure>
    </div>
}

@if (quickExit is not null)
{
    <div class="invoice-modal-backdrop" role="dialog" aria-modal="true" aria-label="Ieșire rapidă @quickExit.Name">
        <div class="invoice-modal quick-exit-modal">
            <ExitOperation @key="quickExit.Id" Embedded="true" InitialProductId="quickExit.Id" OnClosed="CloseQuickExitAsync" />
        </div>
    </div>
}

@if (deleting is not null)
{
    <DeleteConfirmationDialog @key="deleting.Id" Title="Ștergi produsul?" Subject="Produsul"
                              ObjectLabel="@deleting.Name"
                              Description="Produsul trebuie să aibă stoc zero și să nu aibă mișcări de stoc. Imaginea asociată va fi mutată în arhivă."
                              Busy="@deleteBusy" Error="@deleteError" Confirmed="DeleteProductAsync"
                              Cancelled="CancelDeleteAsync" />
}
</PageBoundary>

@code {
    [SupplyParameterFromQuery(Name = "tab")] public string? TabName { get; set; }
    private Product? quickExit;
    private async Task CloseQuickExitAsync() { quickExit = null; await LoadAsync(); }
    private bool regularizeTab;
    private int toRegularize;
    private async Task CountToRegularizeAsync()
    {
        try { toRegularize = (await Movements.GetToRegularizeAsync(null, lifetime.Token)).Count; }
        catch (Exception) { toRegularize = 0; }
        await InvokeAsync(StateHasChanged);
    }
    [SupplyParameterFromQuery(Name = "categorie")] public string? CategoryQuery { get; set; }
    [SupplyParameterFromQuery(Name = "subcategorie")] public string? SubcategoryQuery { get; set; }
    [SupplyParameterFromQuery(Name = "edit")] public int? EditId { get; set; }
    [SupplyParameterFromQuery(Name = "sterge")] public int? DeleteId { get; set; }
    [SupplyParameterFromQuery(Name = ReturnNavigation.QueryName)] public string? ReturnQuery { get; set; }
    private IReadOnlyList<Product> products = Array.Empty<Product>();
    private string query = "", category = "", subcategory = "", stock = "";
    private string? error, notice, deleteError;
    private IReadOnlyList<ProductGroup> groups = Array.Empty<ProductGroup>();
    private Product? editingProduct, deleting;
    private bool editing, deleteBusy;
    private bool canManage;
    private Guid editorKey;
    private bool loading, loaded;
    private bool quantityDescending = true;
    private int page = 1;
    private const int PageSize = 10;
    private Product? imagePreview;
    private DateTime? lastLoaded;
    private readonly CancellationTokenSource lifetime = new();
    private List<Product> ScopedProducts => products
        .Where(p => string.IsNullOrWhiteSpace(category) || string.Equals(p.Category, category, StringComparison.OrdinalIgnoreCase))
        .Where(p => string.IsNullOrWhiteSpace(subcategory) || string.Equals(p.Subcategory, subcategory, StringComparison.OrdinalIgnoreCase))
        .ToList();
    private string SelectionDescription => !string.IsNullOrWhiteSpace(subcategory)
        ? $"Subcategoria {subcategory}"
        : !string.IsNullOrWhiteSpace(category) ? $"Categoria {category}" : "Întregul catalog";
    private List<Product> Filtered
    {
        get
        {
            var filtered = ProductSearch.Filter(products, query, "all", category, stock)
                .Where(p => string.IsNullOrWhiteSpace(subcategory) || string.Equals(p.Subcategory, subcategory, StringComparison.OrdinalIgnoreCase));
            return (quantityDescending ? filtered.OrderByDescending(p => p.Quantity) : filtered.OrderBy(p => p.Quantity))
                .ThenBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase)
                .ToList();
        }
    }
    private int Pages => Math.Max(1, (Filtered.Count + PageSize - 1) / PageSize);
    private IEnumerable<Product> Paged => Filtered.Skip((page - 1) * PageSize).Take(PageSize);
    // Other sessions and external applications: refresh the catalog in place (Task 8).
    private LiveRefresh? live, liveLocks;
    protected override async Task OnInitializedAsync()
    {
        regularizeTab = TabName == "de-regularizat";
        await LoadAsync();
        await CountToRegularizeAsync();
        // Product edit locks (Task 9): taken and released by other sessions, refreshed on their events and every 15 s
        // because a lock also ends silently when its lease expires.
        liveLocks = new LiveRefresh(ChangeFeed, Origin.Id, change => change.EntityType == ChangeEntities.ProductLock,
            () => InvokeAsync(async () => { await RefreshLocksAsync(); StateHasChanged(); }), () => false,
            () => InvokeAsync(StateHasChanged), fallbackInterval: TimeSpan.FromSeconds(15));
        live = new LiveRefresh(ChangeFeed, Origin.Id, change => change.EntityType == AuditEntities.Product,
            () => InvokeAsync(RefreshSilentlyAsync), () => editing || deleting is not null,
            () => InvokeAsync(StateHasChanged), fallbackInterval: TimeSpan.FromSeconds(60));
    }
    private Task ReloadLiveAsync() => live?.ReloadPendingAsync() ?? Task.CompletedTask;
    // Quantity of each product held by vehicles (products without pieces in vehicles are absent).
    private IReadOnlyDictionary<int, int> inVehicles = new Dictionary<int, int>();
    private int InVehicles(int productId) => inVehicles.GetValueOrDefault(productId);
    private async Task RefreshSilentlyAsync()
    {
        if (loading || !loaded) return;
        try
        {
            var productsTask = Repository.GetProductsAsync(lifetime.Token);
            var groupsTask = Repository.GetGroupsAsync(lifetime.Token);
            var vehiclesTask = Movements.GetQuantitiesInVehiclesAsync(lifetime.Token);
            await Task.WhenAll(productsTask, groupsTask, vehiclesTask);
            products = await productsTask; groups = await groupsTask; inVehicles = await vehiclesTask;
            lastLoaded = DateTime.UtcNow; page = Math.Min(page, Pages);
            await RefreshLocksAsync();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex) { Logger.LogWarning("Catalog refresh failed ({ErrorType}).", ex.GetType().Name); }
        StateHasChanged();
    }
    protected override async Task OnParametersSetAsync()
    {
        category = CategoryQuery?.Trim() ?? "";
        subcategory = SubcategoryQuery?.Trim() ?? "";
        ResetPage();
        if (EditId is > 0 && loaded && (!editing || editingProduct?.Id != EditId.Value))
        {
            var requested = products.FirstOrDefault(product => product.Id == EditId.Value);
            if (requested is not null && canManage) await OpenEditorAsync(requested);
            else if (requested is null) error = "Produsul solicitat pentru editare nu mai există.";
        }
        if (DeleteId is > 0 && loaded && deleting?.Id != DeleteId.Value)
        {
            var requested = products.FirstOrDefault(product => product.Id == DeleteId.Value);
            if (requested is not null && canManage) await RequestDeleteAsync(requested);
            else if (requested is null) error = "Produsul solicitat pentru ștergere nu mai există.";
        }
    }
    private async Task LoadAsync()
    {
        if (loading) return;
        loading = true; error = null;
        try
        {
            var productsTask = Repository.GetProductsAsync(lifetime.Token);
            var groupsTask = Repository.GetGroupsAsync(lifetime.Token);
            var accessTask = Access.CanManageProductsAsync(lifetime.Token);
            var vehiclesTask = Movements.GetQuantitiesInVehiclesAsync(lifetime.Token);
            await Task.WhenAll(productsTask, groupsTask, accessTask, vehiclesTask);
            products = await productsTask;
            groups = await groupsTask;
            inVehicles = await vehiclesTask;
            canManage = await accessTask;
            loaded = true; lastLoaded = DateTime.UtcNow; ResetPage();
            await RefreshLocksAsync();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex) { Logger.LogError("Product loading failed ({ErrorType}).", ex.GetType().Name); error = "Catalogul nu a putut fi încărcat. Verifică serverul, accesul contului SQL și configurarea conexiunii."; products = Array.Empty<Product>(); loaded = false; lastLoaded = null; ResetPage(); }
        finally { loading = false; }
    }
    // ---- Edit lock (Task 9): taken when an existing product enters edit mode, renewed while the form is open,
    // released on save, cancel, navigation or when the page is disposed; it expires by itself if the browser vanishes.
    private IReadOnlyDictionary<int, ProductLock> locks = new Dictionary<int, ProductLock>();
    private string? lockMessage;
    private bool lockLost;
    private int lockedProductId;
    private CancellationTokenSource? heartbeat;
    private ProductLock? LockOfOthers(int productId) =>
        locks.TryGetValue(productId, out var held) && held.SessionId != Origin.Id.ToString() ? held : null;

    private async Task RefreshLocksAsync()
    {
        try { locks = (await Locks.GetActiveAsync(lifetime.Token)).ToDictionary(item => item.ProductId); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex) { Logger.LogWarning("Product lock listing failed ({ErrorType}).", ex.GetType().Name); }
    }

    private async Task<bool> TryLockAsync(Product product)
    {
        try
        {
            var attempt = await Locks.AcquireAsync(product.Id, Origin.Id.ToString(), lifetime.Token);
            if (attempt.Acquired) { StartHeartbeat(product.Id); return true; }
            lockMessage = attempt.Lock is { } held ? ProductLockRules.HeldMessage(held) : "Produsul nu mai există și nu poate fi blocat pentru editare.";
            await RefreshLocksAsync();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (AccessDeniedException ex) { error = ex.Message; }
        catch (Exception ex) { Logger.LogError("Product lock failed ({ErrorType}).", ex.GetType().Name); error = "Blocarea pentru editare nu a putut fi obținută. Reîncearcă."; }
        if (EditId is not null) { EditId = null; Navigation.NavigateTo(OriginOrCatalog(category, subcategory)); }
        return false;
    }

    private void StartHeartbeat(int productId)
    {
        StopHeartbeat();
        lockedProductId = productId; lockLost = false;
        var source = heartbeat = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token);
        HeartbeatAsync(productId, source.Token).FireAndForget(Logger, "product lock heartbeat");
    }

    private async Task HeartbeatAsync(int productId, CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(ProductLockRules.HeartbeatSeconds));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                try
                {
                    // Renew only while the browser answers; a vanished client must not keep the product locked. Any reply,
                    // even a JavaScript error, proves the browser is alive; silence or a closed connection does not.
                    try { await JS.InvokeAsync<bool>("blazorStocPing").AsTask().WaitAsync(TimeSpan.FromSeconds(10), token); }
                    catch (JSException) { }
                    catch (Exception ex) when (ex is JSDisconnectedException or TimeoutException or InvalidOperationException) { continue; }
                    var attempt = await Locks.RenewAsync(productId, Origin.Id.ToString(), token);
                    await InvokeAsync(() => { lockLost = !attempt.Acquired; StateHasChanged(); });
                    if (!attempt.Acquired) return;
                }
                catch (OperationCanceledException) when (token.IsCancellationRequested) { throw; }
                catch (Exception ex) { Logger.LogWarning("Product lock renewal failed ({ErrorType}).", ex.GetType().Name); }
            }
        }
        catch (OperationCanceledException) { }
    }

    private void StopHeartbeat() { heartbeat?.Cancel(); heartbeat?.Dispose(); heartbeat = null; }

    private async Task ReleaseLockAsync()
    {
        StopHeartbeat();
        var productId = lockedProductId;
        lockedProductId = 0; lockLost = false;
        if (productId <= 0) return;
        try { await Locks.ReleaseAsync(productId, Origin.Id.ToString(), CancellationToken.None); }
        catch (Exception ex) when (ex is not OperationCanceledException) { Logger.LogWarning("Product lock release failed ({ErrorType}).", ex.GetType().Name); }
    }

    private async Task OpenEditorAsync(Product? product)
    {
        lockMessage = null;
        if (product is not null && !await TryLockAsync(product)) return;
        editingProduct = product; editorKey = Guid.NewGuid(); editing = true; notice = null;
    }
    private async Task CloseEditorAsync()
    {
        editing = false; editingProduct = null;
        await ReleaseLockAsync();
        // A discarded editor (leave warning) must not send the user back to the product page: the chosen target follows.
        if (EditId is not null) { EditId = null; if (!Guard.IsDiscarding) Navigation.NavigateTo(OriginOrCatalog(category, subcategory)); }
    }
    private async Task ProductSavedAsync(Product product)
    {
        var created = editingProduct is null;
        products = products.Where(p => p.Id != product.Id).Append(product).OrderBy(p => p.Subcategory).ThenBy(p => p.Name).ThenBy(p => p.Id).ToArray();
        groups = groups.Append(new(product.Category, product.Subcategory)).Distinct().ToArray();
        var origin = !created && EditId is not null ? ReturnNavigation.Safe(ReturnQuery) : null;
        await CloseEditorAsync(); query = stock = ""; loaded = true; error = null;
        notice = created ? "Produsul a fost adăugat." : "Modificările au fost salvate.";
        // An edit started from the product page returns there after saving; other saves show the catalog.
        Navigation.NavigateTo(origin ?? ProductUrl(product.Category, product.Subcategory));
    }
    private async Task RequestDeleteAsync(Product? product)
    {
        lockMessage = null;
        if (product is not null)
        {
            ProductLock? held = null;
            try { held = await Locks.GetAsync(product.Id, lifetime.Token); }
            catch (Exception ex) when (ex is not OperationCanceledException) { Logger.LogWarning("Product lock check failed ({ErrorType}).", ex.GetType().Name); }
            if (held is not null && held.SessionId != Origin.Id.ToString())
            {
                lockMessage = $"Produsul nu poate fi șters cât timp este editat de {held.Owner}. Un administrator poate elibera blocarea din pagina produsului.";
                if (DeleteId is not null) { DeleteId = null; Navigation.NavigateTo(OriginOrCatalog(category, subcategory)); }
                return;
            }
        }
        deleting = product; deleteError = null; notice = null;
    }
    private Task CancelDeleteAsync() { deleting = null; deleteError = null; ClearDeleteQuery(returnToOrigin: true); return Task.CompletedTask; }
    // The product page (movements) links here with ?sterge=<id> so the existing deletion flow stays in one place.
    // A cancelled deletion returns to the page it was started from; after a real deletion the product page no longer
    // exists, so the catalog is shown instead.
    private void ClearDeleteQuery(bool returnToOrigin = false)
    {
        if (DeleteId is null) return;
        DeleteId = null;
        Navigation.NavigateTo(returnToOrigin ? OriginOrCatalog(category, subcategory) : ProductUrl(category, subcategory));
    }
    private string OriginOrCatalog(string? category, string? subcategory) => ReturnNavigation.Safe(ReturnQuery) ?? ProductUrl(category, subcategory);
    private void OpenMovements(Product product) => Navigation.NavigateTo(StockMovementNavigation.ProductUrl(product.Id));
    private async Task DeleteProductAsync(string reason)
    {
        if (deleteBusy || deleting is null) return;
        deleteBusy = true; deleteError = null;
        try { var deletedId = deleting.Id; await Repository.DeleteAsync(deleting, reason, lifetime.Token); products = products.Where(p => p.Id != deletedId).ToArray(); deleting = null; ClearDeleteQuery(); page = Math.Min(page, Pages); notice = "Produsul a fost mutat în arhivă."; }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (ProductOperationException ex) { deleteError = ex.Message; }
        catch (AccessDeniedException ex) { deleteError = ex.Message; }
        catch (Exception ex) { Logger.LogError("Product deletion failed ({ErrorType}).", ex.GetType().Name); deleteError = "Ștergerea nu a putut fi confirmată. Actualizează catalogul înainte să reîncerci. Verifică accesul de scriere cu administratorul dacă problema continuă."; }
        finally { deleteBusy = false; }
    }
    private void ResetPage() => page = 1;
    private void ToggleQuantitySort() { quantityDescending = !quantityDescending; ResetPage(); }
    private void ClearFilters() { query = stock = ""; Navigation.NavigateTo("/produse"); ResetPage(); }
    private static string ProductUrl(string? category, string? subcategory = null)
    {
        if (string.IsNullOrWhiteSpace(category)) return "/produse";
        var url = $"/produse?categorie={Uri.EscapeDataString(category)}";
        return string.IsNullOrWhiteSpace(subcategory) ? url : $"{url}&subcategorie={Uri.EscapeDataString(subcategory)}";
    }
    private Task CloseImagePreviewAsync() { imagePreview = null; return Task.CompletedTask; }
    private static string ProductImageUrl(Product product) => $"/media/products/{product.Id}?v={product.Version}";
    private static string StockClass(int quantity) => quantity < 0 ? "negative" : quantity == 0 ? "zero" : "positive";
    private static string StockLabel(int quantity) => quantity < 0 ? "Stoc negativ" : quantity == 0 ? "Fără stoc" : "În stoc";
    public async ValueTask DisposeAsync()
    {
        live?.Dispose(); liveLocks?.Dispose();
        var lockedId = lockedProductId; StopHeartbeat();
        if (lockedId > 0)
        {
            try { await Locks.ReleaseAsync(lockedId, Origin.Id.ToString(), CancellationToken.None); }
            catch (Exception) { }
        }
        lifetime.Cancel(); lifetime.Dispose();
    }
}
