@page "/produse/{Id:int}"
@page "/produse/{Id:int}/miscari"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using BlazorStoc.Services
@inject IProductRepository Products
@inject IStockMovementRepository Movements
@inject IBeneficiaryRepository Beneficiaries
@inject IVehicleRepository VehicleRepository
@inject IProjectRepository Projects
@inject ExitFormDraft ExitDraft
@inject IAccessControl Access
@inject NavigationManager Navigation
@inject IChangeFeed ChangeFeed
@inject ChangeOrigin Origin
@inject IProductLockRepository Locks
@inject ILogger<ProductMovements> Logger
@implements IDisposable
<PageBoundary>

<PageTitle>@(product is null ? "Intrări/ieșiri" : $"Intrări/ieșiri · {product.Name}") · BlazorStoc</PageTitle>
<UnsavedChangesHost />
<a class="nav-back" href="@CatalogUrl"><span>←</span> Produse și stocuri</a>

@if (loading && product is null)
{
    <div class="empty-state" role="status"><div class="spinner"></div><h3>Se încarcă produsul</h3></div>
}
else if (error is not null && product is null)
{
    <div class="error-banner" role="alert">@error <button class="primary" @onclick="LoadAsync">Reîncearcă</button></div>
}
else if (product is null)
{
    <div class="empty-state"><span class="empty-icon">▦</span><h3>Produsul nu mai există</h3><p>Produsul a fost șters sau linkul nu este valid.@(restoreMessage is null ? "" : " " + restoreMessage)</p><a class="refresh act-nav" href="/produse">Înapoi la catalog</a></div>
}
else
{
    <div class="page-heading">
        <div><p class="eyebrow">INTRĂRI / IEȘIRI</p><h1>@product.Name</h1><p class="muted">Mișcările de stoc ale produsului. Stocul se modifică numai prin intrări și ieșiri.</p></div>
    </div>
    @if (error is not null) { <div class="error-banner" role="alert">@error <button class="primary" @onclick="LoadPageAsync">Reîncearcă</button></div> }
    @if (notice is not null) { <div class="success-banner" role="status">@notice</div> }
    @if (restoreMessage is not null) { <div class="info-banner" role="status">@restoreMessage</div> }
    <LiveChangeNotice Visible="live?.HasPendingChange == true" Reload="ReloadLiveAsync" />
    @if (holder is not null)
    {
        <div class="info-banner live-change-notice" role="status">
            <span>🔒 @ProductLockRules.HeldMessage(holder)</span>
            @if (isAdministrator) { <button type="button" class="danger" @onclick="OpenUnlock">Deblochează (administrator)</button> }
        </div>
    }
    else if (holderReleased) { <div class="success-banner" role="status">Produsul a fost eliberat și poate fi editat acum.</div> }

    <div class="movement-layout">
        <section class="movement-card movement-product" aria-labelledby="movement-product-title">
            <h2 id="movement-product-title">Produs</h2>
            <dl class="movement-facts">
                <dt>Categorie</dt><dd>@product.Category</dd>
                <dt>Subcategorie</dt><dd>@product.Subcategory</dd>
                <dt>@ProductCode.Label</dt><dd>@product.Name</dd>
            </dl>
            <div class="movement-product-media">
                <button type="button" class="product-thumbnail movement-image" title="Mărește imaginea" aria-label="Mărește imaginea pentru @product.Name" @onclick="() => imagePreview = true"><img src="@ImageUrl" alt="" /></button>
                @if (canManage)
                {
                    <div class="movement-product-actions">
                        @if (holder is null) { <a class="refresh act-edit" href="@ReturnNavigation.EditUrl(product.Id, CurrentPath)">Editează</a> }
                        else { <button type="button" class="row-icon edit" disabled title="@ProductLockRules.HeldMessage(holder)" aria-label="Editează mișcarea"></button> }
                        <a class="danger movement-link-danger" href="@ReturnNavigation.DeleteUrl(product.Id, CurrentPath)">Șterge produs</a>
                    </div>
                }
            </div>
        </section>

        <ProductReservationsInfo ProductId="Id" Stock="stock" Version="reservationVersion" />
        @if (canManage) { <ProductWhere ProductId="Id" Stock="stock" Version="reservationVersion" /> }
        @if (canManage)
        {
            <ReserveSuggestions ProductId="Id" Trigger="suggestionTrigger" Reserved="() => { reservationVersion++; }" />
            <section class="movement-card movement-form" aria-labelledby="movement-form-title">
                <UnsavedChangesTracker @key="Id" @ref="addTracker" Adding="true" Snapshot="AddSnapshot" Discard="DiscardAddAsync" />
                <h2 id="movement-form-title">Înregistrează o mișcare</h2>
                @if (stock < 0)
                {
                    <NegativeStockPanel Resolution="negResolution" Stock="stock" Disabled="saving" Changed="() => formError = null" />
                    <div class="editor-actions"><button type="button" class="primary" disabled="@(saving || !negResolution.IsResolved)" @onclick="RegularizeAsync">Regularizează stocul acum</button></div>
                }
                <EditForm Model="form" OnSubmit="AddAsync" FormName="stock-movement-add">
                    <fieldset disabled="@saving">
                        <div class="movement-form-top">
                            <label class="movement-date" for="movement-date">Data mișcării *
                                <PickOnlyDate Id="movement-date" @bind-Value="form.Date" Min="@StockMovementRules.StorageDate(StockMovementRules.EarliestDate)" Max="@StockMovementRules.StorageDate(StockMovementRules.Today)" /></label>
                            <div class="movement-kind" role="tablist" aria-label="Tipul mișcării">
                                <button type="button" class="kind-button kind-in @(form.Kind == StockMovementKind.Entry ? "selected" : "")" role="tab" aria-selected="@(form.Kind == StockMovementKind.Entry)" @onclick="() => SetKindAsync(StockMovementKind.Entry)">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v13m0 0-5-5m5 5 5-5M5 20h14" /></svg> Intrare</button>
                                <button type="button" class="kind-button kind-out @(form.Kind == StockMovementKind.Exit ? "selected" : "")" role="tab" aria-selected="@(form.Kind == StockMovementKind.Exit)" @onclick="() => SetKindAsync(StockMovementKind.Exit)">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20V7m0 0-5 5m5-5 5 5M5 4h14" /></svg> Ieșire</button>
                            </div>
                        </div>
                        @if (form.Kind == StockMovementKind.Entry)
                        {
                            <EntryOriginPicker @ref="originPicker" Model="form" Disabled="saving" Changed="OriginChanged" ReturnableExits="returnables" />
                            <EntryComponentChoice @key="entryChoiceKey" ComponentId="form.ProjectComponentId" ComponentIdChanged="id => form.ProjectComponentId = id" ProductId="Id" Disabled="saving" />
                        }
                        @if (form.Kind == StockMovementKind.Exit)
                        {
                            <ExitDestinationPicker @ref="addPicker" Prefix="add" Model="form" Beneficiaries="beneficiaries" Projects="projects"
                                                   Vehicles="vehicles" VehicleStocks="vehicleStocks" Disabled="saving" UseProject="useProject"
                                                   AllowAdd="true" AddBeneficiaryRequested="AddBeneficiaryAsync" AddProjectRequested="AddProjectAsync"
                                                   DestinationChanged="() => DestinationChangedAsync(false)"
                                                   VehicleChanged="() => { ApplySuggestion(false); return Task.CompletedTask; }"
                                                   BeneficiaryChanged="id => SelectBeneficiaryAsync(form, id, false)"
                                                   ProjectToggled="v => ToggleProject(form, v, false)"
                                                   ProjectChanged="id => SetProject(form, id)" />
                            @if (form.Destination == ExitDestination.Beneficiary && form.ProjectId is not null)
                            {
                                <ExitComponentChoice ProjectId="form.ProjectId" ProductId="Id" ComponentId="form.ProjectComponentId" OutsideOffer="form.OutsideOffer" Disabled="saving"
                                                     Changed="choice => { form.ProjectComponentId = choice.ComponentId; form.OutsideOffer = choice.OutsideOffer; }" />
                            }
                        }
                        <label class="movement-description" for="movement-description">Descriere *
                            <InputTextArea id="movement-description" @bind-Value="form.Description" rows="3" maxlength="@StockMovementRules.MaxDescriptionLength" /></label>
                        @if (form.Kind == StockMovementKind.Exit)
                        {
                            <label class="movement-description" for="movement-reference">Referință (aviz, bon, număr predare)
                                <InputText id="movement-reference" @bind-Value="form.Reference" maxlength="@StockMovementRules.MaxReferenceLength" /></label>
                        }
                        <div class="movement-form-bottom">
                            <label for="movement-quantity">Cantitate *
                                <InputNumber id="movement-quantity" TValue="int?" @bind-Value="form.Quantity" ParsingErrorMessage="Cantitatea trebuie să fie un număr întreg." min="1" max="@StockMovementRules.MaxQuantity" /></label>
                            <button class="primary" type="submit">@(saving ? "Se salvează…" : "Adaugă")</button>
                        </div>
                        @if (form.Kind == StockMovementKind.Exit && form.SourceVehicleId is null && form.Quantity is { } outQuantity && outQuantity > Math.Max(0, WarehouseStock))
                        {
                            <small class="form-note" role="status">Depășește stocul din depozit (@Math.Max(0, WarehouseStock) buc.): se poate înregistra, dar stocul va deveni negativ și va trebui regularizat la următoarea intrare.</small>
                        }
                        @if (form.Kind == StockMovementKind.Exit && form.SourceVehicleId is { } sourceVehicle && form.Quantity is { } fromVehicle
                             && form.Destination is not (ExitDestination.Vehicle or ExitDestination.WarehouseReturn)
                             && fromVehicle > (vehicleStocks.FirstOrDefault(item => item.VehicleId == sourceVehicle)?.Quantity ?? 0))
                        {
                            <small class="form-note" role="status">Depășește cantitatea înregistrată în mașină (@(vehicleStocks.FirstOrDefault(item => item.VehicleId == sourceVehicle)?.Quantity ?? 0) buc.): se poate înregistra, ieșirea va fi marcată „peste stoc”.</small>
                        }
                        @if (FormOverStock)
                        {
                            @CauseChoice(form, "cause-add")
                        }
                        @if (exitWarning is not null)
                        {
                            <div class="invoice-warning" role="alert">
                                <p>⚠ @exitWarning.Message</p>
                                <label class="full-width" for="duplicate-exit-reason">Motiv pentru ieșirea repetată
                                    <InputTextArea id="duplicate-exit-reason" @bind-Value="duplicateReason" rows="2" maxlength="@ChangeReasonRules.MaximumLength" /></label>
                                <div class="editor-actions">
                                    <button type="button" class="primary" @onclick="ConfirmDuplicateExitAsync">Adaugă totuși</button>
                                    <button type="button" class="danger" @onclick="CancelWarning">Renunț</button>
                                </div>
                            </div>
                        }
                        @if (reservationWarning is not null)
                        {
                            <div class="invoice-warning" role="alert">
                                <p>⚠ @reservationWarning.Message Nu se blochează nimic; alege ce se întâmplă cu rezervările.</p>
                                <ReservationWarningChoice Prefix="add" Choice="reservationChoice" Holders="reservationWarning.Holders" Excess="reservationWarning.Excess" Disabled="saving" />
                                <div class="editor-actions">
                                    <button type="button" class="primary" disabled="@saving" @onclick="ConfirmReservationAsync">Adaugă totuși</button>
                                    <button type="button" class="danger" disabled="@saving" @onclick="CancelWarning">Renunț</button>
                                </div>
                            </div>
                        }
                        @if (invoiceWarning is not null)
                        {
                            <div class="invoice-warning" role="alert">
                                <p>⚠ @invoiceWarning.Message</p>
                                <label class="full-width" for="duplicate-reason">Motiv pentru intrarea nouă
                                    <InputTextArea id="duplicate-reason" @bind-Value="duplicateReason" rows="2" maxlength="@ChangeReasonRules.MaximumLength" /></label>
                                <div class="editor-actions">
                                    <button type="button" class="primary" @onclick="ConfirmDuplicateAsync">Adaugă totuși</button>
                                    <button type="button" class="refresh act-edit" @onclick="ModifyExistingAsync">Modifică intrarea existentă</button>
                                    <button type="button" class="danger" @onclick="CancelWarning">Renunț</button>
                                </div>
                            </div>
                        }
                        @if (formError is not null) { <div class="validation-message" role="alert">@formError</div> }
                    </fieldset>
                </EditForm>
            </section>
        }
    </div>

    <section class="movement-card movement-history" aria-labelledby="movement-list-title">
        <div class="movement-list-head">
            <h2 id="movement-list-title">Intrări/ieșiri produs: @product.Name</h2>
            <span class="movement-stock @StockClass" role="status">Total produse în stoc: <strong>@stock</strong>
                @if (StockMovementRules.StockSplit(stock, inVehicles) is { } breakdown) { <small class="movement-breakdown">· @breakdown</small> }</span>
        </div>
        <div class="filters audit-filters movement-filters">
            <label class="search-box"><span>⌕</span><input id="movement-text-filter" aria-label="Caută în mișcări" autocomplete="off" maxlength="80"
                       placeholder="Descriere, factură, furnizor, beneficiar, proiect, vehicul…" @bind="textFilter" @bind:event="oninput" @bind:after="TextChangedAsync" /></label>
            <label><span class="sr-only">Tip mișcare</span>
                <select id="movement-kind-filter" @onchange="KindChosenAsync">
                    <option value="" selected="@(filter is null && !overStockOnly)">Toate mișcările</option>
                    <option value="in" selected="@(filter == StockMovementKind.Entry)">Intrări</option>
                    <option value="out" selected="@(filter == StockMovementKind.Exit && !overStockOnly)">Ieșiri</option>
                    <option value="over" selected="@overStockOnly">Ieșiri peste stoc</option>
                </select></label>
            <label><span class="sr-only">Proveniența intrărilor</span>
                <select id="movement-source-filter" @onchange="SourceChosenAsync">
                    <option value="" selected="@(source == EntrySource.All)">Toate proveniențele</option>
                    <option value="invoice" selected="@(source == EntrySource.WithInvoice)">Cu factură</option>
                    <option value="free" selected="@(source == EntrySource.Free)">Intrări libere</option>
                </select></label>
            @if (pageData.Suppliers is { Count: > 0 } filterSuppliers)
            {
                <SearchableSelect Id="movement-supplier-filter" Label="Furnizor" Placeholder="Toți furnizorii" EmptyText="Niciun furnizor găsit."
                                  Options="@(filterSuppliers.Select(item => new SelectOption(item.Id, item.Name)).ToArray())" SelectedId="supplierFilter" SelectedIdChanged="SupplierFilterChangedAsync" />
            }
            <label><span class="sr-only">Destinația ieșirilor</span>
                <select id="movement-destination-filter" @onchange="DestinationFilterChangedAsync">
                    <option value="">Toate destinațiile</option>
                    @foreach (var kind in FilterDestinations) { <option value="@((int)kind)" selected="@(destinationFilter == kind)">@StockMovementRules.DestinationLabel(kind)</option> }
                </select></label>
            @if (pageData.ExitBeneficiaries is { Count: > 0 } filterBeneficiaries)
            {
                <SearchableSelect Id="movement-beneficiary-filter" Label="Beneficiar" Placeholder="Toți beneficiarii" EmptyText="Niciun beneficiar găsit."
                                  Options="@(filterBeneficiaries.Select(item => new SelectOption(item.Id, item.Name)).ToArray())" SelectedId="beneficiaryFilter" SelectedIdChanged="BeneficiaryFilterChangedAsync" />
            }
            @if (pageData.ExitVehicles is { Count: > 0 } filterVehicles)
            {
                <label><span class="sr-only">Vehicul</span>
                    <select id="movement-vehicle-filter" @onchange="VehicleFilterChangedAsync">
                        <option value="">Toate vehiculele</option>
                        @foreach (var item in filterVehicles) { <option value="@item.Id" selected="@(vehicleFilter == item.Id)">@item.Name</option> }
                    </select></label>
            }
        </div>
        @if (ActiveFilters.Count > 0)
        {
            <div class="audit-active-filters" role="status">
                <span>Filtre active:</span>
                @foreach (var chip in ActiveFilters)
                {
                    <strong class="audit-filter-chip">@chip.Text <button type="button" aria-label="@($"Elimină filtrul {chip.Text}")" title="@($"Elimină filtrul {chip.Text}")" @onclick="chip.Remove">×</button></strong>
                }
                <button type="button" class="audit-clear-filters danger" @onclick="ClearFiltersAsync">Șterge filtrele</button>
            </div>
        }

        @if (loading)
        {
            <div class="empty-state" role="status"><div class="spinner"></div><h3>Se încarcă mișcările</h3></div>
        }
        else if (pageData.Items.Count == 0)
        {
            <div class="empty-state"><span class="empty-icon">⇅</span><h3>@(filter is null ? "Nu există intrări/ieșiri pentru acest produs" : "Nu există mișcări pentru filtrul ales")</h3><p>@(canManage && filter is null ? "Folosește formularul de mai sus pentru prima mișcare." : "Schimbă filtrul pentru a vedea celelalte mișcări.")</p></div>
        }
        else
        {
            <div class="table-scroll">
                <table class="movement-table">
                    <thead><tr>
                        <th aria-sort="@(descending ? "descending" : "ascending")"><button class="sort-header" @onclick="ToggleSortAsync" aria-label="Sortează după dată @(descending ? "crescător" : "descrescător")">DATA <span aria-hidden="true">@(descending ? "▼" : "▲")</span></button></th>
                        <th>INTRARE/IEȘIRE</th><th class="number">NUMĂR BUCĂȚI</th><th>DESCRIERE</th><th>FURNIZOR / FACTURĂ</th><th>BENEFICIAR/PROIECT</th><th>VEHICUL</th>
                        @if (canManage) { <th><span class="sr-only">Acțiuni</span></th> }
                    </tr></thead>
                    <tbody>
                        @foreach (var m in pageData.Items)
                        {
                            <tr @key="m.Id" class="@(m.Modified ? "modified" : "") @(m.IsVoided ? "voided" : "")" @oncontextmenu="() => OpenHistoryAsync(m)" @oncontextmenu:preventDefault="@m.Modified">
                                <td><button type="button" class="audit-filter-link" title="Filtrează după această dată" @onclick="() => FilterByDateAsync(m.Date)">@StockMovementRules.DisplayDate(m.Date)</button></td>
                                <td><button type="button" class="audit-filter-link kind-label @(m.Kind == StockMovementKind.Entry ? "in" : "out")" title="Filtrează după acest tip de mișcare" @onclick="() => FilterByKindAsync(m.Kind)">@StockMovementRules.KindLabel(m.Kind)@(m.Modified ? "[*]" : "")</button></td>
                                <td class="number">@m.Quantity</td>
                                <td class="movement-text">@m.Description@if (m.IsVoided) { <span class="stock-badge negative" title="@($"Stornat de {m.VoidedBy}: {m.VoidReason}")"> stornat</span> }@if (m.ReturnOfMovementId is { } returnOf) { <small class="movement-project"> · retur al ieșirii #@returnOf</small> }@if (m.Kind == StockMovementKind.Exit && m.Reference is not null) { <small class="movement-project"> · ref. @m.Reference</small> }@if (pageData.OverStockIds?.Contains(m.Id) == true) { <span class="stock-badge negative" title="Ieșirea a depășit stocul din depozit (sau din mașină) la data ei"> peste stoc</span>@if (m.OverStockCause is { } overCause) { <small class="movement-project"> · @StockMovementRules.CauseLabel(overCause)</small> } }</td>
                                <td>
                                    @if (m.InvoiceNumber is not null)
                                    {
                                        <span>@m.InvoiceNumber</span>
                                        @if (m.SupplierId is { } supplierId && m.SupplierName is not null) { <span class="movement-project"> · <a class="category-table-link" href="@SupplierNavigation.SupplierUrl(supplierId)">@m.SupplierName</a> <button type="button" class="audit-filter-link filter-hint" title="Filtrează după acest furnizor" aria-label="Filtrează după acest furnizor" @onclick="() => FilterBySupplierAsync(supplierId)">⌕</button></span> }
                                    }
                                    else if (m.Kind == StockMovementKind.Entry) { <span class="destination-label">Intrare liberă</span> }
                                </td>
                                <td>
                                    @if (m.BeneficiaryName is not null)
                                    {
                                        <a class="category-table-link" href="@($"/beneficiari/{m.BeneficiaryId}")">@m.BeneficiaryName</a> <button type="button" class="audit-filter-link filter-hint" title="Filtrează după acest beneficiar" aria-label="Filtrează după acest beneficiar" @onclick="() => FilterByBeneficiaryAsync(m.BeneficiaryId!.Value)">⌕</button>
                                        @if (m.ProjectName is not null) { <span class="movement-project"> · <a class="category-table-link" href="@($"/proiecte/{m.ProjectId}")">@m.ProjectName</a></span> }
                                    }
                                    else if (m.Destination is ExitDestination.GenericSale or ExitDestination.StockCorrection or ExitDestination.WarehouseReturn)
                                    {
                                        <button type="button" class="audit-filter-link destination-label" title="Filtrează după această destinație" @onclick="() => FilterByDestinationAsync(m.Destination!.Value)">@StockMovementRules.DestinationLabel(m.Destination.Value)</button>
                                    }
                                </td>
                                <td>
                                    @if (m.VehiclePlate is not null) { <span class="movement-project">în <a class="category-table-link" href="@VehicleNavigation.PageUrl(m.VehicleId!.Value)">@m.VehiclePlate</a> <button type="button" class="audit-filter-link filter-hint" title="Filtrează după acest vehicul" aria-label="Filtrează după acest vehicul" @onclick="() => FilterByVehicleAsync(m.VehicleId!.Value)">⌕</button></span> }
                                    @if (m.SourceVehiclePlate is not null) { <span class="movement-project">din <a class="category-table-link" href="@VehicleNavigation.PageUrl(m.SourceVehicleId!.Value)">@m.SourceVehiclePlate</a> <button type="button" class="audit-filter-link filter-hint" title="Filtrează după acest vehicul" aria-label="Filtrează după acest vehicul" @onclick="() => FilterByVehicleAsync(m.SourceVehicleId!.Value)">⌕</button></span> }
                                </td>
                                @if (canManage)
                                {
                                    <td class="movement-actions">
                                        @if (!m.IsVoided)
                                        {
                                            <button class="row-icon edit" aria-label="Editează mișcarea din @StockMovementRules.DisplayDate(m.Date)" @onclick="() => OpenEditAsync(m)" title="Editează mișcarea din @StockMovementRules.DisplayDate(m.Date)"></button>
                                            <button class="row-icon delete" aria-label="Șterge mișcarea din @StockMovementRules.DisplayDate(m.Date)" @onclick="() => RequestDelete(m)" title="Șterge mișcarea din @StockMovementRules.DisplayDate(m.Date)"></button>
                                        }
                                        @if (m.Kind == StockMovementKind.Exit && m.OperationId is { } operationId)
                                        {
                                            <a class="row-action" target="_blank" rel="noopener" href="@($"/api/iesiri/{operationId}/bon.pdf")" aria-label="Bonul de consum al operației @operationId">Bon</a>
                                            @if (!m.IsVoided)
                                            {
                                                <button class="row-action delete" aria-label="Stornează operația @operationId" @onclick="() => RequestVoid(m)">Stornează</button>
                                            }
                                        }
                                        @if (m.Modified) { <button class="row-action" aria-label="Istoricul modificărilor mișcării din @StockMovementRules.DisplayDate(m.Date)" @onclick="() => OpenHistoryAsync(m)">Istoric</button> }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <footer class="table-footer">
            <span>@pageData.TotalCount @(pageData.TotalCount == 1 ? "mișcare" : "mișcări")</span>
            @if (pageSize > 0)
            {
                <div class="pagination"><button disabled="@(pageNumber <= 1 || loading)" @onclick="PreviousPageAsync" aria-label="Pagina anterioară">‹</button><span>Pagina <strong>@pageNumber</strong> din <strong>@TotalPages</strong></span><button disabled="@(pageNumber >= TotalPages || loading)" @onclick="NextPageAsync" aria-label="Pagina următoare">›</button></div>
            }
        </footer>
        @if (pageData.AnyModified) { <p class="movement-legend">Intrările/ieșirile cu [*] au suferit modificări. Click dreapta pe rând sau butonul „Istoric” pentru a vedea istoricul modificărilor.</p> }
    </section>
}

@if (imagePreview && product is not null)
{
    <div class="image-lightbox" role="dialog" aria-modal="true" aria-label="Imagine mărită pentru @product.Name" @onclick="() => imagePreview = false" @onkeydown="ImageKeyAsync">
        <button type="button" class="image-lightbox-close" aria-label="Închide imaginea" @onclick="() => imagePreview = false" title="Închide imaginea">×</button>
        <figure @onclick:stopPropagation="true"><img src="@ImageUrl" alt="Imagine mărită pentru @product.Name" /><figcaption>@product.Name</figcaption></figure>
    </div>
}

@if (editing is not null)
{
    <div class="delete-overlay" @onkeydown="EditKeyAsync">
        <UnsavedChangesTracker @key="editing.Id" @ref="editTracker" Snapshot="EditSnapshot" Discard="DiscardEditAsync" />
        <section class="delete-dialog movement-dialog" role="dialog" aria-modal="true" aria-labelledby="movement-edit-title">
            <h2 id="movement-edit-title">Editează @StockMovementRules.KindLabel(editing.Kind).ToLowerInvariant()a din @StockMovementRules.DisplayDate(editing.Date)</h2>
            <EditForm Model="editForm" OnSubmit="SaveEditAsync" FormName="stock-movement-edit">
                <fieldset disabled="@editSaving">
                    <div class="editor-grid">
                        <label for="edit-date">Data mișcării *<PickOnlyDate Id="edit-date" @bind-Value="editForm.Date" Min="@StockMovementRules.StorageDate(StockMovementRules.EarliestDate)" Max="@StockMovementRules.StorageDate(StockMovementRules.Today)" /></label>
                        <label for="edit-quantity">Cantitate *<InputNumber id="edit-quantity" TValue="int?" @bind-Value="editForm.Quantity" ParsingErrorMessage="Cantitatea trebuie să fie un număr întreg." min="1" max="@StockMovementRules.MaxQuantity" /></label>
                        @if (editing.Kind == StockMovementKind.Exit)
                        {
                            @if (editing.IsVehicleTransfer)
                            {
                                <p class="form-note full-width" role="status">@TransferText(editing) Destinația și sursa nu se schimbă aici; cantitatea, data și descrierea pot fi editate.</p>
                            }
                            else
                            {
                            <div class="full-width">
                                <ExitDestinationPicker @ref="editPicker" Prefix="edit" Model="editForm" Beneficiaries="beneficiaries" Projects="editProjects"
                                                       Vehicles="vehicles" VehicleStocks="vehicleStocks" Disabled="editSaving" UseProject="editUseProject"
                                                       EditingSourceVehicleId="editing.SourceVehicleId" EditingQuantity="editing.Quantity"
                                                       DestinationChanged="() => DestinationChangedAsync(true)"
                                                       VehicleChanged="() => { ApplySuggestion(true); return Task.CompletedTask; }"
                                                       BeneficiaryChanged="id => SelectBeneficiaryAsync(editForm, id, true)"
                                                       ProjectToggled="v => ToggleProject(editForm, v, true)"
                                                       ProjectChanged="id => SetProject(editForm, id)" />
                            </div>
                            }
                        }
                        @if (editing.Kind == StockMovementKind.Entry)
                        {
                            <p class="form-note full-width entry-origin-note" role="status">
                                <strong>Proveniență:</strong>
                                @if (editing.InvoiceNumber is not null) { <text>factura @editing.InvoiceNumber · @editing.SupplierName</text> }
                                else { <text>@StockMovementRules.FreeEntryLabel(editing)@(editing.FreeSupplierName is not null ? $" · {editing.FreeSupplierName}" : "")@(editing.Reference is not null ? $" · {editing.Reference}" : "")</text> }
                                @if (isAdministrator)
                                {
                                    <button type="button" class="primary entry-origin-action" @onclick="() => OpenLink(editing)">@(editing.InvoiceId is null ? "Atașează la factură" : "Detașează de la factură")</button>
                                }
                            </p>
                        }
                        <label class="full-width" for="edit-description">Descriere *<InputTextArea id="edit-description" @bind-Value="editForm.Description" rows="3" maxlength="@StockMovementRules.MaxDescriptionLength" /></label>
                        @if (editing.Kind == StockMovementKind.Exit)
                        {
                            <label class="full-width" for="edit-reference">Referință (aviz, bon, număr predare)<InputText id="edit-reference" @bind-Value="editForm.Reference" maxlength="@StockMovementRules.MaxReferenceLength" /></label>
                        }
                        @if (editing.Kind == StockMovementKind.Exit && pageData.OverStockIds?.Contains(editing.Id) == true)
                        {
                            @CauseChoice(editForm, "cause-edit")
                        }
                        <ChangeReasonField Id="movement-edit-reason" @bind-Value="editCustomReason" AutoText="@EditAutoSummary" @bind-UseAuto="editReasonAuto" Disabled="editSaving" />
                    </div>
                    <p class="movement-summary" role="status">Cantitate veche: <strong>@editing.Quantity</strong> · Cantitate nouă: <strong>@(editForm.Quantity?.ToString() ?? "—")</strong> · Corecție stoc: <strong>@CorrectionText</strong></p>
                    @if (editError is not null) { <div class="validation-message" role="alert">@editError</div> }
                    <div class="editor-actions"><button class="primary" type="submit">@(editSaving ? "Se salvează…" : "Salvează modificarea")</button><button type="button" class="danger" @onclick="RequestCloseEditAsync">Anulează</button></div>
                </fieldset>
            </EditForm>
        </section>
    </div>
}

@if (linking is not null)
{
    <EntryInvoiceLinkDialog Entries="linking" Detach="linkDetach" Cancelled="CancelLink" Done="LinkDoneAsync" />
}

@if (pendingEditChanges is not null && editing is not null)
{
    <SaveConfirmationDialog Title="Salvezi modificările mișcării?"
                            ObjectLabel="@($"{StockMovementRules.KindLabel(editing.Kind)} · {editing.Quantity} buc. · {StockMovementRules.DisplayDate(editing.Date)}")"
                            Changes="pendingEditChanges" Note="@($"Corecție stoc: {CorrectionText} buc.")" Reason="@editForm.Reason"
                            Confirmed="ConfirmEditAsync" Cancelled="CancelEditConfirmation" />
}

@if (unlocking && holder is not null)
{
    <ForceUnlockDialog ObjectLabel="@product?.Name" Owner="@holder.Owner" Busy="@unlockBusy" Error="@unlockError"
                       Confirmed="ForceUnlockAsync" Cancelled="CancelUnlock" />
}

@if (deleting is not null)
{
    <DeleteConfirmationDialog @key="deleting.Id" Title="Ștergi mișcarea?" Subject="Mișcarea"
                              ObjectLabel="@($"{StockMovementRules.KindLabel(deleting.Kind)} · {deleting.Quantity} buc. · {StockMovementRules.DisplayDate(deleting.Date)}")"
                              Description="@DeleteDescription" Busy="@deleteBusy" Error="@deleteError"
                              Confirmed="DeleteAsync" Cancelled="CancelDelete" />
}

@if (voiding is not null)
{
    <div class="delete-overlay">
        <section class="delete-dialog" role="dialog" aria-modal="true" aria-labelledby="void-title">
            <h2 id="void-title">Stornezi operația?</h2>
            <p class="delete-object"><strong>Operația #@voiding.OperationId · @StockMovementRules.DisplayDate(voiding.Date)</strong></p>
            <p>Toate ieșirile operației se anulează (stocul și cantitățile din mașini se refac), dar rămân în pagină marcate „stornat”. Se înregistrează în jurnal.</p>
            @if (voidError is not null) { <div class="error-banner" role="alert">@voidError</div> }
            <label class="full-width" for="void-reason">Motivul stornării *
                <InputTextArea id="void-reason" @bind-Value="voidReason" rows="3" maxlength="@ChangeReasonRules.MaximumLength" disabled="@voidBusy" /></label>
            <div class="editor-actions">
                <button type="button" class="danger" disabled="@voidBusy" @onclick="VoidAsync">@(voidBusy ? "Se stornează…" : "Stornează operația")</button>
                <button type="button" class="refresh act-close" disabled="@voidBusy" @onclick="CancelVoid">Renunț</button>
            </div>
        </section>
    </div>
}

@if (historyFor is not null)
{
    <div class="delete-overlay" @onkeydown="HistoryKeyAsync">
        <section class="delete-dialog movement-dialog" role="dialog" aria-modal="true" aria-labelledby="movement-history-title">
            <h2 id="movement-history-title">Istoricul modificărilor · @StockMovementRules.KindLabel(historyFor.Kind) din @StockMovementRules.DisplayDate(historyFor.Date)</h2>
            @if (historyError is not null) { <div class="error-banner" role="alert">@historyError</div> }
            else if (history.Count == 0) { <p class="muted">Nu există modificări înregistrate.</p> }
            else
            {
                <ol class="movement-history-list">
                    @foreach (var entry in history)
                    {
                        <li><strong>@entry.TimestampUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong> · @entry.Actor
                            <div>@StockMovementRules.NormalizeDisplayDates(entry.Changes)</div>
                            <div class="muted">Motiv: @entry.Reason</div></li>
                    }
                </ol>
            }
            <div class="editor-actions"><button type="button" class="primary" autofocus @onclick="CloseHistory">Închide</button></div>
        </section>
    </div>
}

</PageBoundary>

@code {
    private RenderFragment CauseChoice(StockMovementInput target, string name) => @<fieldset class="cause-choice full-width">
        <legend>Cauza ieșirii peste stoc (opțional)</legend>
        <label><input type="radio" name="@name" checked="@(target.OverStockCause is null)" @onchange="() => target.OverStockCause = null" /> Necunoscută</label>
        <label><input type="radio" name="@name" checked="@(target.OverStockCause == OverStockCause.UnrecordedEntry)" @onchange="() => target.OverStockCause = OverStockCause.UnrecordedEntry" /> @StockMovementRules.CauseLabel(OverStockCause.UnrecordedEntry)</label>
        <label><input type="radio" name="@name" checked="@(target.OverStockCause == OverStockCause.WrongStock)" @onchange="() => target.OverStockCause = OverStockCause.WrongStock" /> @StockMovementRules.CauseLabel(OverStockCause.WrongStock)</label>
    </fieldset>;
}
