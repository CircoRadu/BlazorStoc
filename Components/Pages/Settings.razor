@page "/setari"
@attribute [Authorize(Policy = "perm:setari-facturi.view|setari-anaf.view|setari-notificari.view|setari-harta.view|setari-backup.view|setari-module.view|setari-jurnal.view|setari-actualizare.view|setari-import-activityapp.view|utilizatori.view|tipuri-utilizatori.view")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using BlazorStoc.Services
@inject BlazorStoc.Services.IDatabaseAccountService DatabaseAccountsGate
@inject UnsavedChanges Guard
@inject IInvoiceTemplateService InvoiceTemplates
@inject IAccessControl Access
@inject NavigationManager Navigation
@implements IDisposable
<PageBoundary>

<PageTitle>Setări · BlazorStoc</PageTitle>
<UnsavedChangesHost />
<div class="page-heading"><div><p class="eyebrow">@(isAdmin ? "ADMINISTRARE" : "FACTURI")</p><h1>Setări</h1><p class="muted">@(isAdmin ? "Configurări și operații rezervate administratorului." : "Șabloanele de citire a facturilor: creare și modificare.")</p></div></div>
<section class="catalog settings-panel">
    @* The settings are a dashboard: one tile for each section the user has the right to; a tile opens its section, and the bar above the section leads back to the tiles. *@
    @if (activeTab is null)
    {
        <div class="settings-dashboard" id="settings-dashboard">
            @foreach (var tab in VisibleTabs)
            {
                <button type="button" class="settings-tile" id="tile-@tab.Id" aria-label="@tab.Title" @onclick="() => SelectTab(tab.Id)"><span class="main-menu-icon" aria-hidden="true">@TileIcon(tab.Id)</span><strong>@tab.Title</strong><small>@TileText(tab.Id)</small></button>
            }
        </div>
    }
    else
    {
        <div class="settings-section-bar">
            @if (VisibleTabs.Length > 1) { <button type="button" id="settings-back" class="refresh act-nav" @onclick="() => SelectTab(null)">‹ Toate setările</button> }
            <div role="tablist" aria-label="Secțiunea deschisă">
                <button type="button" role="tab" id="tab-@activeTab" class="settings-tab active" aria-selected="true" aria-controls="panel-@activeTab" tabindex="0">@(Tabs.FirstOrDefault(tab => tab.Id == activeTab).Title)</button>
            </div>
        </div>
    }
    @* The invoices panel stays mounted (hidden) when another tab is shown, so a template being edited keeps its changes. *@
        <div role="tabpanel" id="panel-@InvoicesTab" aria-labelledby="tab-@InvoicesTab" class="settings-body" hidden="@(activeTab != InvoicesTab)">
            <ModuleGate ModuleId="@BlazorStoc.Modules.Invoices.InvoicesModule.ModuleId">
            @SubtabBar(InvoiceSubtabs, "Secțiuni facturi")
            @* The analysis stays mounted (hidden) when the saved templates are shown, so switching sub-tabs does not lose the file being worked on. *@
            <div role="tabpanel" id="subpanel-@InvoiceAnalysisSubtab" aria-labelledby="subtab-@InvoiceAnalysisSubtab" hidden="@(invoiceSubtab != InvoiceAnalysisSubtab)">
                <InvoiceTemplateWorkbench Saved="OnTemplateCreated" />
            </div>
            @* Editing a saved template has a sub-tab of its own, present only while the editing is active; leaving it (for another sub-tab, tab or
               page) closes the editing, after a warning when there are unsaved changes. *@
            @if (editTemplate is not null)
            {
                <div role="tabpanel" id="subpanel-@InvoiceEditSubtab" aria-labelledby="subtab-@InvoiceEditSubtab" hidden="@(invoiceSubtab != InvoiceEditSubtab)">
                    <InvoiceTemplateWorkbench @key="editRequest" EditTemplateId="editTemplate.Info.Id" EditTemplateName="@editTemplate.Info.Name" EditRequest="editRequest" Saved="OnTemplateEdited" Closed="CloseEditing" />
                </div>
            }
            @if (invoiceSubtab == InvoiceTemplatesSubtab)
            {
                <div role="tabpanel" id="subpanel-@InvoiceTemplatesSubtab" aria-labelledby="subtab-@InvoiceTemplatesSubtab">
                    <InvoiceTemplatesList @key="templatesVersion" FocusTemplateId="InvoiceTemplateParameter" OnEditWithFile="EditWithFile" />
                </div>
            }
            </ModuleGate>
        </div>
    @if (activeTab == AnafTab && allowedTabs.Contains(AnafTab))
    {
        <div role="tabpanel" id="panel-@AnafTab" aria-labelledby="tab-@AnafTab" class="settings-body">
            <ModuleGate ModuleId="@BlazorStoc.Modules.Anaf.AnafModule.ModuleId"><AnafConfigurator /></ModuleGate>
        </div>
    }
    else if (activeTab == ActivityImportTab && allowedTabs.Contains(ActivityImportTab))
    {
        <div role="tabpanel" id="panel-@ActivityImportTab" aria-labelledby="tab-@ActivityImportTab" class="settings-body">
            <ModuleGate ModuleId="@BlazorStoc.Modules.ActivityImport.ActivityImportModule.ModuleId"><ActivityImportPanel /></ModuleGate>
        </div>
    }
    else if (activeTab == NotificationsTab && allowedTabs.Contains(NotificationsTab))
    {
        <div role="tabpanel" id="panel-@NotificationsTab" aria-labelledby="tab-@NotificationsTab" class="settings-body">
            <ModuleGate ModuleId="@BlazorStoc.Modules.Notifications.NotificationsModule.ModuleId">
            @SubtabBar(NotificationSubtabs, "Secțiuni notificări")
            @if (notificationSubtab == TemplatesSubtab)
            {
                <div role="tabpanel" id="subpanel-@TemplatesSubtab" aria-labelledby="subtab-@TemplatesSubtab"><NotificationTemplatesEditor FocusTemplateId="TemplateParameter" /></div>
            }
            else
            {
                <div role="tabpanel" id="subpanel-@SettingsSubtab" aria-labelledby="subtab-@SettingsSubtab"><NotificationSettingsEditor /></div>
            }
            </ModuleGate>
        </div>
    }
    else if (activeTab == BackupTab && allowedTabs.Contains(BackupTab))
    {
        <div role="tabpanel" id="panel-@BackupTab" aria-labelledby="tab-@BackupTab" class="settings-body">
            @SubtabBar(BackupSubtabs, "Secțiuni backup")
            @if (backupSubtab == NasTab)
            {
                <div role="tabpanel" id="subpanel-@NasTab" aria-labelledby="subtab-@NasTab"><BackupNasSettings /></div>
            }
            else if (backupSubtab == BackupTimeSubtab)
            {
                <div role="tabpanel" id="subpanel-@BackupTimeSubtab" aria-labelledby="subtab-@BackupTimeSubtab"><BackupSettingsPanel Section="@BackupSettingsPanel.TimeSection" /></div>
            }
            else
            {
                <div role="tabpanel" id="subpanel-@BackupMainSubtab" aria-labelledby="subtab-@BackupMainSubtab"><BackupSettingsPanel Section="@BackupSettingsPanel.BackupSection" /></div>
            }
        </div>
    }
    else if (activeTab == DatabaseTab && allowedTabs.Contains(DatabaseTab))
    {
        <div role="tabpanel" id="panel-@DatabaseTab" aria-labelledby="tab-@DatabaseTab" class="settings-body">
            @SubtabBar(DatabaseSubtabs, "Secțiuni bază de date")
            @if (databaseSubtab == DatabaseConnectionSubtab)
            {
                <div role="tabpanel" id="subpanel-@DatabaseConnectionSubtab" aria-labelledby="subtab-@DatabaseConnectionSubtab"><DatabaseServerPanel Changed="ServerChanged" /><DatabaseConnectionPanel @key="@($"connection-{connectionRevision}")" /><ApplicationPanel @key="@($"application-{connectionRevision}")" /><DatabaseAccountsPanel /></div>
            }
            else
            {
                <div role="tabpanel" id="subpanel-@DatabaseStatusSubtab" aria-labelledby="subtab-@DatabaseStatusSubtab"><DatabaseStatusPanel /></div>
            }
        </div>
    }
    else if (activeTab == MapTab && allowedTabs.Contains(MapTab))
    {
        <div role="tabpanel" id="panel-@MapTab" aria-labelledby="tab-@MapTab" class="settings-body">
            @SubtabBar(MapSubtabs, "Secțiuni hartă")
            @if (mapSubtab == MapEngineSubtab)
            {
                <div role="tabpanel" id="subpanel-@MapEngineSubtab" aria-labelledby="subtab-@MapEngineSubtab"><ModuleGate ModuleId="@BlazorStoc.Modules.Maintenance.MaintenanceModule.ModuleId"><MapEngineEditor /></ModuleGate></div>
            }
            else
            {
                <div role="tabpanel" id="subpanel-@MapOverlaySubtab" aria-labelledby="subtab-@MapOverlaySubtab"><ModuleGate ModuleId="@BlazorStoc.Modules.Maintenance.MaintenanceModule.ModuleId"><MapPinTypesEditor FocusPinTypeId="PinParameter" /></ModuleGate></div>
            }
        </div>
    }
    else if (activeTab == JournalTab && allowedTabs.Contains(JournalTab))
    {
        <div role="tabpanel" id="panel-@JournalTab" aria-labelledby="tab-@JournalTab" class="settings-body">
            <JournalSettingsPanel />
        </div>
    }
    else if (activeTab == ModulesTab && allowedTabs.Contains(ModulesTab))
    {
        <div role="tabpanel" id="panel-@ModulesTab" aria-labelledby="tab-@ModulesTab" class="settings-body">
            <ModulesPanel />
        </div>
    }
    else if (activeTab == UpdateTab && allowedTabs.Contains(UpdateTab))
    {
        <div role="tabpanel" id="panel-@UpdateTab" aria-labelledby="tab-@UpdateTab" class="settings-body">
            <UpdatePanel />
        </div>
    }
    else if (activeTab == UsersTab && allowedTabs.Contains(UsersTab))
    {
        <div role="tabpanel" id="panel-@UsersTab" aria-labelledby="tab-@UsersTab" class="settings-body">
            @SubtabBar(UserSubtabs, "Secțiuni utilizatori")
            @if (userSubtab == UserTypesSubtab)
            {
                <div role="tabpanel" id="subpanel-@UserTypesSubtab" aria-labelledby="subtab-@UserTypesSubtab"><UserTypesPanel /></div>
            }
            else
            {
                <div role="tabpanel" id="subpanel-@UserAccountsSubtab" aria-labelledby="subtab-@UserAccountsSubtab"><UsersPanel EditId="UserEditParameter" /></div>
            }
        </div>
    }
</section>

</PageBoundary>

@code {
    // The connection and the application port are read again after the server changed (a new port of the server changes the connection shown beside it).
    private int connectionRevision;
    private void ServerChanged() => connectionRevision++;

    private const string AnafTab = "anaf";
    private const string ActivityImportTab = "preluare-activityapp";
    private const string NotificationsTab = SettingsNavigation.NotificationsTab;
    private const string MapTab = SettingsNavigation.MapTab;
    private const string InvoicesTab = SettingsNavigation.InvoicesTab;
    private const string BackupTab = "backup";
    private const string JournalTab = "jurnal";
    // The Administrator role (every administrator, also the one configured in the private file) sees this tab; it is not a key of the catalog.
    private const string DatabaseTab = "baza-de-date";
    private const string DatabaseStatusSubtab = "stare";
    private const string DatabaseConnectionSubtab = "conexiune";
    private static readonly (string Id, string Title)[] DatabaseSubtabs = [(DatabaseStatusSubtab, "Stare"), (DatabaseConnectionSubtab, "Conexiune")];
    private string databaseSubtab = DatabaseStatusSubtab;
    // Users is one tab with two sub-tabs: the accounts and the user types (their rights). The old tab id of the types keeps working in addresses.
    private const string UsersTab = "utilizatori";
    private const string LegacyUserTypesTab = "tipuri-utilizatori";
    private const string UserAccountsSubtab = "conturi";
    private const string UserTypesSubtab = "tipuri";
    private bool canUsers, canUserTypes;
    private static readonly (string Id, string Title)[] UserSubtabsBoth = [(UserAccountsSubtab, "Utilizatori"), (UserTypesSubtab, "Tipuri de utilizatori")];
    private static readonly (string Id, string Title)[] UserSubtabsAccounts = [UserSubtabsBoth[0]];
    private static readonly (string Id, string Title)[] UserSubtabsTypes = [UserSubtabsBoth[1]];
    // Only the sub-tabs the signed-in user has the right to (static arrays: the sub-tab bar tells them apart by reference).
    private (string Id, string Title)[] UserSubtabs => canUsers && canUserTypes ? UserSubtabsBoth : canUsers ? UserSubtabsAccounts : UserSubtabsTypes;
    private string userSubtab = UserAccountsSubtab;
    private const string ModulesTab = SettingsNavigation.ModulesTab;
    private const string UpdateTab = SettingsNavigation.UpdateTab;
    // Backup is one tab with three sub-tabs: backup and restore, the NAS copy, the check of the server clock.
    private const string BackupMainSubtab = "backup-main";
    private const string NasTab = "backup-nas";
    private const string BackupTimeSubtab = "backup-time";
    private static readonly (string Id, string Title)[] BackupSubtabs = [(BackupMainSubtab, "Backup și restaurare"), (NasTab, "Backup NAS"), (BackupTimeSubtab, "Verificare oră")];
    private string backupSubtab = BackupMainSubtab;
    private static readonly (string Id, string Title)[] Tabs = [(AnafTab, "Preluare date ANAF"), (ActivityImportTab, "Preluare ActivityApp"), (NotificationsTab, "Notificări"), (MapTab, "Hartă"), (InvoicesTab, "Facturi"), (BackupTab, "Backup"), (JournalTab, "Jurnal activitate"), (ModulesTab, "Module"), (UpdateTab, "Actualizare"), (UsersTab, "Utilizatori"), (DatabaseTab, "Bază de date")];
    // The key that opens each tab (what the user type of the signed-in user allows).
    private static readonly Dictionary<string, string> TabKeys = new()
    {
        [AnafTab] = "setari-anaf.view", [ActivityImportTab] = "setari-import-activityapp.view", [NotificationsTab] = "setari-notificari.view", [MapTab] = "setari-harta.view",
        [InvoicesTab] = "setari-facturi.view", [BackupTab] = "setari-backup.view", [ModulesTab] = "setari-module.view", [JournalTab] = "setari-jurnal.view", [UpdateTab] = "setari-actualizare.view"
    };
    private readonly HashSet<string> allowedTabs = [];
    // The open section; null shows the dashboard of the sections.
    private string? activeTab;

    // The glyph on the tile of a section of the settings dashboard (the same icon box as the tiles of the main page).
    private static string TileIcon(string id) => id switch
    {
        AnafTab => "⌕",
        ActivityImportTab => "⇅",
        NotificationsTab => "✉",
        MapTab => "⌖",
        InvoicesTab => "▤",
        BackupTab => "⤓",
        JournalTab => "≡",
        ModulesTab => "▦",
        UpdateTab => "↻",
        UsersTab => "♙",
        DatabaseTab => "▥",
        _ => "☰"
    };

    private static string TileText(string id) => id switch
    {
        AnafTab => "Interogarea serviciului public ANAF pentru datele firmelor.",
        ActivityImportTab => "Conexiunea la ActivityApp, tichetele preluate, corespondența câmpurilor și programarea importului.",
        NotificationsTab => "Șabloanele de notificări și setările lor.",
        MapTab => "Furnizorul și aspectul hărții de mentenanță.",
        InvoicesTab => "Șabloanele de citire a facturilor.",
        BackupTab => "Backup, restaurare, copiere pe NAS și verificarea orei.",
        ModulesTab => "Starea modulelor și oprirea sau pornirea lor.",
        JournalTab => "Câte evenimente recente arată implicit pagina Jurnal activitate.",
        UpdateTab => "Versiunea aplicației, pachetele de actualizare și istoricul lor.",
        UsersTab => "Conturile utilizatorilor și drepturile fiecărui tip de utilizator.",
        DatabaseTab => "Starea serverului bazei de date și conexiunea aplicației la el.",
        _ => ""
    };

    // The administrator has every tab; a user without that role only reaches the invoice templates (creating and changing them).
    private bool isAdmin => allowedTabs.Any(tab => tab != InvoicesTab);
    private (string Id, string Title)[] VisibleTabs => [.. Tabs.Where(tab => allowedTabs.Contains(tab.Id))];

    // The "Setări" entry of the menu leads back to the dashboard from an open section (the address is the same, so the page is not rebuilt: the click is seen here).
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        var uri = new Uri(args.Location);
        if (!uri.AbsolutePath.Equals("/setari", StringComparison.OrdinalIgnoreCase) || uri.Query.Length > 1 || activeTab is null || VisibleTabs.Length < 2) return;
        _ = InvokeAsync(() => { SelectTab(null); StateHasChanged(); });
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        // The Database tab depends only on the Administrator role (from the sign-in cookie, no database involved): it must open when the database is down,
        // because it is where the connection is fixed. A key that cannot be read (the database does not answer) only hides its own tab.
        if (await Access.IsAdministratorAsync()) allowedTabs.Add(DatabaseTab);
        foreach (var (tab, key) in TabKeys)
        {
            try { if (await Access.HasAsync(key)) allowedTabs.Add(tab); }
            catch (Exception exception) when (exception is not OperationCanceledException) { }
        }
        // Users: the tab opens with either right; each sub-tab needs its own.
        try
        {
            canUsers = await Access.HasAsync("utilizatori.view");
            canUserTypes = await Access.HasAsync("tipuri-utilizatori.view");
            if (canUsers || canUserTypes) allowedTabs.Add(UsersTab);
            if (!canUsers) userSubtab = UserTypesSubtab;
        }
        catch (Exception exception) when (exception is not OperationCanceledException) { }
        // An account of the database still has the default password: the administrator sees only the connection (where the passwords are changed) until it is done.
        if (allowedTabs.Contains(DatabaseTab))
        {
            try
            {
                if (await DatabaseAccountsGate.AnyDefaultPasswordAsync())
                {
                    allowedTabs.Clear();
                    allowedTabs.Add(DatabaseTab);
                    activeTab = DatabaseTab;
                    databaseSubtab = DatabaseConnectionSubtab;
                }
            }
            catch (Exception exception) when (exception is not OperationCanceledException) { }
        }
        // A user with a single section (the invoice templates) goes straight into it: a dashboard of one tile would only be a step more.
        if (activeTab is not null && !allowedTabs.Contains(activeTab)) activeTab = null;
        if (activeTab is null && VisibleTabs.Length == 1) activeTab = VisibleTabs[0].Id;
    }


    private const string TemplatesSubtab = SettingsNavigation.TemplatesSubtab;
    private const string SettingsSubtab = SettingsNavigation.SettingsSubtab;
    private static readonly (string Id, string Title)[] NotificationSubtabs = [(TemplatesSubtab, "Șabloane notificări"), (SettingsSubtab, "Setări notificări")];
    private string notificationSubtab = TemplatesSubtab;

    private const string MapEngineSubtab = SettingsNavigation.MapEngineSubtab;
    private const string MapOverlaySubtab = SettingsNavigation.MapOverlaySubtab;
    private static readonly (string Id, string Title)[] MapSubtabs = [(MapEngineSubtab, "Motor hartă"), (MapOverlaySubtab, "Overlay (tipuri de pinuri)")];
    private string mapSubtab = MapEngineSubtab;

    private const string InvoiceAnalysisSubtab = SettingsNavigation.InvoiceAnalysisSubtab;
    private const string InvoiceTemplatesSubtab = SettingsNavigation.InvoiceTemplatesSubtab;
    private const string InvoiceEditSubtab = SettingsNavigation.InvoiceEditSubtab;
    private static readonly (string Id, string Title)[] InvoiceSubtabsBase = [(InvoiceAnalysisSubtab, "Generare șablon factură"), (InvoiceTemplatesSubtab, "Șabloane salvate")];
    private static readonly (string Id, string Title)[] InvoiceSubtabsEditing = [.. InvoiceSubtabsBase, (InvoiceEditSubtab, "Editare șablon")];
    // The "Editare șablon" sub-tab exists only while a template is being edited.
    private (string Id, string Title)[] InvoiceSubtabs => editTemplate is null ? InvoiceSubtabsBase : InvoiceSubtabsEditing;
    private string invoiceSubtab = InvoiceAnalysisSubtab;
    private InvoiceTemplateRecord? editTemplate;
    private int templatesVersion;
    private int editRequest;

    // The edit sub-tab opens for the chosen template. When another template is being edited with unsaved changes, the user is asked first.
    private void EditWithFile(InvoiceTemplateRecord template)
    {
        if (editTemplate is not null && Guard.HasUnsavedChanges)
        {
            Guard.Request(() => { OpenEditing(template); return InvokeAsync(StateHasChanged); });
            return;
        }
        OpenEditing(template);
    }

    private void OpenEditing(InvoiceTemplateRecord template)
    {
        editTemplate = template;
        editRequest++;
        invoiceSubtab = InvoiceEditSubtab;
    }

    // A template made in "Generare șablon factură" was saved: the list of saved templates is reloaded.
    private void OnTemplateCreated() => templatesVersion++;

    // The edited template was saved: the edit sub-tab closes and the saved templates are shown.
    private void OnTemplateEdited()
    {
        CloseEditing();
        templatesVersion++;
    }

    private void CloseEditing()
    {
        editTemplate = null;
        invoiceSubtab = InvoiceTemplatesSubtab;
    }

    private string CurrentSubtab((string Id, string Title)[] subtabs) =>
        subtabs == MapSubtabs ? mapSubtab : subtabs == InvoiceSubtabs ? invoiceSubtab : subtabs == BackupSubtabs ? backupSubtab : subtabs == DatabaseSubtabs ? databaseSubtab : subtabs == UserSubtabs ? userSubtab : notificationSubtab;

    // Deep links (for example from the Journal) open the named tab, sub-tab and object; later clicks on the tabs win.
    [SupplyParameterFromQuery(Name = SettingsNavigation.TabParameter)] public string? TabQuery { get; set; }
    [SupplyParameterFromQuery(Name = SettingsNavigation.SubtabParameter)] public string? SubtabQuery { get; set; }
    [SupplyParameterFromQuery(Name = SettingsNavigation.TemplateParameter)] public int? TemplateParameter { get; set; }
    // A link with the id of an account (?edit=) opens the editor of that account in the Utilizatori tab.
    [SupplyParameterFromQuery(Name = "edit")] public int? UserEditParameter { get; set; }
    [SupplyParameterFromQuery(Name = SettingsNavigation.PinParameter)] public int? PinParameter { get; set; }
    [SupplyParameterFromQuery(Name = SettingsNavigation.InvoiceTemplateParameter)] public int? InvoiceTemplateParameter { get; set; }
    // A fresh value forces a link that points at the same address as before (the banner's "Detalii" while the user moved to another tab) to be applied again.
    [SupplyParameterFromQuery(Name = SettingsNavigation.RefreshParameter)] public string? RefreshQuery { get; set; }
    private string? appliedLink;

    // A link with the id of a template opens its editing (the "Editare șablon" sub-tab) at once.
    [SupplyParameterFromQuery(Name = SettingsNavigation.InvoiceEditParameter)] public int? InvoiceEditParameter { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var link = $"{TabQuery}|{SubtabQuery}|{TemplateParameter}|{PinParameter}|{InvoiceTemplateParameter}|{InvoiceEditParameter}|{UserEditParameter}|{RefreshQuery}";
        if (link == appliedLink) return;
        appliedLink = link;
        if (VisibleTabs.Any(tab => tab.Id == TabQuery)) activeTab = TabQuery!;
        // The old address of the user types (and an account to edit) opens the matching sub-tab of Utilizatori.
        if (allowedTabs.Contains(UsersTab))
        {
            if (TabQuery == LegacyUserTypesTab) { activeTab = UsersTab; if (canUserTypes) userSubtab = UserTypesSubtab; }
            if (UserSubtabs.Any(tab => tab.Id == SubtabQuery) && (TabQuery is UsersTab or LegacyUserTypesTab)) userSubtab = SubtabQuery!;
            if (UserEditParameter is > 0 && canUsers) { activeTab = UsersTab; userSubtab = UserAccountsSubtab; }
        }
        // The old address of the NAS tab keeps working.
        if (allowedTabs.Contains(BackupTab) && TabQuery == NasTab) { activeTab = BackupTab; backupSubtab = NasTab; }
        if (BackupSubtabs.Any(tab => tab.Id == SubtabQuery)) { backupSubtab = SubtabQuery!; if (isAdmin && TabQuery is null or BackupTab) activeTab = BackupTab; }
        if (allowedTabs.Contains(DatabaseTab) && TabQuery == DatabaseTab && DatabaseSubtabs.Any(tab => tab.Id == SubtabQuery)) databaseSubtab = SubtabQuery!;
        if (NotificationSubtabs.Any(tab => tab.Id == SubtabQuery)) notificationSubtab = SubtabQuery!;
        if (MapSubtabs.Any(tab => tab.Id == SubtabQuery)) mapSubtab = SubtabQuery!;
        if (InvoiceSubtabs.Any(tab => tab.Id == SubtabQuery)) invoiceSubtab = SubtabQuery!;
        if (InvoiceEditParameter is { } editId && editTemplate?.Info.Id != editId)
        {
            InvoiceTemplateRecord? record = null;
            try { record = await InvoiceTemplates.GetAsync(editId); }
            catch (Exception) { }
            if (record is not null) { activeTab = InvoicesTab; OpenEditing(record); }
        }
    }

    private RenderFragment SubtabBar((string Id, string Title)[] subtabs, string label) => builder =>
    {
        var current = CurrentSubtab(subtabs);
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "settings-subtabs");
        builder.AddAttribute(seq++, "role", "tablist");
        builder.AddAttribute(seq++, "aria-label", label);
        builder.AddAttribute(seq++, "onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, args => OnSubtabKeyDown(subtabs, args)));
        foreach (var subtab in subtabs)
        {
            var selected = subtab.Id == current;
            var id = subtab.Id;
            builder.OpenElement(seq++, "button");
            builder.AddAttribute(seq++, "type", "button");
            builder.AddAttribute(seq++, "role", "tab");
            builder.AddAttribute(seq++, "id", "subtab-" + id);
            builder.AddAttribute(seq++, "class", "settings-subtab " + (selected ? "active" : ""));
            builder.AddAttribute(seq++, "aria-selected", selected ? "true" : "false");
            builder.AddAttribute(seq++, "aria-controls", "subpanel-" + id);
            builder.AddAttribute(seq++, "tabindex", selected ? "0" : "-1");
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => SelectSubtab(subtabs, id)));
            builder.AddContent(seq++, subtab.Title);
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    // Leaving the "Editare șablon" sub-tab (for another sub-tab, another tab or another page) closes the editing; with unsaved changes the user is
    // asked first (the same question as for every editor), and the change happens only after he chose to leave.
    private void SelectTab(string? id)
    {
        if (id != InvoicesTab && activeTab == InvoicesTab && editTemplate is not null) AfterEditingClosed(() => activeTab = id);
        else activeTab = id;
    }

    private void AfterEditingClosed(Action change)
    {
        if (editTemplate is null) { change(); return; }
        if (Guard.HasUnsavedChanges)
        {
            Guard.Request(() =>
            {
                CloseEditing();
                change();
                return InvokeAsync(StateHasChanged);
            });
            return;
        }
        CloseEditing();
        change();
    }

    private void SelectSubtab((string Id, string Title)[] subtabs, string id)
    {
        if (subtabs == MapSubtabs) mapSubtab = id;
        else if (subtabs == BackupSubtabs) backupSubtab = id;
        else if (subtabs == DatabaseSubtabs) databaseSubtab = id;
        else if (subtabs == UserSubtabs) userSubtab = id;
        else if (subtabs == InvoiceSubtabs) { if (id != InvoiceEditSubtab && editTemplate is not null) AfterEditingClosed(() => invoiceSubtab = id); else invoiceSubtab = id; }
        else notificationSubtab = id;
    }

    private void OnSubtabKeyDown((string Id, string Title)[] subtabs, KeyboardEventArgs args)
    {
        var current = CurrentSubtab(subtabs);
        var index = Array.FindIndex(subtabs, tab => tab.Id == current);
        index = args.Key switch
        {
            "ArrowRight" => (index + 1) % subtabs.Length,
            "ArrowLeft" => (index - 1 + subtabs.Length) % subtabs.Length,
            _ => index
        };
        SelectSubtab(subtabs, subtabs[index].Id);
    }

}
