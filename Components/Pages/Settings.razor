@page "/setari"
@attribute [Authorize(Roles = AccessRoles.Administrator + "," + AccessRoles.LimitedUser)]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using BlazorStoc.Services
@inject UnsavedChanges Guard
@inject IInvoiceTemplateService InvoiceTemplates
@inject IAccessControl Access
<PageBoundary>

<PageTitle>Setări · BlazorStoc</PageTitle>
<UnsavedChangesHost />
<div class="page-heading"><div><p class="eyebrow">@(isAdmin ? "ADMINISTRARE" : "FACTURI")</p><h1>Setări</h1><p class="muted">@(isAdmin ? "Configurări și operații rezervate administratorului." : "Șabloanele de citire a facturilor: creare și modificare.")</p></div></div>
<section class="catalog settings-panel">
    <div class="settings-tabs" role="tablist" aria-label="Secțiuni setări" @onkeydown="OnTabKeyDown">
        @foreach (var tab in VisibleTabs)
        {
            var selected = tab.Id == activeTab;
            <button type="button" role="tab" id="tab-@tab.Id" class="settings-tab @(selected ? "active" : "")" aria-selected="@(selected ? "true" : "false")" aria-controls="panel-@tab.Id" tabindex="@(selected ? 0 : -1)" @onclick="() => SelectTab(tab.Id)">@tab.Title</button>
        }
    </div>
    @* The invoices panel stays mounted (hidden) when another tab is shown, so a template being edited keeps its changes. *@
        <div role="tabpanel" id="panel-@InvoicesTab" aria-labelledby="tab-@InvoicesTab" class="settings-body" hidden="@(activeTab != InvoicesTab)">
            @SubtabBar(InvoiceSubtabs, "Secțiuni facturi")
            @* The analysis stays mounted (hidden) when the saved templates are shown, so switching sub-tabs does not lose the file being worked on. *@
            <div role="tabpanel" id="subpanel-@InvoiceAnalysisSubtab" aria-labelledby="subtab-@InvoiceAnalysisSubtab" hidden="@(invoiceSubtab != InvoiceAnalysisSubtab)">
                <InvoiceTemplateWorkbench Saved="OnTemplateCreated" />
            </div>
            @* Editing a saved template has a sub-tab of its own, present only while the editing is active; leaving it (for another sub-tab, tab or
               page) closes the editing, after a warning when there are unsaved changes. *@
            @if (editTemplate is not null)
            {
                <div role="tabpanel" id="subpanel-@InvoiceEditSubtab" aria-labelledby="subtab-@InvoiceEditSubtab" hidden="@(invoiceSubtab != InvoiceEditSubtab)">
                    <InvoiceTemplateWorkbench @key="editRequest" EditTemplateId="editTemplate.Info.Id" EditTemplateName="@editTemplate.Info.Name" EditRequest="editRequest" Saved="OnTemplateEdited" Closed="CloseEditing" />
                </div>
            }
            @if (invoiceSubtab == InvoiceTemplatesSubtab)
            {
                <div role="tabpanel" id="subpanel-@InvoiceTemplatesSubtab" aria-labelledby="subtab-@InvoiceTemplatesSubtab">
                    <InvoiceTemplatesList @key="templatesVersion" FocusTemplateId="InvoiceTemplateParameter" OnEditWithFile="EditWithFile" />
                </div>
            }
        </div>
    @if (isAdmin && activeTab == AnafTab)
    {
        <div role="tabpanel" id="panel-@AnafTab" aria-labelledby="tab-@AnafTab" class="settings-body">
            <AnafConfigurator />
        </div>
    }
    else if (isAdmin && activeTab == NotificationsTab)
    {
        <div role="tabpanel" id="panel-@NotificationsTab" aria-labelledby="tab-@NotificationsTab" class="settings-body">
            @SubtabBar(NotificationSubtabs, "Secțiuni notificări")
            @if (notificationSubtab == TemplatesSubtab)
            {
                <div role="tabpanel" id="subpanel-@TemplatesSubtab" aria-labelledby="subtab-@TemplatesSubtab"><NotificationTemplatesEditor FocusTemplateId="TemplateParameter" /></div>
            }
            else
            {
                <div role="tabpanel" id="subpanel-@SettingsSubtab" aria-labelledby="subtab-@SettingsSubtab"><NotificationSettingsEditor /></div>
            }
        </div>
    }
    else if (isAdmin && activeTab == BackupTab)
    {
        <div role="tabpanel" id="panel-@BackupTab" aria-labelledby="tab-@BackupTab" class="settings-body">
            @SubtabBar(BackupSubtabs, "Secțiuni backup")
            @if (backupSubtab == NasTab)
            {
                <div role="tabpanel" id="subpanel-@NasTab" aria-labelledby="subtab-@NasTab"><BackupNasSettings /></div>
            }
            else if (backupSubtab == BackupTimeSubtab)
            {
                <div role="tabpanel" id="subpanel-@BackupTimeSubtab" aria-labelledby="subtab-@BackupTimeSubtab"><BackupSettingsPanel Section="@BackupSettingsPanel.TimeSection" /></div>
            }
            else
            {
                <div role="tabpanel" id="subpanel-@BackupMainSubtab" aria-labelledby="subtab-@BackupMainSubtab"><BackupSettingsPanel Section="@BackupSettingsPanel.BackupSection" /></div>
            }
        </div>
    }
    else if (isAdmin && activeTab == MapTab)
    {
        <div role="tabpanel" id="panel-@MapTab" aria-labelledby="tab-@MapTab" class="settings-body">
            @SubtabBar(MapSubtabs, "Secțiuni hartă")
            @if (mapSubtab == MapEngineSubtab)
            {
                <div role="tabpanel" id="subpanel-@MapEngineSubtab" aria-labelledby="subtab-@MapEngineSubtab"><MapEngineEditor /></div>
            }
            else
            {
                <div role="tabpanel" id="subpanel-@MapOverlaySubtab" aria-labelledby="subtab-@MapOverlaySubtab"><MapPinTypesEditor FocusPinTypeId="PinParameter" /></div>
            }
        </div>
    }
</section>

</PageBoundary>

@code {
    private const string AnafTab = "anaf";
    private const string NotificationsTab = SettingsNavigation.NotificationsTab;
    private const string MapTab = SettingsNavigation.MapTab;
    private const string InvoicesTab = SettingsNavigation.InvoicesTab;
    private const string BackupTab = "backup";
    // Backup is one tab with three sub-tabs: backup and restore, the NAS copy, the check of the server clock.
    private const string BackupMainSubtab = "backup-main";
    private const string NasTab = "backup-nas";
    private const string BackupTimeSubtab = "backup-time";
    private static readonly (string Id, string Title)[] BackupSubtabs = [(BackupMainSubtab, "Backup și restaurare"), (NasTab, "Backup NAS"), (BackupTimeSubtab, "Verificare oră")];
    private string backupSubtab = BackupMainSubtab;
    private static readonly (string Id, string Title)[] Tabs = [(AnafTab, "Preluare date ANAF"), (NotificationsTab, "Notificări"), (MapTab, "Hartă"), (InvoicesTab, "Facturi"), (BackupTab, "Backup")];
    private string activeTab = AnafTab;

    // The administrator has every tab; a user without that role only reaches the invoice templates (creating and changing them).
    private bool isAdmin;
    private (string Id, string Title)[] VisibleTabs => isAdmin ? Tabs : [.. Tabs.Where(tab => tab.Id == InvoicesTab)];

    protected override async Task OnInitializedAsync()
    {
        isAdmin = await Access.IsAdministratorAsync();
        if (!isAdmin) activeTab = InvoicesTab;
    }

    private const string TemplatesSubtab = SettingsNavigation.TemplatesSubtab;
    private const string SettingsSubtab = SettingsNavigation.SettingsSubtab;
    private static readonly (string Id, string Title)[] NotificationSubtabs = [(TemplatesSubtab, "Șabloane notificări"), (SettingsSubtab, "Setări notificări")];
    private string notificationSubtab = TemplatesSubtab;

    private const string MapEngineSubtab = SettingsNavigation.MapEngineSubtab;
    private const string MapOverlaySubtab = SettingsNavigation.MapOverlaySubtab;
    private static readonly (string Id, string Title)[] MapSubtabs = [(MapEngineSubtab, "Motor hartă"), (MapOverlaySubtab, "Overlay (tipuri de pinuri)")];
    private string mapSubtab = MapEngineSubtab;

    private const string InvoiceAnalysisSubtab = SettingsNavigation.InvoiceAnalysisSubtab;
    private const string InvoiceTemplatesSubtab = SettingsNavigation.InvoiceTemplatesSubtab;
    private const string InvoiceEditSubtab = SettingsNavigation.InvoiceEditSubtab;
    private static readonly (string Id, string Title)[] InvoiceSubtabsBase = [(InvoiceAnalysisSubtab, "Generare șablon factură"), (InvoiceTemplatesSubtab, "Șabloane salvate")];
    private static readonly (string Id, string Title)[] InvoiceSubtabsEditing = [.. InvoiceSubtabsBase, (InvoiceEditSubtab, "Editare șablon")];
    // The "Editare șablon" sub-tab exists only while a template is being edited.
    private (string Id, string Title)[] InvoiceSubtabs => editTemplate is null ? InvoiceSubtabsBase : InvoiceSubtabsEditing;
    private string invoiceSubtab = InvoiceAnalysisSubtab;
    private InvoiceTemplateRecord? editTemplate;
    private int templatesVersion;
    private int editRequest;

    // The edit sub-tab opens for the chosen template. When another template is being edited with unsaved changes, the user is asked first.
    private void EditWithFile(InvoiceTemplateRecord template)
    {
        if (editTemplate is not null && Guard.HasUnsavedChanges)
        {
            Guard.Request(() => { OpenEditing(template); return InvokeAsync(StateHasChanged); });
            return;
        }
        OpenEditing(template);
    }

    private void OpenEditing(InvoiceTemplateRecord template)
    {
        editTemplate = template;
        editRequest++;
        invoiceSubtab = InvoiceEditSubtab;
    }

    // A template made in "Generare șablon factură" was saved: the list of saved templates is reloaded.
    private void OnTemplateCreated() => templatesVersion++;

    // The edited template was saved: the edit sub-tab closes and the saved templates are shown.
    private void OnTemplateEdited()
    {
        CloseEditing();
        templatesVersion++;
    }

    private void CloseEditing()
    {
        editTemplate = null;
        invoiceSubtab = InvoiceTemplatesSubtab;
    }

    private string CurrentSubtab((string Id, string Title)[] subtabs) =>
        subtabs == MapSubtabs ? mapSubtab : subtabs == InvoiceSubtabs ? invoiceSubtab : subtabs == BackupSubtabs ? backupSubtab : notificationSubtab;

    // Deep links (for example from the Journal) open the named tab, sub-tab and object; later clicks on the tabs win.
    [SupplyParameterFromQuery(Name = SettingsNavigation.TabParameter)] public string? TabQuery { get; set; }
    [SupplyParameterFromQuery(Name = SettingsNavigation.SubtabParameter)] public string? SubtabQuery { get; set; }
    [SupplyParameterFromQuery(Name = SettingsNavigation.TemplateParameter)] public int? TemplateParameter { get; set; }
    [SupplyParameterFromQuery(Name = SettingsNavigation.PinParameter)] public int? PinParameter { get; set; }
    [SupplyParameterFromQuery(Name = SettingsNavigation.InvoiceTemplateParameter)] public int? InvoiceTemplateParameter { get; set; }
    private string? appliedLink;

    // A link with the id of a template opens its editing (the "Editare șablon" sub-tab) at once.
    [SupplyParameterFromQuery(Name = SettingsNavigation.InvoiceEditParameter)] public int? InvoiceEditParameter { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var link = $"{TabQuery}|{SubtabQuery}|{TemplateParameter}|{PinParameter}|{InvoiceTemplateParameter}|{InvoiceEditParameter}";
        if (link == appliedLink) return;
        appliedLink = link;
        if (VisibleTabs.Any(tab => tab.Id == TabQuery)) activeTab = TabQuery!;
        // The old address of the NAS tab keeps working.
        if (isAdmin && TabQuery == NasTab) { activeTab = BackupTab; backupSubtab = NasTab; }
        if (BackupSubtabs.Any(tab => tab.Id == SubtabQuery)) { backupSubtab = SubtabQuery!; if (isAdmin && TabQuery is null or BackupTab) activeTab = BackupTab; }
        if (NotificationSubtabs.Any(tab => tab.Id == SubtabQuery)) notificationSubtab = SubtabQuery!;
        if (MapSubtabs.Any(tab => tab.Id == SubtabQuery)) mapSubtab = SubtabQuery!;
        if (InvoiceSubtabs.Any(tab => tab.Id == SubtabQuery)) invoiceSubtab = SubtabQuery!;
        if (InvoiceEditParameter is { } editId && editTemplate?.Info.Id != editId)
        {
            InvoiceTemplateRecord? record = null;
            try { record = await InvoiceTemplates.GetAsync(editId); }
            catch (Exception) { }
            if (record is not null) { activeTab = InvoicesTab; OpenEditing(record); }
        }
    }

    private RenderFragment SubtabBar((string Id, string Title)[] subtabs, string label) => builder =>
    {
        var current = CurrentSubtab(subtabs);
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "settings-subtabs");
        builder.AddAttribute(seq++, "role", "tablist");
        builder.AddAttribute(seq++, "aria-label", label);
        builder.AddAttribute(seq++, "onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, args => OnSubtabKeyDown(subtabs, args)));
        foreach (var subtab in subtabs)
        {
            var selected = subtab.Id == current;
            var id = subtab.Id;
            builder.OpenElement(seq++, "button");
            builder.AddAttribute(seq++, "type", "button");
            builder.AddAttribute(seq++, "role", "tab");
            builder.AddAttribute(seq++, "id", "subtab-" + id);
            builder.AddAttribute(seq++, "class", "settings-subtab " + (selected ? "active" : ""));
            builder.AddAttribute(seq++, "aria-selected", selected ? "true" : "false");
            builder.AddAttribute(seq++, "aria-controls", "subpanel-" + id);
            builder.AddAttribute(seq++, "tabindex", selected ? "0" : "-1");
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => SelectSubtab(subtabs, id)));
            builder.AddContent(seq++, subtab.Title);
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    // Leaving the "Editare șablon" sub-tab (for another sub-tab, another tab or another page) closes the editing; with unsaved changes the user is
    // asked first (the same question as for every editor), and the change happens only after he chose to leave.
    private void SelectTab(string id)
    {
        if (id != InvoicesTab && activeTab == InvoicesTab && editTemplate is not null) AfterEditingClosed(() => activeTab = id);
        else activeTab = id;
    }

    private void AfterEditingClosed(Action change)
    {
        if (editTemplate is null) { change(); return; }
        if (Guard.HasUnsavedChanges)
        {
            Guard.Request(() =>
            {
                CloseEditing();
                change();
                return InvokeAsync(StateHasChanged);
            });
            return;
        }
        CloseEditing();
        change();
    }

    private void SelectSubtab((string Id, string Title)[] subtabs, string id)
    {
        if (subtabs == MapSubtabs) mapSubtab = id;
        else if (subtabs == BackupSubtabs) backupSubtab = id;
        else if (subtabs == InvoiceSubtabs) { if (id != InvoiceEditSubtab && editTemplate is not null) AfterEditingClosed(() => invoiceSubtab = id); else invoiceSubtab = id; }
        else notificationSubtab = id;
    }

    private void OnSubtabKeyDown((string Id, string Title)[] subtabs, KeyboardEventArgs args)
    {
        var current = CurrentSubtab(subtabs);
        var index = Array.FindIndex(subtabs, tab => tab.Id == current);
        index = args.Key switch
        {
            "ArrowRight" => (index + 1) % subtabs.Length,
            "ArrowLeft" => (index - 1 + subtabs.Length) % subtabs.Length,
            _ => index
        };
        SelectSubtab(subtabs, subtabs[index].Id);
    }

    private void OnTabKeyDown(KeyboardEventArgs args)
    {
        var tabs = VisibleTabs;
        var index = Array.FindIndex(tabs, tab => tab.Id == activeTab);
        index = args.Key switch
        {
            "ArrowRight" => (index + 1) % tabs.Length,
            "ArrowLeft" => (index - 1 + tabs.Length) % tabs.Length,
            "Home" => 0,
            "End" => tabs.Length - 1,
            _ => index
        };
        SelectTab(tabs[index].Id);
    }
}
