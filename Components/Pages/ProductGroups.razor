@page "/categorii"
@attribute [Authorize(Policy = "perm:categorii.view")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using BlazorStoc.Services
@inject IProductRepository Repository
@inject ISubcategoryTree Tree
@inject ICatalogSettings CatalogSettings
@inject IProductParameterRepository ParameterRepository
@inject IProductTagRepository TagRepository
@inject IAccessControl Access
@inject ILogger<ProductGroups> Logger
@inject IJSRuntime JS
@implements IDisposable
<PageBoundary>

<PageTitle>Categorii produse · BlazorStoc</PageTitle>
<UnsavedChangesHost />
<div class="page-heading">
    <div><p class="eyebrow">ORGANIZARE CATALOG</p><h1>Categorii și subcategorii</h1><p class="muted">Redenumește categoriile și mută subcategoriile fără să pierzi produsele asociate.@(isAdministrator ? " Trage categoriile de mânerul din dreapta ca să le aranjezi: ordinea de aici este ordinea din meniul lateral." : "")</p></div>
    <div class="heading-actions">@if (permAdd) { <button class="primary" disabled="@(saving || IsEditing)" @onclick="CreateCategory">+ Adaugă categorie</button> }</div>
</div>
@if (error is not null) { <div class="error-banner" role="alert">@error</div> }
@if (notice is not null) { <div class="success-banner" role="status">@notice</div> }

@if (creatingCategory || editingCategory is not null)
{
    <div class="delete-overlay"><section class="delete-dialog group-editor-dialog" role="dialog" aria-modal="true" aria-labelledby="category-editor-title">
        <UnsavedChangesTracker @ref="groupTracker" Adding="@(creatingCategory || creatingSubcategory)" Snapshot="CurrentSnapshot" Discard="DiscardEditAsync" />
        <div class="catalog-heading dialog-head"><h2 id="category-editor-title">@(creatingCategory ? "Adaugă categorie" : $"Editează categoria „{editingCategory}”")</h2><HelpButton Topic="categorii" About="categoria și subcategoria" /></div>
        <div class="editor-grid">
            <label class="full-width" for="category-name">Denumire categorie *<input id="category-name" maxlength="100" @bind="categoryName" disabled="@saving" /></label>
            @if (!creatingCategory) { <ChangeReasonField Id="category-reason" @bind-Value="customReason" AutoText="@AutoSummary" @bind-UseAuto="reasonAuto" Disabled="@saving" /> }
        </div>
        <div class="editor-actions"><button class="primary" disabled="@saving" @onclick="RequestSaveCategoryAsync">@(creatingCategory ? "Adaugă categoria" : "Salvează categoria")</button><button class="danger" disabled="@saving" @onclick="RequestCancelEditAsync">Anulează</button></div>
    </section></div>
}
else if (editingSubcategory is not null || creatingSubcategory)
{
    @SubcategoryEditor
}

@if (parametersGroup is not null)
{
    @if (Inherited(parametersGroup) is { Length: > 0 } inheritedText) { <p class="muted catalog-body" role="note">@inheritedText</p> }
    <SubcategoryParametersPanel @key="@($"parameters:{parametersGroup.Category}:{parametersGroup.Subcategory}")" Group="parametersGroup" ProductCount="ProductCount(parametersGroup)"
                                Closed="CloseParameters" Changed="LoadAsync" />
}

@if (pendingChanges is not null)
{
    <SaveConfirmationDialog Title="@(editingCategory is not null ? "Salvezi modificările categoriei?" : "Salvezi modificările subcategoriei?")"
                            ObjectLabel="@(editingCategory ?? editingSubcategory?.Subcategory ?? string.Empty)" Changes="pendingChanges"
                            Note="@(editingSubcategory is not null ? "Produsele subcategoriei vor urma modificările de mai sus." : "Produsele categoriei vor urma noua denumire.")"
                            Reason="@reason" Confirmed="ConfirmGroupSaveAsync" Cancelled="CancelGroupConfirmation" />
}

@if (deletingCategory is not null)
{
    <DeleteConfirmationDialog @key="@($"cat:{deletingCategory}")" Title="Ștergi categoria goală?" Subject="Categoria" ObjectLabel="@deletingCategory"
                              Description="Se pot șterge doar categoriile fără subcategorii și fără produse."
                              Busy="@deleteBusy" Error="@deleteError" Confirmed="DeleteCategoryAsync" Cancelled="CancelDelete" />
}
@if (deletingGroup is not null)
{
    <DeleteConfirmationDialog @key="@($"sub:{deletingGroup.Category}:{deletingGroup.Subcategory}")" Title="Ștergi subcategoria goală?" Subject="Subcategoria"
                              ObjectLabel="@($"{deletingGroup.Category} / {deletingGroup.Subcategory}")"
                              Description="Se pot șterge doar subcategoriile fără produse."
                              Busy="@deleteBusy" Error="@deleteError" Confirmed="DeleteSubcategoryAsync" Cancelled="CancelDelete" />
}

@if (loading)
{
    <div class="empty-state" role="status"><div class="spinner"></div><h3>Se încarcă structura catalogului</h3></div>
}
else
{
    <div class="category-management-list">
        @foreach (var category in Categories)
        {
            var categoryIndex = Categories.IndexOf(category);
            <div class="category-drag-item @(isAdministrator ? "has-handle" : null)" data-category-index="@categoryIndex" data-category-name="@category">
                @if (isAdministrator)
                {
                    @* A span, not a button: Firefox does not start a drag from a button. *@
                    <span role="button" tabindex="0" class="row-icon drag" draggable="@(saving || IsEditing ? "false" : "true")" data-category-handle aria-disabled="@((saving || IsEditing).ToString().ToLowerInvariant())" aria-label="@($"Mută categoria {category} (trage sau folosește săgețile sus / jos)")" title="@($"Trage ca să muți categoria {category} în meniu")"
                          @onkeydown="args => CategoryKeyAsync(args, categoryIndex)"></span>
                }
            <CollapsibleSection Id="@CategoryId(category)"
                                RootClass="catalog category-management-card"
                                HeaderRowClass="catalog-heading collapsible-header"
                                ToggleClass="category-disclosure"
                                ActionsClass="heading-actions"
                                ContentClass="category-management-content"
                                Expanded="@IsCategoryExpanded(category)"
                                ExpandedChanged="@(expanded => SetCategoryExpanded(category, expanded))">
                <Header>
                    <span class="category-disclosure-text"><span class="category-title" data-category-drop="@category">@category</span><small>@SubcategoryCountLabel(category)</small><small>@ProductCount(category) produse asociate</small></span>
                </Header>
                <Actions>
                    <button class="row-icon add" disabled="@(saving || IsEditing)" aria-label="@($"Adaugă subcategorie în {category}")" title="@($"Adaugă subcategorie în {category}")" @onclick="() => CreateSubcategory(category)"></button>
                    @if (permEdit) { <button class="row-icon edit" disabled="@(saving || IsEditing)" aria-label="@($"Editează categoria {category}")" title="@($"Editează categoria {category}")" @onclick="() => EditCategory(category)"></button> }
                    @if (permDelete) { <button class="row-icon delete" disabled="@(saving || IsEditing || !CategoryIsEmpty(category))" aria-label="@($"Șterge categoria {category}")" title="@(DeleteCategoryTitle(category))" @onclick="() => RequestDeleteCategory(category)"></button> }
                </Actions>
                <ChildContent>
                    @if (Subcategories(category).Count == 0)
                    {
                        <div class="empty-state compact"><p>Categoria nu are subcategorii.</p></div>
                    }
                    else
                    {
                        <div class="table-scroll"><table><thead><tr>@if (isAdministrator) { <th class="drag-column"><span class="sr-only">Ordine</span></th> }<th>SUBCATEGORIE</th><th>PRODUSE</th><th>PARAMETRI OBLIGATORII</th><th>ETICHETE</th><th><span class="sr-only">Acțiuni</span></th></tr></thead><tbody>
                        @foreach (var (group, depth) in Flattened(category))
                        {
                            var subIndex = depth == 0 ? Subcategories(category).IndexOf(group) : -1;
                            <tr @key="@($"{group.Category}:{group.Subcategory}")" data-depth="@depth" data-subcategory-index="@(depth == 0 ? subIndex : null)" data-subcategory-category="@(depth == 0 ? category : null)" data-subcategory-name="@(depth == 0 ? group.Subcategory : null)" data-node-category="@category" data-node-name="@group.Subcategory">
                                @if (isAdministrator)
                                {
                                    <td class="drag-column"><span role="button" tabindex="0" class="row-icon drag" draggable="@(saving || IsEditing ? "false" : "true")" data-subcategory-handle aria-disabled="@((saving || IsEditing).ToString().ToLowerInvariant())" aria-label="@($"Mută subcategoria {group.Subcategory}")" title="Trage pentru a muta; sau săgețile sus/jos pe element"
                                          @onkeydown="args => depth == 0 ? SubcategoryKeyAsync(args, category, subIndex) : NodeKeyAsync(args, group)"></span></td>
                                }
                                <td style="@(depth > 0 ? $"padding-left:{depth * 28 + 12}px" : null)">@if (depth > 0) { <span aria-hidden="true">↳ </span> }<strong>@group.Subcategory</strong></td><td>@ProductCount(group) produse</td><td><span class="count-badge">@ParameterCount(group)</span></td><td><span class="count-badge">@TagCount(group)</span></td><td class="row-actions">@if (permAdd && depth + 1 < maxDepth) { <button type="button" class="row-icon addchild" disabled="@(saving || IsEditing)" aria-label="@($"Adaugă subcategorie copil în {group.Subcategory}")" title="@($"Adaugă subcategorie copil în {group.Subcategory}")" @onclick="() => CreateChild(group)"></button> }
<button type="button" class="row-icon params" disabled="@(saving || IsEditing)" aria-label="@($"Parametri și etichete ale subcategoriei {group.Subcategory}")" title="@($"Parametri și etichete ale subcategoriei {group.Subcategory}")" @onclick="() => OpenParameters(group)"></button>@if (permEdit) { <button class="row-icon edit" disabled="@(saving || IsEditing)" aria-label="@($"Editează sau mută subcategoria {group.Subcategory}")" title="@($"Editează sau mută subcategoria {group.Subcategory}")" @onclick="() => EditSubcategory(group)"></button> }
                                @if (ProductCount(group) == 0 && IsLeaf(group))
                                {
                                    @if (permDelete) { <button class="row-icon delete" disabled="@(saving || IsEditing)" aria-label="@($"Șterge subcategoria goală {group.Subcategory}")" title="@($"Șterge subcategoria goală {group.Subcategory}")" @onclick="() => RequestDeleteSubcategory(group)"></button> }
                                }
                            </td></tr>
                        }
                        </tbody></table></div>
                    }
                </ChildContent>
            </CollapsibleSection>
            </div>
        }
    </div>
}

</PageBoundary>

@code {
    private bool permAdd, permEdit, permDelete;
    private async Task LoadPermissionsAsync()
    {
        permAdd = await Access.HasAsync("categorii.add");
        permEdit = await Access.HasAsync("categorii.edit");
        permDelete = await Access.HasAsync("categorii.delete");
    }
    private IReadOnlyList<ProductGroup> groups = Array.Empty<ProductGroup>();
    private IReadOnlyList<Product> products = Array.Empty<Product>();
    private string? editingCategory;
    private ProductGroup? editingSubcategory;
    private bool creatingCategory, creatingSubcategory;
    private string categoryName = "", subcategoryName = "", targetCategory = "", reason = "";
    // The reason of an edit: the summary of the changes made in the form (one on each line, following the form) or a text the user writes.
    private bool reasonAuto = true;
    private string customReason = "";
    private string AutoSummary => editingCategory is not null ? ChangeReasonSummary.Build([new("Categorie", editingCategory, categoryName)])
        : editingSubcategory is not null ? ChangeReasonSummary.Build([new("Subcategorie", editingSubcategory.Subcategory, subcategoryName), new("Categorie", editingSubcategory.Category, targetCategory)])
        : "";
    private string? error, notice;
    private bool loading, saving;
    private IReadOnlyList<AuditChange>? pendingChanges;
    private readonly HashSet<string> expandedCategories = new(StringComparer.Ordinal);
    private readonly CancellationTokenSource lifetime = new();
    // Task 1: leaving an edit form with modified values (the reason alone does not count) asks for confirmation first.
    private UnsavedChangesTracker? groupTracker;
    private string CurrentSnapshot() => FormSnapshot.Values(categoryName, subcategoryName, targetCategory);
    // Called by the leave dialog (another component), so the page asks for its own re-render to close the form.
    private async Task DiscardEditAsync() { CancelEdit(); await InvokeAsync(StateHasChanged); }
    private Task RequestCancelEditAsync() => groupTracker is null ? DiscardEditAsync() : groupTracker.RunAfterConfirmAsync(DiscardEditAsync);
    private bool IsEditing => creatingCategory || creatingSubcategory || editingCategory is not null || editingSubcategory is not null;
    // In the order the administrator arranged (the repository returns them that way); the same order is used by the side menu.
    private List<string> Categories => groups.Select(group => group.Category).Where(value => value.Length > 0)
        .Distinct(StringComparer.OrdinalIgnoreCase).ToList();

    // ---- the order of the categories (administrator only): drag the handle (category-order.js) or Up / Down on the focused handle ----
    private bool isAdministrator;
    private DotNetObjectReference<ProductGroups>? reference;

    [JSInvokable]
    public Task MoveCategory(int from, int to) => InvokeAsync(() => MoveCategoryAsync(from, to));

    [JSInvokable]
    public Task MoveSubcategory(string category, int from, int to) => InvokeAsync(() => MoveSubcategoryAsync(category, from, to));

    private Task SubcategoryKeyAsync(KeyboardEventArgs args, string category, int index) => args.Key switch
    {
        "ArrowUp" => MoveSubcategoryAsync(category, index, index - 1),
        "ArrowDown" => MoveSubcategoryAsync(category, index, index + 1),
        _ => Task.CompletedTask
    };

    private async Task MoveSubcategoryAsync(string category, int from, int to)
    {
        var order = Subcategories(category).Select(group => group.Subcategory).ToList();
        if (!isAdministrator || saving || IsEditing || from == to || from < 0 || to < 0 || from >= order.Count || to >= order.Count) return;
        var moved = order[from];
        order.RemoveAt(from);
        order.Insert(to, moved);
        saving = true; error = null; notice = null;
        try
        {
            await Repository.ReorderSubcategoriesAsync(category, order, lifetime.Token);
            notice = $"Subcategoria „{moved}” a fost mutată pe poziția {to + 1} din „{category}”; ordinea se vede și în meniul lateral.";
        }
        catch (ProductOperationException exception) { error = exception.Message; }
        catch (AccessDeniedException exception) { error = exception.Message; }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) { Logger.LogError("Subcategory reordering failed ({ErrorType}).", exception.GetType().Name); error = "Ordinea subcategoriilor nu a putut fi salvată."; }
        finally { saving = false; }
        await LoadAsync();
        StateHasChanged();
    }

    // ---- the nodes of the tree (administrator only): drag a row handle onto any row (before / after / as a child) or onto a category title (category-order.js) ----
    [JSInvokable]
    public Task DropSubcategory(string category, string name, string targetCategory, string targetName, string zone) =>
        InvokeAsync(() => DropSubcategoryAsync(category, name, targetCategory, targetName, zone));

    private Task NodeKeyAsync(KeyboardEventArgs args, ProductGroup group)
    {
        var step = args.Key switch { "ArrowUp" => -1, "ArrowDown" => 1, _ => 0 };
        var node = Node(group);
        if (step == 0 || node is null) return Task.CompletedTask;
        var siblings = tree.Where(item => string.Equals(item.Category, node.Category, StringComparison.Ordinal) && item.Parent == node.Parent).ToList();
        var index = siblings.FindIndex(item => item.Name == node.Name);
        return index + step < 0 || index + step >= siblings.Count ? Task.CompletedTask : MoveNodeAsync(group, node.Parent is null ? null : new ProductGroup(node.Category, node.Parent), node.Category, index + step);
    }

    private async Task DropSubcategoryAsync(string category, string name, string targetCategory, string targetName, string zone)
    {
        if (saving || IsEditing || !isAdministrator) return;
        ProductGroup? parent = null;
        var destination = targetCategory;
        var position = int.MaxValue;
        if (zone != "end")
        {
            var target = Node(new ProductGroup(targetCategory, targetName));
            if (target is null) return;
            destination = target.Category;
            if (zone == "inside") parent = new ProductGroup(target.Category, target.Name);
            else
            {
                if (target.Parent is not null) parent = new ProductGroup(target.Category, target.Parent);
                var siblings = tree.Where(item => string.Equals(item.Category, target.Category, StringComparison.Ordinal) && item.Parent == target.Parent && item.Name != name).ToList();
                position = siblings.FindIndex(item => item.Name == target.Name) + (zone == "after" ? 1 : 0);
            }
        }
        await MoveNodeAsync(new ProductGroup(category, name), parent, destination, position);
    }

    private async Task MoveNodeAsync(ProductGroup group, ProductGroup? parent, string destination, int position)
    {
        if (saving) return;
        saving = true; error = notice = null;
        string? failure = null;
        try
        {
            var result = await Tree.MoveAsync(group, parent, destination, position, lifetime.Token);
            SetCategoryExpanded(destination, true);
            notice = result.OnlyReordered
                ? $"Subcategoria „{group.Subcategory}” a fost mutată pe noua poziție; ordinea se vede și în meniul lateral."
                : $"Subcategoria „{group.Subcategory}” a fost mutată împreună cu structura de sub ea ({result.NodesMoved} {(result.NodesMoved == 1 ? "nod" : "noduri")}).";
            if (result.IncompleteProducts > 0)
                notice += $" {result.IncompleteProducts} produse moștenesc parametri noi și trebuie completate înainte de orice mișcare de stoc.";
        }
        catch (ProductOperationException exception) { failure = exception.Message; }
        catch (AccessDeniedException exception) { failure = exception.Message; }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) { Logger.LogError("Subcategory move failed ({ErrorType}).", exception.GetType().Name); failure = "Subcategoria nu a putut fi mutată."; }
        finally { saving = false; }
        await LoadAsync();
        if (failure is not null) error = failure;   // LoadAsync clears the banner
        StateHasChanged();
    }

    private Task CategoryKeyAsync(KeyboardEventArgs args, int index) => args.Key switch
    {
        "ArrowUp" => MoveCategoryAsync(index, index - 1),
        "ArrowDown" => MoveCategoryAsync(index, index + 1),
        _ => Task.CompletedTask
    };

    private async Task MoveCategoryAsync(int from, int to)
    {
        var order = Categories;
        if (!isAdministrator || saving || IsEditing || from == to || from < 0 || to < 0 || from >= order.Count || to >= order.Count) return;
        var moved = order[from];
        order.RemoveAt(from);
        order.Insert(to, moved);
        saving = true; error = null; notice = null;
        try
        {
            await Repository.ReorderCategoriesAsync(order, lifetime.Token);
            notice = $"Categoria „{moved}” a fost mutată pe poziția {to + 1}; ordinea se vede și în meniul lateral.";
        }
        catch (ProductOperationException exception) { error = exception.Message; }
        catch (AccessDeniedException exception) { error = exception.Message; }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) { Logger.LogError("Category reordering failed ({ErrorType}).", exception.GetType().Name); error = "Ordinea categoriilor nu a putut fi salvată."; }
        finally { saving = false; }
        await LoadAsync();
        StateHasChanged();
    }

    // The form of a subcategory (new or edited) opens as a popup over the page.
    private RenderFragment SubcategoryEditor => @<div class="delete-overlay"><section class="delete-dialog group-editor-dialog" role="dialog" aria-modal="true" aria-labelledby="subcategory-editor-title">
        <UnsavedChangesTracker @ref="groupTracker" Adding="@(creatingCategory || creatingSubcategory)" Snapshot="CurrentSnapshot" Discard="DiscardEditAsync" />
        <div class="catalog-heading dialog-head"><h2 id="subcategory-editor-title">@(creatingChildOf is not null ? $"Adaugă subcategorie copil în „{creatingChildOf.Subcategory}”" : creatingSubcategory ? $"Adaugă subcategorie în „{targetCategory}”" : $"Editează subcategoria „{editingSubcategory!.Subcategory}”")</h2><HelpButton Topic="categorii" About="categoria și subcategoria" /></div>
        <div class="editor-grid">
            @if (creatingChildOf is not null && ProductCount(creatingChildOf) > 0) { <p class="full-width muted" role="note">Subcategoria „@creatingChildOf.Subcategory” are @ProductCount(creatingChildOf) produse. Produsele se asociază numai subcategoriilor de la ultimul nivel, deci la adăugare se mută în noua subcategorie și își păstrează parametrii și etichetele.</p> }
            <label for="subcategory-name">Denumire subcategorie *<input id="subcategory-name" maxlength="100" @bind="subcategoryName" disabled="@saving" autocomplete="off" /></label>
            @* Only the name is edited here; moving a subcategory to another category is done by drag and drop. *@
            @if (!creatingSubcategory) { <ChangeReasonField Id="subcategory-reason" @bind-Value="customReason" AutoText="@AutoSummary" @bind-UseAuto="reasonAuto" Disabled="@saving" /> }
        </div>
        <div class="editor-actions"><button class="primary" disabled="@saving" @onclick="RequestSaveSubcategoryAsync">@(creatingChildOf is not null && ProductCount(creatingChildOf) > 0 ? "Adaugă și mută produsele" : creatingSubcategory ? "Adaugă subcategoria" : "Salvează subcategoria")</button><button class="danger" disabled="@saving" @onclick="RequestCancelEditAsync">Anulează</button></div>
    </section></div>;

    protected override async Task OnInitializedAsync()
    {
        await LoadPermissionsAsync();
        if (!await Access.HasAsync("categorii.view", lifetime.Token)) { error = "Nu ai dreptul să vezi catalogul."; return; }
        isAdministrator = await Access.IsAdministratorAsync(lifetime.Token);
        reference = DotNetObjectReference.Create(this);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true; error = null;
        try
        {
            var groupsTask = Repository.GetGroupsAsync(lifetime.Token);
            var productsTask = Repository.GetProductsAsync(lifetime.Token);
            var parametersTask = ParameterRepository.GetParametersAsync(lifetime.Token);
            var tagsTask = TagRepository.GetTagsAsync(lifetime.Token);
            var treeTask = Tree.GetTreeAsync(lifetime.Token);
            await Task.WhenAll(groupsTask, productsTask, parametersTask, tagsTask, treeTask);
            groups = await groupsTask;
            products = await productsTask;
            allParameters = await parametersTask;
            allTags = await tagsTask;
            tree = await treeTask;
            maxDepth = await CatalogSettings.GetMaxSubcategoryDepthAsync(lifetime.Token);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) { Logger.LogError("Product group loading failed ({ErrorType}).", exception.GetType().Name); error = "Structura catalogului nu a putut fi încărcată."; }
        finally { loading = false; }
    }

    private List<ProductGroup> Subcategories(string category) => groups
        .Where(group => string.Equals(group.Category, category, StringComparison.OrdinalIgnoreCase) && group.Subcategory.Length > 0 && IsRoot(group)).ToList();
    private int ProductCount(string category) => products.Count(product => string.Equals(product.Category, category, StringComparison.OrdinalIgnoreCase));
    private string SubcategoryCountLabel(string category)
    {
        var count = Flattened(category).Count;
        return $"{count} {(count == 1 ? "subcategorie" : "subcategorii")}";
    }
    private int ProductCount(ProductGroup group) => products.Count(product =>
        string.Equals(product.Category, group.Category, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(product.Subcategory, group.Subcategory, StringComparison.OrdinalIgnoreCase));
    private static string CategoryId(string category) => $"category-{Uri.EscapeDataString(TextNormalization.UniquenessKey(category))}";
    private bool IsCategoryExpanded(string category) => expandedCategories.Contains(TextNormalization.UniquenessKey(category));
    private void SetCategoryExpanded(string category, bool expanded)
    {
        var key = TextNormalization.UniquenessKey(category);
        if (expanded) expandedCategories.Add(key);
        else expandedCategories.Remove(key);
    }

    private void CreateCategory() { CancelEdit(); creatingCategory = true; categoryName = ""; notice = null; }
    // The form opens inside the category (under its last subcategory), so the category is opened and the form is brought into view.
    private void CreateSubcategory(string category)
    {
        CancelEdit(); creatingSubcategory = true; targetCategory = category; subcategoryName = ""; notice = null;
        SetCategoryExpanded(category, true);
        showNewSubcategory = true;
    }
    private bool showNewSubcategory, orderRegistered;
    // The tree of subcategories (migration 54): children are shown under their parent, products are attached to leaves only, the maximum depth is a setting.
    private IReadOnlyList<SubcategoryNode> tree = [];
    private int maxDepth = CatalogSettingsRules.DefaultSubcategoryDepth;
    private ProductGroup? creatingChildOf;
    private SubcategoryNode? Node(ProductGroup group) => tree.FirstOrDefault(node =>
        string.Equals(node.Category, group.Category, StringComparison.OrdinalIgnoreCase) && string.Equals(node.Name, group.Subcategory, StringComparison.OrdinalIgnoreCase));
    private bool IsRoot(ProductGroup group) => Node(group)?.Parent is null;
    private bool IsLeaf(ProductGroup group) => Node(group)?.IsLeaf ?? true;
    private List<(ProductGroup Group, int Depth)> Flattened(string category) => tree
        .Where(node => string.Equals(node.Category, category, StringComparison.OrdinalIgnoreCase)).Select(node => (new ProductGroup(node.Category, node.Name), node.Depth)).ToList();
    private void CreateChild(ProductGroup parent)
    {
        CancelEdit(); creatingSubcategory = true; creatingChildOf = parent; targetCategory = parent.Category; subcategoryName = ""; notice = null;
        SetCategoryExpanded(parent.Category, true);
        showNewSubcategory = true;
    }
    // The parameters and tags a subcategory inherits from its ancestors (edited at the ancestor, not here).
    private string Inherited(ProductGroup group)
    {
        var ancestors = new List<string>();
        for (var node = Node(group); node?.Parent is { } parent; node = tree.FirstOrDefault(item => string.Equals(item.Category, group.Category, StringComparison.OrdinalIgnoreCase) && item.Name == parent))
            ancestors.Insert(0, parent);
        if (ancestors.Count == 0) return "";
        var names = new List<string>();
        foreach (var ancestor in ancestors)
        {
            var parameters = allParameters.Where(item => string.Equals(item.Subcategory, ancestor, StringComparison.OrdinalIgnoreCase)).Select(item => item.Name).ToList();
            var tags = allTags.Where(item => string.Equals(item.Subcategory, ancestor, StringComparison.OrdinalIgnoreCase)).Select(item => item.Name).ToList();
            if (parameters.Count + tags.Count > 0)
                names.Add($"{ancestor}: parametri ({(parameters.Count == 0 ? "—" : string.Join(", ", parameters))}), etichete ({(tags.Count == 0 ? "—" : string.Join(", ", tags))})");
        }
        return names.Count == 0 ? "" : "Moștenește de la părinți (se modifică la părintele care le definește) — " + string.Join("; ", names) + ".";
    }

    // The required parameters of a subcategory (values chosen when a product is saved): panel under the editors, opened from the row or after a subcategory is created.
    private ProductGroup? parametersGroup;
    private IReadOnlyList<SubcategoryParameter> allParameters = [];
    private int ParameterCount(ProductGroup group) => allParameters.Count(parameter =>
        string.Equals(parameter.Category, group.Category, StringComparison.OrdinalIgnoreCase) && string.Equals(parameter.Subcategory, group.Subcategory, StringComparison.OrdinalIgnoreCase));
    private void OpenParameters(ProductGroup group) { CancelEdit(); parametersGroup = group; notice = null; }
    private Task CloseParameters() { parametersGroup = null; return Task.CompletedTask; }

    private IReadOnlyList<SubcategoryTag> allTags = [];
    private int TagCount(ProductGroup group) => allTags.Count(tag =>
        string.Equals(tag.Category, group.Category, StringComparison.OrdinalIgnoreCase) && string.Equals(tag.Subcategory, group.Subcategory, StringComparison.OrdinalIgnoreCase));

    private bool CategoryIsEmpty(string category) => Subcategories(category).Count == 0 && ProductCount(category) == 0;

    private string DeleteCategoryTitle(string category) => CategoryIsEmpty(category)
        ? $"Șterge categoria goală {category}"
        : "Categoria nu se poate șterge: are subcategorii sau produse. Se șterg doar categoriile goale (fără subcategorii și fără produse); șterge mai întâi subcategoriile goale sau mută produsele.";

    // ---- deleting an empty category or subcategory ----
    private string? deletingCategory, deleteError;
    private ProductGroup? deletingGroup;
    private bool deleteBusy;

    private void RequestDeleteCategory(string category) { CancelEdit(); deletingGroup = null; deletingCategory = category; deleteError = null; notice = null; }
    private void RequestDeleteSubcategory(ProductGroup group) { CancelEdit(); deletingCategory = null; deletingGroup = group; deleteError = null; notice = null; }
    private Task CancelDelete() { deletingCategory = null; deletingGroup = null; deleteError = null; return Task.CompletedTask; }

    private Task DeleteCategoryAsync(string deleteReason) => RunDeleteAsync(async () =>
    {
        await Repository.DeleteCategoryAsync(deletingCategory!, deleteReason, lifetime.Token);
        return $"Categoria „{deletingCategory}” a fost ștearsă.";
    });

    private Task DeleteSubcategoryAsync(string deleteReason) => RunDeleteAsync(async () =>
    {
        await Repository.DeleteSubcategoryAsync(deletingGroup!, deleteReason, lifetime.Token);
        return $"Subcategoria „{deletingGroup!.Subcategory}” a fost ștearsă.";
    });

    private async Task RunDeleteAsync(Func<Task<string>> delete)
    {
        if (deleteBusy) return;
        deleteBusy = true; deleteError = null;
        try
        {
            var message = await delete();
            deletingCategory = null; deletingGroup = null;
            await LoadAsync();
            notice = message;
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (ProductOperationException exception) { deleteError = exception.Message; }
        catch (AccessDeniedException exception) { deleteError = exception.Message; }
        catch (Exception exception) { Logger.LogError("Category deletion failed ({ErrorType}).", exception.GetType().Name); deleteError = "Ștergerea nu a reușit. Actualizează lista și reîncearcă."; }
        finally { deleteBusy = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || (isAdministrator && !orderRegistered))
        {
            if (isAdministrator && reference is not null)
            {
                orderRegistered = true;
                try { await JS.InvokeVoidAsync("blazorStocCategoryOrder.register", reference); }
                catch (Exception exception) when (exception is JSException or InvalidOperationException or TaskCanceledException or JSDisconnectedException) { }
            }
        }
        if (!showNewSubcategory) return;
        showNewSubcategory = false;
        try { await JS.InvokeVoidAsync("blazorStocScrollTo", "subcategory-name"); }
        catch (Exception exception) when (exception is JSException or InvalidOperationException or TaskCanceledException or JSDisconnectedException) { }
    }
    private void EditCategory(string category) { CancelEdit(); editingCategory = category; categoryName = category; notice = null; }
    private void EditSubcategory(ProductGroup group) { CancelEdit(); editingSubcategory = group; subcategoryName = group.Subcategory; targetCategory = group.Category; notice = null; }
    private void CancelEdit() { pendingChanges = null; creatingCategory = creatingSubcategory = false; creatingChildOf = null; editingCategory = null; editingSubcategory = null; reason = ""; customReason = ""; reasonAuto = true; error = null; }

    // Renaming or moving existing groups needs an explicit confirmation of the changed fields; creating one is saved directly.
    private Task RequestSaveCategoryAsync()
    {
        if (saving) return Task.CompletedTask;
        if (creatingCategory) return SaveCategoryAsync();
        if (editingCategory is null) return Task.CompletedTask;
        error = null;
        reason = ChangeReasonSummary.Chosen(reasonAuto, AutoSummary, customReason);
        if (ChangeReasonSummary.ValidationError(reasonAuto, AutoSummary, customReason) is { } reasonError) { error = reasonError; return Task.CompletedTask; }
        pendingChanges = SaveSummary.Changed(new AuditChange("Categorie", editingCategory, TextNormalization.ForObjectNameOrCode(categoryName)));
        return Task.CompletedTask;
    }

    private Task RequestSaveSubcategoryAsync()
    {
        if (saving) return Task.CompletedTask;
        if (creatingSubcategory) return SaveSubcategoryAsync();
        if (editingSubcategory is null) return Task.CompletedTask;
        error = null;
        reason = ChangeReasonSummary.Chosen(reasonAuto, AutoSummary, customReason);
        if (ChangeReasonSummary.ValidationError(reasonAuto, AutoSummary, customReason) is { } reasonError) { error = reasonError; return Task.CompletedTask; }
        pendingChanges = SaveSummary.Changed(
            new("Subcategorie", editingSubcategory.Subcategory, TextNormalization.ForObjectNameOrCode(subcategoryName)),
            new("Categorie", editingSubcategory.Category, TextNormalization.ForObjectNameOrCode(targetCategory)));
        return Task.CompletedTask;
    }

    private Task ConfirmGroupSaveAsync()
    {
        pendingChanges = null;
        return editingCategory is not null ? SaveCategoryAsync() : SaveSubcategoryAsync();
    }

    private Task CancelGroupConfirmation() { pendingChanges = null; return Task.CompletedTask; }

    private async Task SaveCategoryAsync()
    {
        if (saving || (!creatingCategory && editingCategory is null)) return;
        saving = true; error = null;
        try
        {
            if (creatingCategory) await Repository.CreateCategoryAsync(categoryName, lifetime.Token);
            else await Repository.RenameCategoryAsync(editingCategory!, categoryName, reason, lifetime.Token);
            var created = creatingCategory; CancelEdit(); notice = created ? "Categoria a fost adăugată." : "Categoria a fost actualizată."; await LoadAsync();
        }
        catch (ProductOperationException exception) { error = exception.Message; }
        catch (AccessDeniedException exception) { error = exception.Message; }
        catch (Exception exception) { Logger.LogError("Category update failed ({ErrorType}).", exception.GetType().Name); error = "Categoria nu a putut fi actualizată."; }
        finally { saving = false; }
    }

    private async Task SaveSubcategoryAsync()
    {
        if (saving || (!creatingSubcategory && editingSubcategory is null)) return;
        saving = true; error = null;
        try
        {
            if (creatingChildOf is not null) await Tree.CreateChildAsync(creatingChildOf, subcategoryName, ProductCount(creatingChildOf) > 0, lifetime.Token);
            else if (creatingSubcategory) await Repository.CreateSubcategoryAsync(targetCategory, subcategoryName, lifetime.Token);
            else await Repository.UpdateSubcategoryAsync(editingSubcategory!, subcategoryName, targetCategory, reason, lifetime.Token);
            var created = creatingSubcategory;
            var createdGroup = new ProductGroup(targetCategory, TextNormalization.ForObjectNameOrCode(subcategoryName));
            CancelEdit(); notice = created ? "Subcategoria a fost adăugată. Dacă produsele ei au caracteristici obligatorii (de exemplu lentila unei camere), adaugă-le acum." : "Subcategoria a fost actualizată."; await LoadAsync();
            if (created) parametersGroup = createdGroup;
        }
        catch (ProductOperationException exception) { error = exception.Message; }
        catch (AccessDeniedException exception) { error = exception.Message; }
        catch (Exception exception) { Logger.LogError("Subcategory update failed ({ErrorType}).", exception.GetType().Name); error = "Subcategoria nu a putut fi actualizată."; }
        finally { saving = false; }
    }

    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); reference?.Dispose(); }
}
