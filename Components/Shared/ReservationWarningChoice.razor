@using BlazorStoc.Services
@* The choice made when an exit would take pieces reserved by other projects: continue without touching the reservations, or lower the reservation of one of the
   projects (quantity and a short reason, both journaled). The model is changed in place; the page applies it to the exit with ReservationChoice.ApplyTo. *@
<fieldset class="cause-choice reservation-choice" disabled="@Disabled">
    <legend>Pe ce rezervări se ia (@Excess buc.)</legend>
    <label><input type="radio" name="@($"{Prefix}-reservation")" checked="@(Choice.Mode == ReservationChoiceMode.Continue)" @onchange="() => Choice.Mode = ReservationChoiceMode.Continue" /> Continuă fără să ating rezervările</label>
    <label><input type="radio" name="@($"{Prefix}-reservation")" checked="@(Choice.Mode == ReservationChoiceMode.Reduce)" @onchange="StartReduce" /> Scade rezervarea unui proiect</label>
    @if (Choice.Mode == ReservationChoiceMode.Reduce)
    {
        <div class="relation-row">
            <select aria-label="Proiectul a cărui rezervare se scade" @onchange="args => Choice.ProjectId = int.TryParse(args.Value?.ToString(), out var id) ? id : null">
                <option value="" selected="@(Choice.ProjectId is null)">— alege proiectul —</option>
                @foreach (var holder in Holders) { <option value="@holder.ProjectId" selected="@(Choice.ProjectId == holder.ProjectId)">@holder.ProjectName (@holder.Quantity buc. rezervate)</option> }
            </select>
            <input type="number" aria-label="Cantitatea scăzută din rezervare" min="1" @bind="Choice.Quantity" @bind:event="oninput" />
            <input type="text" aria-label="Motivul scăderii rezervării" placeholder="Motiv scurt" maxlength="@ReservationRules.ReasonMaximumLength" @bind="Choice.Reason" @bind:event="oninput" />
        </div>
    }
</fieldset>

@code {
    [Parameter, EditorRequired] public string Prefix { get; set; } = "";
    [Parameter, EditorRequired] public ReservationChoice Choice { get; set; } = new();
    [Parameter] public IReadOnlyList<ReservationHolder> Holders { get; set; } = [];
    [Parameter] public int Excess { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private void StartReduce()
    {
        Choice.Mode = ReservationChoiceMode.Reduce;
        Choice.Quantity ??= Excess;
        if (Choice.ProjectId is null && Holders.Count == 1) Choice.ProjectId = Holders[0].ProjectId;
    }
}
