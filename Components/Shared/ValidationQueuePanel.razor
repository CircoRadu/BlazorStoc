@namespace BlazorStoc.Components.Shared
@using BlazorStoc.Components.Pages

@* The lists of the events that wait for a decision from ActivityApp (tickets proposed as maintenance with the discarded ones, beneficiaries to verify, the problems found by the import). They belong to
   the ActivityApp import module; the pages of other modules (Maintenance, Notifications) show them through this wrapper, because modules do not refer to each other. *@
<ModuleGate ModuleId="@BlazorStoc.Modules.ActivityImport.ActivityImportModule.ModuleId" Section="Coada de validare tichete">
    @if (Beneficiaries) { <BeneficiaryChecksSection ShowEmpty="true" Changed="Changed" /> }
    else if (Issues) { <ActivityIssuesSection Changed="Changed" /> }
    else
    {
        <ActivityReviewSection Decided="DecidedAsync" />
        @if (ShowDiscarded) { <ActivityDiscardedSection @ref="discarded" /> }
    }
</ModuleGate>

@code {
    private ActivityDiscardedSection? discarded;

    /// <summary>False: the tickets proposed as maintenance; true: the beneficiaries to verify.</summary>
    [Parameter] public bool Beneficiaries { get; set; }
    /// <summary>True: the problems the import found (instead of a queue).</summary>
    [Parameter] public bool Issues { get; set; }
    /// <summary>Under the queue of tickets, the tickets discarded from it (with their reactivation).</summary>
    [Parameter] public bool ShowDiscarded { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    private async Task DecidedAsync()
    {
        if (discarded is not null) await discarded.RefreshIfShownAsync();
        await Changed.InvokeAsync();
    }
}
