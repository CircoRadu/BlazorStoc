@using System.Globalization
@using BlazorStoc.Services
@inject IInvoiceTemplateService Service
@inject IAccessControl Access
@inject IJSRuntime JS
@inject ILogger<InvoiceTemplatesList> Logger
@implements IDisposable

<h2>Șabloane de facturi salvate</h2>
<p class="muted">Fiecare furnizor poate avea mai multe șabloane (de exemplu pentru un PDF din program și pentru unul scanat). La analiza unei facturi, aplicația propune șabloanele care se potrivesc, după CUI-ul furnizorului și după aspectul facturii. Un șablon se editează cu iconița ✎ (elementele lui, denumirea și furnizorul); fiecare salvare înlocuiește șablonul.</p>

@if (error is not null) { <div class="error-banner" role="alert">@error</div> }
@if (notice is not null) { <div class="success-banner" role="status">@notice</div> }
@if (FocusTemplateId is { } wanted && !loading && templates.All(item => item.Info.Id != wanted)) { <div class="error-banner" role="status">Șablonul #@wanted nu mai există (a fost șters).</div> }

<section class="catalog">
    <div class="catalog-heading"><h3>Șabloane <span>@templates.Count</span></h3><button type="button" class="refresh" disabled="@loading" @onclick="LoadAsync">Actualizează</button></div>
    @if (loading) { <div class="empty-state" role="status"><div class="spinner"></div><h3>Se încarcă șabloanele</h3></div> }
    else if (templates.Count == 0) { <div class="empty-state"><div class="empty-icon" aria-hidden="true">▤</div><h3>Nu există șabloane salvate</h3><p>Încarcă o factură în pagina „Generare șablon factură” și salvează șablonul creat.</p></div> }
    else
    {
        <div class="table-scroll"><table><thead><tr><th>ACTIV</th><th>ȘABLON</th><th>FURNIZOR</th><th>CUI</th><th>SURSĂ</th><th>CONȚINUT</th><th>ACTUALIZAT</th><th><span class="sr-only">Acțiuni</span></th></tr></thead><tbody>
        @foreach (var template in templates)
        {
            var info = template.Info;
            var focused = info.Id == FocusTemplateId;
            var open = expanded == info.Id;
            <tr @key="info.Id" id="invoice-template-@info.Id" class="@(focused ? "row-focus" : null)">
<td><ToggleSwitch Value="@info.Active" Disabled="@saving" OnText="Activ" OffText="Inactiv" AriaLabel="@($"Șablon activ: {info.Name}")" Title="@(info.Active ? "Șablonul este folosit la citirea facturilor. Apasă ca să nu mai fie folosit." : "Șablonul nu este folosit la citirea facturilor. Apasă ca să fie folosit.")" ValueChanged="@(active => SetActiveAsync(info, active))" /></td>
                <td><strong>@info.Name</strong></td>
                <td>@(info.SupplierName.Length > 0 ? info.SupplierName : "—")</td>
                <td>@(info.SupplierCui.Length > 0 ? info.SupplierCui : "—")</td>
                <td>@(info.SourceKind == InvoiceSources.Ocr ? "Scanat (OCR)" : "PDF cu text")</td>
                <td><small>@template.Definition.UsedFieldCount câmpuri · @template.Definition.UsedColumnCount coloane</small></td>
                <td><small>@Stamp(info.UpdatedUtc)<br />@info.UpdatedBy</small></td>
                <td class="row-actions">
                    <button type="button" class="invoice-icon-btn" title="@(open ? "Ascunde detaliile șablonului" : "Arată detaliile șablonului")" aria-label="@(open ? "Ascunde detaliile șablonului" : "Arată detaliile șablonului")" aria-expanded="@(open ? "true" : "false")" @onclick="() => ToggleDetails(info.Id)">👁</button>
                    <button type="button" class="invoice-icon-btn" disabled="@saving" title="Editează șablonul (elementele, denumirea și furnizorul)" aria-label="Editează șablonul" @onclick="() => OnEditWithFile.InvokeAsync(template)">✎</button>
                    @if (isAdmin) { <button type="button" class="invoice-icon-btn danger" disabled="@saving" title="Șterge șablonul" aria-label="Șterge șablonul" @onclick="() => deleting = info">🗑</button> }
                </td>
            </tr>
            @if (open)
            {
                <tr class="invoice-details-row"><td colspan="8">
                    <div class="invoice-details">
                        <div><strong>Câmpuri folosite</strong>
                            <ul>@foreach (var field in template.Definition.Fields.Where(field => field.Use)) { <li>@(field.Name.Length > 0 ? field.Name : "(fără denumire)")</li> }
                                @if (template.Definition.UsedFieldCount == 0) { <li class="muted">niciunul</li> }</ul></div>
                        <div><strong>Coloanele tabelului</strong>
                            <ul>@foreach (var column in template.Definition.Table?.Columns.Where(column => column.Use && column.Meaning != InvoiceColumnMeanings.Ignore) ?? [])
                                { <li>@(column.Label.Length > 0 ? column.Label : "(fără denumire)")</li> }
                                @if (template.Definition.UsedColumnCount == 0) { <li class="muted">niciuna</li> }</ul>
                            @if (template.Definition.Table?.NameCodeSeparator is { Length: > 0 } separator) { <small class="muted">Codul produsului se ia din denumire, înaintea separatorului „@separator”.</small> }</div>
                    </div>
                </td></tr>
            }
        }
        </tbody></table></div>
    }
</section>

@if (deleting is not null)
{
    <DeleteConfirmationDialog @key="deleting.Id" Title="Ștergi șablonul?" Subject="Șablonul de factură" ObjectLabel="@deleting.Name"
                              Description="Șablonul și toate versiunile lui salvate dispar. Facturile deja importate nu sunt afectate."
                              ConfirmationNote="Șablonul nu se arhivează: se șterge definitiv, iar operația este înregistrată în jurnal."
                              Busy="@deleteBusy" Error="@deleteError" Confirmed="DeleteAsync" Cancelled="CancelDelete" />
}

@code {
    [Parameter] public int? FocusTemplateId { get; set; }
    [Parameter] public EventCallback<InvoiceTemplateRecord> OnEditWithFile { get; set; }

    private readonly CancellationTokenSource lifetime = new();
    private IReadOnlyList<InvoiceTemplateRecord> templates = [];
    private InvoiceTemplateInfo? deleting;
    private string? error, notice, deleteError;
    private int? expanded, scrolledTo;
    private bool loading, saving, deleteBusy, isAdmin;

    private static string Stamp(DateTime utc) => StockMovementRules.DisplayDate(DateOnly.FromDateTime(utc.ToLocalTime())) + " " + utc.ToLocalTime().ToString("HH:mm", CultureInfo.InvariantCulture);

    // Every user who may use templates changes them; deleting one is for the administrator only.
    protected override async Task OnInitializedAsync()
    {
        isAdmin = await Access.IsAdministratorAsync(lifetime.Token);
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (loading || FocusTemplateId is not { } id || scrolledTo == id || templates.All(item => item.Info.Id != id)) return;
        scrolledTo = id;
        try { await JS.InvokeVoidAsync("blazorStocScrollTo", $"invoice-template-{id}"); }
        catch (Exception exception) when (exception is JSException or InvalidOperationException or TaskCanceledException) { }
    }

    private async Task LoadAsync()
    {
        loading = true; error = null;
        try { templates = await Service.GetAllAsync(lifetime.Token); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Logger.LogError("Invoice templates loading failed ({ErrorType}).", exception.GetType().Name);
            error = "Șabloanele nu au putut fi încărcate.";
        }
        finally { loading = false; }
    }

    private void ToggleDetails(int id) => expanded = expanded == id ? null : id;

    // Chooses whether the template is used when invoices are read (a supplier can have several templates).
    private async Task SetActiveAsync(InvoiceTemplateInfo info, bool active)
    {
        if (saving) return;
        saving = true; error = null; notice = null;
        try
        {
            await Service.SetActiveAsync(info, active, lifetime.Token);
            notice = active ? $"Șablonul „{info.Name}” este folosit din nou la citirea facturilor." : $"Șablonul „{info.Name}” nu mai este folosit la citirea facturilor.";
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (InvoiceTemplateOperationException exception) { error = exception.Message; }
        catch (AccessDeniedException exception) { error = exception.Message; }
        catch (Exception exception)
        {
            Logger.LogError("Invoice template activation failed ({ErrorType}).", exception.GetType().Name);
            error = "Starea șablonului nu a putut fi schimbată. Reîncearcă.";
        }
        finally { saving = false; }
        await LoadAsync();
    }

    private async Task DeleteAsync(string reason)
    {
        if (deleting is null || deleteBusy) return;
        deleteBusy = true; deleteError = null;
        try
        {
            await Service.DeleteAsync(deleting, reason, lifetime.Token);
            deleting = null;
            notice = "Șablonul a fost șters.";
            await LoadAsync();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (InvoiceTemplateOperationException exception) { deleteError = exception.Message; }
        catch (AccessDeniedException exception) { deleteError = exception.Message; }
        catch (Exception exception)
        {
            Logger.LogError("Invoice template deletion failed ({ErrorType}).", exception.GetType().Name);
            deleteError = "Șablonul nu a putut fi șters. Reîncearcă.";
        }
        finally { deleteBusy = false; }
    }

    private void CancelDelete() { deleting = null; deleteError = null; }

    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
}
