@using BlazorStoc.Services

@* Page size and page buttons under the journal tables. PageSize 0 means "all the results" (offered only when AllowAll). *@
<div class="table-footer audit-table-footer">
    <div class="audit-page-size">
        <label for="@Id">Evenimente pe pagină</label>
        <select id="@Id" value="@PageSize" @onchange="SizeChangedAsync">
            @foreach (var size in PageSizes) { <option value="@size" selected="@(size == PageSize)">@(size == 0 ? "Toate" : size.ToString())</option> }
        </select>
        <span>@Summary</span>
    </div>
    @if (PageSize > 0)
    {
        <nav class="pagination" aria-label="Paginare jurnal">
            <button type="button" aria-label="Pagina anterioară" title="Pagina anterioară" disabled="@(Page <= 1)" @onclick="() => PageChanged.InvokeAsync(Page - 1)">‹</button>
            <span>Pagina <strong>@Page</strong> din <strong>@TotalPages</strong></span>
            <button type="button" aria-label="Pagina următoare" title="Pagina următoare" disabled="@(Page >= TotalPages)" @onclick="() => PageChanged.InvokeAsync(Page + 1)">›</button>
        </nav>
    }
</div>

@code {
    [Parameter] public string Id { get; set; } = "audit-page-size";
    [Parameter] public IReadOnlyList<int> PageSizes { get; set; } = AuditListState.PageSizes;
    [Parameter] public int PageSize { get; set; }
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int Total { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }

    private int TotalPages => PageSize == 0 ? 1 : Math.Max(1, (Total + PageSize - 1) / PageSize);

    private string Summary
    {
        get
        {
            if (PageSize == 0 || Total == 0) return $"{Total:N0} rezultate";
            var first = (Page - 1) * PageSize + 1;
            var last = Math.Min(Page * PageSize, Total);
            return $"{first:N0}–{last:N0} din {Total:N0} rezultate";
        }
    }

    private Task SizeChangedAsync(ChangeEventArgs args) =>
        int.TryParse(args.Value?.ToString(), out var size) ? PageSizeChanged.InvokeAsync(size) : Task.CompletedTask;
}
