@* A styled file field: click to choose, or drag files onto it (file-drop.js hands the dropped files to the hidden InputFile and raises its
   own change event, so OnChange runs exactly as for a normal selection). *@
<div class="file-drop @(Disabled ? "disabled" : null)" data-file-drop>
    <label class="file-drop-label" for="@Id">
        <span class="file-drop-icon" aria-hidden="true">⇪</span>
        <span class="file-drop-text"><strong>@ButtonText</strong> <span class="muted">sau trage @(Multiple ? "fișierele" : "fișierul") aici</span></span>
    </label>
    <InputFile id="@Id" class="sr-only" OnChange="OnChange" multiple="@Multiple" accept="@Accept" disabled="@Disabled" />
</div>

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter, EditorRequired] public EventCallback<InputFileChangeEventArgs> OnChange { get; set; }
    [Parameter] public bool Multiple { get; set; }
    [Parameter] public string? Accept { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Text { get; set; }

    private string ButtonText => Text ?? (Multiple ? "Alege fișiere" : "Alege fișier");

    protected override void OnInitialized() => Id ??= "file-drop-" + Guid.NewGuid().ToString("N")[..8];
}
