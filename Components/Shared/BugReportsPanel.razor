@namespace BlazorStoc.Components.Shared
@using BlazorStoc.Modules
@using BlazorStoc.Modules.BugReports
@using Microsoft.AspNetCore.Components.Forms
@inject IBugReportService Reports
@inject IAccessControl Access
@inject IChangeFeed ChangeFeed
@inject IJSRuntime JS
@inject ILogger<BugReportsPanel> Logger
@implements IAsyncDisposable
@* Setari -> Rapoarte erori (administrator): the reports sent from the menu entry "Raportează o eroare". Filters, a paged table (server side), the report with its pictures,
   the change of state with a note, the deletion and the ZIP export (one report or everything the filters show). *@
<section class="catalog" aria-labelledby="bug-admin-title">
    <div class="catalog-heading"><h2 id="bug-admin-title">Rapoarte erori <span class="count-badge">@total</span></h2></div>
    <div class="catalog-body">
        @if (error is not null) { <div class="error-banner" role="alert" id="bug-admin-error">@error</div> }
        @if (notice is not null) { <div class="success-banner" role="status" id="bug-admin-notice">@notice</div> }
        <CollapsibleSection Id="bug-admin-flow" RootClass="bug-help" HeaderRowClass="collapsible-header" ToggleClass="bug-help-toggle" ContentClass="bug-help-body" Expanded="false">
            <Header>Cum se lucrează cu rapoartele</Header>
            <ChildContent>
                <ol>
                    <li>Utilizatorii trimit rapoarte din meniul „Raportează o eroare”; fiecare primește un număr (BUG-0042) și starea <strong>Nou</strong>. Rapoartele nu ies din aplicație.</li>
                    <li>Filtrezi lista după stare, gravitate, autor sau perioadă și deschizi un raport cu pictograma ochi: vezi descrierea, pagina, detaliile tehnice și imaginile (prima este captura paginii).</li>
                    <li>Alegi starea (<strong>În analiză</strong>, <strong>Rezolvat</strong>, <strong>Respins</strong>) și scrii o notă pentru autor; autorul le vede în „Rapoartele mele”. Fiecare schimbare intră în jurnalul de activitate.</li>
                    <li><strong>Exportă raportul</strong> descarcă un ZIP cu <code>raport.json</code>, <code>raport.txt</code> și imaginile; <strong>Exportă lista filtrată</strong> pune toate rapoartele din filtre într-un ZIP, cu un <code>index.csv</code>.</li>
                    <li>Pictograma coșului șterge definitiv raportul și imaginile lui (după confirmare); ștergerea intră în jurnal.</li>
                </ol>
            </ChildContent>
        </CollapsibleSection>

        <div class="settings-tabs" role="tablist" aria-label="Rapoarte erori">
            <button type="button" role="tab" id="tab-bugs-open" class="settings-tab @(showClosed ? "" : "active")" aria-selected="@(showClosed ? "false" : "true")" aria-controls="panel-bugs" @onclick="() => OpenTabAsync(false)">Nerezolvate</button>
            <button type="button" role="tab" id="tab-bugs-closed" class="settings-tab @(showClosed ? "active" : "")" aria-selected="@(showClosed ? "true" : "false")" aria-controls="panel-bugs" @onclick="() => OpenTabAsync(true)">Rezolvate</button>
        </div>
        <div id="panel-bugs" role="tabpanel" aria-labelledby="@(showClosed ? "tab-bugs-closed" : "tab-bugs-open")">
        <div class="audit-filters bug-filters">
            <label>Stare
                <select id="bug-filter-state" @bind="state" @bind:after="FilterChangedAsync">
                    <option value="">Toate</option>
                    @foreach (var item in BugReportRules.States.Where(s => (s is BugReportRules.StateResolved or BugReportRules.StateRejected) == showClosed)) { <option value="@item">@item</option> }
                </select></label>
            <label>Gravitate
                <select id="bug-filter-severity" @bind="severity" @bind:after="FilterChangedAsync">
                    <option value="">Toate</option>
                    @foreach (var item in BugReportRules.Severities) { <option value="@item">@item</option> }
                </select></label>
            <label>Autor <input id="bug-filter-user" @bind="user" @bind:event="onchange" @bind:after="FilterChangedAsync" /></label>
            <label>De la <input id="bug-filter-from" type="date" @bind="from" @bind:after="FilterChangedAsync" /></label>
            <label>Până la <input id="bug-filter-to" type="date" @bind="to" @bind:after="FilterChangedAsync" /></label>
        </div>
        <div class="editor-actions">
            <button type="button" class="refresh act-reload" id="bug-refresh" disabled="@busy" @onclick="LoadAsync">Actualizează</button>
            @if (canExport) { <button type="button" class="refresh act-export" id="bug-export-filter" disabled="@(busy || total == 0)" @onclick="ExportFilteredAsync">Exportă lista filtrată (ZIP)</button> }
            @if (canEdit && showClosed) { <button type="button" class="danger" id="bug-delete-all" disabled="@(busy || total == 0)" title="Șterge definitiv toate rapoartele rezolvate sau respinse" @onclick="AskDeleteAllAsync">Șterge toate cele rezolvate</button> }
        </div>

        @if (loading) { <div class="empty-state" role="status"><div class="spinner"></div><h3>Se încarcă</h3></div> }
        else if (items.Count == 0) { <p class="muted" id="bug-admin-empty">Niciun raport pentru filtrele alese.</p> }
        else
        {
            <div class="table-scroll">
                <table id="bug-admin-table">
                    <thead><tr><th>Număr</th><th>Titlu</th><th>Gravitate</th><th>Stare</th><th>Autor</th><th>Trimis</th><th>Imagini</th><th>Operații</th></tr></thead>
                    <tbody>
                        @foreach (var report in items)
                        {
                            var item = report;
                            <tr class="@(opened?.Id == item.Id ? "selected" : "")">
                                <td>@item.Number</td><td>@item.Title</td><td>@item.Severity</td><td>@item.State</td><td>@item.UserName</td>
                                <td>@BugReportRules.Display(item.CreatedUtc)</td><td>@item.FileCount</td>
                                <td class="row-actions">
                                    <button type="button" class="row-icon view" aria-label="Deschide raportul @item.Number" title="Deschide raportul @item.Number" @onclick="() => OpenAsync(item)"></button>
                                    @if (canEdit) { <button type="button" class="row-icon edit" aria-label="Editează raportul @item.Number" title="Editează raportul @item.Number" @onclick="() => OpenAsync(item, true)"></button> }
                                    @if (canExport) { <button type="button" class="row-icon export" aria-label="Exportă raportul @item.Number" title="Exportă raportul @item.Number (ZIP)" disabled="@busy" @onclick="() => ExportRowAsync(item)"></button> }
                                    @if (canEdit) { <button type="button" class="row-icon delete" aria-label="Șterge raportul @item.Number" title="Șterge raportul @item.Number" @onclick="() => AskDelete(item)"></button> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <AuditPager Id="bug-admin-size" Label="Rapoarte pe pagină" PageSizes="sizes" PageSize="pageSize" Page="page" Total="total" PageChanged="PageChangedAsync" PageSizeChanged="SizeChangedAsync" />
        }

        </div>
        @if (deleting is not null)
        {
            <div class="error-banner" role="alert" id="bug-delete-confirm">Ștergi definitiv raportul <strong>@deleting.Number</strong> („@deleting.Title”) și imaginile lui? Nu se poate anula.
                <span class="editor-actions"><button type="button" class="danger" id="bug-delete-yes" disabled="@busy" @onclick="DeleteAsync">Da, șterge</button>
                    <button type="button" class="refresh act-nav" id="bug-delete-no" @onclick="() => deleting = null">Nu, păstrează</button></span></div>
        }
@if (deletingAll)        {            <div class="error-banner" role="alert" id="bug-delete-all-confirm">Ștergi definitiv <strong>@(deleteAllCount == 1 ? "singurul raport rezolvat sau respins" : $"toate cele {deleteAllCount} rapoarte rezolvate sau respinse")</strong>, cu imaginile lor? Se șterg de pe server, nu se arhivează, și nu se pot recupera.                <span class="editor-actions"><button type="button" class="danger" id="bug-delete-all-yes" disabled="@busy" @onclick="DeleteAllAsync">Da, șterge toate</button>                    <button type="button" class="refresh act-nav" id="bug-delete-all-no" @onclick="() => deletingAll = false">Nu, păstrează</button></span></div>        }

        @if (zoomed is not null)
        {
            <ImageLightbox Src="@zoomed.Url" Title="@zoomed.Name" Closed="() => zoomed = null" />
        }

        @if (opened is not null)
        {
            <AppDialog Size="AppDialogSize.L" Floating="AnnotatorView" Title="@($"{opened.Number} · {opened.Title}")" TitleId="bug-detail-title" HelpTopic="raportare-eroare" HelpAbout="Rapoarte de eroare" OnClose="RequestClose" PanelClass="bug-detail">
                <div id="bug-detail" class="catalog-body">
                    <dl class="bug-facts">
                        <dt>Gravitate</dt><dd>@opened.Severity</dd>
                        <dt>Autor</dt><dd>@opened.UserName (@opened.UserRole)</dd>
                        <dt>Trimis</dt><dd>@BugReportRules.Display(opened.CreatedUtc) · versiunea @opened.AppVersion</dd>
                        <dt>Pagina</dt><dd>@opened.PageTitle <code>@opened.Route</code></dd>
                        <dt>Stare</dt><dd id="bug-detail-state-text">@opened.State</dd>
                    </dl>
                    <h4>Descriere</h4>
                    <p class="bug-description">@opened.Description</p>
                    <div class="bug-images" id="bug-detail-images">
                        @foreach (var picture in pictures)
                        {
                            var shown = picture;
                            <figure class="bug-image"><button type="button" class="bug-image-zoom" aria-label="Mărește imaginea @shown.Name" title="@(editing ? "Marchează zone pe imaginea " + shown.Name : "Mărește imaginea " + shown.Name)" @onclick="() => OpenPicture(shown)"><img src="@shown.Url" alt="@shown.Name" /><span class="bug-zoom-plus" aria-hidden="true">+</span></button><figcaption>@shown.Name</figcaption></figure>
                        }
                    </div>
                    <CollapsibleSection Id="bug-detail-tech" RootClass="bug-help" HeaderRowClass="collapsible-header" ToggleClass="bug-help-toggle" ContentClass="bug-help-body" Expanded="false">
                        <Header>Detalii tehnice</Header>
                        <ChildContent><pre class="bug-tech-text">@(string.IsNullOrWhiteSpace(opened.TechJson) ? "(neatașate)" : opened.TechJson)</pre></ChildContent>
                    </CollapsibleSection>
                    @if (error is not null) { <div class="error-banner" role="alert" id="bug-detail-error">@error</div> }
                    @if (confirmDiscard) { <div class="error-banner" role="alert" id="bug-detail-discard">Ai modificări nesalvate. <span class="editor-actions"><button type="button" class="danger" id="bug-detail-discard-yes" @onclick="CloseDetail">Renunț la modificări</button> <button type="button" class="refresh act-nav" id="bug-detail-discard-no" @onclick="() => confirmDiscard = false">Rămân</button></span></div> }
                    @if (editing)
                    {
                        <h4>Modificarea raportului</h4>
                        <div class="editor-grid bug-form">
                            <label class="wide">Titlu
                                <input id="bug-detail-title-input" maxlength="@BugReportRules.MaxTitle" @bind="editTitle" @bind:event="oninput" disabled="@busy" /></label>
                            <label class="wide">Descriere
                                <textarea id="bug-detail-description" rows="6" maxlength="@BugReportRules.MaxDescription" @bind="editDescription" @bind:event="oninput" disabled="@busy"></textarea></label>
                        </div>
                        <h4>Imagini adăugate acum <span class="count-badge">@added.Count</span></h4>
                        <div class="bug-images" id="bug-detail-added">
                            @foreach (var image in added)
                            {
                                var item = image;
                                <figure class="bug-image">
                                    <button type="button" class="bug-image-zoom" aria-label="Marchează zone pe imaginea @item.Name" title="Deschide imaginea mărită și marchează zone" @onclick="() => annotating = new Marking(item.Id, item.Name, item.DataUrl)"><img src="@item.DataUrl" alt="@item.Name" /><span class="bug-zoom-plus" aria-hidden="true">+</span></button>
                                    <figcaption>@item.Name</figcaption>
                                    <button type="button" class="row-icon delete" aria-label="Scoate imaginea @item.Name" title="Scoate imaginea @item.Name" disabled="@busy" @onclick="() => added.Remove(item)"></button>
                                </figure>
                            }
                        </div>
                        <div class="bug-add-images">
                            <label class="refresh act-confirm bug-file-button">Adaugă imagini…<InputFile OnChange="OnAddFilesAsync" multiple accept="image/png,image/jpeg,image/gif,image/webp" disabled="@busy" /></label>
                            <span class="muted">cel mult @BugReportRules.MaxImages imagini în total (acum @pictures.Count), fiecare de cel mult @(BugReportRules.MaxImageBytes / 1024 / 1024) MB</span>
                        </div>
                    <div class="editor-grid bug-form">
                        <label>Stare
                            <select id="bug-detail-state" @bind="newState" disabled="@(!canEdit || busy)">
                                @foreach (var item in BugReportRules.States) { <option value="@item">@item</option> }
                            </select></label>
                        <label class="wide">Notă pentru autor
                            <textarea id="bug-detail-note" rows="3" maxlength="@BugReportRules.MaxNote" @bind="note" @bind:event="oninput" disabled="@(!canEdit || busy)"></textarea></label>
                    </div>
                        <div class="editor-actions">
                            <button type="button" class="primary" id="bug-detail-save" disabled="@busy" @onclick="SaveStateAsync">@(busy ? "Se salvează…" : "Salvează starea")</button>
                            <button type="button" class="refresh act-nav" id="bug-detail-cancel" disabled="@busy" @onclick="CancelEdit">Renunță</button>
                        </div>
                    }
                    else
                    {
                        <div class="editor-actions">
                            @if (canEdit) { <button type="button" class="refresh act-edit" id="bug-detail-edit" @onclick="BeginEdit">Editează</button> }
                            @if (canExport) { <button type="button" class="refresh act-export" id="bug-detail-export" disabled="@busy" @onclick="ExportOpenedAsync">Exportă raportul (ZIP)</button> }
                            <button type="button" class="refresh act-close" id="bug-detail-close" @onclick="RequestClose">Închide raportul</button>
                        </div>
                    }
                </div>
            </AppDialog>
        }
    </div>
</section>

@code {
    private sealed record Picture(string Name, string Url);

    private readonly CancellationTokenSource lifetime = new();
    private static readonly IReadOnlyList<int> sizes = [10, 25, 50, 100];
    private IReadOnlyList<BugReport> items = [];
    private List<Picture> pictures = [];
    private Picture? zoomed;
    private BugReport? opened, deleting;
    private string state = "", severity = "", user = "", newState = BugReportRules.StateNew, note = "";
    private DateTime? from, to;
    private int page = 1, pageSize = 25, total;
    private bool loading = true, busy, canEdit, canExport, showClosed;
    private string? error, notice;
    private IJSObjectReference? downloads;

    protected override async Task OnInitializedAsync()
    {
        StartLive();
        try
        {
            canEdit = await Access.HasAsync("setari-bug-raport.edit", lifetime.Token);
            canExport = await Access.HasAsync("setari-bug-raport.export", lifetime.Token);
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        await LoadAsync();
    }

    private BugReportQuery Query => new(state.Length == 0 ? null : state, severity.Length == 0 ? null : severity, user, from is { } f ? DateOnly.FromDateTime(f) : null, to is { } t ? DateOnly.FromDateTime(t) : null, showClosed);

    private async Task OpenTabAsync(bool closed)
    {
        if (showClosed == closed) return;
        showClosed = closed; state = ""; page = 1; opened = null; deleting = null; pictures = [];
        await LoadAsync();
    }

    // A proposal / report added, changed or deleted by any session (also the dialog of this one) refreshes the table in place, without the spinner.
    private LiveRefresh? live;
    private void StartLive() => live = new LiveRefresh(ChangeFeed, Guid.NewGuid(), change => change.EntityType == AuditEntities.BugReport,
        () => InvokeAsync(async () => { await LoadAsync(silent: true); StateHasChanged(); }), () => busy, () => Task.CompletedTask, fallbackInterval: TimeSpan.FromSeconds(60));

    private Task LoadAsync() => LoadAsync(silent: false);
    private async Task LoadAsync(bool silent)
    {
        if (!silent) { loading = true; error = null; }
        try
        {
            var result = await Reports.QueryAsync(Query, page, pageSize, lifetime.Token);
            if (result.Items.Count == 0 && result.Total > 0 && page > 1) { page = Math.Max(1, (result.Total + pageSize - 1) / pageSize); result = await Reports.QueryAsync(Query, page, pageSize, lifetime.Token); }
            items = result.Items; total = result.Total;
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) when (exception is AccessDeniedException or ModuleUnavailableException or BugReportException) { error = exception.Message; }
        catch (Exception exception)
        {
            Logger.LogError("The bug reports could not be read ({ErrorType}).", exception.GetType().Name);
            error = "Rapoartele nu au putut fi citite. Încearcă din nou.";
        }
        finally { loading = false; }
    }

    private async Task FilterChangedAsync() { page = 1; await LoadAsync(); }
    private async Task PageChangedAsync(int value) { page = value; await LoadAsync(); }
    private async Task SizeChangedAsync(int value) { pageSize = value; page = 1; await LoadAsync(); }

    // Editing the content (BUG-0014): the title and the description can be corrected and more pictures added (the ones already there stay); saved with the state.
    private string editTitle = "", editDescription = "";
    private readonly List<NewImage> added = [];
    private sealed class NewImage(string name, byte[] bytes, string contentType, string? source = null)
    {
        public string Id { get; } = Guid.NewGuid().ToString("N");
        public string Name { get; private set; } = name;
        public byte[] Bytes { get; private set; } = bytes;
        public string ContentType { get; private set; } = contentType;
        /// <summary>Key of the saved picture this one is a marked copy of (null: a picture chosen from a file).</summary>
        public string? Source { get; } = source;
        public string DataUrl => $"data:{ContentType};base64,{Convert.ToBase64String(Bytes)}";
        public void Replace(byte[] marked, string type) { Bytes = marked; ContentType = type; Name = Path.ChangeExtension(Name, ".jpg"); }
    }

    // Marking zones over a picture while editing (the picture of the report stays as it is: the marked copy is added as a new picture, saved with the rest).
    private sealed record Marking(string Id, string Label, string Src);
    private Marking? annotating;
    private RenderFragment? AnnotatorView => annotating is not { } shown ? null : @<ImageAnnotator @key="shown.Id" ImageId="@shown.Id" Label="@shown.Label" Src="@shown.Src" MaxBytes="BugReportRules.MaxImageBytes" Applied="AppliedAsync" Closed="() => annotating = null" />;
    private void OpenPicture(Picture picture)
    {
        if (!editing) { zoomed = picture; return; }
        annotating = new Marking("saved-" + pictures.IndexOf(picture), picture.Name, picture.Url);
    }
    private Task AppliedAsync((string ImageId, byte[] Bytes, string ContentType) marked)
    {
        if (added.FirstOrDefault(item => item.Id == marked.ImageId || item.Source == marked.ImageId) is { } existing) { existing.Replace(marked.Bytes, marked.ContentType); return Task.CompletedTask; }
        if (pictures.Count + added.Count >= BugReportRules.MaxImages) { error = $"Poți avea cel mult {BugReportRules.MaxImages} imagini."; return Task.CompletedTask; }
        var name = annotating?.Label ?? "imagine";
        added.Add(new NewImage("marcata-" + Path.GetFileNameWithoutExtension(name) + ".jpg", marked.Bytes, marked.ContentType, marked.ImageId));
        return Task.CompletedTask;
    }

    private void StartEditing(BugReport report) { editing = true; newState = report.State; note = report.AdminNote; editTitle = report.Title; editDescription = report.Description; added.Clear(); annotating = null; }
    private bool ContentChanged => opened is not null && (editTitle.Trim() != opened.Title || editDescription.Trim() != opened.Description || added.Count > 0);

    private async Task OnAddFilesAsync(InputFileChangeEventArgs args)
    {
        error = null;
        foreach (var file in args.GetMultipleFiles(BugReportRules.MaxImages))
        {
            if (pictures.Count + added.Count >= BugReportRules.MaxImages) { error = $"Un raport poate avea cel mult {BugReportRules.MaxImages} imagini."; break; }
            if (file.Size > BugReportRules.MaxImageBytes) { error = $"Imaginea „{file.Name}” depășește {BugReportRules.MaxImageBytes / 1024 / 1024} MB."; continue; }
            try
            {
                await using var stream = file.OpenReadStream(BugReportRules.MaxImageBytes);
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer, lifetime.Token);
                var bytes = buffer.ToArray();
                if (BugReportRules.DetectImageType(bytes) is not { } type) { error = $"Fișierul „{file.Name}” nu este o imagine (PNG, JPEG, GIF sau WebP)."; continue; }
                added.Add(new NewImage(file.Name, bytes, type));
            }
            catch (Exception exception) when (exception is IOException or InvalidOperationException) { error = $"Fișierul „{file.Name}” nu a putut fi citit."; }
        }
    }

    private async Task LoadPicturesAsync(BugReport report)
    {
        pictures = [];
        foreach (var file in await Reports.GetFilesAsync(report.Id, lifetime.Token))
            if (await Reports.GetFileContentAsync(file.Id, lifetime.Token) is { } content)
                pictures.Add(new Picture(file.Kind == BugReportRules.KindScreenshot ? "Captura paginii" : file.FileName, $"data:{content.ContentType};base64,{Convert.ToBase64String(content.Content)}"));
    }

    private bool editing, confirmDiscard;
    private async Task OpenAsync(BugReport report, bool edit = false)
    {
        error = notice = null; deleting = null; editing = edit && canEdit; confirmDiscard = false;
        opened = report; newState = report.State; note = report.AdminNote; pictures = [];
        if (editing) StartEditing(report);
        try
        {
            foreach (var file in await Reports.GetFilesAsync(report.Id, lifetime.Token))
                if (await Reports.GetFileContentAsync(file.Id, lifetime.Token) is { } content)
                    pictures.Add(new Picture(file.Kind == BugReportRules.KindScreenshot ? "Captura paginii" : file.FileName, $"data:{content.ContentType};base64,{Convert.ToBase64String(content.Content)}"));
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) when (exception is AccessDeniedException or ModuleUnavailableException) { error = exception.Message; }
    }

    private void CloseDetail() { opened = null; pictures = []; zoomed = null; editing = false; confirmDiscard = false; added.Clear(); annotating = null; }
    private bool Dirty => editing && opened is not null && (newState != opened.State || note != opened.AdminNote || ContentChanged);
    private void RequestClose() { if (Dirty) confirmDiscard = true; else CloseDetail(); }
    private void BeginEdit() { if (!canEdit || opened is null) return; StartEditing(opened); }
    private void CancelEdit() { if (Dirty && !confirmDiscard) { confirmDiscard = true; return; } editing = false; confirmDiscard = false; added.Clear(); annotating = null; if (opened is not null) { newState = opened.State; note = opened.AdminNote; } }
    private Task ExportRowAsync(BugReport report) => RunAsync(() => ExportAsync([report.Id]), "Exportul nu a putut fi făcut.");
    private void AskDelete(BugReport report) { deleting = report; deletingAll = false; error = notice = null; }

    private async Task RunAsync(Func<Task> work, string failure)
    {
        if (busy) return;
        busy = true; error = null;
        try { await work(); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) when (exception is BugReportException or AccessDeniedException or ModuleUnavailableException) { error = exception.Message; }
        catch (Exception exception)
        {
            Logger.LogError("{Failure} ({ErrorType}).", failure, exception.GetType().Name);
            error = failure + " Încearcă din nou.";
        }
        finally { busy = false; }
    }

    private Task SaveStateAsync() => RunAsync(async () =>
    {
        var current = opened!;
        var contentSaved = false;
        if (ContentChanged)
        {
            current = await Reports.UpdateContentAsync(current.Id, editTitle, editDescription, [.. added.Select(item => new BugReportImage(BugReportRules.KindFile, item.Name, item.Bytes))], lifetime.Token);
            added.Clear(); annotating = null;
            await LoadPicturesAsync(current);
            contentSaved = true;
        }
        var saved = await Reports.ChangeStateAsync(current.Id, newState, note, lifetime.Token);
        opened = saved; note = saved.AdminNote; editing = false; confirmDiscard = false;
        notice = contentSaved ? $"Raportul {saved.Number} a fost modificat și este acum „{saved.State}”." : $"Raportul {saved.Number} este acum „{saved.State}”.";
        await LoadAsync();
    }, "Starea nu a putut fi salvată.");

    private bool deletingAll;
    private int deleteAllCount;
    private Task AskDeleteAllAsync() => RunAsync(async () =>
    {
        deleteAllCount = (await Reports.QueryAsync(new BugReportQuery(Closed: true), 1, 1, lifetime.Token)).Total;
        deletingAll = deleteAllCount > 0; deleting = null; notice = null;
        if (deleteAllCount == 0) notice = "Nu există rapoarte rezolvate de șters.";
    }, "Numărul rapoartelor nu a putut fi citit.");

    private Task DeleteAllAsync() => RunAsync(async () =>
    {
        var deleted = await Reports.DeleteClosedAsync(lifetime.Token);
        deletingAll = false; if (opened is not null && opened.State is BugReportRules.StateResolved or BugReportRules.StateRejected) CloseDetail();
        notice = deleted == 1 ? "A fost șters definitiv un raport rezolvat sau respins." : $"Au fost șterse definitiv {deleted} rapoarte rezolvate sau respinse.";
        page = 1;
        await LoadAsync();
    }, "Rapoartele nu au putut fi șterse.");

    private Task DeleteAsync() => RunAsync(async () =>
    {
        var gone = deleting!;
        await Reports.DeleteAsync(gone.Id, lifetime.Token);
        if (opened?.Id == gone.Id) CloseDetail();
        deleting = null;
        notice = $"Raportul {gone.Number} a fost șters.";
        await LoadAsync();
    }, "Raportul nu a putut fi șters.");

    private Task ExportOpenedAsync() => RunAsync(() => ExportAsync([opened!.Id]), "Exportul nu a putut fi făcut.");

    private Task ExportFilteredAsync() => RunAsync(async () =>
    {
        var all = await Reports.QueryAsync(Query, 1, 0, lifetime.Token);
        await ExportAsync([.. all.Items.Select(item => item.Id)]);
    }, "Exportul nu a putut fi făcut.");

    private async Task ExportAsync(IReadOnlyList<int> ids)
    {
        var export = await Reports.ExportAsync(ids, lifetime.Token);
        downloads ??= await JS.InvokeAsync<IJSObjectReference>("import", "./file-download.js");
        using var stream = new MemoryStream(export.Content);
        using var reference = new DotNetStreamReference(stream);
        await downloads.InvokeVoidAsync("downloadBinary", export.FileName, reference, "application/zip");
        notice = $"Fișierul {export.FileName} a fost descărcat ({export.Reports} {(export.Reports == 1 ? "raport" : "rapoarte")}).";
    }

    public async ValueTask DisposeAsync()
    {
        live?.Dispose();
        await DisposeCoreAsync();
    }

    private async ValueTask DisposeCoreAsync()
    {
        lifetime.Cancel();
        if (downloads is not null)
        {
            try { await downloads.DisposeAsync(); }
            catch (Exception exception) when (exception is JSDisconnectedException or JSException or InvalidOperationException) { }
        }
        lifetime.Dispose();
    }
}
