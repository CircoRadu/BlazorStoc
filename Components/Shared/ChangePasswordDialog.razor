@using BlazorStoc.Services
@inject IOwnAccountService Account
@inject ILogger<ChangePasswordDialog> Logger
@implements IDisposable
@* The window over the page where the signed-in user changes their own password: the current one first, then the new one twice. The password is never shown, kept or journaled. *@

<div class="delete-overlay" @onkeydown="KeyDown">
    <section class="delete-dialog password-dialog" role="dialog" aria-modal="true" aria-labelledby="password-dialog-title">
        <div class="dialog-head"><h2 id="password-dialog-title">Schimbă parola</h2><HelpButton Topic="schimbare-parola" About="Schimbarea parolei" /></div>
        @if (done)
        {
            <div class="success-banner" role="status">@message</div>
            <div class="editor-actions"><button type="button" class="primary" @onclick="Close">Închide</button></div>
        }
        else
        {
            <div class="anaf-grid">
                <label>Parola actuală<input id="own-password-current" type="@(showPassword ? "text" : "password")" autocomplete="current-password" maxlength="200" @bind="current" @bind:event="oninput" /></label>
            </div>
            <div class="anaf-grid password-pair">
                <label>Parola nouă<input id="own-password-new" type="@(showPassword ? "text" : "password")" autocomplete="new-password" maxlength="200" @bind="newPassword" @bind:event="oninput" /></label>
                <label>Repetă parola<input id="own-password-confirm" type="@(showPassword ? "text" : "password")" autocomplete="new-password" maxlength="200" @bind="confirmation" @bind:event="oninput" @onkeydown="InputKeyDown" /></label>
            </div>
            <ToggleSwitch Class="password-show" @bind-Value="showPassword" OnText="Parolele se văd" OffText="Parolele sunt ascunse">Arată parola</ToggleSwitch>
            <PasswordRulesList Password="@newPassword" Extra="@ExtraRules" />
            @if (message is not null) { <div class="error-banner" role="alert">@message</div> }
            <div class="editor-actions">
                <button type="button" class="primary" disabled="@(busy || !CanSave)" @onclick="SaveAsync">Schimbă parola</button>
                <button type="button" class="refresh act-close" disabled="@busy" @onclick="Close">Renunță</button>
                @if (busy) { <span class="muted" role="status">Se salvează…</span> }
            </div>
        }
    </section>
</div>

@code {
    [Parameter] public EventCallback Closed { get; set; }

    private readonly CancellationTokenSource lifetime = new();
    private bool busy, done, showPassword;
    private string current = "", newPassword = "", confirmation = "";
    private string? message;

    // The two lines that are not about the password itself: the repetition is the same, and the new one is not the current one.
    private IEnumerable<(string Text, bool Met)> ExtraRules =>
    [
        ("Parolele introduse coincid", newPassword.Length > 0 && string.Equals(newPassword, confirmation, StringComparison.Ordinal)),
        ("Diferită de parola actuală", newPassword.Length > 0 && current.Length > 0 && !string.Equals(newPassword, current, StringComparison.Ordinal))
    ];

    private bool CanSave => current.Length > 0 && PasswordPolicy.Validate(newPassword) is null && ExtraRules.All(rule => rule.Met);

    private async Task Close()
    {
        current = newPassword = confirmation = "";
        await Closed.InvokeAsync();
    }

    private async Task KeyDown(KeyboardEventArgs args) { if (args.Key == "Escape" && !busy) await Close(); }
    private async Task InputKeyDown(KeyboardEventArgs args) { if (args.Key == "Enter" && !busy && CanSave) await SaveAsync(); }

    private async Task SaveAsync()
    {
        if (busy) return;
        busy = true; message = null;
        try
        {
            var result = await Account.ChangePasswordAsync(current, newPassword, confirmation, lifetime.Token);
            if (result.Success) { done = true; current = newPassword = confirmation = ""; }
            else { message = result.Message; if (result.Message == OwnAccountService.WrongCurrentMessage) current = ""; }
            if (done) message = result.Message;
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex)
        {
            Logger.LogError("Own password change failed ({ErrorType}).", ex.GetType().Name);
            message = "Operația a eșuat. Reîncearcă; detaliile sunt în jurnalul aplicației.";
        }
        finally { busy = false; }
    }

    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
}
