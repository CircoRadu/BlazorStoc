@using BlazorStoc.Services

@* Invoice pickup, step 2: the catalog product of one row: the exact one (and where it came from), the new product prepared for it, or the closest ones to choose from. *@
@if (Match.Exact is { } exact)
{
    <div class="pickup-exact"><span class="stock-badge in-stock"><span>●</span> @ExactText(Match.Via)</span> <strong>@exact.Name</strong> <small class="muted">@exact.Description · stoc @exact.Quantity buc.</small>
        @if (Incomplete.Contains(exact.Id)) { <small class="lock-badge incomplete-badge">⚠ Parametri obligatorii necompletați: intrarea va fi refuzată. <a href="@($"/produse?edit={exact.Id}")" target="_blank" rel="noopener">Editează produsul</a> (într-o fereastră nouă), apoi reia pasul.</small> }</div>
}
else if (Staged is { } staged)
{
    <div class="pickup-exact"><span class="stock-badge low"><span>●</span> Produs nou pregătit</span> <strong>@staged.Input.Name</strong>
        <small class="muted">@staged.Input.Category / @staged.Input.Subcategory · nu e în catalog încă, se adaugă la finalizare</small>
        <button type="button" class="refresh act-edit" @onclick="OnOpenNew">Modifică</button>
        <button type="button" class="danger" @onclick="OnDiscardStaged">Renunță</button></div>
}
else if (Match.Variants is { } variants)
{
    <fieldset class="pickup-alternatives pickup-variants">
        <legend class="muted">@(Match.Note.Length > 0 ? Match.Note + " " : "")Modelul „@Match.BaseModel” are variante în catalog. Alege varianta de preluat:</legend>
        @foreach (var variant in variants)
        {
            <label class="pickup-alternative"><input type="radio" name="@("pick-" + Index)" checked="@(ProductId == variant.Id)" @onchange="() => OnPick.InvokeAsync(variant.Id)" />
                <span><strong>@variant.Name</strong> <small class="muted">@variant.Description · stoc @variant.Quantity buc.</small>
                    @if (Incomplete.Contains(variant.Id)) { <small class="lock-badge incomplete-badge">⚠ Parametri necompletați: <a href="@($"/produse?edit={variant.Id}")" target="_blank" rel="noopener">editează produsul</a></small> }</span></label>
        }
        <label class="pickup-alternative"><input type="radio" name="@("pick-" + Index)" checked="@(ProductId is null)" @onchange="() => OnNone.InvokeAsync()" /> <span>Niciuna dintre variante (rândul nu se preia)</span></label>
        <button type="button" class="refresh act-confirm" @onclick="OnOpenNew">+ Variantă nouă a modelului „@Match.BaseModel”</button>
    </fieldset>
}
else
{
    <fieldset class="pickup-alternatives">
        <legend class="muted">@(Match.Note.Length > 0 ? Match.Note : Match.Alternatives.Count == 0 ? "Niciun produs apropiat de codul „" + Match.Code + "”" : "Fără potrivire exactă pentru „" + Match.Code + "”. Alege cel mult un produs:")</legend>
        @foreach (var candidate in Match.Alternatives)
        {
            var productId = candidate.Product.Id;
            <label class="pickup-alternative"><input type="radio" name="@("pick-" + Index)" checked="@(ProductId == productId)" @onchange="() => OnPick.InvokeAsync(productId)" />
                <span><strong>@candidate.Product.Name</strong> <small class="muted">@candidate.Product.Description · stoc @candidate.Product.Quantity buc. · @((int)Math.Round(candidate.Score * 100))% asemănare</small></span></label>
        }
        <label class="pickup-alternative"><input type="radio" name="@("pick-" + Index)" checked="@(ProductId is null)" @onchange="() => OnNone.InvokeAsync()" /> <span>Niciunul dintre ele</span></label>
        <button type="button" class="refresh act-confirm" @onclick="OnOpenNew">+ Pregătește un produs nou</button>
    </fieldset>
}

@code {
    [Parameter, EditorRequired] public InvoiceProductMatch Match { get; set; } = default!;
    [Parameter] public StagedProduct? Staged { get; set; }
    [Parameter] public int? ProductId { get; set; }
    // Products with required parameters that miss a value: they cannot take a stock entry until they are completed.
    [Parameter] public IReadOnlySet<int> Incomplete { get; set; } = new HashSet<int>();
    [Parameter] public int Index { get; set; }
    [Parameter] public EventCallback<int> OnPick { get; set; }
    [Parameter] public EventCallback OnNone { get; set; }
    [Parameter] public EventCallback OnOpenNew { get; set; }
    [Parameter] public EventCallback OnDiscardStaged { get; set; }

    private static string ExactText(string via) => via switch
    {
        InvoiceProductMatcher.ViaSupplierCode => "Legat din factura anterioară a furnizorului",
        InvoiceProductMatcher.ViaName => "Cod găsit în denumire",
        _ => "Potrivire exactă"
    };
}
