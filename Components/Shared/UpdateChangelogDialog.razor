@using BlazorStoc.Services
@using BlazorStoc.Services.Update
@inject ILogger<UpdateChangelogDialog> Logger
@* Setari -> Actualizare -> Istoric -> iconita de changelog: what the versions an update went through brought (Assets/Data/changelog.txt, the same text as the notes of the
   package). Nothing is changed here. *@
<AppDialog @ref="appDialog" OnClose="() => Closed.InvokeAsync()" TitleId="update-changelog-title" HelpTopic="setari-actualizare-changelog" HelpAbout="Changelog-ul versiunii" PanelClass="save-confirmation-dialog update-changelog-dialog" OnKeyDown="KeyDownAsync"><TitleContent>Changelog · @Title</TitleContent><ChildContent>
        @if (versions.Count == 0)
        {
            <div class="empty-state" role="status"><h3>Nu există changelog pentru această versiune</h3></div>
        }
        else
        {
            @foreach (var entry in versions)
            {
                <section class="changelog-version" aria-label="@($"Versiunea {entry.Version}")">
                    <h3>Versiunea @entry.Version @if (entry.Date.Length > 0) { <small class="muted">&nbsp;· @entry.Date</small> }</h3>
                    @foreach (var group in entry.Sections)
                    {
                        @if (group.Name.Length > 0) { <h4 class="changelog-category">@group.Name</h4> }
                        <ul>
                            @foreach (var item in group.Items) { <li>@item</li> }
                        </ul>
                    }
                </section>
            }
        }
        <div class="editor-actions">
            <button type="button" class="refresh act-close" @onclick="() => Closed.InvokeAsync()">Închide</button>
        </div>
</ChildContent>
</AppDialog>

@code {
    /// <summary>The version the update started from (null when unknown) and the version it went to.</summary>
    [Parameter] public string? From { get; set; }
    [Parameter, EditorRequired] public string To { get; set; } = "";
    [Parameter, EditorRequired] public EventCallback Closed { get; set; }

    private AppDialog? appDialog;
    private IReadOnlyList<ChangelogVersion> versions = [];
    private string Title => From is not null && versions.Count > 1 ? $"{From} → {To}" : $"versiunea {To}";

    protected override void OnParametersSet() => versions = UpdateChangelog.Between(From, To);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { await appDialog!.Panel.FocusAsync(); }
        catch (JSDisconnectedException) { }
        catch (Exception exception) { Logger.LogWarning("Changelog dialog could not take focus ({ErrorType}).", exception.GetType().Name); }
    }

    private Task KeyDownAsync(KeyboardEventArgs args) => args.Key == "Escape" ? Closed.InvokeAsync() : Task.CompletedTask;
}
