@namespace BlazorStoc.Components.Shared
@inject IJSRuntime JS
@implements IAsyncDisposable
@* PROP-0009: the picture of a bug report or of a proposal shown large in a window of its own that floats over the popup (so the description of the popup stays reachable), where the
   user marks zones: rectangles numbered 1..N (at most 10), only deletable, drawn on the picture by wwwroot/image-annotate.js, which hands the marked picture back to Applied. *@
<div class="image-annotator app-dialog-frame" id="image-annotator" data-app-dialog-frame data-app-dialog-floating role="group" aria-label="@("Marcare zone pe " + Label)" @ref="root" tabindex="-1" @onkeydown="KeyAsync" @onkeydown:stopPropagation>
    <div class="delete-dialog app-dialog-panel image-annotator-panel">
        <div class="dialog-head app-dialog-head" title="Trage de bara de titlu pentru a muta fereastra"><h2>Marchează zone: @Label</h2><button type="button" class="refresh act-close" id="annotator-close" @onclick="() => Closed.InvokeAsync()">Închide</button></div>
        <div class="app-dialog-body annotator-body">
            <div class="annotator-stage" data-annotator-stage>
                <img data-annotator-image alt="@Label" draggable="false" />
                <div class="annotator-layer" data-annotator-layer></div>
            </div>
        </div>
        <div class="annotator-foot">
            <small class="muted">Trage pe imagine pentru a marca o zonă (cel mult 10); numerele se actualizează singure. Zonele se pot doar șterge, cu × din colțul zonei.</small>
            <span class="annotator-tools"><span class="annotator-zoom" role="group" aria-label="Mărire imagine"><button type="button" class="refresh act-nav" data-annotator-zoom-out id="annotator-zoom-out" title="Micșorează imaginea" aria-label="Micșorează imaginea" disabled>−</button> <span class="count-badge" data-annotator-zoom-label id="annotator-zoom-label">100%</span> <button type="button" class="refresh act-nav" data-annotator-zoom-in id="annotator-zoom-in" title="Mărește imaginea (sau Ctrl + rotița mouse-ului)" aria-label="Mărește imaginea">+</button> <button type="button" class="refresh act-nav" data-annotator-zoom-fit id="annotator-zoom-fit" title="Potrivește imaginea în fereastră" disabled>Potrivește</button></span> <span class="count-badge" data-annotator-count id="annotator-count">0 / 10 zone</span> <button type="button" class="refresh act-edit" data-annotator-undo id="annotator-undo" disabled>Șterge ultima zonă</button></span>
            <small class="error-text" data-annotator-limit hidden>Ai atins cele 10 zone: șterge una ca să marchezi alta.</small>
        </div>
        <span class="app-dialog-resize" data-app-dialog-resize aria-hidden="true" title="Trage pentru a redimensiona (dublu-clic: dimensiunea implicită)"></span>
    </div>
</div>

@code {
    /// <summary>Id of the picture of the form (the original and its zones are kept under it until the form is left).</summary>
    [Parameter, EditorRequired] public string ImageId { get; set; } = "";
    [Parameter] public string Label { get; set; } = "imagine";
    /// <summary>The picture as it is now (a data URL); used as the ORIGINAL the first time this picture is opened.</summary>
    [Parameter, EditorRequired] public string Src { get; set; } = "";
    [Parameter] public int MaxBytes { get; set; } = 8 * 1024 * 1024;
    /// <summary>The marked picture (JPEG bytes) after every change of the zones.</summary>
    [Parameter] public EventCallback<(string ImageId, byte[] Bytes, string ContentType)> Applied { get; set; }
    [Parameter] public EventCallback Closed { get; set; }

    private ElementReference root;
    private DotNetObjectReference<ImageAnnotator>? self;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        self = DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("imageAnnotate.open", root, self, ImageId, Src, MaxBytes); }
        catch (Exception exception) when (exception is JSException or InvalidOperationException or TaskCanceledException) { }
    }

    private Task KeyAsync(KeyboardEventArgs args) => args.Key == "Escape" ? Closed.InvokeAsync() : Task.CompletedTask;

    [JSInvokable("Applied")]
    public async Task AppliedAsync(IJSStreamReference picture, string contentType)
    {
        await using var stream = await picture.OpenReadStreamAsync(MaxBytes + 1);
        using var buffer = new MemoryStream();
        await stream.CopyToAsync(buffer);
        await InvokeAsync(() => Applied.InvokeAsync((ImageId, buffer.ToArray(), contentType)));
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("imageAnnotate.close", root); }
        catch (Exception exception) when (exception is JSException or InvalidOperationException or TaskCanceledException or JSDisconnectedException) { }
        self?.Dispose();
    }
}
