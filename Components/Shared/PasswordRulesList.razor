@using BlazorStoc.Services
@* The conditions of a password, one per line, checked as the user types: green when met, red otherwise. Extra lines (the repetition matches, differs from the current one) come from the caller. *@
<ul class="password-rules" aria-live="polite">
    @if (Items is null)
    {
    @foreach (var rule in PasswordPolicy.Rules)
    {
        var met = rule.Test(Password ?? "");
        <li class="@(met ? "ok" : "bad")" data-rule="@rule.Key"><span class="rule-mark" aria-hidden="true">@(met ? "✓" : "✕")</span><span>@rule.Text<span class="sr-only"> — @(met ? "îndeplinită" : "neîndeplinită")</span></span></li>
    }
    }
    else
    {
        @foreach (var (text, met) in Items)
        {
            <li class="@(met ? "ok" : "bad")"><span class="rule-mark" aria-hidden="true">@(met ? "✓" : "✕")</span><span>@text<span class="sr-only"> — @(met ? "îndeplinită" : "neîndeplinită")</span></span></li>
        }
    }
    @if (Extra is not null)
    {
        @foreach (var (text, met) in Extra)
        {
            <li class="@(met ? "ok" : "bad")"><span class="rule-mark" aria-hidden="true">@(met ? "✓" : "✕")</span><span>@text<span class="sr-only"> — @(met ? "îndeplinită" : "neîndeplinită")</span></span></li>
        }
    }
</ul>

@code {
    [Parameter] public string? Password { get; set; }
    [Parameter] public IEnumerable<(string Text, bool Met)>? Extra { get; set; }
    /// <summary>Lines of the caller instead of the rules of the web accounts (Password is then not used).</summary>
    [Parameter] public IEnumerable<(string Text, bool Met)>? Items { get; set; }
}
