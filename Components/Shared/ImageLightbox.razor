@namespace BlazorStoc.Components.Shared
@* An image shown large, over the page or over a popup: a dark overlay, the picture fitted to the window and the name under it. A click outside the picture, the button or Escape closes it
   (the close icon of the bar above any popup triggers the same button). Used by the form of a bug report and by the administrator view of the reports. *@
<div class="delete-overlay image-lightbox" role="dialog" aria-modal="true" aria-label="@Title" tabindex="-1" @ref="overlay" @onclick="() => Closed.InvokeAsync()" @onkeydown="KeyAsync">
    <div class="image-lightbox-panel" @onclick:stopPropagation="true">
        <div class="image-lightbox-head"><strong>@Title</strong><button type="button" class="refresh act-close" data-popup-close @onclick="() => Closed.InvokeAsync()">Închide</button></div>
        <img src="@Src" alt="@Title" />
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Src { get; set; } = "";
    [Parameter] public string Title { get; set; } = "Imagine";
    [Parameter] public EventCallback Closed { get; set; }

    private ElementReference overlay;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { await overlay.FocusAsync(); }
        catch (Exception exception) when (exception is JSException or InvalidOperationException or TaskCanceledException) { }
    }

    private Task KeyAsync(KeyboardEventArgs args) => args.Key == "Escape" ? Closed.InvokeAsync() : Task.CompletedTask;
}
