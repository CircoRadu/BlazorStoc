                              Description="Parametrii familiei rămân, dar fiecare devine obligatoriu separat: produsele care nu au valori pentru toți devin incomplete până li se aleg."
                              ConfirmationNote="Familia se desface; operația se înregistrează în jurnal."
                              Busy="@deleteBusy" Error="@deleteError" Confirmed="DeleteFamilyAsync" Cancelled="CancelDelete" />
}
@if (deletingParameter is not null)
{
    <DeleteConfirmationDialog @key="@($"param:{deletingParameter.Id}")" Title="Ștergi parametrul?" Subject="Parametrul" ObjectLabel="@($"{NodeName} / {deletingParameter.Name}")"
                              Description="Se șterge parametrul cu toate valorile lui. Niciun produs nu are o valoare pentru el."
                              ConfirmationNote="Parametrul și valorile lui se șterg definitiv; operația se înregistrează în jurnal."
                              Busy="@deleteBusy" Error="@deleteError" Confirmed="DeleteParameterAsync" Cancelled="CancelDelete" />
}
@if (archivingParameter is not null || archivingFamily is not null || archivingTag is not null)
{
    <ParameterArchiveDialog Title="@ArchiveTitle" ObjectLabel="@ArchiveLabel" Description="@ArchiveDescription" Affected="@(archivePreview?.Affected ?? [])" Conflicts="@(archivePreview?.Conflicts ?? [])"
                            Unused="@ArchiveUnused" CanDelete="@(archivingFamily is null && isAdministrator)" Busy="@archiveBusy" Error="@archiveError"
                            Archived="ConfirmArchiveAsync" DeleteRequested="RequestDeleteFromArchive" Cancelled="CancelArchive" />
}
@if (restoring is not null && restorePreview is not null)
{
    <ParameterRestoreDialog Title="@RestoreTitle" EmptyText="@(restoring.Tag is not null ? $"Eticheta o au {restoring.Products} produse; își recapătă On/Off-ul." : "Niciun produs nu are valori arhivate pentru această definiție.")" ObjectLabel="@($"{NodeName} / {restoring.Name}")"
                            Description="@(restoring.Tag is not null ? "Eticheta revine în lista subcategoriei, cu On/Off-ul produselor care o aveau." : "Valorile copte în modelul produselor ies din nume, iar definiția redevine obligatorie. Produsele create între timp rămân incomplete până li se aleg valorile.")"
                            Preview="restorePreview" Busy="@restoreBusy" Error="@restoreError" Confirmed="ConfirmRestoreAsync" Cancelled="CancelRestore" />
}
@if (usageRow is not null)
{
    <ParameterUsageDialog Title="Unde a fost folosit" ObjectLabel="@($"{NodeName} / {usageRow.Name}")" Entries="usageEntries" Closed="CloseUsage" />
}
@if (givingUp is not null)
{
    <DeleteConfirmationDialog @key="@($"giveup:{givingUp.Key}")" Title="Renunți definitiv la restaurare?" Subject="Definiția" ObjectLabel="@($"{NodeName} / {givingUp.Name}")"
                              Description="@($"Legăturile arhivate cu cele {givingUp.Products} produse se șterg, iar produsele rămân cu numele pe care îl au acum. Definiția ajunge în fila „Nefolosite”.")"
                              ConfirmationNote="Restaurarea nu va mai fi posibilă; operația se înregistrează în jurnal."
                              Busy="@deleteBusy" Error="@deleteError" Confirmed="GiveUpAsync" Cancelled="CancelDelete" />
}
@if (deletingArchived is not null)
{
    <DeleteConfirmationDialog @key="@($"purge:{deletingArchived.Key}")" Title="Ștergi definitiv?" Subject="Definiția" ObjectLabel="@($"{NodeName} / {deletingArchived.Name}")"
                              Description="Niciun produs nu mai folosește această definiție. Se șterge cu toate valorile ei; istoricul de utilizare rămâne în jurnal."
                              ConfirmationNote="Definiția se șterge definitiv; operația se înregistrează în jurnal."
                              Busy="@deleteBusy" Error="@deleteError" Confirmed="DeleteArchivedAsync" Cancelled="CancelDelete" />
}
@if (deletingValue is not null)
{
    <DeleteConfirmationDialog @key="@($"value:{deletingValue.Value.Value.Id}")" Title="Ștergi valoarea?" Subject="Valoarea"
                              ObjectLabel="@($"{deletingValue.Value.Parameter.Name}: {deletingValue.Value.Parameter.Display(deletingValue.Value.Value.Value)}")"
                              Description="Se poate șterge numai o valoare care nu este atașată niciunui produs."
                              ConfirmationNote="Valoarea se șterge definitiv din lista parametrului; operația se înregistrează în jurnal."
                              Busy="@deleteBusy" Error="@deleteError" Confirmed="DeleteValueAsync" Cancelled="CancelDelete" />
