@code {
    [Parameter, EditorRequired] public ProductGroup Group { get; set; } = new("", "");
    // The number of products of the subcategory (the parameters of a subcategory with products cannot be deleted).
    [Parameter] public int ProductCount { get; set; }
    [Parameter] public EventCallback Closed { get; set; }
    // Something changed that the page showing the panel may display (product names, the counts of the list).
    [Parameter] public EventCallback Changed { get; set; }

    private readonly CancellationTokenSource lifetime = new();
    private readonly string instanceId = Guid.NewGuid().ToString("N");
    private string TitleId => $"parameters-title-{instanceId}";
    // A group with no subcategory is a category: its parameters, families and tags are inherited by every subcategory under it.
    private bool ForCategory => Group.Subcategory.Length == 0;
    private string NodeName => ForCategory ? Group.Category : Group.Subcategory;
    private IReadOnlyList<SubcategoryParameter> parameters = [];
    private bool loading = true, busy, deleteBusy, isAdministrator, canEdit;
    private string? error, notice, deleteError;
    private readonly Dictionary<int, string> newValues = [], newStarts = [], newEnds = [];
    private string NewStart(int parameterId) => newStarts.TryGetValue(parameterId, out var text) ? text : "";
    private string NewEnd(int parameterId) => newEnds.TryGetValue(parameterId, out var text) ? text : "";
    private string newName = "", newUnit = "";
    private ParameterKind newKind = ParameterKind.Text;
    private SubcategoryParameter? editingParameter, deletingParameter;
    private (SubcategoryParameter Parameter, ParameterListValue Value)? editingValue, deletingValue;
    private string editName = "", editUnit = "", editReason = "";
    private ParameterKind editKind = ParameterKind.Text;
    private bool editReasonAuto = true;
    private IReadOnlyList<AuditChange>? pendingChanges;
    private string editReasonChosen = "";
    private bool SubcategoryIsEmpty => ProductCount == 0;
    private string NewValue(int parameterId) => newValues.TryGetValue(parameterId, out var text) ? text : "";
    private string EditSummary => editingParameter is null ? "" : ChangeReasonSummary.Build(
        [new("Denumire parametru", editingParameter.Name, editName), new("Unitate", editingParameter.Unit, ProductParameterRules.UsesUnit(editKind) ? editUnit : ""), new("Tip parametru", ProductParameterRules.KindLabel(editingParameter.Kind), ProductParameterRules.KindLabel(editKind))]);

    protected override async Task OnInitializedAsync()
    {
        try { isAdministrator = await Access.IsAdministratorAsync(lifetime.Token); canEdit = await Access.HasAsync("categorii.edit", lifetime.Token); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        await LoadAsync();
    }

    // ---- sections: add forms, expanded value lists ----
    private bool showAddTag, showAddFamily, showAddParameter;
    private readonly HashSet<int> expandedParameters = [];
    private void ToggleValues(int parameterId) { if (!expandedParameters.Remove(parameterId)) expandedParameters.Add(parameterId); }

    // ---- tags of the subcategory (optional, On/Off on each product) ----
    private IReadOnlyList<SubcategoryTag> tags = [];
    private SubcategoryTag? renamingTag, deletingTag;
    private string newTagName = "", renameTagText = "", renameTagReason = "";
    private bool renameTagReasonAuto = true;
    private string RenameTagSummary => renamingTag is null ? "" : ChangeReasonSummary.Build([new("Denumire etichetă", renamingTag.Name, renameTagText)]);
    private void BeginRenameTag(SubcategoryTag tag) { renamingTag = tag; renameTagText = tag.Name; renameTagReason = ""; renameTagReasonAuto = true; notice = null; error = null; }

    private Task AddTagAsync() => RunAsync(async () =>
    {
        var added = await Tags.AddTagAsync(Group, newTagName, lifetime.Token);
        newTagName = ""; showAddTag = false;
        return $"Eticheta „{added.Name}” a fost adăugată.";
    }, "Eticheta nu a putut fi adăugată.");

    private Task AddTagKeyAsync(KeyboardEventArgs args) => args.Key == "Enter" ? AddTagAsync() : Task.CompletedTask;

    private Task RenameTagAsync() => RunAsync(async () =>
    {
        var tag = renamingTag!;
        if (ChangeReasonSummary.ValidationError(renameTagReasonAuto, RenameTagSummary, renameTagReason) is { } reasonError) throw new ProductOperationException(reasonError);
        var saved = await Tags.RenameTagAsync(tag, renameTagText, ChangeReasonSummary.Chosen(renameTagReasonAuto, RenameTagSummary, renameTagReason), lifetime.Token);
        renamingTag = null;
        return $"Eticheta a fost redenumită „{saved.Name}”.";
    }, "Eticheta nu a putut fi redenumită.");

    private Task DeleteTagAsync(string reason) => RunDeleteAsync(async () =>
    {
        await Tags.DeleteTagAsync(deletingTag!, reason, lifetime.Token);
        return $"Eticheta „{deletingTag!.Name}” a fost ștearsă.";
    });

    // ---- families of parameters ----
    private IReadOnlyList<ParameterFamily> families = [];
    private ParameterFamily? editingFamily, deletingFamily;
    private string familyName = "", newFamilyName = "", familyReason = "";
    private bool familyReasonAuto = true;
    private readonly HashSet<int> familyMembers = [], newFamilyMembers = [];

    private string MemberNames(IEnumerable<int> ids) => string.Join(", ", parameters.Where(parameter => ids.Contains(parameter.Id)).Select(parameter => parameter.Name));
    private string FamilySummary => editingFamily is null ? "" : ChangeReasonSummary.Build([new("Denumire familie", editingFamily.Name, familyName),
        new("Parametri", MemberNames(editingFamily.ParameterIds), MemberNames(familyMembers))]);

    private void EditFamily(ParameterFamily family)
    {
        editingFamily = family; familyName = family.Name; familyReason = ""; familyReasonAuto = true; notice = null; error = null;
        familyMembers.Clear();
        foreach (var id in family.ParameterIds) familyMembers.Add(id);
    }

    private void SetFamilyMember(int id, bool on) { if (on) familyMembers.Add(id); else familyMembers.Remove(id); }
    private void SetNewFamilyMember(int id, bool on) { if (on) newFamilyMembers.Add(id); else newFamilyMembers.Remove(id); }

    private Task AddFamilyAsync() => RunAsync(async () =>
    {
        var added = await Parameters.CreateFamilyAsync(Group, newFamilyName, newFamilyMembers.ToList(), lifetime.Token);
        newFamilyName = ""; newFamilyMembers.Clear(); showAddFamily = false;
        return $"Familia „{added.Name}” a fost adăugată. Produsele care nu au valoare pentru niciunul dintre parametrii ei sunt incomplete până li se alege una.";
    }, "Familia nu a putut fi adăugată.");

    private Task SaveFamilyAsync() => RunAsync(async () =>
    {
        var family = editingFamily!;
        if (ChangeReasonSummary.ValidationError(familyReasonAuto, FamilySummary, familyReason) is { } reasonError) throw new ProductOperationException(reasonError);
        var saved = await Parameters.UpdateFamilyAsync(family, familyName, familyMembers.ToList(), ChangeReasonSummary.Chosen(familyReasonAuto, FamilySummary, familyReason), lifetime.Token);
        editingFamily = null;
        return $"Familia „{saved.Name}” a fost actualizată.";
    }, "Familia nu a putut fi actualizată.");

    private Task DeleteFamilyAsync(string reason) => RunDeleteAsync(async () =>
    {
        await Parameters.DeleteFamilyAsync(deletingFamily!, reason, lifetime.Token);
        return $"Familia „{deletingFamily!.Name}” a fost desfăcută.";
    });

    private async Task LoadAsync()
    {
        try
        {
            parameters = (await Parameters.GetParametersAsync(lifetime.Token))
                .Where(parameter => string.Equals(parameter.Category, Group.Category, StringComparison.OrdinalIgnoreCase)
                    && string.Equals(parameter.Subcategory, Group.Subcategory, StringComparison.OrdinalIgnoreCase)).ToList();
            tags = (await Tags.GetTagsAsync(lifetime.Token))
                .Where(tag => string.Equals(tag.Category, Group.Category, StringComparison.OrdinalIgnoreCase) && string.Equals(tag.Subcategory, Group.Subcategory, StringComparison.OrdinalIgnoreCase)).ToList();
            families = (await Parameters.GetFamiliesAsync(lifetime.Token))
                .Where(family => string.Equals(family.Category, Group.Category, StringComparison.OrdinalIgnoreCase)
                    && string.Equals(family.Subcategory, Group.Subcategory, StringComparison.OrdinalIgnoreCase)).ToList();
            await LoadArchiveAsync();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) { Logger.LogError("Parameter loading failed ({ErrorType}).", exception.GetType().Name); error = "Parametrii nu au putut fi încărcați."; }
        finally { loading = false; }
    }

    private async Task RunAsync(Func<Task<string?>> action, string failure)
    {
        if (busy) return;
        busy = true; error = null; notice = null;
        try
        {
            notice = await action();
            await LoadAsync();
            await Changed.InvokeAsync();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (ProductOperationException exception) { error = exception.Message; }
        catch (AccessDeniedException exception) { error = exception.Message; }
        catch (Exception exception) { Logger.LogError("Parameter operation failed ({ErrorType}).", exception.GetType().Name); error = failure; }
        finally { busy = false; }
    }

    private Task AddParameterAsync() => RunAsync(async () =>
    {
        var added = await Parameters.AddParameterAsync(Group, newName, newUnit, newKind, lifetime.Token);
        newName = newUnit = ""; newKind = ParameterKind.Text; showAddParameter = false;
        return $"Parametrul „{added.Name}” a fost adăugat. Produsele existente ale subcategoriei rămân blocate până li se aleg valorile.";
    }, "Parametrul nu a putut fi adăugat.");

    private Task AddValueAsync(SubcategoryParameter parameter) => RunAsync(async () =>
    {
        var text = parameter.Kind == ParameterKind.Interval ? IntervalInputs.Compose(NewStart(parameter.Id), NewEnd(parameter.Id)) : NewValue(parameter.Id);
        var added = await Parameters.AddValueAsync(parameter.Id, text, lifetime.Token);
        newValues.Remove(parameter.Id); newStarts.Remove(parameter.Id); newEnds.Remove(parameter.Id);
        return $"Valoarea „{parameter.Display(added.Value)}” a fost adăugată.";
    }, "Valoarea nu a putut fi adăugată.");

    private Task AddValueKeyAsync(KeyboardEventArgs args, SubcategoryParameter parameter) => args.Key == "Enter" ? AddValueAsync(parameter) : Task.CompletedTask;

    private void EditParameter(SubcategoryParameter parameter)
    {
        editingParameter = parameter; editName = parameter.Name; editUnit = parameter.Unit; editKind = parameter.Kind; editReason = ""; editReasonAuto = true; pendingChanges = null; notice = null; error = null;
    }

    private void CancelEditParameter() { editingParameter = null; pendingChanges = null; }

    private void RequestSaveParameter()
    {
        if (editingParameter is null) return;
        error = null;
        editReasonChosen = ChangeReasonSummary.Chosen(editReasonAuto, EditSummary, editReason);
        if (ChangeReasonSummary.ValidationError(editReasonAuto, EditSummary, editReason) is { } reasonError) { error = reasonError; return; }
        pendingChanges = SaveSummary.Changed(new("Denumire parametru", editingParameter.Name, TextNormalization.ForObjectNameOrCode(editName)),
            new("Unitate", editingParameter.Unit, ProductParameterRules.UsesUnit(editKind) ? TextNormalization.ForObjectNameOrCode(editUnit) : ""),
            new("Tip parametru", ProductParameterRules.KindLabel(editingParameter.Kind), ProductParameterRules.KindLabel(editKind)));
    }

    private async Task ConfirmSaveParameterAsync()
    {
        pendingChanges = null;
        var parameter = editingParameter;
        if (parameter is null) return;
        await RunAsync(async () =>
        {
            await Parameters.UpdateParameterAsync(parameter, editName, editUnit, editKind, editReasonChosen, lifetime.Token);
            editingParameter = null;
            return "Parametrul a fost actualizat.";
        }, "Parametrul nu a putut fi actualizat.");
    }

    private Task CancelDelete() { deletingParameter = null; deletingValue = null; deletingFamily = null; deletingTag = null; givingUp = null; deletingArchived = null; deleteError = null; return Task.CompletedTask; }

    private Task DeleteParameterAsync(string reason) => RunDeleteAsync(async () =>
    {
        await Parameters.DeleteParameterAsync(deletingParameter!, reason, lifetime.Token);
        return $"Parametrul „{deletingParameter!.Name}” a fost șters.";
    });

    private Task DeleteValueAsync(string reason) => RunDeleteAsync(async () =>
    {
        await Parameters.DeleteValueAsync(deletingValue!.Value.Value.Id, reason, lifetime.Token);
        return $"Valoarea „{deletingValue.Value.Parameter.Display(deletingValue.Value.Value.Value)}” a fost ștearsă.";
    });

    private async Task RunDeleteAsync(Func<Task<string>> delete)
    {
        if (deleteBusy) return;
        deleteBusy = true; deleteError = null;
        try
        {
            var message = await delete();
            deletingParameter = null; deletingValue = null; deletingFamily = null; deletingTag = null; givingUp = null; deletingArchived = null;
            await LoadAsync();
            notice = message;
            await Changed.InvokeAsync();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (ProductOperationException exception) { deleteError = exception.Message; }
        catch (AccessDeniedException exception) { deleteError = exception.Message; }
        catch (Exception exception) { Logger.LogError("Parameter deletion failed ({ErrorType}).", exception.GetType().Name); deleteError = "Ștergerea nu a reușit. Actualizează lista și reîncearcă."; }
        finally { deleteBusy = false; }
    }

    // ---- archive (migration 56): used definitions are archived, not deleted; the archive lists them for restoring, giving up or deleting when unused ----
    private readonly IReadOnlyList<int> pageSizes = [10, 25, 50, 0];
    private bool showUnused;
    private int retentionDays = ParameterArchiveRules.DefaultRetentionDays;

    private sealed record ArchiveRow(string Key, string Kind, string Name, string Detail, DateTime? ArchivedAt, string By, int Products,
        ArchivedParameter? Parameter, ArchivedFamily? Family, ArchivedTag? Tag)
    {
        public bool Unused => Products == 0;
        public bool HasHistory => Tag is null;
    }

    private IReadOnlyList<ArchiveRow> archiveRows = [];
    private SubcategoryParameter? archivingParameter;
    private ParameterFamily? archivingFamily;
    private SubcategoryTag? archivingTag;
    private ParameterArchivePreview? archivePreview;
    private bool archiveBusy, restoreBusy;
    private string? archiveError, restoreError;
    private ArchiveRow? restoring, usageRow, givingUp, deletingArchived;
    private ParameterRestorePreview? restorePreview;
    private IReadOnlyList<ParameterUsageEntry> usageEntries = [];

    private string ArchiveTitle => archivingFamily is not null ? "Arhivezi familia?" : archivingTag is not null ? "Arhivezi eticheta?" : "Arhivezi parametrul?";
    private string ArchiveLabel => $"{NodeName} / {archivingParameter?.Name ?? archivingFamily?.Name ?? archivingTag?.Name}";
    private bool ArchiveUnused => archivingTag is not null ? archivingTag.ProductCount == 0 : archivePreview?.Unused ?? true;
    private string ArchiveDescription => archivingTag is not null
        ? (archivingTag.ProductCount > 0
            ? $"{archivingTag.ProductCount} produse au eticheta activă. Eticheta dispare din liste și filtre, dar produsele o păstrează în arhivă și o recapătă la restaurare."
            : "Niciun produs nu are eticheta activă.")
        : ArchiveUnused
            ? string.Empty
            : "Valoarea fiecărui produs se mută în modelul lui (numele se rescrie, cum arată tabelul), iar definiția cu valorile ei rămâne în arhivă. O poți restaura oricând; la restaurare numele se refac.";
    private string RestoreTitle => restoring?.Tag is not null ? "Restaurezi eticheta?" : restoring?.Family is not null ? "Restaurezi familia?" : "Restaurezi parametrul?";

    private static bool Mine(string category, string subcategory, ProductGroup group) =>
        string.Equals(category, group.Category, StringComparison.OrdinalIgnoreCase) && string.Equals(subcategory, group.Subcategory, StringComparison.OrdinalIgnoreCase);

    private async Task LoadArchiveAsync()
    {
        var all = await Parameters.GetArchivedAsync(lifetime.Token);
        var archivedTags = await Tags.GetArchivedTagsAsync(lifetime.Token);
        retentionDays = await Settings.GetRestoreRetentionDaysAsync(lifetime.Token);
        var rows = new List<ArchiveRow>();
        foreach (var item in all.Parameters.Where(item => item.FamilyId is null && Mine(item.Category, item.Subcategory, Group)))
            rows.Add(new($"parameter:{item.Id}", "Parametru", item.Name, item.Unit, MariaTimeText.ParseOrNull(item.ArchivedUtc), item.ArchivedBy, item.ProductCount, item, null, null));
        foreach (var item in all.Families.Where(item => Mine(item.Category, item.Subcategory, Group)))
            rows.Add(new($"family:{item.Id}", "Familie", item.Name, string.Join(" · ", all.Parameters.Where(member => item.ParameterIds.Contains(member.Id)).Select(member => member.Name)),
                MariaTimeText.ParseOrNull(item.ArchivedUtc), item.ArchivedBy, item.ProductCount, null, item, null));
        foreach (var item in archivedTags.Where(item => Mine(item.Category, item.Subcategory, Group)))
            rows.Add(new($"tag:{item.Id}", "Etichetă", item.Name, "", MariaTimeText.ParseOrNull(item.ArchivedUtc), item.ArchivedBy, item.ProductCount, null, null, item));
        archiveRows = rows.OrderBy(row => row.Kind, StringComparer.CurrentCultureIgnoreCase).ThenBy(row => row.Name, StringComparer.CurrentCultureIgnoreCase).ToList();
    }

    private bool GiveUpAllowed(ArchiveRow row) => row.ArchivedAt is { } at && ParameterArchiveRules.GiveUpAllowedFrom(at, retentionDays) <= DateTime.UtcNow;
    private string GiveUpTitle(ArchiveRow row) => row.ArchivedAt is { } at && !GiveUpAllowed(row)
        ? $"Renunțarea definitivă devine posibilă din {ParameterArchiveRules.GiveUpAllowedFrom(at, retentionDays).ToLocalTime():dd.MM.yyyy}."
        : $"Renunță definitiv la restaurarea {row.Name} (produsele rămân cu numele actual)";

    private async Task BeginArchiveAsync(Func<Task> load)
    {
        error = notice = archiveError = null;
        try { await load(); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) when (exception is ProductOperationException or AccessDeniedException) { error = exception.Message; }
        catch (Exception exception) { Logger.LogError("Archive preview failed ({ErrorType}).", exception.GetType().Name); error = "Efectul arhivării nu a putut fi calculat. Reîncearcă."; }
    }

    private Task BeginArchiveParameterAsync(SubcategoryParameter parameter) => BeginArchiveAsync(async () =>
    {
        archivePreview = await Parameters.PreviewParameterArchiveAsync(parameter, lifetime.Token);
        archivingParameter = parameter;
    });

    private Task BeginArchiveFamilyAsync(ParameterFamily family) => BeginArchiveAsync(async () =>
    {
        archivePreview = await Parameters.PreviewFamilyArchiveAsync(family, lifetime.Token);
        archivingFamily = family;
    });

    private void BeginArchiveTag(SubcategoryTag tag) { error = notice = archiveError = null; archivePreview = null; archivingTag = tag; }

    private Task CancelArchive() { archivingParameter = null; archivingFamily = null; archivingTag = null; archivePreview = null; archiveError = null; return Task.CompletedTask; }

    // An unused definition can be deleted for good instead: the deletion dialog (with its own reason and confirmation word) takes over.
    private Task RequestDeleteFromArchive()
    {
        var (parameter, tag) = (archivingParameter, archivingTag);
        CancelArchive();
        deletingParameter = parameter; deletingTag = tag; deleteError = null;
        return Task.CompletedTask;
    }

    private async Task ConfirmArchiveAsync(string reason)
    {
        if (archiveBusy) return;
        archiveBusy = true; archiveError = null;
        try
        {
            if (archivingParameter is { } parameter) { await Parameters.ArchiveParameterAsync(parameter, reason, lifetime.Token); notice = $"Parametrul „{parameter.Name}” a fost arhivat."; }
            else if (archivingFamily is { } family) { await Parameters.ArchiveFamilyAsync(family, reason, lifetime.Token); notice = $"Familia „{family.Name}” a fost arhivată împreună cu parametrii ei."; }
            else if (archivingTag is { } tag) { await Tags.ArchiveTagAsync(tag, reason, lifetime.Token); notice = $"Eticheta „{tag.Name}” a fost arhivată."; }
            await CancelArchive();
            await LoadAsync();
            await Changed.InvokeAsync();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) when (exception is ProductOperationException or AccessDeniedException) { archiveError = exception.Message; }
        catch (Exception exception) { Logger.LogError("Archiving failed ({ErrorType}).", exception.GetType().Name); archiveError = "Arhivarea nu a reușit. Actualizează lista și reîncearcă."; }
        finally { archiveBusy = false; }
    }

    private async Task BeginRestoreAsync(ArchiveRow row)
    {
        error = notice = restoreError = null;
        try
        {
            restorePreview = row.Parameter is { } parameter ? await Parameters.PreviewParameterRestoreAsync(parameter, lifetime.Token)
                : row.Family is { } family ? await Parameters.PreviewFamilyRestoreAsync(family, lifetime.Token)
                : new ParameterRestorePreview([]);
            restoring = row;
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) when (exception is ProductOperationException or AccessDeniedException) { error = exception.Message; }
        catch (Exception exception) { Logger.LogError("Restore preview failed ({ErrorType}).", exception.GetType().Name); error = "Efectul restaurării nu a putut fi calculat. Reîncearcă."; }
    }

    private Task CancelRestore() { restoring = null; restorePreview = null; restoreError = null; return Task.CompletedTask; }

    private async Task ConfirmRestoreAsync(ParameterRestoreDialog.Decision decision)
    {
        if (restoreBusy || restoring is not { } row) return;
        restoreBusy = true; restoreError = null;
        try
        {
            if (row.Parameter is { } parameter) await Parameters.RestoreParameterAsync(parameter, decision.BaseModels, decision.Reason, lifetime.Token);
            else if (row.Family is { } family) await Parameters.RestoreFamilyAsync(family, decision.BaseModels, decision.Reason, lifetime.Token);
            else if (row.Tag is { } tag) await Tags.RestoreTagAsync(tag, decision.Reason, lifetime.Token);
            notice = $"„{row.Name}” a fost restaurat.";
            await CancelRestore();
            await LoadAsync();
            await Changed.InvokeAsync();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) when (exception is ProductOperationException or AccessDeniedException) { restoreError = exception.Message; }
        catch (Exception exception) { Logger.LogError("Restore failed ({ErrorType}).", exception.GetType().Name); restoreError = "Restaurarea nu a reușit. Actualizează lista și reîncearcă."; }
        finally { restoreBusy = false; }
    }

    private async Task ShowUsageAsync(ArchiveRow row)
    {
        error = notice = null;
        try
        {
            var ids = row.Parameter is { } parameter ? new[] { parameter.Id } : row.Family?.ParameterIds.ToArray() ?? [];
            usageEntries = await Parameters.GetUsageAsync(ids, lifetime.Token);
            usageRow = row;
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception exception) { Logger.LogError("Usage history failed ({ErrorType}).", exception.GetType().Name); error = "Istoricul de utilizare nu a putut fi citit."; }
    }

    private Task CloseUsage() { usageRow = null; usageEntries = []; return Task.CompletedTask; }

    private Task GiveUpAsync(string reason) => RunDeleteAsync(async () =>
    {
        var row = givingUp!;
        if (row.Parameter is { } parameter) await Parameters.GiveUpParameterRestoreAsync(parameter, reason, lifetime.Token);
        else if (row.Family is { } family) await Parameters.GiveUpFamilyRestoreAsync(family, reason, lifetime.Token);
        else if (row.Tag is { } tag) await Tags.GiveUpTagRestoreAsync(tag, reason, lifetime.Token);
        return $"S-a renunțat definitiv la restaurarea „{row.Name}”.";
    });

    private Task DeleteArchivedAsync(string reason) => RunDeleteAsync(async () =>
    {
        var row = deletingArchived!;
        if (row.Parameter is { } parameter) await Parameters.DeleteArchivedParameterAsync(parameter, reason, lifetime.Token);
        else if (row.Family is { } family) await Parameters.DeleteArchivedFamilyAsync(family, reason, lifetime.Token);
        else if (row.Tag is { } tag) await Tags.DeleteArchivedTagAsync(tag, reason, lifetime.Token);
        return $"„{row.Name}” a fost ștearsă definitiv.";
    });
    private Task CloseValueEditAsync() { editingValue = null; return Task.CompletedTask; }

    private async Task ValueChangedAsync(string message)
    {
        editingValue = null;
        await LoadAsync();
        notice = message;
        await Changed.InvokeAsync();
    }

    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
}
