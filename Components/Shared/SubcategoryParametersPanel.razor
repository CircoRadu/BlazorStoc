@using BlazorStoc.Services
@inject IProductParameterRepository Parameters
@inject IProductTagRepository Tags
@inject IAccessControl Access
@inject ICatalogSettings Settings
@inject ILogger<SubcategoryParametersPanel> Logger
@implements IDisposable

<div class="delete-overlay">
<section class="delete-dialog subcategory-parameters-dialog subcategory-parameters" role="dialog" aria-modal="true" aria-labelledby="@TitleId">
    <div class="catalog-heading"><h2 id="@TitleId">Parametri și etichete · @NodeName<span class="count-badge">@(parameters.Count + families.Count + tags.Count)</span></h2><span class="heading-actions"><HelpButton Topic="categorii-parametri" About="Parametrii și etichetele subcategoriei" /><button type="button" class="danger" @onclick="() => Closed.InvokeAsync()">Închide</button></span></div>
    @if (ForCategory) { <p class="form-note category-inheritance-note">Parametrii, familiile și etichetele categoriei se moștenesc de toate subcategoriile ei, pe toate nivelurile: produsele lor au nevoie de valorile lor, iar codul începe cu ele.</p> }
    <p class="form-note">Parametrii sunt obligatorii: un produs din această subcategorie nu poate fi salvat sau mișcat în stoc fără model și fără o valoare pentru fiecare parametru, iar codul lui devine „model - valoare - valoare”. Etichetele sunt opționale (On/Off pe produs) și devin filtre în catalog.</p>
    @if (error is not null) { <div class="error-banner" role="alert">@error</div> }
    @if (notice is not null) { <div class="success-banner" role="status">@notice</div> }
    @if (loading)
    {
        <div class="empty-state compact" role="status"><div class="spinner"></div></div>
    }
    else
    {
        @* ---- Etichete ---- *@
        <details class="def-section" id="section-tags">
            <summary><span>Etichete</span><span class="count-badge">@tags.Count</span></summary>
            <div class="def-body">
                <p class="form-note">Etichetele sunt opționale: fiecare produs al subcategoriei le are pe On sau pe Off din formularul produsului. Nu fac parte din codul produsului și nu blochează stocul.</p>
                @if (canEdit) { <div class="def-toolbar"><button type="button" class="refresh act-confirm" aria-expanded="@showAddTag.ToString().ToLowerInvariant()" disabled="@busy" @onclick="() => showAddTag = !showAddTag">Adaugă etichetă</button></div> }
                @if (showAddTag && canEdit)
                {
                    <div class="def-form">
                        <div class="editor-grid">
                            <label for="new-tag-name">Denumire etichetă *<input id="new-tag-name" maxlength="@ProductTagRules.NameMaximumLength" @bind="newTagName" @bind:event="oninput" @onkeydown="AddTagKeyAsync" disabled="@busy" autocomplete="off" placeholder="ex. PoE" /></label>
                        </div>
                        <div class="editor-actions"><button type="button" class="primary" disabled="@busy" @onclick="AddTagAsync">Adaugă eticheta</button><button type="button" class="danger" disabled="@busy" @onclick="() => showAddTag = false">Anulează</button></div>
                    </div>
                }
                @if (tags.Count == 0) { <div class="empty-state compact"><p>Subcategoria nu are etichete.</p></div> }
                else
                {
                    <div class="table-scroll"><table class="def-table"><thead><tr><th>ETICHETĂ</th><th>PRODUSE</th><th><span class="sr-only">Acțiuni</span></th></tr></thead><tbody>
                    @foreach (var tag in tags)
                    {
                        <tr @key="@($"tag:{tag.Id}")"><td><strong>@tag.Name</strong></td><td>@tag.ProductCount produse</td>
                            <td class="row-actions">
                                @if (isAdministrator)
                                {
                                    <button class="row-icon edit" disabled="@busy" aria-label="@($"Redenumește eticheta {tag.Name}")" title="@($"Redenumește eticheta {tag.Name}")" @onclick="() => BeginRenameTag(tag)"></button>
                                    <button class="row-icon archive" disabled="@busy" aria-label="@($"Arhivează eticheta {tag.Name}")" title="@($"Arhivează eticheta {tag.Name}")" @onclick="() => BeginArchiveTag(tag)"></button>
                                }
                            </td></tr>
                        @if (renamingTag?.Id == tag.Id)
                        {
                            <tr class="def-detail" @key="@($"tag-edit:{tag.Id}")"><td colspan="3"><div class="editor-grid parameter-edit">
                                <label>Denumire etichetă *<input maxlength="@ProductTagRules.NameMaximumLength" @bind="renameTagText" @bind:event="oninput" disabled="@busy" autocomplete="off" /></label>
                                <ChangeReasonField Id="tag-reason" @bind-Value="renameTagReason" AutoText="@RenameTagSummary" @bind-UseAuto="renameTagReasonAuto" Disabled="@busy" />
                            </div>
                            <div class="editor-actions"><button type="button" class="primary" disabled="@busy" @onclick="RenameTagAsync">Salvează eticheta</button><button type="button" class="danger" disabled="@busy" @onclick="() => renamingTag = null">Anulează</button></div></td></tr>
                        }
                    }
                    </tbody></table></div>
                }
                @if (!isAdministrator) { <p class="form-note">Redenumirea și arhivarea etichetelor o face administratorul.</p> }
            </div>
        </details>

        @* ---- Familii de parametri (always shown, so it can be found; its form needs at least two parameters) ---- *@
        <details class="def-section" id="section-families">
            <summary><span>Familii de parametri</span><span class="count-badge">@families.Count</span></summary>
            <div class="def-body parameter-families">
                @if (parameters.Count < ProductParameterRules.FamilyMinimumMembers && families.Count == 0)
                {
                    <p class="form-note" id="family-needs-parameters">Subcategoria are @parameters.Count @(parameters.Count == 1 ? "parametru" : "parametri"). O familie grupează cel puțin @ProductParameterRules.FamilyMinimumMembers parametri (de exemplu „Fixă” și „Varifocală” într-o familie „Lentilă”, dintre care un produs are doar unul activ): adaugă mai întâi parametrii, apoi creează familia aici.</p>
                }
                else
                {
                    <p class="form-note">O familie grupează cel puțin @ProductParameterRules.FamilyMinimumMembers parametri; un produs are exact unul dintre ei activ (de exemplu o cameră este cu lentilă fixă sau varifocală, nu ambele). Parametrii din afara familiilor rămân obligatorii. Familia ocupă în codul produsului locul primului ei parametru.</p>
                    @if (isAdministrator) { <div class="def-toolbar"><button type="button" class="refresh act-confirm" aria-expanded="@showAddFamily.ToString().ToLowerInvariant()" disabled="@busy" @onclick="() => showAddFamily = !showAddFamily">Adaugă familie</button></div> }
                    else { <p class="form-note">Familiile se creează și se modifică de administrator.</p> }
                    @if (showAddFamily && isAdministrator)
                    {
                        <div class="def-form">
                            <div class="editor-grid">
                                <label for="new-family-name">Denumire familie nouă<input id="new-family-name" maxlength="@ProductParameterRules.NameMaximumLength" @bind="newFamilyName" @bind:event="oninput" disabled="@busy" autocomplete="off" placeholder="ex. Lentilă" /></label>
                                <fieldset class="parameter-kind"><legend>Parametri în familie (cel puțin @ProductParameterRules.FamilyMinimumMembers)</legend>
                                    @foreach (var parameter in parameters.Where(item => item.FamilyId is null))
                                    {
                                        <ToggleSwitch Value="@newFamilyMembers.Contains(parameter.Id)" Disabled="@busy" ValueChanged="on => SetNewFamilyMember(parameter.Id, on)">@parameter.Name</ToggleSwitch>
                                    }
                                    @if (!parameters.Any(item => item.FamilyId is null)) { <p class="muted">Toți parametrii sunt deja în familii.</p> }
                                </fieldset>
                            </div>
                            <div class="editor-actions"><button type="button" class="primary" disabled="@(busy || newFamilyMembers.Count < ProductParameterRules.FamilyMinimumMembers)" @onclick="AddFamilyAsync">Adaugă familia</button><button type="button" class="danger" disabled="@busy" @onclick="() => showAddFamily = false">Anulează</button></div>
                        </div>
                    }
                    @if (families.Count == 0) { <div class="empty-state compact"><p>Subcategoria nu are familii de parametri.</p></div> }
                    else
                    {
                        <div class="table-scroll"><table class="def-table"><thead><tr><th>FAMILIE</th><th>PARAMETRI</th><th><span class="sr-only">Acțiuni</span></th></tr></thead><tbody>
                        @foreach (var family in families)
                        {
                            <tr class="family-card" @key="@($"family:{family.Id}")"><td><strong>@family.Name</strong></td><td>@string.Join(" · ", parameters.Where(parameter => parameter.FamilyId == family.Id).Select(parameter => parameter.Name))</td>
                                <td class="row-actions">
                                    @if (isAdministrator)
                                    {
                                        <button class="row-icon edit" disabled="@busy" aria-label="@($"Editează familia {family.Name}")" title="@($"Editează familia {family.Name}")" @onclick="() => EditFamily(family)"></button>
                                        <button class="row-icon archive" disabled="@busy" aria-label="@($"Arhivează familia {family.Name}")" title="@($"Arhivează familia {family.Name} împreună cu parametrii ei")" @onclick="() => BeginArchiveFamilyAsync(family)"></button>
                                        <button class="row-icon delete" disabled="@busy" aria-label="@($"Desfă familia {family.Name}")" title="@($"Desfă familia {family.Name} (parametrii rămân, fiecare obligatoriu separat)")" @onclick="() => { deletingFamily = family; deleteError = null; }"></button>
                                    }
                                </td></tr>
                            @if (editingFamily?.Id == family.Id)
                            {
                                <tr class="def-detail" @key="@($"family-edit:{family.Id}")"><td colspan="3"><div class="editor-grid parameter-edit">
                                    <label>Denumire familie *<input maxlength="@ProductParameterRules.NameMaximumLength" @bind="familyName" @bind:event="oninput" disabled="@busy" autocomplete="off" /></label>
                                    <fieldset class="parameter-kind"><legend>Parametri în familie * (cel puțin @ProductParameterRules.FamilyMinimumMembers)</legend>
                                        @foreach (var parameter in parameters.Where(item => item.FamilyId is null || item.FamilyId == family.Id))
                                        {
                                            <ToggleSwitch Value="@familyMembers.Contains(parameter.Id)" Disabled="@busy" ValueChanged="on => SetFamilyMember(parameter.Id, on)">@parameter.Name</ToggleSwitch>
                                        }
                                    </fieldset>
                                    <ChangeReasonField Id="family-reason" @bind-Value="familyReason" AutoText="@FamilySummary" @bind-UseAuto="familyReasonAuto" Disabled="@busy" />
                                </div>
                                <div class="editor-actions"><button type="button" class="primary" disabled="@busy" @onclick="SaveFamilyAsync">Salvează familia</button><button type="button" class="danger" disabled="@busy" @onclick="() => editingFamily = null">Anulează</button></div></td></tr>
                            }
                        }
                        </tbody></table></div>
                    }
                }
            </div>
        </details>

        @* ---- Parametri ---- *@
        <details class="def-section" id="section-parameters">
            <summary><span>Parametri</span><span class="count-badge">@parameters.Count</span></summary>
            <div class="def-body">
                <p class="form-note">Produsele deja existente ale subcategoriei rămân blocate până li se aleg valorile noilor parametri.</p>
                @if (canEdit) { <div class="def-toolbar"><button type="button" class="refresh act-confirm" aria-expanded="@showAddParameter.ToString().ToLowerInvariant()" disabled="@busy" @onclick="() => showAddParameter = !showAddParameter">Adaugă parametru</button></div> }
                @if (showAddParameter && canEdit)
                {
                    <div class="def-form">
                        <div class="editor-grid">
                            <label for="new-parameter-name">Denumire parametru *<input id="new-parameter-name" maxlength="@ProductParameterRules.NameMaximumLength" @bind="newName" @bind:event="oninput" disabled="@busy" autocomplete="off" placeholder="ex. Lentilă" /></label>
                            <fieldset class="parameter-kind" aria-describedby="new-parameter-kind-note">
                                <legend>Tip *</legend>
                                <ToggleSwitch Value="@(newKind == ParameterKind.Text)" Disabled="@busy" ValueChanged="on => newKind = on ? ParameterKind.Text : ParameterKind.Number">Text liber (ex. culoare)</ToggleSwitch>
                                <ToggleSwitch Value="@(newKind == ParameterKind.Number)" Disabled="@busy" ValueChanged="on => newKind = on ? ParameterKind.Number : ParameterKind.Text">Număr (ex. 2,8)</ToggleSwitch>
                                <ToggleSwitch Value="@(newKind == ParameterKind.Interval)" Disabled="@busy" ValueChanged="on => newKind = on ? ParameterKind.Interval : ParameterKind.Text">Interval (început și sfârșit, ex. 2,8 – 12)</ToggleSwitch>
                                <ToggleSwitch Value="@(newKind == ParameterKind.Fixed)" Disabled="@busy" ValueChanged="on => newKind = on ? ParameterKind.Fixed : ParameterKind.Text">Valoare fixă (ex. Fisheye; numai în familie)</ToggleSwitch>
                            </fieldset>
                            @if (ProductParameterRules.UsesUnit(newKind))
                            {
                                <label for="new-parameter-unit">Unitate de măsură<input id="new-parameter-unit" maxlength="@ProductParameterRules.UnitMaximumLength" @bind="newUnit" @bind:event="oninput" disabled="@busy" autocomplete="off" placeholder="ex. mm" /></label>
                            }
                        </div>
                        <div class="editor-actions"><button type="button" class="primary" disabled="@busy" @onclick="AddParameterAsync">Adaugă parametrul</button><button type="button" class="danger" disabled="@busy" @onclick="() => showAddParameter = false">Anulează</button></div>
                    </div>
                }
                @if (parameters.Count == 0) { <div class="empty-state compact"><p>Subcategoria nu are parametri obligatorii.</p></div> }
                else
                {
                    <div class="table-scroll"><table class="def-table"><thead><tr><th>PARAMETRU</th><th>TIP</th><th>UNITATE</th><th>FAMILIE</th><th>VALORI</th><th>PRODUSE</th><th><span class="sr-only">Acțiuni</span></th></tr></thead><tbody>
                    @foreach (var parameter in parameters)
                    {
                        <tr class="parameter-row" @key="@($"parameter:{parameter.Id}")">
                            <td><strong>@parameter.Name</strong></td>
                            <td>@ProductParameterRules.KindLabel(parameter.Kind)</td>
                            <td>@(parameter.Unit.Length > 0 ? parameter.Unit : "—")</td>
                            <td>@(parameter.FamilyId is { } inFamily && families.FirstOrDefault(item => item.Id == inFamily) is { } parameterFamily ? parameterFamily.Name : "—")</td>
                            <td>@parameter.Values.Count</td>
                            <td>@parameter.ProductCount produse</td>
                            <td class="row-actions">
                                <button class="row-icon view" aria-expanded="@expandedParameters.Contains(parameter.Id).ToString().ToLowerInvariant()" aria-label="@($"Valorile parametrului {parameter.Name}")" title="@($"Valorile parametrului {parameter.Name}")" @onclick="() => ToggleValues(parameter.Id)"></button>
                                @if (isAdministrator)
                                {
                                    <button class="row-icon edit" disabled="@busy" aria-label="@($"Editează parametrul {parameter.Name}")" title="@($"Editează parametrul {parameter.Name}")" @onclick="() => EditParameter(parameter)"></button>
                                    <button class="row-icon archive" disabled="@(busy || parameter.FamilyId is not null)" aria-label="@($"Arhivează parametrul {parameter.Name}")"
                                            title="@(parameter.FamilyId is not null ? "Face parte dintr-o familie: arhivează familia sau scoate parametrul din ea." : $"Arhivează parametrul {parameter.Name}")" @onclick="() => BeginArchiveParameterAsync(parameter)"></button>
                                }
                            </td>
                        </tr>
                        @if (editingParameter?.Id == parameter.Id)
                        {
                            <tr class="def-detail" @key="@($"parameter-edit:{parameter.Id}")"><td colspan="7">
                                <div class="editor-grid parameter-edit">
                                    <label>Denumire parametru *<input maxlength="@ProductParameterRules.NameMaximumLength" @bind="editName" @bind:event="oninput" disabled="@busy" autocomplete="off" /></label>
                                    <label>Tip parametru<select @bind="editKind" disabled="@(busy || parameter.Kind == ParameterKind.Fixed)"><option value="@ParameterKind.Number">Număr (ex. 2,8)</option><option value="@ParameterKind.Text">Text liber (ex. culoare)</option><option value="@ParameterKind.Interval">Interval (început și sfârșit)</option>@if (parameter.Kind == ParameterKind.Fixed) { <option value="@ParameterKind.Fixed">Valoare fixă (ex. Fisheye)</option> }</select>
                                        @if (parameter.Kind == ParameterKind.Fixed) { <small class="form-note">Valoarea fixă este denumirea parametrului: se poate redenumi doar cât timp nu există produse care o folosesc, iar tipul nu se schimbă.</small> }
                                        else { <small class="form-note">Tipul se poate schimba dacă toate valorile existente se potrivesc cu tipul nou; unitatea nu se schimbă cât timp există produse.</small> }</label>
                                    @if (ProductParameterRules.UsesUnit(editKind))
                                    {
                                        <label>Unitate de măsură<input maxlength="@ProductParameterRules.UnitMaximumLength" @bind="editUnit" @bind:event="oninput" disabled="@(busy || parameter.ProductCount > 0)" autocomplete="off" />
                                            @if (parameter.ProductCount > 0) { <small class="form-note">Unitatea face parte din codurile produselor și nu se mai schimbă.</small> }</label>
                                    }
                                    <ChangeReasonField Id="parameter-reason" @bind-Value="editReason" AutoText="@EditSummary" @bind-UseAuto="editReasonAuto" Disabled="@busy" />
                                </div>
                                <div class="editor-actions"><button type="button" class="primary" disabled="@busy" @onclick="RequestSaveParameter">Salvează parametrul</button><button type="button" class="danger" disabled="@busy" @onclick="CancelEditParameter">Anulează</button></div>
                            </td></tr>
                        }
                        @if (expandedParameters.Contains(parameter.Id))
                        {
                            <tr class="def-detail parameter-card" @key="@($"parameter-values:{parameter.Id}")"><td colspan="7">
                                @if (parameter.Kind == ParameterKind.Fixed)
                                {
                                    <p class="form-note fixed-parameter-note">Valoare unică: <strong>@parameter.Name</strong>. @(parameter.FamilyId is null ? "Parametrul lucrează numai într-o familie: adaugă-l într-o familie (împreună cu cel puțin un alt parametru), altfel nu apare la produse." : "Alegerea lui la un produs dă familiei valoarea, fără alte valori de completat.")</p>
                                }
                                else if (parameter.Values.Count == 0) { <p class="form-note">Parametrul nu are încă valori. Adaugă mai jos valorile din care se alege.</p> }
                                else
                                {
                                    <div class="table-scroll"><table><thead><tr><th>VALOARE</th><th>PRODUSE</th><th><span class="sr-only">Acțiuni</span></th></tr></thead><tbody>
                                    @foreach (var value in parameter.Values)
                                    {
                                        <tr @key="value.Id"><td><strong>@parameter.Display(value.Value)</strong></td><td>@value.ProductCount produse</td><td class="row-actions">
                                            @if (isAdministrator)
                                            {
                                                <button class="row-icon edit" disabled="@busy" aria-label="@($"Editează valoarea {parameter.Display(value.Value)}")" title="@($"Editează valoarea {parameter.Display(value.Value)}")" @onclick="() => { editingValue = (parameter, value); notice = null; }"></button>
                                            }
                                            @if (canEdit)
                                            {
                                            <button class="row-icon delete" disabled="@(busy || value.ProductCount > 0)" aria-label="@($"Șterge valoarea {parameter.Display(value.Value)}")"
                                                    title="@(value.ProductCount > 0 ? $"Folosită de {value.ProductCount} produse: nu se poate șterge." : $"Șterge valoarea {parameter.Display(value.Value)}")"
                                                    @onclick="() => { deletingValue = (parameter, value); deleteError = null; }"></button>
                                            }
                                        </td></tr>
                                    }
                                    </tbody></table></div>
                                }
                                @if (canEdit && parameter.Kind != ParameterKind.Fixed)
                                {
                                <div class="parameter-add">
                                    @if (parameter.Kind == ParameterKind.Interval)
                                    {
                                        <IntervalInputs Label="@($"Interval nou pentru {parameter.Name}")" Start="@NewStart(parameter.Id)" End="@NewEnd(parameter.Id)" Disabled="@busy"
                                                        StartChanged="value => newStarts[parameter.Id] = value" EndChanged="value => newEnds[parameter.Id] = value" KeyDown="args => AddValueKeyAsync(args, parameter)" />
                                    }
                                    else
                                    {
                                    <input aria-label="@($"Valoare nouă pentru {parameter.Name}")" maxlength="@ProductParameterRules.ValueMaximumLength" placeholder="@(parameter.Kind == ParameterKind.Number ? "Valoare nouă (număr, ex. 2,8)" : "Valoare nouă")"
                                           value="@NewValue(parameter.Id)" @oninput="args => newValues[parameter.Id] = args.Value?.ToString() ?? string.Empty" @onkeydown="args => AddValueKeyAsync(args, parameter)" disabled="@busy" autocomplete="off" />
                                    }
                                    <button type="button" class="refresh act-confirm" disabled="@busy" @onclick="() => AddValueAsync(parameter)">Adaugă valoarea</button>
                                </div>
                                }
                            </td></tr>
                        }
                    }
                    </tbody></table></div>
                }
                @if (!isAdministrator) { <p class="form-note">Valorile se pot adăuga și șterge (dacă nu sunt folosite) de orice utilizator; editarea valorilor și a parametrilor o face administratorul.</p> }
            </div>
        </details>

        @* ---- Arhivă (migration 56): archived parameters, families and tags; the unused ones can be deleted for good ---- *@
        <details class="def-section" id="section-archive">
            <summary><span>Arhivă</span><span class="count-badge">@archiveRows.Count</span></summary>
            <div class="def-body">
                <p class="form-note">Un parametru, o familie sau o etichetă folosită de produse nu se șterge: se arhivează. Valorile parametrilor arhivați rămân în numele produselor, iar la restaurare numele se refac. Ce nu mai este folosit de niciun produs poate fi șters definitiv din fila „Nefolosite”.</p>
                <div class="settings-subtabs" role="tablist" aria-label="Arhivă">
                    <button type="button" role="tab" id="archive-tab-used" class="settings-subtab @(!showUnused ? "active" : "")" aria-selected="@(!showUnused)" @onclick="() => showUnused = false">Arhivă (@archiveRows.Count(row => !row.Unused))</button>
                    <button type="button" role="tab" id="archive-tab-unused" class="settings-subtab @(showUnused ? "active" : "")" aria-selected="@showUnused" @onclick="() => showUnused = true">Nefolosite (@archiveRows.Count(row => row.Unused))</button>
                </div>
                @{ var shown = archiveRows.Where(row => row.Unused == showUnused).ToList(); }
                @if (shown.Count == 0) { <div class="empty-state compact"><p>@(showUnused ? "Nicio definiție arhivată nu este nefolosită." : "Nicio definiție folosită de produse nu este arhivată.")</p></div> }
                else
                {
                    <Paged Items="shown" Id="@($"archive-rows-{(showUnused ? "unused" : "used")}")" Label="Rânduri pe pagină" DefaultSize="10" Sizes="@pageSizes">
                        <div class="table-scroll"><table class="def-table archive-table"><thead><tr><th>TIP</th><th>DENUMIRE</th><th>ARHIVAT</th><th>DE</th><th>PRODUSE</th><th><span class="sr-only">Acțiuni</span></th></tr></thead><tbody>
                        @foreach (var row in context)
                        {
                            <tr @key="@row.Key"><td>@row.Kind</td><td><strong>@row.Name</strong>@if (row.Detail.Length > 0) { <small class="muted"> · @row.Detail</small> }</td>
                                <td>@(row.ArchivedAt is { } at ? at.ToLocalTime().ToString("dd.MM.yyyy", System.Globalization.CultureInfo.InvariantCulture) : "—")</td><td>@(row.By.Length > 0 ? row.By : "—")</td><td>@row.Products produse</td>
                                <td class="row-actions">
                                    @if (row.HasHistory)
                                    {
                                        <button class="row-icon history" disabled="@busy" aria-label="@($"Unde a fost folosit {row.Name}")" title="@($"Unde a fost folosit {row.Name}")" @onclick="() => ShowUsageAsync(row)"></button>
                                    }
                                    @if (isAdministrator)
                                    {
                                        @if (!row.Unused)
                                        {
                                            <button class="row-icon restore" disabled="@busy" aria-label="@($"Restaurează {row.Name}")" title="@($"Restaurează {row.Name} (produsele își recapătă numele)")" @onclick="() => BeginRestoreAsync(row)"></button>
                                            <button class="row-icon close giveup" disabled="@(busy || !GiveUpAllowed(row))" aria-label="@($"Renunță definitiv la restaurarea {row.Name}")"
                                                    title="@GiveUpTitle(row)" @onclick="() => { givingUp = row; deleteError = null; }"></button>
                                        }
                                        else
                                        {
                                            <button class="row-icon delete" disabled="@busy" aria-label="@($"Șterge definitiv {row.Name}")" title="@($"Șterge definitiv {row.Name}")" @onclick="() => { deletingArchived = row; deleteError = null; }"></button>
                                        }
                                    }
                                </td></tr>
                        }
                        </tbody></table></div>
                    </Paged>
                }
                @if (!isAdministrator) { <p class="form-note">Restaurarea, renunțarea la restaurare și ștergerea definitivă le face administratorul.</p> }
                else { <p class="form-note">Renunțarea definitivă la restaurare devine posibilă după @retentionDays de zile de la arhivare (se setează în Setări → Catalog); produsele rămân cu numele pe care le au.</p> }
            </div>
        </details>
    }
</section>
</div>

@if (pendingChanges is not null && editingParameter is not null)
{
    <SaveConfirmationDialog Title="Salvezi modificările parametrului?" ObjectLabel="@($"{NodeName} / {editingParameter.Name}")" Changes="pendingChanges"
                            Reason="@editReasonChosen" Confirmed="ConfirmSaveParameterAsync" Cancelled="() => { pendingChanges = null; return Task.CompletedTask; }" />
}
@if (deletingTag is not null)
{
    <DeleteConfirmationDialog @key="@($"tag:{deletingTag.Id}")" Title="Ștergi eticheta?" Subject="Eticheta" ObjectLabel="@($"{NodeName} / {deletingTag.Name}")"
                              Description="@(deletingTag.ProductCount > 0 ? $"{deletingTag.ProductCount} produse au eticheta activă și o pierd; produsele rămân neschimbate în rest." : "Niciun produs nu are eticheta activă.")"
