@using BlazorStoc.Services

@* Beneficiary and project checkboxes for stock exits: the project can be activated only after a beneficiary was chosen. *@
<div class="relation-picker">
    <div class="relation-row">
        <label class="relation-check" for="@($"{Prefix}-use-beneficiary")">
            <input id="@($"{Prefix}-use-beneficiary")" type="checkbox" checked="@UseBeneficiary" disabled="@Disabled"
                   @onchange="args => BeneficiaryToggled.InvokeAsync(args.Value is true)" /> Beneficiar</label>
        @if (UseBeneficiary)
        {
            <input type="search" class="relation-filter" placeholder="Caută beneficiar…" aria-label="Caută beneficiar"
                   value="@filter" disabled="@Disabled" @oninput="args => filter = args.Value?.ToString() ?? string.Empty" />
            <select id="@($"{Prefix}-beneficiary")" aria-label="Beneficiar" disabled="@Disabled"
                    @onchange="args => BeneficiaryChanged.InvokeAsync(ParseId(args.Value))">
                <option value="" selected="@(BeneficiaryId is null)">— alege beneficiarul —</option>
                @foreach (var beneficiary in Visible)
                {
                    <option value="@beneficiary.Id" selected="@(BeneficiaryId == beneficiary.Id)">@beneficiary.Name</option>
                }
            </select>
        }
    </div>
    <div class="relation-row">
        <label class="relation-check" for="@($"{Prefix}-use-project")">
            <input id="@($"{Prefix}-use-project")" type="checkbox" checked="@UseProject"
                   disabled="@(Disabled || !UseBeneficiary || BeneficiaryId is null)"
                   @onchange="args => ProjectToggled.InvokeAsync(args.Value is true)" /> Proiect</label>
        @if (UseProject)
        {
            <select id="@($"{Prefix}-project")" aria-label="Proiect" disabled="@Disabled"
                    @onchange="args => ProjectChanged.InvokeAsync(ParseId(args.Value))">
                <option value="" selected="@(ProjectId is null)">— alege proiectul —</option>
                @foreach (var project in Projects)
                {
                    <option value="@project.Id" selected="@(ProjectId == project.Id)">@project.Name</option>
                }
            </select>
            @if (Projects.Count == 0) { <small class="form-note">Beneficiarul ales nu are proiecte.</small> }
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Prefix { get; set; } = "";
    [Parameter] public IReadOnlyList<Beneficiary> Beneficiaries { get; set; } = Array.Empty<Beneficiary>();
    [Parameter] public IReadOnlyList<Project> Projects { get; set; } = Array.Empty<Project>();
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool UseBeneficiary { get; set; }
    [Parameter] public bool UseProject { get; set; }
    [Parameter] public int? BeneficiaryId { get; set; }
    [Parameter] public int? ProjectId { get; set; }
    [Parameter] public EventCallback<bool> BeneficiaryToggled { get; set; }
    [Parameter] public EventCallback<bool> ProjectToggled { get; set; }
    [Parameter] public EventCallback<int?> BeneficiaryChanged { get; set; }
    [Parameter] public EventCallback<int?> ProjectChanged { get; set; }
    private string filter = "";

    private IEnumerable<Beneficiary> Visible => string.IsNullOrWhiteSpace(filter)
        ? Beneficiaries
        : Beneficiaries.Where(beneficiary => beneficiary.Id == BeneficiaryId ||
                                             beneficiary.Name.Contains(filter.Trim(), StringComparison.CurrentCultureIgnoreCase));

    private static int? ParseId(object? value) => int.TryParse(value?.ToString(), out var id) ? id : null;
}
