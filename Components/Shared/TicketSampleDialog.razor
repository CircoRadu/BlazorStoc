@using BlazorStoc.Modules.ActivityImport
@* Setari -> Preluare ActivityApp, secțiunea 6: un tichet real din ActivityApp cu toate coloanele lui și valorile, ca să se vadă ce conține fiecare coloană. Deasupra: ce primește fiecare informație
   (și cum ar arăta observațiile) cu setările de pe ecran, chiar nesalvate. Fiecare coloană cu text se poate alege direct pentru o informație sau ca nou câmp suplimentar. Nimic din tichet nu se
   păstrează: se citește la cerere și se arată. *@
<div class="delete-overlay" @onkeydown="Key">
    <div class="delete-dialog template-popup review-popup ticket-sample" role="dialog" aria-modal="true" tabindex="-1" aria-labelledby="ticket-sample-title">
        <div class="catalog-heading"><h2 id="ticket-sample-title">Tichet exemplu @Sample.Number @Sample.Title</h2><span class="heading-actions"><HelpButton Topic="setari-tichet-exemplu" About="Tichetul exemplu" /><button type="button" class="danger" @onclick="() => Close.InvokeAsync()">Închide</button></span></div>
        @if (Error is not null) { <div class="error-banner" role="alert">@Error</div> }
        <div class="editor-actions">
            <button type="button" class="refresh act-nav" id="ticket-sample-older" disabled="@(Busy || !Sample.HasOlder)" title="Încarcă tichetul finalizat dinaintea celui afișat" @onclick="() => Older.InvokeAsync()">Tichet anterior</button>
            <button type="button" class="refresh act-nav" id="ticket-sample-newer" disabled="@(Busy || !HasNewer)" title="Înapoi la tichetul afișat înainte" @onclick="() => Newer.InvokeAsync()">Tichet mai nou</button>
            <span class="muted" id="ticket-sample-info">Tichet @Sample.TicketId@(Sample.TicketDate is { } date ? " din " + date.ToString("dd.MM.yyyy HH:mm") : "")@(Busy ? " · se încarcă…" : "")</span>
        </div>
        <p class="muted"><small>Dacă acest tichet are puține date, apasă „Tichet anterior”. Valorile sunt cele din ActivityApp; nimic din acest tichet nu se păstrează în BlazorStoc.</small></p>

        @if (Note is not null) { <div class="info-banner" role="status" id="ticket-sample-note">@Note</div> }

        @foreach (var table in Sample.Tables)
        {
            <h3>@table.Table</h3>
            <div class="table-scroll"><table class="catalog-table" id="@($"ticket-sample-{table.Table}")">
                <thead><tr><th>Coloana</th><th>Tip</th><th>Valoare</th><th>Folosit pentru</th><th>Folosește pentru</th></tr></thead>
                <tbody>
                @foreach (var column in table.Columns)
                {
                    <tr>
                        <td>@column.Column</td>
                        <td>@column.DataType</td>
                        <td class="review-text">@(column.Value is { Length: > 0 } value ? value : "—")</td>
                        <td>@UsedByCached(table.Table, column.Column)</td>
                        <td>
                            @if (column.IsText)
                            {
                                @if (editing == (table.Table, column.Column))
                                {
                                    <select aria-label="@($"Folosește coloana {column.Column} pentru")" value="" disabled="@Busy" @onchange="args => Choose(table.Table, column.Column, args.Value?.ToString())" @onblur="StopEditing">
                                        <option value="">— alege —</option>
                                        @foreach (var target in TargetsOf(table.Table)) { <option value="@target.Key">@ActivityFieldMap.TablePrefix(table.Table) – @target.Label</option> }
                                        @foreach (var extra in Extras)
                                        {
                                            <option value="@("x:" + extra.Key)">@ActivityFieldMap.TablePrefix(extra.Table) – @extra.Label (câmp suplimentar@(Extras.Count(other => other.Label == extra.Label) > 1 ? ", " + extra.Column : ""))</option>
                                        }
                                        <option value="extra">+ Câmp suplimentar nou…</option>
                                    </select>
                                }
                                else
                                {
                                    <button type="button" class="refresh act-confirm" disabled="@Busy" aria-label="@($"Alege pentru ce folosești coloana {column.Column}")" @onclick="() => StartEditing(table.Table, column.Column)">Alege…</button>
                                }
                            }
                            else { <span class="muted">nu are text</span> }
                        </td>
                    </tr>
                }
                </tbody>
            </table></div>
        }

        <h3>Sumar: ce se preia din ActivityApp</h3>
        @if (preview is null) { <p class="muted" role="status">Setările de pe ecran nu sunt valide: @Problem</p> }
        else
        {
            <p class="muted"><small>Informațiile așa cum se preiau cu corespondența de pe ecran (chiar nesalvată), cu valorile acestui tichet.</small></p>
            <div class="table-scroll"><table class="catalog-table" id="ticket-sample-preview">
                <thead><tr><th>Informație</th><th>Citită din</th><th>Valoare din acest tichet</th><th>Merge în</th></tr></thead>
                <tbody>
                @foreach (var item in preview.Items)
                {
                    <tr>
                        <td>@item.Label</td>
                        <td>@(item.Source.Length > 0 ? item.Source : "—")</td>
                        <td class="review-text">@(item.Target == "oprit" ? "—" : item.Value.Length > 0 ? item.Value : "—")</td>
                        <td>@TargetText(item.Target)</td>
                    </tr>
                }
                </tbody>
            </table></div>
            <h3>Observațiile intervenției, așa cum ajung în aplicația de stoc</h3>
            <pre class="review-text" id="ticket-sample-notes">@preview.Notes</pre>
        }
    </div>
</div>

@if (adding is { } add)
{
    <div class="delete-overlay" @onkeydown="AddKey">
        <div class="delete-dialog template-popup" role="dialog" aria-modal="true" tabindex="-1" aria-labelledby="ticket-sample-extra-title" id="ticket-sample-extra">
            <div class="catalog-heading"><h2 id="ticket-sample-extra-title">Câmp suplimentar nou</h2></div>
            <div class="catalog-body">
                <p class="muted"><small>Coloana <strong>@ActivityFieldMap.ColumnName(add.Table, add.Column)</strong> se preia ca un câmp separat, sub numele ales. Numele nu trebuie să fie unic.</small></p>
                <div class="anaf-grid">
                    <label>Nume afișat<input id="ticket-sample-extra-name" aria-label="Numele câmpului suplimentar" maxlength="@ActivityFieldMap.MaximumLabel" value="@addName" @oninput="TypeName" autocomplete="off" /></label>
                    <label>Se atașează ca
                        <select aria-label="Se atașează câmpul suplimentar ca" @bind="addTarget">
                            <option value="@ActivityFieldMap.Notes">În observații</option>
                            <option value="@ActivityFieldMap.Separate">Câmp separat</option>
                            <option value="@ActivityFieldMap.Both">Observații și câmp separat</option>
                        </select>
                    </label>
                </div>
                <div class="editor-actions">
                    <button type="button" class="refresh act-confirm" id="ticket-sample-extra-add" disabled="@(addName.Trim().Length == 0)" @onclick="ConfirmAdd">Adaugă câmpul</button>
                    <button type="button" class="refresh act-close" @onclick="CancelAdd">Renunță</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>An information that is read from a column: its key, its name and the table the column is in.</summary>
    public sealed record SampleTarget(string Key, string Label, string Table);

    /// <summary>The column chosen in the window: the table, the column and what it is chosen for (the key of an information; "x:" and the key of an extra field already there, which moves to the column;
    /// or "extra" for a new extra field, with its Name and Target).</summary>
    public sealed record SampleAssignment(string Table, string Column, string For, string Name = "", string Target = "");

    [Parameter, EditorRequired] public TicketSample Sample { get; set; } = null!;
    /// <summary>What the last choice changed besides the column itself (an information that gave its column up).</summary>
    [Parameter] public string? Note { get; set; }
    [Parameter] public ActivityFieldMap? Map { get; set; }
    [Parameter] public string? Problem { get; set; }
    [Parameter] public IReadOnlyList<SampleTarget> Targets { get; set; } = [];
    [Parameter] public bool HasNewer { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback Older { get; set; }
    [Parameter] public EventCallback Newer { get; set; }
    [Parameter] public EventCallback Close { get; set; }
    [Parameter] public EventCallback<SampleAssignment> Assign { get; set; }

    private SamplePreview? preview;
    private Dictionary<string, string> usedBy = [];
    private Dictionary<string, List<SampleTarget>> targetsByTable = [];
    private string signature = "";
    private TicketSample? lastSample;
    private bool dirty = true;

    // The parent rebuilds Map and Targets on every one of its renders, which would re-send this whole window
    // (hundreds of rows with a list each) over the connection each time; it is drawn again only when what it shows changed.
    protected override void OnParametersSet()
    {
        preview = Map is null ? null : ActivityTicketSampleRules.Preview(Sample, Map);
        targetsByTable = Targets.GroupBy(item => item.Table).ToDictionary(group => group.Key, group => group.ToList());
        usedBy = [];
        foreach (var table in Sample.Tables)
            foreach (var column in table.Columns)
                if (column.IsText) usedBy[table.Table + "\u0001" + column.Column] = UsedBy(table.Table, column.Column);
        var text = new System.Text.StringBuilder();
        text.Append(Busy).Append('|').Append(Error).Append('|').Append(Problem).Append('|').Append(HasNewer).Append('|').Append(Sample.Number).Append('|').Append(Sample.Title).Append('|').Append(Sample.TicketId);
        text.Append('|').Append(Note);
        foreach (var extra in Extras) text.Append('|').Append(extra.Key).Append(':').Append(extra.Label);
        foreach (var target in Targets) text.Append('|').Append(target.Key).Append(':').Append(target.Label);
        foreach (var pair in usedBy) text.Append('|').Append(pair.Key).Append('=').Append(pair.Value);
        if (preview is not null)
        {
            foreach (var item in preview.Items) text.Append('|').Append(item.Label).Append('=').Append(item.Target).Append('=').Append(item.Source).Append('=').Append(item.Value);
            text.Append('|').Append(preview.Notes);
        }
        var changed = !ReferenceEquals(lastSample, Sample) || text.ToString() != signature;
        lastSample = Sample;
        signature = text.ToString();
        if (changed) dirty = true;
    }

    protected override bool ShouldRender()
    {
        if (!dirty) return false;
        dirty = false;
        return true;
    }

    private IReadOnlyList<SampleTarget> TargetsOf(string table) => targetsByTable.TryGetValue(table, out var list) ? list : [];

    private string UsedByCached(string table, string column) => usedBy.TryGetValue(table + "\u0001" + column, out var text) ? text : "—";

    private static string TargetText(string target) => target switch
    {
        "oprit" => "oprit",
        ActivityFieldMap.Notes => "observații",
        ActivityFieldMap.Separate => "câmp separat",
        _ => "observații și câmp separat"
    };

    // The pieces of information (and extra fields) that read this column with the settings on the screen.
    private string UsedBy(string table, string column)
    {
        if (Map is null) return "—";
        var names = new List<string>();
        foreach (var target in Targets.Where(item => item.Table == table))
        {
            var field = ActivityFieldMap.Fields.FirstOrDefault(item => item.Table == table && ActivityFieldMap.ItemOf(target.Key)?.FieldKey == item.Key);
            if (field is not null && Map.ColumnOf(field).Equals(column, StringComparison.OrdinalIgnoreCase) && Map.IsEnabled(target.Key)) names.Add(Map.LabelOf(target.Key));
        }
        names.AddRange(Map.Extras.Where(extra => extra.Table == table && extra.Column.Equals(column, StringComparison.OrdinalIgnoreCase)).Select(extra => extra.Label));
        return names.Count == 0 ? "—" : string.Join(", ", names);
    }

    // Only the row being chosen for draws its list; the other rows show a button, so the window stays light.
    private (string Table, string Column)? editing;

    private void StartEditing(string table, string column) { editing = (table, column); dirty = true; }

    private void StopEditing() { if (editing is null) return; editing = null; dirty = true; }

    private IReadOnlyList<ActivityExtraField> Extras => Map?.Extras ?? [];

    private Task Choose(string table, string column, string? value)
    {
        editing = null;
        dirty = true;
        if (string.IsNullOrEmpty(value)) return Task.CompletedTask;
        if (value == "extra")
        {
            adding = (table, column);
            addName = column; addTarget = ActivityFieldMap.Both;
            return Task.CompletedTask;
        }
        return Assign.InvokeAsync(new SampleAssignment(table, column, value));
    }

    // The window of a new extra field: the column is the one chosen, the name and the destination are typed here.
    private (string Table, string Column)? adding;
    private string addName = "", addTarget = ActivityFieldMap.Both;

    private void TypeName(ChangeEventArgs args) { addName = args.Value?.ToString() ?? ""; dirty = true; }

    private void CancelAdd() { adding = null; dirty = true; }

    private Task ConfirmAdd()
    {
        if (adding is not { } add || addName.Trim().Length == 0) return Task.CompletedTask;
        adding = null;
        dirty = true;
        return Assign.InvokeAsync(new SampleAssignment(add.Table, add.Column, "extra", addName.Trim(), addTarget));
    }

    private Task AddKey(KeyboardEventArgs args) { if (args.Key == "Escape") CancelAdd(); return Task.CompletedTask; }

    private Task Key(KeyboardEventArgs args) => args.Key == "Escape" && adding is null ? Close.InvokeAsync() : Task.CompletedTask;
}
