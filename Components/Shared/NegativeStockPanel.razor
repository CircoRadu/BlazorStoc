@using BlazorStoc.Services
@* A product with negative stock: that cannot exist physically, it is an operating error. Before the next entry the user states the real quantity in
   the warehouse (or sets the stock to zero); a correction entry then brings the stock there (see IStockMovementRepository.RegularizeNegativeStockAsync). *@
<div class="invoice-warning negative-stock-panel" role="alert">
    <p>⚠ @StockMovementRules.NegativeStockWarning(Stock)</p>
    <div class="movement-kind">
        <button type="button" class="settings-tab @(Resolution.Zero ? "active" : "")" aria-pressed="@Resolution.Zero" disabled="@Disabled" @onclick="ChooseZeroAsync">Trec stocul pe 0</button>
        <label class="negative-stock-real">Cantitate reală în depozit
            <input type="number" inputmode="numeric" step="1" min="0" max="@StockMovementRules.MaxQuantity" disabled="@Disabled" placeholder="introdu cantitatea"
                   aria-invalid="@(invalid ? "true" : null)" value="@(Resolution.Zero ? "" : Resolution.Real?.ToString(System.Globalization.CultureInfo.InvariantCulture))" @oninput="RealInputAsync" /></label>
    </div>
    @if (invalid)
    {
        <div class="validation-message" role="alert">@StockMovementRules.RealQuantityMessage</div>
    }
    @if (Resolution.IsResolved)
    {
        <small class="form-note" role="status">Depozitul va avea @Resolution.RealQuantity buc. după o intrare de corecție, făcută înainte de intrarea nouă.</small>
    }
</div>

@code {
    [Parameter, EditorRequired] public NegativeStockResolution Resolution { get; set; } = new();
    // Current stock of the product (negative).
    [Parameter] public int Stock { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    // A negative or non-integer quantity cannot be the real quantity of a warehouse: it is flagged at once and the regularization stays off.
    // The value is read on every keystroke, so a valid quantity activates "Regularizează" without leaving the field.
    private bool invalid;

    private async Task ChooseZeroAsync() { Resolution.Zero = true; Resolution.Real = null; invalid = false; await Changed.InvokeAsync(); }

    private async Task RealInputAsync(ChangeEventArgs args)
    {
        var text = args.Value?.ToString()?.Trim() ?? "";
        Resolution.Zero = false;
        if (text.Length == 0) { Resolution.Real = null; invalid = false; }
        else if (int.TryParse(text, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var value))
        {
            Resolution.Real = value;
            invalid = value is < 0 or > StockMovementRules.MaxQuantity;
        }
        else { Resolution.Real = null; invalid = true; }
        await Changed.InvokeAsync();
    }
}
