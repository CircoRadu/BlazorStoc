@code {
    private sealed class Row(ActivityTypeItem item)
    {
        public long Id { get; } = item.Id;
        public string Name { get; } = item.Name;
        public string Category { get; } = item.Category;
        public int? Resolved { get; } = item.Resolved;
        public int? Open { get; } = item.Open;
        public int? Deleted { get; } = item.Deleted;
        public string State { get; } = item.State;
        public bool Selected { get; set; } = item.Selected;
        public string Destination { get; set; } = item.Destination;
    }

    private readonly CancellationTokenSource lifetime = new();
    private bool loading = true, busy, noticeOk, hasPassword, enabled, fillEmpty;
    private string? error, notice, busyText, typesError, runArea;
    private bool showPassword;
    private string server = "", database = "TIPActivity", user = "", password = "";
    private int port = 1433, fromHour, toHour = 24, pageSize = 200;
    private DateOnly? since;
    private ActivityImportSettings current = new(false, "", 1433, "TIPActivity", "", false, null, 0, 24, 200, false, null, null, "", StructureStatus.Unchecked, "", [], null, "", null);
    // The table of a group of ticket types (the same columns in both groups).
    private RenderFragment TypesTable(List<Row> rows, string tableId) => __builder =>
    {
        <div class="table-scroll"><table class="catalog-table" id="@tableId">
            <thead><tr><th>Alege</th><th>Cod</th><th>Tip de tichet</th><th>Categorie</th><th>Rezolvate</th><th>Deschise</th><th>Șterse</th><th>Destinație</th><th>Stare</th></tr></thead>
            <tbody>
            @foreach (var item in rows)
            {
                <tr @key="item.Id">
                    <td><ToggleSwitch Compact AriaLabel="@($"Preia tipul {item.Name}")" @bind-Value="item.Selected" Disabled="@(item.State == ActivityImportRules.StateMissing)" /></td>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Category</td>
                    <td>@Count(item.Resolved)</td>
                    <td>@Count(item.Open)</td>
                    <td>@Count(item.Deleted)</td>
                    <td><select aria-label="@($"Destinația tipului {item.Name}")" @bind="item.Destination"><option value="@ActivityDestination.OnDemand">La cerere</option><option value="@ActivityDestination.Maintenance">De mentenanță</option></select></td>
                    <td>@item.State</td>
                </tr>
            }
            </tbody>
        </table></div>
    };

    private List<Row>? types;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Apply(await Import.GetSettingsAsync(lifetime.Token));
            await LoadImportStateAsync();
            // The types saved are shown at once (without asking ActivityApp); "Citește tipurile din ActivityApp" refreshes them with the counts and the new types.
            var saved = await Import.GetSavedTypesAsync(lifetime.Token);
            if (saved.Items.Count > 0) types = [.. saved.Items.Select(item => new Row(item))];
            // The saved correspondence of the fields is shown at once too (the column lists come with "Citește coloanele din ActivityApp").
            Show(await Import.GetFieldChoicesAsync(false, lifetime.Token));
            await CountOutdatedAsync();
        }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (AccessDeniedException ex) { error = ex.Message; }
        catch (Exception ex) { Logger.LogError("ActivityApp import settings loading failed ({ErrorType}).", ex.GetType().Name); error = "Setările nu au putut fi încărcate. Verifică conexiunea la baza de date."; }
        finally { loading = false; }
    }

    private void Apply(ActivityImportSettings settings)
    {
        current = settings; enabled = settings.Enabled; server = settings.Server; port = settings.Port; database = settings.Database; user = settings.User; hasPassword = settings.HasPassword;
        since = settings.SinceDate ?? settings.EffectiveSince(DateOnly.FromDateTime(DateTime.Now)); fromHour = settings.WindowFromHour; toHour = settings.WindowToHour; pageSize = settings.PageSize;
        fillEmpty = settings.FillEmptyFields; syncEnabled = settings.SyncEnabled; syncHours = settings.SyncIntervalMinutes / 60; syncMinutes = settings.SyncIntervalMinutes % 60; syncMode = settings.SyncMode; syncTimes = settings.SyncTimes; takePartners = settings.TakePartners; autoAcceptPartners = settings.AutoAcceptPartners; password = "";
    }

    private ActivityImportInput Input => new(enabled, server, port, database, user, string.IsNullOrEmpty(password) ? null : password, since, fromHour, toHour, pageSize, fillEmpty, syncEnabled, syncHours * 60 + syncMinutes, syncMode, syncTimes, takePartners, autoAcceptPartners);

    private static string Count(int? value) => value?.ToString() ?? "—";

    private async Task RunAsync(string working, Func<Task> action, string area = "")
    {
        if (busy) return;
        busy = true; busyText = working; error = null; notice = null; runArea = area;
        try { await action(); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
        catch (Exception ex) when (ex is ActivityImportException or ActivitySourceException or AccessDeniedException) { error = ex.Message; }
        catch (Exception ex) { Logger.LogError("ActivityApp import action failed ({ErrorType}).", ex.GetType().Name); error = "Operația a eșuat. Reîncearcă; detaliile sunt în jurnalul aplicației."; }
        finally { busy = false; }
    }

    private Task SaveAsync() => RunAsync("Se salvează…", async () =>
    {
        await Import.SaveSettingsAsync(Input, lifetime.Token);
        Apply(await Import.GetSettingsAsync(lifetime.Token));
        noticeOk = true; notice = "Setările au fost salvate." + (enabled ? "" : " Preluarea este inactivă.");
    });

    private Task TestAsync() => RunAsync("Se testează conexiunea…", async () =>
    {
        var result = await Import.TestAsync(Input, lifetime.Token);
        Apply(await Import.GetSettingsAsync(lifetime.Token));
        noticeOk = result.Ok; notice = result.Message;
    });

    private Task LoadTypesAsync() => RunAsync("Se citesc tipurile…", async () =>
    {
        var view = await Import.GetTypesAsync(lifetime.Token);
        typesError = view.SourceError;
        types = [.. view.Items.Select(item => new Row(item))];
        Apply(await Import.GetSettingsAsync(lifetime.Token));
    });

    private Task SaveTypesAsync() => RunAsync("Se salvează alegerea…", async () =>
    {
        await Import.SaveTypesAsync([.. types!.Select(row => new ActivityTypeChoice(row.Id, row.Name, row.Selected, row.Destination))], lifetime.Token);
        var view = await Import.GetTypesAsync(lifetime.Token);
        typesError = view.SourceError;
        types = [.. view.Items.Select(item => new Row(item))];
        noticeOk = true; notice = "Alegerea tipurilor a fost salvată.";
    });

    private ImportReport? report;
    private ImportRunInfo? lastRun;
    private bool confirmApply;

    private async Task LoadImportStateAsync()
    {
        try
        {
            lastRun = await Partners.GetLastRunAsync(lifetime.Token);
        }
        catch (AccessDeniedException) { }
    }

    private Task SimulateAsync() => RunAsync("Se simulează importul…", async () =>
    {
        confirmApply = false;
        report = await Partners.SimulateAsync(lifetime.Token);
        await LoadImportStateAsync();
        noticeOk = true; notice = "Simularea s-a terminat; nu s-a scris nimic.";
    }, "partners");

    private Task ApplyAsync() => RunAsync("Se aplică importul…", async () =>
    {
        confirmApply = false;
        var progress = new Progress<string>(text => { busyText = text; _ = InvokeAsync(StateHasChanged); });
        report = await Partners.ApplyAsync(progress, lifetime.Token);
        await LoadImportStateAsync();
        noticeOk = true; notice = $"Import aplicat: {report.Partners.Create} beneficiari și {report.Points.Create} puncte de lucru create, {report.Partners.Problems + report.Points.Problems} probleme." + (report.AnafFilled > 0 ? $" Completați din ANAF: {report.AnafFilled}." : "") + (report.AnafUnverified > 0 ? $" Neverificați în ANAF: {report.AnafUnverified}." : "");
    }, "partners");

    private Task IncludeAsync(long partnerId, bool asCompany) => RunAsync("Se include partenerul…", async () =>
    {
        await Partners.IncludeAsync(partnerId, asCompany, lifetime.Token);
        confirmApply = false;
        report = await Partners.SimulateAsync(lifetime.Token);
        await LoadImportStateAsync();
        noticeOk = true; notice = "Partenerul a fost inclus în preluare (neverificat, preluat manual); apare în lista de preluat. Tichetele lui se preiau după „Recitește tot”.";
    }, "partners");

    private TicketReport? ticketReport;
    private bool confirmTickets;

    private sealed class Paging { public int Size = 25, Page = 1; }
    private static readonly int[] planPageSizes = [10, 25, 50, 100, 0];
    private readonly Paging takenPaging = new(), ignoredPaging = new(), ticketProblemsPaging = new(), ticketWaitingPaging = new(), ticketTakenPaging = new(), ticketIgnoredPaging = new();

    private RenderFragment PlanTable(List<ImportReportItem> all, string id, bool applied, Paging? paging = null, bool includable = false, bool entity = true) => __builder =>
    {
        var pages = paging is null || paging.Size == 0 ? 1 : Math.Max(1, (all.Count + paging.Size - 1) / paging.Size);
        var current = paging is null ? 1 : Math.Clamp(paging.Page, 1, pages);
        var items = paging is null || paging.Size == 0 ? all : all.Skip((current - 1) * paging.Size).Take(paging.Size).ToList();
        <div class="table-scroll"><table class="catalog-table" id="@id">
            <thead><tr>@if (entity) { <th>Ce</th> }<th>Cod ActivityApp</th><th>@(entity ? "Denumire" : "Tichet")</th><th>Rezultat</th><th>Motiv</th>@if (includable) { <th>Include în preluare</th> }</tr></thead>
            <tbody>
            @foreach (var item in items)
            {
                <tr>@if (entity) { <td>@EntityLabel(item.Entity)</td> }<td>@item.SourceId</td><td>@item.Name</td><td>@ActionLabel(item, applied)</td><td>@item.Message</td>
                    @if (includable)
                    {
                        <td>@if (item.Entity == "partner" && !applied)
                            {
                                <button type="button" class="refresh act-confirm" disabled="@busy" aria-label="@($"Include partenerul {item.Name} ca persoană fizică")" @onclick="() => IncludeAsync(item.SourceId, false)">Ca persoană fizică</button>
                                <button type="button" class="refresh act-confirm" disabled="@busy" aria-label="@($"Include partenerul {item.Name} ca persoană juridică")" @onclick="() => IncludeAsync(item.SourceId, true)">Ca persoană juridică</button>
                            }</td>
                    }
                </tr>
            }
            </tbody>
        </table></div>
        if (paging is not null)
        {
            <AuditPager Id="@(id + "-page-size")" Label="Rânduri pe pagină" PageSizes="planPageSizes" PageSize="paging.Size" Page="current" Total="all.Count"
                        PageChanged="page => paging.Page = page" PageSizeChanged="size => { paging.Size = size; paging.Page = 1; }" />
        }
    };

    private static string ActionLabel(ImportReportItem item, bool applied) => item.Action switch
    {
        "Problem" => "Problemă",
        "Create" when item.Message.Contains("De verificat", StringComparison.Ordinal) => applied ? "Creat, de verificat" : "De creat, de verificat",
        "Create" => applied ? "Creat" : "De creat",
        "Link" => applied ? "Legat de existent" : "De legat de existent",
        "Waiting" => "În așteptare",
        _ => "Ignorat"
    };

    private static string EntityLabel(string entity) => entity switch { "partner" => "Partener", "ticket" => "Tichet", "partner-deleted" => "Partener șters în ActivityApp", "workpoint-deleted" => "Punct de lucru șters în ActivityApp", "ticket-deleted" => "Tichet șters în ActivityApp", _ => "Punct de lucru" };

    private static string KindLabel(string kind) => kind switch
    {
        "apply" => "aplicare beneficiari și puncte de lucru", "tickets-apply" => "aplicare tichete", "tickets-simulation" => "simulare tichete", _ => "simulare beneficiari și puncte de lucru"
    };

    private Task SimulateTicketsAsync() => RunAsync("Se simulează tichetele…", async () =>
    {
        confirmTickets = false;
        ticketReport = await Tickets.SimulateAsync(lifetime.Token);
        await LoadImportStateAsync();
        noticeOk = true; notice = "Simularea tichetelor s-a terminat; nu s-a scris nimic.";
    });

    private Task ApplyTicketsAsync() => RunAsync("Se preiau tichetele…", async () =>
    {
        confirmTickets = false;
        var progress = new Progress<string>(text => { busyText = text; _ = InvokeAsync(StateHasChanged); });
        ticketReport = await Tickets.ApplyAsync(progress, lifetime.Token);
        await LoadImportStateAsync();
        noticeOk = true; notice = $"Tichete puse la validare: {ticketReport.Tickets.Create} (Notificări, „Tichete de validat”), {ticketReport.Tickets.Problems} probleme.";
    });

    private sealed class FieldRow(ActivityInfoItem item, ActivityFieldChoice? choice, bool enabled, string target)
    {
        public ActivityInfoItem Item { get; } = item;
        // The name shown for the piece of information (editable for the optional ones).
        public string Label { get; set; } = item.Label;
        public bool Enabled { get; set; } = item.Mandatory || enabled;
        public string Target { get; set; } = target;
        public string DefaultColumn { get; } = choice?.Field.Column ?? "";
        public bool Missing { get; } = choice?.CurrentMissing ?? false;
        // Null for a piece that is not read from a column of its own (the resolution comes from the problem and the report).
        public string? Column { get; set; } = choice?.Current;
        public string? FieldKey => choice?.Field.Key;
        // The columns found in ActivityApp; the one in use and the default are always listed (so a column that is gone is still shown, and the default can be chosen back).
        public List<string> Choices { get; } = choice is null ? [] : [.. choice.Available.Concat([choice.Current, choice.Field.Column]).Distinct(StringComparer.OrdinalIgnoreCase)];
    }

    private sealed class ExtraRow(string table, string column, string label, string target)
    {
        public string Table { get; } = table;
        public string Column { get; } = column;
        public string Label { get; set; } = label;
        public string Target { get; set; } = target;
        public string Key => ActivityFieldMap.ExtraKey(Table, Column);
    }

    private List<FieldRow>? fields;
    private readonly List<ExtraRow> extras = [];
    private IReadOnlyDictionary<string, IReadOnlyList<string>>? textColumns;
    private string newTable = ActivityFieldMap.ExtraTables[0], newColumn = "", newLabel = "";
    private string? fieldsError;
    private int outdated;
    private TicketStructureDiff? structureChange;

    private IEnumerable<string> AvailableForNew =>
        (textColumns is not null && textColumns.TryGetValue(newTable, out var list) ? list : [])
            .Where(name => !extras.Any(extra => extra.Table == newTable && extra.Column.Equals(name, StringComparison.OrdinalIgnoreCase)));

    // The rows of the screen from the settings in force (and, when the source was read, the columns ActivityApp has now).
    private void Show(ActivityFieldMapView view)
    {
        fieldsError = view.SourceError;
        structureChange = view.StructureChange;
        var map = view.Map ?? ActivityFieldMap.Empty;
        fields = [.. ActivityFieldMap.Info.Select(item => new FieldRow(item, item.FieldKey is null ? null : view.Fields.FirstOrDefault(choice => choice.Field.Key == item.FieldKey), map.IsEnabled(item.Key), item.Mandatory ? ActivityFieldMap.Notes : map.TargetOf(item.Key)) { Label = map.LabelOf(item.Key) })];
        extras.Clear();
        extras.AddRange(map.Extras.Select(extra => new ExtraRow(extra.Table, extra.Column, extra.Label, extra.Target)));
        if (view.TextColumns is not null) textColumns = view.TextColumns;
        newColumn = "";
    }

    private async Task ReadFieldsAsync()
    {
        Show(await Import.GetFieldChoicesAsync(true, lifetime.Token));
        await CountOutdatedAsync();
    }

    private async Task CountOutdatedAsync()
    {
        try { outdated = await Refresh.CountOutdatedAsync(lifetime.Token); }
        catch (Exception ex) when (ex is ActivityImportException or AccessDeniedException or BlazorStoc.Modules.ModuleUnavailableException) { outdated = 0; }
    }

    private Task LoadFieldsAsync() => RunAsync("Se citesc coloanele…", ReadFieldsAsync);

    // The settings as the screen holds them: only the columns that differ from the default, the pieces switched off, the destinations chosen and the extra fields.
    private ActivityFieldMap? Settings(out string? problem)
    {
        var columns = fields!.Where(row => row.FieldKey is not null && row.Column is not null).ToDictionary(row => row.FieldKey!, row => row.Column!);
        var off = fields!.Where(row => !row.Item.Mandatory && !row.Enabled).Select(row => row.Item.Key);
        var targets = fields!.Where(row => !row.Item.Mandatory).ToDictionary(row => row.Item.Key, row => row.Target);
        var labels = fields!.Where(row => !row.Item.Mandatory).ToDictionary(row => row.Item.Key, row => row.Label);
        return ActivityFieldMap.Create(columns, off, targets, extras.Select(extra => new ActivityExtraField(extra.Table, extra.Column, extra.Label, extra.Target)), labels, out problem);
    }

    private Task SaveFieldsAsync() => RunAsync("Se salvează corespondența…", async () =>
    {
        var settings = Settings(out var problem) ?? throw new ActivityImportException(problem ?? "Corespondența câmpurilor nu este validă.");
        await Import.SaveFieldSettingsAsync(settings, lifetime.Token);
        await ReadFieldsAsync();
        noticeOk = true; notice = "Corespondența câmpurilor a fost salvată.";
        if (outdated > 0) await RefreshAfterSaveAsync();
    });

    // After a save that asks for more than the tickets kept hold: they are read again at once. A failure here (no connection, ActivityApp does not answer) leaves the settings saved.
    private async Task RefreshAfterSaveAsync()
    {
        try { await RefreshCoreAsync(); }
        catch (Exception ex) when (ex is ActivityImportException or ActivitySourceException)
        {
            noticeOk = true; notice = "Corespondența a fost salvată, dar tichetele preluate nu s-au putut actualiza acum: " + ex.Message + " Se actualizează la următoarea sincronizare.";
        }
    }

    private async Task RefreshCoreAsync()
    {
        var progress = new Progress<string>(text => { busyText = text; _ = InvokeAsync(StateHasChanged); });
        var report = await Refresh.RefreshAsync(progress, lifetime.Token);
        await CountOutdatedAsync();
        noticeOk = report.Problems.Count == 0;
        notice = $"Corespondența a fost salvată. Tichete actualizate: {report.Updated}" + (report.NotFound > 0 ? $", {report.NotFound} negăsite în ActivityApp" : "") +
            $"; înregistrări sursă rescrise: {report.SourceRecords}; observații actualizate: {report.NotesUpdated}" + (report.NotesEdited > 0 ? $", {report.NotesEdited} modificate de operator (lăsate neatinse)" : "") +
            (report.Problems.Count > 0 ? "; probleme: " + string.Join(" ", report.Problems.Take(3)) : ".");
    }

    private Task RefreshTicketsAsync() => RunAsync("Se actualizează tichetele preluate…", RefreshCoreAsync);

    private void AddExtra()
    {
        var label = newLabel.Trim();
        if (newColumn.Length == 0 || label.Length == 0) return;
        fieldsError = null;
        extras.Add(new ExtraRow(newTable, newColumn, label, ActivityFieldMap.Both));
        newColumn = ""; newLabel = "";
    }

    private void RemoveExtra(ExtraRow extra) => extras.Remove(extra);

    // The correspondence was checked for the structure ActivityApp has now: the notification ends and the next changes are compared with this structure.
    private Task ConfirmStructureAsync() => RunAsync("Se confirmă structura…", async () =>
    {
        await Import.ConfirmTicketStructureAsync(lifetime.Token);
        await ReadFieldsAsync();
        noticeOk = true; notice = "Corespondența a fost confirmată pentru structura actuală a tichetelor din ActivityApp.";
    });

    // The example ticket: the newest finished one, and the ones before it as "Tichet anterior"; the ones already loaded are kept for "Tichet mai nou". Nothing of them is kept after the window is closed.
    private readonly List<TicketSample> samples = [];
    private int sampleIndex;
    private bool sampleBusy;
    private string? sampleError;
    private TicketSample? sample => samples.Count > 0 ? samples[sampleIndex] : null;

    private IReadOnlyList<TicketSampleDialog.SampleTarget> SampleTargets =>
        [.. ActivityFieldMap.Info.Where(item => item.FieldKey is not null).Select(item => new TicketSampleDialog.SampleTarget(item.Key, fields?.FirstOrDefault(row => row.Item.Key == item.Key)?.Label ?? item.Label, item.FieldKey!.Split('.')[0]))];

    private Task OpenSampleAsync() => RunAsync("Se citește tichetul exemplu…", async () =>
    {
        var view = await Import.GetTicketSampleAsync(null, lifetime.Token);
        if (view.Sample is null) { fieldsError = view.Error; return; }
        fieldsError = null; sampleError = null;
        samples.Clear(); samples.Add(view.Sample); sampleIndex = 0;
    });

    private async Task OlderSampleAsync()
    {
        if (sampleBusy || sample is not { } current) return;
        if (sampleIndex < samples.Count - 1) { sampleIndex++; sampleError = null; return; }
        sampleBusy = true; sampleError = null;
        try
        {
            var view = await Import.GetTicketSampleAsync(current.TicketId, lifetime.Token);
            if (view.Sample is null) sampleError = view.Error;
            else { samples.Add(view.Sample); sampleIndex = samples.Count - 1; }
        }
        catch (Exception ex) when (ex is ActivityImportException or ActivitySourceException or AccessDeniedException) { sampleError = ex.Message; }
        finally { sampleBusy = false; }
    }

    private void NewerSample() { if (sampleIndex > 0) { sampleIndex--; sampleError = null; } }

    private void CloseSample() { samples.Clear(); sampleIndex = 0; sampleError = null; sampleNote = null; }

    // A column chosen in the window. A piece of information has one column: choosing a column for it moves the correspondence there (the column it had before is free; the piece that had the
    // chosen column gives it up: one that can be switched off is switched off, title and number take the column the chosen piece had). A new extra field is named in the window (the name may repeat),
    // and an extra field already there moves to the column. A column may feed an extra field and a piece of information at once.
    private string? sampleNote;

    /// <summary>A column of the lists of the example ticket and what is done with it.</summary>
    private sealed record SampleAssignment(string Table, string Column, string For, string Name = "", string Target = "");

    // The list "Folosite" of the window: the pieces of information that are on (with their column) and the free fields, in the order they are saved; the client CUI is always there.
    private IReadOnlyList<TicketSampleDialog.SampleUsed> UsedList()
    {
        var list = new List<TicketSampleDialog.SampleUsed>();
        if (fields is null) return list;
        foreach (var row in fields)
        {
            var table = row.Item.FieldKey?.Split('.')[0] ?? "";
            var column = row.Column ?? "";
            if (row.Item.Mandatory) list.Add(new(row.Item.Key, table, column, ActivityFieldMap.ColumnName(table, column), row.Item.Label, ActivityFieldMap.Notes, row.Item.Key, true, "Se preia mereu: în observații și titlu"));
            else if (row.Enabled) list.Add(new(row.Item.Key, table, column, column.Length == 0 ? "" : ActivityFieldMap.ColumnName(table, column), row.Label, row.Target, row.Item.Key));
        }
        foreach (var extra in extras) list.Add(new(extra.Key, extra.Table, extra.Column, ActivityFieldMap.ColumnName(extra.Table, extra.Column), extra.Label, extra.Target, "extra"));
        if (sample?.Tables.FirstOrDefault(table => table.Table == ClientTable)?.Columns.FirstOrDefault() is { } cui)
            list.Add(new("client-cui", ClientTable, cui.Column, "Client – " + cui.Column, "CUI client", ActivityFieldMap.Notes, "client", true, "Se preia automat pentru persoane juridice; nu poate fi detașat"));
        return list;
    }

    private const string ClientTable = "Client";

    // A column switched on or off in the lists of the window. On: a piece of information that was switched off and reads this column comes back; otherwise the column becomes a free field named like the
    // column. Off: the free field goes away and the pieces of information that read the column are switched off (title and number cannot).
    private void ToggleFromSample(TicketSampleDialog.SampleToggle toggle)
    {
        sampleError = null; sampleNote = null;
        if (toggle.Table == ClientTable) return;
        bool Same(string table, string column) => toggle.Table.Equals(table, StringComparison.OrdinalIgnoreCase) && toggle.Column.Equals(column, StringComparison.OrdinalIgnoreCase);
        var name = ActivityFieldMap.ColumnName(toggle.Table, toggle.Column);
        var roles = fields?.Where(row => row.FieldKey is not null && row.Column is not null && Same(row.FieldKey.Split('.')[0], row.Column)).ToList() ?? [];
        if (toggle.On)
        {
            if (roles.Any(row => row.Item.Mandatory || row.Enabled) || extras.Any(extra => Same(extra.Table, extra.Column))) return;
            if (roles.FirstOrDefault(row => !row.Item.Mandatory) is { } back) { back.Enabled = true; sampleNote = $"„{back.Label}” se citește din {name}."; return; }
            extras.Add(new ExtraRow(toggle.Table, toggle.Column, toggle.Column, ActivityFieldMap.Both));
            sampleNote = $"{name} este acum folosită, cu descrierea „{toggle.Column}”; o poți schimba în lista „Folosite”.";
            return;
        }
        if (roles.Any(row => row.Item.Mandatory)) { sampleError = $"{name} se preia mereu (titlul sau numărul tichetului) și nu poate fi detașată."; return; }
        var gone = new List<string>();
        foreach (var extra in extras.Where(extra => Same(extra.Table, extra.Column)).ToList()) { extras.Remove(extra); gone.Add(extra.Label); }
        foreach (var row in roles.Where(row => row.Enabled)) { row.Enabled = false; gone.Add(row.Label); }
        if (gone.Count > 0) sampleNote = $"{name} a fost detașată: {string.Join(", ", gone.Select(label => $"„{label}”"))} nu se mai preia.";
    }

    // A change in the list "Folosite": the description, the destination, the role (a free field becomes a piece of information and back) or the detaching.
    private void EditFromSample(TicketSampleDialog.SampleEdit edit)
    {
        sampleError = null; sampleNote = null;
        var row = fields?.FirstOrDefault(item => item.Item.Key == edit.Key && !item.Item.Mandatory);
        var extra = extras.FirstOrDefault(item => item.Key == edit.Key);
        if (row is null && extra is null) return;
        if (edit.Detach)
        {
            if (extra is not null) { extras.Remove(extra); sampleNote = $"„{extra.Label}” a fost detașat."; }
            else if (row is not null) { row.Enabled = false; sampleNote = $"„{row.Label}” a fost detașat."; }
            return;
        }
        if (edit.Label is not null)
        {
            var label = edit.Label.Trim();
            if (label.Length == 0) { sampleError = "Descrierea nu poate fi goală."; return; }
            if (label.Length > ActivityFieldMap.MaximumLabel) label = label[..ActivityFieldMap.MaximumLabel];
            if (extra is not null) extra.Label = label; else row!.Label = label;
        }
        if (edit.Target is not null && ActivityFieldMap.IsTarget(edit.Target))
        {
            if (extra is not null) extra.Target = edit.Target; else row!.Target = edit.Target;
        }
        if (edit.Role is not null)
        {
            if (extra is not null && edit.Role != "extra")
            {
                extras.Remove(extra);
                AssignFromSample(new SampleAssignment(extra.Table, extra.Column, edit.Role));
            }
            else if (row is not null && row.Column is not null && row.FieldKey is not null && edit.Role == "extra")
            {
                var table = row.FieldKey.Split('.')[0];
                row.Enabled = false;
                extras.Add(new ExtraRow(table, row.Column, row.Label, row.Target));
                sampleNote = $"{ActivityFieldMap.ColumnName(table, row.Column)} este acum câmp liber „{row.Label}”.";
            }
            else if (row is not null && row.Column is not null && row.FieldKey is not null && edit.Role != row.Item.Key)
                AssignFromSample(new SampleAssignment(row.FieldKey.Split('.')[0], row.Column, edit.Role));
        }
    }

    private void AssignFromSample(SampleAssignment choice)
    {
        sampleError = null; sampleNote = null;
        bool Same(string table, string column) => choice.Table.Equals(table, StringComparison.OrdinalIgnoreCase) && choice.Column.Equals(column, StringComparison.OrdinalIgnoreCase);
        var name = ActivityFieldMap.ColumnName(choice.Table, choice.Column);
        if (choice.For == "extra")
        {
            if (extras.FirstOrDefault(extra => Same(extra.Table, extra.Column)) is { } existing) { sampleError = $"{name} este deja câmpul suplimentar „{existing.Label}”; alege-l din listă ca să-l muți sau scoate-l mai întâi."; return; }
            var label = choice.Name.Trim().Length > 0 ? choice.Name.Trim() : choice.Column;
            extras.Add(new ExtraRow(choice.Table, choice.Column, label.Length > ActivityFieldMap.MaximumLabel ? label[..ActivityFieldMap.MaximumLabel] : label, ActivityFieldMap.IsTarget(choice.Target) ? choice.Target : ActivityFieldMap.Both));
            sampleNote = $"Câmp suplimentar nou „{label}”, citit din {name}.";
            return;
        }
        if (choice.For.StartsWith("x:", StringComparison.Ordinal))
        {
            var moving = extras.FirstOrDefault(extra => extra.Key == choice.For[2..]);
            if (moving is null) return;
            if (Same(moving.Table, moving.Column)) return;
            var from = ActivityFieldMap.ColumnName(moving.Table, moving.Column);
            var parts = new List<string> { $"Câmpul suplimentar „{moving.Label}” se citește acum din {name} (înainte din {from})." };
            if (extras.FirstOrDefault(extra => extra != moving && Same(extra.Table, extra.Column)) is { } displaced)
            {
                extras.Remove(displaced);
                parts.Add($"Câmpul suplimentar „{displaced.Label}”, care citea {name}, a fost scos.");
            }
            extras[extras.IndexOf(moving)] = new ExtraRow(choice.Table, choice.Column, moving.Label, moving.Target);
            sampleNote = string.Join(" ", parts);
            return;
        }
        if (fields?.FirstOrDefault(row => row.Item.Key == choice.For) is not { Column: not null } target) return;
        var previous = target.Column;
        var notes = new List<string>();
        if (!previous.Equals(choice.Column, StringComparison.OrdinalIgnoreCase))
        {
            foreach (var other in fields.Where(row => row != target && row.Column is not null && row.FieldKey is not null && row.FieldKey.StartsWith(choice.Table + ".", StringComparison.Ordinal)
                         && row.Column.Equals(choice.Column, StringComparison.OrdinalIgnoreCase) && (row.Enabled || row.Item.Mandatory)).ToList())
            {
                if (other.Item.Mandatory)
                {
                    if (!other.Choices.Contains(previous, StringComparer.OrdinalIgnoreCase)) other.Choices.Add(previous);
                    other.Column = previous;
                    notes.Add($"„{other.Label}” a trecut pe coloana {ActivityFieldMap.ColumnName(choice.Table, previous)} (o informație obligatorie nu rămâne fără coloană).");
                }
                else
                {
                    other.Enabled = false;
                    notes.Add($"„{other.Label}” a rămas fără coloană și a fost oprită.");
                }
            }
        }
        if (!target.Choices.Contains(choice.Column, StringComparer.OrdinalIgnoreCase)) target.Choices.Add(choice.Column);
        target.Column = choice.Column;
        target.Enabled = true;
        notes.Insert(0, previous.Equals(choice.Column, StringComparison.OrdinalIgnoreCase) ? $"„{target.Label}” se citește din {name}." : $"„{target.Label}”: {ActivityFieldMap.ColumnName(choice.Table, previous)} → {name}.");
        sampleNote = string.Join(" ", notes);
    }

    private void ResetFields()
    {
        foreach (var row in fields!)
        {
            if (row.Column is not null) row.Column = row.DefaultColumn;
            row.Enabled = true;
            row.Target = row.Item.DefaultTarget;
            row.Label = row.Item.Label;
        }
        extras.Clear();
    }


