<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tool separat de aplicatie: pune "NU OPRI PC" pe fundalul ecranului de blocare/login din Windows 11, cat timp este pornit; la repornire revine imaginea originala. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>LoginMessage</AssemblyName>
    <RootNamespace>LoginMessage</RootNamespace>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.10" />
  </ItemGroup>

</Project>
